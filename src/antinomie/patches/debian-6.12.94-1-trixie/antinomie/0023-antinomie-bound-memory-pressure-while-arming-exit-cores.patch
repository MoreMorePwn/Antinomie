Description: antinomie: bound memory pressure while arming exit cores
Author: MikiMiku <jonathanirvinjo@gmail.com>
Origin: project
Forwarded: no
Last-Update: 2026-10-12


---
diff --git a/kernel/antinomie/process_core.c b/kernel/antinomie/process_core.c
index 957cfc4b7..d3151d687 100644
--- a/kernel/antinomie/process_core.c
+++ b/kernel/antinomie/process_core.c
@@ -119,7 +119,9 @@ struct ant_core *ant_core_create(u32 max_size, u32 timeout_ms)
 	core->max_size = max_size;
 	refcount_set(&core->refs, 1);
 	INIT_LIST_HEAD(&core->node);
-	core->data = vzalloc(max_size);
+	/* Optional acquisition must not escalate reclaim to arm its buffer. */
+	core->data = __vmalloc(max_size, GFP_KERNEL | __GFP_ZERO |
+			      __GFP_NORETRY | __GFP_NOWARN);
 	if (!core->data) {
 		core_put(core);
 		return ERR_PTR(-ENOMEM);
@@ -352,7 +354,7 @@ bool ant_monitor_core_exit(int wait_status, const kernel_siginfo_t *siginfo)
 	else if (time_after_eq(jiffies, core->deadline))
 		error = -ETIMEDOUT;
 	if (!error && (!core->expected_size || core->size < core->expected_size))
-		error = -EFBIG;
+		error = core->expected_size > core->max_size ? -EFBIG : -EIO;
 	mutex_lock(&core_lock);
 	if (core->expected_size)
 		core->flags |= ANTC_CORE_NATIVE_ELF64;
