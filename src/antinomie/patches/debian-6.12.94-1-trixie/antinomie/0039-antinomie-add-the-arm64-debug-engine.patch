+#ifdef ANT_DBG_FORK_REPAIR
+/* A child with its own copy of the program's memory that the debugger does
+ * not follow, before it runs: the engine's bytes in that copy go back to the
+ * program's own. A child that met one would take a SIGTRAP, and under a
+ * SIGTRAP handler it would trap again at the same BRK for ever.
+ */
+static void unfollowed_child_bytes(struct ant_dbg *s, struct task_struct *child)
+{
+	struct ant_dbg_bp *bps;
+	struct ant_dbg_as *as;
+	unsigned int i, count = 0;
+
+	as = as_get(s);
+	if (!as)
+		return;
+	bps = kmalloc_array(MAX_BREAKPOINTS, sizeof(*bps), GFP_KERNEL);
+	if (bps) {
+		spin_lock_irq(&as->lock);
+		for (i = 0; i < as->bp_count; i++)
+			if (as->bps[i].inserted)
+				bps[count++] = as->bps[i];
+		spin_unlock_irq(&as->lock);
+		for (i = 0; i < count; i++)
+			restore_byte(child->mm, bps[i].addr, bps[i].orig, bps[i].len);
+		kfree(bps);
+	}
+	as_put(as);
+}
+#endif
