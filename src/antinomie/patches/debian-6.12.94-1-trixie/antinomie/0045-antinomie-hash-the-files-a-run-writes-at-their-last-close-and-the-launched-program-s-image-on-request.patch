+/* Filesystems with no stored content: a write there is a control operation,
+ * not a file the run left behind, and its last close publishes nothing.
+ */
+static bool pseudo_fs(unsigned long magic)
+{
+	switch (magic) {
+	case PROC_SUPER_MAGIC: case SYSFS_MAGIC: case CGROUP_SUPER_MAGIC:
+	case CGROUP2_SUPER_MAGIC: case DEBUGFS_MAGIC: case TRACEFS_MAGIC:
+	case SECURITYFS_MAGIC: case BPF_FS_MAGIC: case PSTOREFS_MAGIC:
+	case EFIVARFS_MAGIC: case SELINUX_MAGIC: case SMACK_MAGIC:
+	case BINFMTFS_MAGIC:
+		return true;
+	}
+	return false;
+}
+
+/* __fput() of a file opened for writing, after its write access was put. When
+ * it was the file's last writer and a task of a run that hashes its writes let
+ * it go (also at exit, after the task left the run), the content the run left
+ * is queued for hashing. Never sleeps or waits: the job takes its own path
+ * reference before __fput() drops the file's.
+ */
+void ant_monitor_close_write(struct file *file)
+{
+	struct inode *inode = file->f_inode;
+	struct ant_hash_job *job;
+
+	/* A file opened for writing holds write access; a pseudo file made for
+	 * writing (memfd) has none, and only one with write methods counts (an
+	 * attached System V shared memory segment has none).
+	 */
+	if (!S_ISREG(inode->i_mode) ||
+	    !(file->f_mode & (FMODE_WRITER | FMODE_CAN_WRITE)) ||
+	    (file->f_mode & FMODE_NONOTIFY) || pseudo_fs(inode->i_sb->s_magic) ||
+	    !ant_run_hashes(current, ANTC_EXEC_HASH_WRITES))
+		return;
+	/* Another writer still has it open (or, below zero, it is being
+	 * executed and cannot have one): its own last close comes later.
+	 */
+	if (atomic_read(&inode->i_writecount) != 0)
+		return;
+	job = job_new(ANTC_HASH_WRITE, true);
+	if (!job)
+		return;
+	job->deferred = true;
+	job->status = classify(inode, &job->seen);
+	job->size = job->seen.size;
+	job->mode = inode->i_mode;
+	job->nlink = inode->i_nlink;
+	if (job->status == ANTC_HASH_OK) {
+		job->path = file->f_path;
+		path_get(&job->path);
+	}
+	submit(job);
+}
