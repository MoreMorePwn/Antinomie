+static void operand_clear(struct ant_task *ctx)
+{
+	kfree(ctx->operand);
+	ctx->operand = NULL;
+	ctx->operand_set = false;
+}
+
+/* A kernel path hands over its own copy of a user operand whose extent only
+ * the kernel knows; it is emitted at this syscall's exit as kernel-imported.
+ */
+void ant_monitor_operand(u8 arg, const char *key, const char *layout, const void *data,
+			 size_t size)
+{
+	struct ant_task *ctx = current->ant_monitor;
+
+	if (!current->ant_cookie || !ctx || !ctx->active)
+		return;
+	operand_clear(ctx);
+	ctx->operand_key = key;
+	ctx->operand_layout = layout;
+	ctx->operand_arg = arg;
+	ctx->operand_size = size;
+	ctx->operand = size ? kmemdup(data, size, GFP_NOWAIT) : NULL;
+	ctx->operand_set = true;
+}
+
+static void operand_emit(struct ant_task *ctx)
+{
+	if (!ctx->operand_set)
+		return;
+	ctx->kernel_imported = true;
+	field(ctx, ctx->operand_arg, ctx->operand_key, ctx->operand_layout, 3,
+	      ctx->operand_arg < 6 ? ctx->args[ctx->operand_arg] : 0, ctx->operand,
+	      ctx->operand_size, ctx->operand_size,
+	      ctx->operand || !ctx->operand_size ? ANT_COMPLETE : ANT_RESOURCE_EXHAUSTED);
+	ctx->kernel_imported = false;
+	operand_clear(ctx);
+}
+
 void ant_monitor_enter(struct pt_regs *regs, long nr)
 {
