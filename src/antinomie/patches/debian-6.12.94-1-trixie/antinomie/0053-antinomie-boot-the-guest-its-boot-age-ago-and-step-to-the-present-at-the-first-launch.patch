diff --git a/kernel/antinomie/uptime.c b/kernel/antinomie/uptime.c
new file mode 100644
index 000000000..2bd2e22f4
--- /dev/null
+++ b/kernel/antinomie/uptime.c
@@ -0,0 +1,118 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* The VM's boot age: a machine in use has been up for hours (a desktop or
+ * laptop) or days to months (a server), not the minutes of a fresh VM.
+ *
+ * The host passes antinomie_boot_age=SECONDS:MODEL, chosen once per VM; like
+ * the other antinomie_* options it is taken out of the command line before
+ * the kernel prints it. The guest then boots age seconds in the past and
+ * reaches the present when the host first launches a program (the first EXEC
+ * command, after the boot's own records are written):
+ *
+ * - While booting the wall clock runs age seconds behind the time the host
+ *   gave it (timekeeping_init(), and every setting of the clock before the
+ *   first launch: the RTC at boot, timesyncd's saved time, hwclock). What the
+ *   boot writes is stamped with that time: the utmp/wtmp boot record, the
+ *   journal's first entries, the files it creates. The boot time
+ *   (/proc/stat btime), CLOCK_BOOTTIME, uptime and the kernel log's place in
+ *   wall time agree with it, and the processes started at boot (init) have
+ *   their start time at the boot.
+ * - At the first launch the wall clock steps to the present and
+ *   CLOCK_BOOTTIME forward by the age, as a resume from sleep does: uptime,
+ *   sysinfo() and the boot time say the machine has been up since age seconds
+ *   before the boot. Then by the model:
+ *   - suspend (desktop, laptop): CLOCK_MONOTONIC does not move, as after a
+ *     real sleep (and, as there, the kernel log's timestamps do not count it).
+ *   - continuous (server, cloud): programs' CLOCK_MONOTONIC (system calls,
+ *     the vDSO, absolute timers, futexes, clock_nanosleep, timerfd) and the
+ *     kernel log's timestamps run age seconds ahead from then on, so
+ *     CLOCK_MONOTONIC equals CLOCK_BOOTTIME as on a machine that never slept,
+ *     and each CPU's idle time has most of the age in it.
+ *
+ * The kernel's own CLOCK_MONOTONIC, jiffies and scheduler clock never move:
+ * the recorder's timestamps, the host's accounting of guest time and every
+ * timeout in the kernel run on them. What stays: timestamps the kernel hands
+ * out on its own monotonic clock (input events, DRM vblanks) are behind a
+ * continuous-model program's clock by the age; a process running across the
+ * first launch sees its clocks move forward then.
+ */
+#include <linux/antinomie_stealth.h>
+#include <linux/atomic.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/math64.h>
+#include <linux/string.h>
+#include <linux/time64.h>
+#include <linux/timekeeping.h>
+
+/* The oldest boot the host may ask for: about three years. */
+#define ANT_BOOT_AGE_MAX_S (3ULL * 366 * 24 * 3600)
+
+static u64 boot_age_s __ro_after_init;
+static bool continuous __ro_after_init;
+/* Seconds the wall clock runs behind while booting; 0 once at the present or
+ * without an age. */
+static u64 behind_s;
+/* The true wall time minus CLOCK_MONOTONIC at timekeeping_init(). */
+static struct timespec64 true_minus_mono;
+static atomic_t reached = ATOMIC_INIT(0);
+/* Programs' CLOCK_MONOTONIC ahead of the kernel's (continuous model, after
+ * the first launch); read by time_namespace.h, vsyscall.c and printk. */
+u64 ant_user_mono_ns __read_mostly;
+
+static int __init boot_age_param(char *value)
+{
+	char *model;
+	u64 seconds;
+
+	if (!value)
+		return -EINVAL;
+	model = strchr(value, ':');
+	if (model)
+		*model++ = '\0';
+	if (kstrtoull(value, 10, &seconds) || !seconds || seconds > ANT_BOOT_AGE_MAX_S)
+		return -EINVAL;
+	boot_age_s = seconds;
+	continuous = model && !strcmp(model, "continuous");
+	return 0;
+}
+early_param("antinomie_boot_age", boot_age_param);
+
+/* timekeeping_init(): the wall clock read from the persistent clock (wall,
+ * true time) goes back by the age; boot_offset is CLOCK_MONOTONIC then. An
+ * age the wall clock cannot go back by is ignored. */
+void __init ant_boot_age_init(struct timespec64 *wall, const struct timespec64 *boot_offset)
+{
+	if (!boot_age_s || wall->tv_sec <= (time64_t)boot_age_s)
+		return;
+	true_minus_mono = timespec64_sub(*wall, *boot_offset);
+	wall->tv_sec -= boot_age_s;
+	behind_s = boot_age_s;
+}
+
+/* do_settimeofday64() before the first launch: a time set while booting (the
+ * RTC, a saved time, hwclock) is a present time, shown as the boot's. */
+void ant_boot_age_settime(struct timespec64 *ts)
+{
+	u64 behind = READ_ONCE(behind_s);
+
+	if (behind && ts->tv_sec > (time64_t)behind)
+		ts->tv_sec -= behind;
+}
+
+/* A continuous boot age as a server's: its CPUs mostly idle (97 %) through
+ * it, in each CPU's idle time (/proc/stat, /proc/uptime). A suspend leaves
+ * idle time alone, as a real sleep does. */
+u64 ant_boot_idle_ns(void)
+{
+	return div_u64(READ_ONCE(ant_user_mono_ns), 100) * 97;
+}
+
+/* The first EXEC: the present. Once; later calls return at once. */
+void ant_boot_age_present(void)
+{
+	if (!READ_ONCE(behind_s) || atomic_xchg(&reached, 1))
+		return;
+	ant_timekeeping_present(&true_minus_mono, (s64)boot_age_s * NSEC_PER_SEC,
+				continuous ? boot_age_s * NSEC_PER_SEC : 0);
+	WRITE_ONCE(behind_s, 0);
+}
