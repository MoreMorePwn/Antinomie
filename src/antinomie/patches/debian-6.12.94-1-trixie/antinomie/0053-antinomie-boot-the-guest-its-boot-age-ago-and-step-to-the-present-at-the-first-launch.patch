diff --git a/include/linux/time_namespace.h b/include/linux/time_namespace.h
index 876e31b44..299a994be 100644
--- a/include/linux/time_namespace.h
+++ b/include/linux/time_namespace.h
@@ -12,6 +12,46 @@
 struct user_namespace;
 extern struct user_namespace init_user_ns;
 
+/* Antinomie: how far programs' CLOCK_MONOTONIC runs ahead of the kernel's
+ * (the continuous boot age, kernel/antinomie/uptime.c); 0 otherwise. */
+#ifdef CONFIG_ANTINOMIE_BOOT_AGE
+extern u64 ant_user_mono_ns;
+
+static inline void ant_add_user_monotonic(struct timespec64 *ts)
+{
+	u64 ahead = READ_ONCE(ant_user_mono_ns);
+
+	if (ahead)
+		timespec64_add_ns(ts, ahead);
+}
+
+static inline ktime_t ant_user_monotonic_to_kernel(clockid_t clockid, ktime_t tim)
+{
+	u64 ahead = READ_ONCE(ant_user_mono_ns);
+
+	if (!ahead || clockid != CLOCK_MONOTONIC)
+		return tim;
+	return tim > (ktime_t)ahead ? tim - (ktime_t)ahead : 0;
+}
+
+static inline u64 ant_user_monotonic_s(void)
+{
+	return div_u64(READ_ONCE(ant_user_mono_ns), NSEC_PER_SEC);
+}
+#else
+static inline void ant_add_user_monotonic(struct timespec64 *ts) { }
+
+static inline u64 ant_user_monotonic_s(void)
+{
+	return 0;
+}
+
+static inline ktime_t ant_user_monotonic_to_kernel(clockid_t clockid, ktime_t tim)
+{
+	return tim;
+}
+#endif
