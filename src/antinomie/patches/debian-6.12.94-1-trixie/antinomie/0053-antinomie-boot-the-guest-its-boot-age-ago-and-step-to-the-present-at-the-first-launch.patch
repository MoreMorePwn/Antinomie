diff --git a/kernel/time/timekeeping.c b/kernel/time/timekeeping.c
index e3896b2be..390ca97f7 100644
--- a/kernel/time/timekeeping.c
+++ b/kernel/time/timekeeping.c
@@ -24,6 +24,7 @@
 #include <linux/compiler.h>
 #include <linux/audit.h>
 #include <linux/random.h>
+#include <linux/antinomie_stealth.h>
 
 #include "tick-internal.h"
 #include "ntp_internal.h"
@@ -141,7 +142,10 @@ static void tk_set_xtime(struct timekeeper *tk, const struct timespec64 *ts)
 	tk->tkr_mono.xtime_nsec = (u64)ts->tv_nsec << tk->tkr_mono.shift;
 }
 
-static void tk_xtime_add(struct timekeeper *tk, const struct timespec64 *ts)
+/* Antinomie: inlined, as Debian's build does (ant_timekeeping_present() is a
+ * second caller). */
+static __always_inline void tk_xtime_add(struct timekeeper *tk,
+					 const struct timespec64 *ts)
 {
 	tk->xtime_sec += ts->tv_sec;
 	tk->tkr_mono.xtime_nsec += (u64)ts->tv_nsec << tk->tkr_mono.shift;
@@ -1343,10 +1347,13 @@ EXPORT_SYMBOL_GPL(timekeeping_clocksource_has_base);
 int do_settimeofday64(const struct timespec64 *ts)
 {
 	struct timekeeper *tk = &tk_core.timekeeper;
-	struct timespec64 ts_delta, xt;
+	struct timespec64 ts_delta, xt, shown = *ts;
 	unsigned long flags;
 	int ret = 0;
 
+	/* Antinomie: a time set while booting is shown at the boot's. */
+	ant_boot_age_settime(&shown);
+	ts = &shown;
 	if (!timespec64_valid_settod(ts))
 		return -EINVAL;
 
@@ -1678,6 +1685,8 @@ void __init timekeeping_init(void)
 
 	if (timespec64_compare(&wall_time, &boot_offset) < 0)
 		boot_offset = (struct timespec64){0};
+	/* Antinomie: the boot happens the VM's boot age in the past. */
+	ant_boot_age_init(&wall_time, &boot_offset);
 
 	/*
 	 * We want set wall_to_mono, so the following is true:
@@ -1708,6 +1717,40 @@ void __init timekeeping_init(void)
 /* time in seconds when suspend began for persistent clock */
 static struct timespec64 timekeeping_suspend_time;
 
+#ifdef CONFIG_ANTINOMIE_BOOT_AGE
+/*
+ * Antinomie (kernel/antinomie/uptime.c): the boot age's step to the present.
+ * The wall clock steps to the true time (@true_minus_mono, the true wall time
+ * minus CLOCK_MONOTONIC at timekeeping_init(), plus CLOCK_MONOTONIC now),
+ * CLOCK_BOOTTIME forward by @age_ns as a resume adds a sleep, and
+ * CLOCK_MONOTONIC stays; @user_mono_ns is how far programs' CLOCK_MONOTONIC
+ * runs ahead from now on (the vDSO's data is updated here too).
+ */
+notrace void ant_timekeeping_present(const struct timespec64 *true_minus_mono, s64 age_ns,
+				     u64 user_mono_ns)
+{
+	struct timekeeper *tk = &tk_core.timekeeper;
+	struct timespec64 delta, wall;
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&timekeeper_lock, flags);
+	write_seqcount_begin(&tk_core.seq);
+	timekeeping_forward_now(tk);
+	delta = timespec64_add(*true_minus_mono, tk->wall_to_monotonic);
+	wall = timespec64_add(tk_xtime(tk), delta);
+	if (timespec64_valid_settod(&wall)) {
+		tk_xtime_add(tk, &delta);
+		tk_set_wall_to_mono(tk, timespec64_sub(tk->wall_to_monotonic, delta));
+	}
+	tk_update_sleep_time(tk, ns_to_ktime(age_ns));
+	WRITE_ONCE(ant_user_mono_ns, user_mono_ns);
+	timekeeping_update(tk, TK_CLEAR_NTP | TK_MIRROR | TK_CLOCK_WAS_SET);
+	write_seqcount_end(&tk_core.seq);
+	raw_spin_unlock_irqrestore(&timekeeper_lock, flags);
+	clock_was_set(CLOCK_SET_WALL | CLOCK_SET_BOOT);
+}
+#endif
+
 /**
  * __timekeeping_inject_sleeptime - Internal function to add sleep interval
  * @tk:		Pointer to the timekeeper to be updated
diff --git a/kernel/time/vsyscall.c b/kernel/time/vsyscall.c
index 9193d6133..8f31f9eb0 100644
--- a/kernel/time/vsyscall.c
+++ b/kernel/time/vsyscall.c
@@ -8,6 +8,7 @@
  */
 
 #include <linux/hrtimer.h>
+#include <linux/time_namespace.h>
 #include <linux/timekeeper_internal.h>
 #include <vdso/datapage.h>
 #include <vdso/helpers.h>
@@ -69,6 +70,14 @@ static inline void update_vdso_data(struct vdso_data *vdata,
 	vdso_ts->sec	= tk->raw_sec;
 	vdso_ts->nsec	= tk->tkr_raw.xtime_nsec;
 
+	/*
+	 * Antinomie: programs' CLOCK_MONOTONIC (and its raw clock) run ahead
+	 * of the kernel's by the continuous boot age; CLOCK_BOOTTIME has it in
+	 * its boot offset already.
+	 */
+	vdata[CS_HRES_COARSE].basetime[CLOCK_MONOTONIC].sec += ant_user_monotonic_s();
+	vdata[CS_RAW].basetime[CLOCK_MONOTONIC_RAW].sec += ant_user_monotonic_s();
+
 	/* CLOCK_TAI */
 	vdso_ts		= &vdata[CS_HRES_COARSE].basetime[CLOCK_TAI];
 	vdso_ts->sec	= tk->xtime_sec + (s64)tk->tai_offset;
@@ -105,6 +114,7 @@ void update_vsyscall(struct timekeeper *tk)
 	nsec		= tk->tkr_mono.xtime_nsec >> tk->tkr_mono.shift;
 	nsec		= nsec + tk->wall_to_monotonic.tv_nsec;
 	vdso_ts->sec	+= __iter_div_u64_rem(nsec, NSEC_PER_SEC, &vdso_ts->nsec);
+	vdso_ts->sec	+= ant_user_monotonic_s();
 
 	/*
 	 * Read without the seqlock held by clock_getres().
