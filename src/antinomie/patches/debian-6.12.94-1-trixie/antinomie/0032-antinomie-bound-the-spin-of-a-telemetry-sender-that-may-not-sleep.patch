Description: antinomie: bound the spin of a telemetry sender that may not sleep
Author: MikiMiku <jonathanirvinjo@gmail.com>
Origin: project
Forwarded: no
Last-Update: 2026-10-20

Cap the atomic-context wait in ant_send at 200 microseconds; a sender that may sleep keeps the host's allowance.

---
diff --git a/kernel/antinomie/guest.c b/kernel/antinomie/guest.c
index d508f3cb8..a34d621c1 100644
--- a/kernel/antinomie/guest.c
+++ b/kernel/antinomie/guest.c
@@ -18,6 +18,13 @@
 #include "process_core.h"
 #include "debug.h"
 
+/* The longest a sender that may not sleep spins for room in a full ring, whatever
+ * wait the host asked for: it holds a CPU, and with interrupts off a spin of
+ * milliseconds is a hard-lockup report. A sender that may sleep waits for the
+ * host's full allowance.
+ */
+#define ANT_SEND_ATOMIC_WAIT_US 200U
+
 struct ant_cpu {
 	struct page *pages;
 	void *data;
@@ -146,6 +153,7 @@ int ant_send(const void *data, size_t payload_len)
 	struct ant_message msg = { .payload_len = payload_len };
 	u64 waited_from = 0, now;
 	u32 wait_us;
+	bool may_sleep;
 	int error;
 
 	if (!in_task()) return -EWOULDBLOCK;
@@ -167,8 +175,11 @@ int ant_send(const void *data, size_t payload_len)
 		/* The host may ask senders to wait for room instead of dropping,
 		 * bounded and only while it is live. A sender that may sleep
 		 * sleeps, so the control worker and other tasks keep running;
-		 * one in atomic context spins. */
+		 * one in atomic context spins, and only briefly. */
+		may_sleep = preempt_count() == 1 && !irqs_disabled() && !rcu_preempt_depth();
 		wait_us = min_t(u32, READ_ONCE(control->send_wait_us), ANT_SEND_WAIT_MAX_US);
+		if (!may_sleep)
+			wait_us = min_t(u32, wait_us, ANT_SEND_ATOMIC_WAIT_US);
 		if (!wait_us || !READ_ONCE(control->live))
 			break;
 		now = local_clock();
@@ -178,7 +189,7 @@ int ant_send(const void *data, size_t payload_len)
 		} else if (now - waited_from >= (u64)wait_us * NSEC_PER_USEC) {
 			break;
 		}
-		if (preempt_count() == 1 && !irqs_disabled() && !rcu_preempt_depth()) {
+		if (may_sleep) {
 			/* Only our own preempt_disable is held: sleep, then take this
 			 * CPU's producer again (the task may have moved). */
 			WRITE_ONCE(q->attempted, p->attempted);
