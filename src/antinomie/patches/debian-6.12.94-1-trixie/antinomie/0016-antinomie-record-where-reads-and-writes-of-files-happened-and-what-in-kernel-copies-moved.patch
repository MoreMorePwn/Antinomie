+#include "control_wire.h"
+
+#define ANT_FILEPOS_KEY "file.position"
+#define ANT_FILEPOS_LAYOUT "antinomie.filepos/1"
+#define ANT_FILECOPY_KEY "file.copy"
+#define ANT_FILECOPY_LAYOUT "antinomie.filecopy/1"
+#define ANT_FILECOPY_DATA_KEY "file.copy.data"
+
+/* What the file hooks found during the current traced call, published as
+ * kernel-imported fields of its exit (control_wire.h, file.position and
+ * file.copy). Owned by the task's recorder context; reset at each entry.
+ */
+struct ant_fileops {
+	u8 position[ANTC_FILEPOS_SIZE];
+	u8 copy[ANTC_FILECOPY_SIZE];
+	/* Bytes a copy from a source that cannot be read again gave the destination. */
+	u8 *data;
+	u32 data_len, data_size;
+	/* Write order of the call's first write (control_wire.h); zero: none. */
+	u64 order;
+	bool position_set, copy_set, data_wanted, data_cut;
+};
+
+/* The records of the calling task's traced native call in progress, and its
+ * system call number; NULL when the task is not inside one.
+ */
+struct ant_fileops *ant_monitor_fileops(u64 *nr);
+/* Forget the records (and free the carried bytes). */
+void ant_fileops_reset(struct ant_fileops *ops);
+
+#endif
