+#define ANTC_REVISION 18
 #define ANTC_HEADER_SIZE 8
 #define ANTC_UPLOAD_BEGIN 0x1001
 #define ANTC_UPLOAD_CHUNK 0x1002
@@ -327,6 +329,66 @@
 #define ANTC_HASH_FILE_MAX 16777216
 #define ANTC_HASH_PENDING_MAX 67108864
 #define ANTC_HASH_QUEUE 16
+/* Kernel-imported fields of a call's exit (arg_index 255, provenance
+ * KERNEL_IMPORTED; revision 18, additive: a host that does not know them shows
+ * an unknown field). Only native calls that succeeded carry them, and only for
+ * seekable files: regular files and block devices.
+ * file.position, layout "antinomie.filepos/1", 24 bytes: u64 offset at 0, the
+ * file offset where the transfer began, u64 length at 8, the bytes it moved
+ * (the result), and u64 write order at 16 (below). Published by read, write,
+ * pread64, pwrite64, readv, writev, preadv, pwritev, preadv2 and pwritev2. It
+ * is the position the file system used, not the one the program could have
+ * predicted: a descriptor shared with another task (fork, dup, SCM_RIGHTS)
+ * moves for all of them, and an O_APPEND write (or RWF_APPEND, or a pwrite on
+ * an O_APPEND file) starts at the end of the file as it was when the write
+ * took the inode lock.
+ * Write order: a number from one counter for the whole guest, taken in the
+ * file system's write checks (generic_write_checks), which it runs holding the
+ * file's inode lock. Two writes to one file that the lock serialized have
+ * numbers in the order the file system applied them, whatever order their
+ * exits reach the host in; a host replays overlapping writes by it. Zero when
+ * not known: a read, a block device, a file system that does not use the
+ * generic checks. A call that writes in several pieces (a splice) has the
+ * number of its first piece.
+ * file.copy, layout "antinomie.filecopy/1", 104 bytes: what an in-kernel copy
+ * moved, or the range an allocation changed. u8 kind at 0 (SENDFILE, SPLICE,
+ * COPY_RANGE: copy_file_range, CLONE: ioctl FICLONE or FICLONERANGE,
+ * FALLOCATE: fallocate or a preallocation ioctl), u8 flags at 1
+ * (SOURCE_OFFSET: the source offset is a file offset; DEST_OFFSET: the same
+ * for the destination; DATA: the bytes follow as field file.copy.data;
+ * DATA_CUT: the destination got more than file.copy.data holds), zero at 2,
+ * u32 mode at 4 (FALLOCATE: the FALLOC_FL_* flags; zero otherwise), u64
+ * length at 8 (bytes moved or cloned; FALLOCATE: the range's length), u64
+ * source offset at 16, u64 destination offset at 24 (where the range began;
+ * zero without its flag), then the source at 32 and the destination at 56,
+ * each u64 dev (new_encode_dev of the superblock), u64 ino, u32 generation,
+ * u32 mode (i_mode; all zero for FALLOCATE's absent source; a pipe or socket
+ * has its own inode), u64 destination size at 80 (i_size after the call, for
+ * a seekable destination), u32 data length at 88 (bytes in file.copy.data),
+ * zero at 92, u64 write order at 96 (as for file.position, of the write into
+ * the destination; zero for a clone or an allocation). A copy is recorded when either end is seekable: a splice
+ * between a pipe and a socket is not. When the destination is seekable and
+ * the source is not (a splice from a pipe; sendfile and copy_file_range need
+ * a seekable source), the source cannot be read again, so the bytes the
+ * destination got at the destination offset are carried as file.copy.data
+ * (encoding 1, declared extent = length), at most ANTC_FILECOPY_DATA_MAX per
+ * call; the rest is DATA_CUT. A seekable source is not carried: the host
+ * rebuilds the bytes from what it knows of that file. ioctl FIDEDUPERANGE is
+ * not recorded (it changes no content), and neither are io_uring's splice and
+ * fallocate requests.
+ */
+#define ANTC_FILEPOS_SIZE 24
+#define ANTC_FILECOPY_SIZE 104
+#define ANTC_FILECOPY_SENDFILE 1
+#define ANTC_FILECOPY_SPLICE 2
+#define ANTC_FILECOPY_RANGE 3
+#define ANTC_FILECOPY_CLONE 4
+#define ANTC_FILECOPY_FALLOCATE 5
+#define ANTC_FILECOPY_SOURCE_OFFSET 1
+#define ANTC_FILECOPY_DEST_OFFSET 2
+#define ANTC_FILECOPY_DATA 4
+#define ANTC_FILECOPY_DATA_CUT 8
+#define ANTC_FILECOPY_DATA_MAX 1048576
 #define ANTC_UPLOAD_OVERWRITE 1
 #define ANTC_UPLOAD_EXECUTABLE 2
 
diff --git a/kernel/antinomie/fileops.c b/kernel/antinomie/fileops.c
new file mode 100644
index 0000000..e59d1be
--- /dev/null
+++ b/kernel/antinomie/fileops.c
@@ -0,0 +1,232 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Where a traced call read or wrote a file, and what an in-kernel copy moved.
+ *
+ * A read or write through a descriptor uses the open file's position, which
+ * the host cannot follow: a descriptor shared after fork or dup moves for
+ * every task that uses it, and an O_APPEND write lands at the end of the file
+ * as it is when the write takes the inode lock, whatever the position was.
+ * The file system leaves the position where the transfer ended, so the record
+ * carries where it began and its length (file.position).
+ *
+ * An in-kernel copy (sendfile, splice, copy_file_range, a reflink clone)
+ * moves bytes the program never holds, and fallocate changes a range without
+ * writing it. The record names both files and both ranges (file.copy), so the
+ * host can rebuild the bytes from the source it knows. The pipe a splice
+ * reads cannot be read again (sendfile and copy_file_range need a seekable
+ * source), so the bytes the destination got are carried with it
+ * (file.copy.data), up to a budget per call.
+ *
+ * Writes to one file that race finish in an order the exits do not show: the
+ * file system applies them one at a time under the inode lock, and the task
+ * that took the lock first can reach its exit last. Each write takes a number
+ * from one counter while the lock is held (the write order), so the host can
+ * replay overlapping writes in the order the file system applied them.
+ *
+ * Only seekable files have positions: regular files and block devices. All
+ * records go out with the call's exit; a call that failed has none.
+ */
+#include <linux/antinomie_monitor.h>
+#include <linux/atomic.h>
+#include <linux/bvec.h>
+#include <linux/fs.h>
+#include <linux/kdev_t.h>
+#include <linux/minmax.h>
+#include <linux/mm.h>
+#include <linux/sched.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/uio.h>
+#include <linux/unaligned.h>
+#include <asm/unistd.h>
+
+#include "control_wire.h"
+#include "fileops.h"
+
+static_assert(ANT_FILE_COPY_SENDFILE == ANTC_FILECOPY_SENDFILE &&
+	      ANT_FILE_COPY_SPLICE == ANTC_FILECOPY_SPLICE &&
+	      ANT_FILE_COPY_RANGE == ANTC_FILECOPY_RANGE &&
+	      ANT_FILE_COPY_CLONE == ANTC_FILECOPY_CLONE &&
+	      ANT_FILE_COPY_FALLOCATE == ANTC_FILECOPY_FALLOCATE);
+
+static bool seekable(const struct inode *inode)
+{
+	return S_ISREG(inode->i_mode) || S_ISBLK(inode->i_mode);
+}
+
+static bool rw_call(u64 nr)
+{
+	switch (nr) {
+	case __NR_read: case __NR_write: case __NR_pread64: case __NR_pwrite64:
+	case __NR_readv: case __NR_writev: case __NR_preadv: case __NR_pwritev:
+	case __NR_preadv2: case __NR_pwritev2:
+		return true;
+	}
+	return false;
+}
+
+/* The system call that makes a record of @kind. The hooks sit in functions
+ * that other paths share (io_uring's splice and fallocate, an exec reading its
+ * image): only the call itself is recorded.
+ */
+static bool copy_call(u8 kind, u64 nr)
+{
+	switch (kind) {
+	case ANT_FILE_COPY_SENDFILE:
+		return nr == __NR_sendfile;
+	case ANT_FILE_COPY_SPLICE:
+		return nr == __NR_splice;
+	case ANT_FILE_COPY_RANGE:
+		return nr == __NR_copy_file_range;
+	case ANT_FILE_COPY_CLONE:
+		return nr == __NR_ioctl;
+	case ANT_FILE_COPY_FALLOCATE:
+		/* fallocate, and the preallocation ioctls that call it. */
+		return nr == __NR_fallocate || nr == __NR_ioctl;
+	}
+	return false;
+}
+
+void ant_fileops_reset(struct ant_fileops *ops)
+{
+	if (!ops->position_set && !ops->copy_set && !ops->data_wanted && !ops->order)
+		return;
+	kvfree(ops->data);
+	memset(ops, 0, sizeof(*ops));
+}
+
+/* vfs_read(), vfs_write(), vfs_readv(), vfs_writev(): @pos is where the
+ * transfer of @ret bytes left the position (NULL for a stream).
+ */
+void ant_monitor_file_pos(struct file *file, const loff_t *pos, ssize_t ret)
+{
+	struct ant_fileops *ops;
+	u64 nr;
+
+	if (!current->ant_monitor || ret < 0 || !pos || !seekable(file_inode(file)))
+		return;
+	ops = ant_monitor_fileops(&nr);
+	if (!ops || !rw_call(nr))
+		return;
+	put_unaligned_le64(*pos - ret, ops->position);
+	put_unaligned_le64(ret, ops->position + 8);
+	put_unaligned_le64(ops->order, ops->position + 16);
+	ops->position_set = true;
+}
+
+static atomic64_t write_order = ATOMIC64_INIT(0);
+
+/* generic_write_checks_count(), which the file system runs holding the
+ * file's inode lock: the write is about to be applied. A call that writes in
+ * pieces keeps the number of its first.
+ */
+void ant_monitor_write_order(void)
+{
+	struct ant_fileops *ops;
+	u64 nr;
+
+	if (!current->ant_monitor)
+		return;
+	ops = ant_monitor_fileops(&nr);
+	if (!ops || ops->order)
+		return;
+	if (!rw_call(nr) && !copy_call(ANT_FILE_COPY_SENDFILE, nr) &&
+	    !copy_call(ANT_FILE_COPY_SPLICE, nr) && !copy_call(ANT_FILE_COPY_RANGE, nr))
+		return;
+	ops->order = atomic64_inc_return(&write_order);
+}
+
+/* Before a copy of up to @count bytes from @in to @out: a destination file
+ * fed from something that cannot be read again keeps the bytes it gets.
+ */
+void ant_monitor_copy_begin(u8 kind, struct file *in, struct file *out, size_t count)
+{
+	struct ant_fileops *ops;
+	size_t size;
+	u64 nr;
+
+	if (!current->ant_monitor || seekable(file_inode(in)) || !seekable(file_inode(out)))
+		return;
+	ops = ant_monitor_fileops(&nr);
+	if (!ops || !copy_call(kind, nr) || ops->data_wanted)
+		return;
+	ops->data_wanted = true;
+	size = min_t(size_t, count, ANTC_FILECOPY_DATA_MAX);
+	ops->data = size ? kvmalloc(size, GFP_KERNEL | __GFP_NOWARN) : NULL;
+	ops->data_size = ops->data ? size : 0;
+}
+
+/* iter_file_splice_write(): @len bytes of @bvec went into the destination. */
+void ant_monitor_copy_data(const struct bio_vec *bvec, unsigned int segs, size_t len)
+{
+	struct ant_fileops *ops;
+	struct iov_iter from;
+	size_t take;
+	u64 nr;
+
+	if (!current->ant_monitor)
+		return;
+	ops = ant_monitor_fileops(&nr);
+	if (!ops || !ops->data_wanted)
+		return;
+	take = min_t(size_t, len, ops->data_size - ops->data_len);
+	if (take) {
+		iov_iter_bvec(&from, ITER_SOURCE, bvec, segs, take);
+		take = copy_from_iter(ops->data + ops->data_len, take, &from);
+		ops->data_len += take;
+	}
+	if (take < len)
+		ops->data_cut = true;
+}
+
+static void pack_file(u8 *at, const struct inode *inode)
+{
+	put_unaligned_le64(new_encode_dev(inode->i_sb->s_dev), at);
+	put_unaligned_le64(inode->i_ino, at + 8);
+	put_unaligned_le32(inode->i_generation, at + 16);
+	put_unaligned_le32(inode->i_mode, at + 20);
+}
+
+/* After a copy, clone or allocation that succeeded: @len bytes from @in at
+ * @in_pos to @out at @out_pos (a negative position: none). @in is NULL for an
+ * allocation, whose @mode is the FALLOC_FL_* flags.
+ */
+void ant_monitor_file_copy(u8 kind, struct file *in, loff_t in_pos, struct file *out,
+			   loff_t out_pos, u64 len, u32 mode)
+{
+	struct inode *source = in ? file_inode(in) : NULL, *target = file_inode(out);
+	struct ant_fileops *ops;
+	u8 *rec, flags = 0;
+	u64 nr;
+
+	if (!current->ant_monitor || !(seekable(target) || (source && seekable(source))))
+		return;
+	ops = ant_monitor_fileops(&nr);
+	if (!ops || !copy_call(kind, nr))
+		return;
+	rec = ops->copy;
+	memset(rec, 0, ANTC_FILECOPY_SIZE);
+	rec[0] = kind;
+	if (source && seekable(source) && in_pos >= 0) {
+		flags |= ANTC_FILECOPY_SOURCE_OFFSET;
+		put_unaligned_le64(in_pos, rec + 16);
+	}
+	if (seekable(target) && out_pos >= 0) {
+		flags |= ANTC_FILECOPY_DEST_OFFSET;
+		put_unaligned_le64(out_pos, rec + 24);
+	}
+	if (ops->data_len)
+		flags |= ANTC_FILECOPY_DATA;
+	if (ops->data_cut || (ops->data_wanted && ops->data_len < len))
+		flags |= ANTC_FILECOPY_DATA_CUT;
+	rec[1] = flags;
+	put_unaligned_le32(mode, rec + 4);
+	put_unaligned_le64(len, rec + 8);
+	if (source)
+		pack_file(rec + 32, source);
+	pack_file(rec + 56, target);
+	if (seekable(target))
+		put_unaligned_le64(i_size_read(target), rec + 80);
+	put_unaligned_le32(ops->data_len, rec + 88);
+	put_unaligned_le64(ops->order, rec + 96);
+	ops->copy_set = true;
+}
