Description: antinomie: escalate Stop to SIGKILL for the whole run after a grace period
Author: MikiMiku <jonathanirvinjo@gmail.com>
Origin: project
Forwarded: no
Last-Update: 2026-10-20

STOP_RUN arms a guest-side SIGKILL for the whole run after a grace period (default 4 s), without interrupting a core copy; RUN_STATUS flag KILL_ESCALATED.

---
diff --git a/kernel/antinomie/control.c b/kernel/antinomie/control.c
index 2b8303f4b..3de30719c 100644
--- a/kernel/antinomie/control.c
+++ b/kernel/antinomie/control.c
@@ -27,6 +27,7 @@
 #include "observer.h"
 #include "resources.h"
 #include "process_core.h"
+#include "run.h"
 #include "debug.h"
 
 #define ANT_SESSION_MAX 64
@@ -521,40 +522,33 @@ static int terminal_command(u32 opcode, const u8 *args, size_t args_len,
 
 static int stop_run(const u8 *args, size_t args_len)
 {
-	struct task_struct *process, *task;
 	u64 root_cookie;
-	bool issued = false;
-	int error, first_error = 0;
+	u32 grace_ms = 0;
+	bool issued;
+	int error;
 
-	if (args_len != 16)
+	if (args_len != 16 && args_len != 24)
 		return -EINVAL;
 	root_cookie = get_unaligned_le64(args + 8);
 	if (!root_cookie)
 		return -EINVAL;
+	if (args_len == 24) {
+		grace_ms = get_unaligned_le32(args + 16);
+		if (get_unaligned_le32(args + 20) ||
+		    (grace_ms && (grace_ms < 100 || grace_ms > 30000)))
+			return -EINVAL;
+	}
 
-	/* RCU protects traversal; each signal uses a referenced task, never a PID.
-	 * Membership survives PTY reaping and root exit. Concurrent forks can
-	 * escape this pass, so success only reports an issued signal request.
+	/* Membership survives PTY reaping and root exit. Concurrent forks can
+	 * escape this pass, so success only reports an issued signal request;
+	 * the escalation to SIGKILL (run.c) covers a task that ignores SIGTERM.
 	 */
-	rcu_read_lock();
-	for_each_process_thread(process, task) {
-		if (!READ_ONCE(task->ant_cookie) ||
-		    READ_ONCE(task->ant_root_cookie) != root_cookie)
-			continue;
-		get_task_struct(task);
-		error = send_sig(SIGTERM, task, 1);
-		put_task_struct(task);
-		if (!error)
-			issued = true;
-		else if (error != -ESRCH && !first_error)
-			first_error = error;
-	}
-	rcu_read_unlock();
-	if (issued)
+	error = ant_run_signal(root_cookie, SIGTERM, &issued);
+	if (issued) {
 		ant_monitor_run_stopped(root_cookie);
-	if (first_error)
-		return first_error;
-	return issued ? 0 : -ESRCH;
+		ant_run_stop_arm(root_cookie, grace_ms);
+	}
+	return error;
 }
 
 static int command(const void *data, size_t args_len, void *reply,
diff --git a/kernel/antinomie/control_wire.h b/kernel/antinomie/control_wire.h
index 56ef8c362..3252203b9 100644
--- a/kernel/antinomie/control_wire.h
+++ b/kernel/antinomie/control_wire.h
@@ -33,6 +33,7 @@
 #define ANTC_RUN_STOP_REQUESTED 4
 #define ANTC_RUN_ASYNC_COMPLETE 8
 #define ANTC_RUN_OBSERVATION_INCOMPLETE 16
+#define ANTC_RUN_KILL_ESCALATED 32
 #define ANTC_STATS 0x1020
 #define ANTC_INFO 0x1021
 #define ANTC_INFO_SIZE 160
@@ -281,11 +282,18 @@
  * u16 pixel_width at 20, u16 pixel_height at 22. Empty success reply.
  * SIGNAL: header, u64 session_id at 8, u32 signal at 16,
  * u32 reserved=0 at 20. Signals launch process group. Empty success reply.
- * STOP_RUN: header flags=0, nonzero u64 root_task_cookie at 8 (16 bytes).
+ * STOP_RUN: header flags=0, nonzero u64 root_task_cookie at 8 (16 bytes), or
+ * 24 bytes with u32 grace_ms at 16 (0 selects the default, 4000; otherwise
+ * 100..30000) and u32 reserved=0 at 20.
  * Requests SIGTERM for each traced task with this inherited launch cookie,
  * including descendants after root exit or PTY/session reaping. Empty reply.
  * Status 0 means signal requests issued, not proven tree termination; -ESRCH
  * means no signalable matching task. Concurrent forks may escape this pass.
+ * After the grace period the guest itself sends SIGKILL to every task of the
+ * run still alive and repeats it every 250 ms (20 passes at most) while tasks
+ * remain, and sets RUN_STATUS flag KILL_ESCALATED (32). A process core being
+ * copied is not interrupted: the escalation waits for it, for at most 15 s
+ * past the grace period. A later STOP_RUN only brings the deadline forward.
  * RUN_STATUS: header flags=0, nonzero u64 root cookie at 8 (16 bytes).
  * Success: 64-byte reply specified in protocol/run-status.md. Task/tree
  * completion, root wait status, async observations and saving are distinct.
diff --git a/kernel/antinomie/process_core.c b/kernel/antinomie/process_core.c
index 3c0dd589d..ae05c2c1f 100644
--- a/kernel/antinomie/process_core.c
+++ b/kernel/antinomie/process_core.c
@@ -549,6 +549,24 @@ void ant_monitor_core_unavailable(int wait_status)
 	ant_run_core_arm(root_cookie, false);
 }
 
+/* Whether a process core of this run is being copied right now. A SIGKILL sent
+ * then would abort the copy, so Stop's escalation waits (bounded) for it.
+ */
+bool ant_core_run_busy(u64 root_cookie)
+{
+	struct ant_core *core;
+	bool busy = false;
+
+	mutex_lock(&core_lock);
+	list_for_each_entry(core, &cores, node)
+		if (core->root_cookie == root_cookie && core->state == ANTC_CORE_COPYING) {
+			busy = true;
+			break;
+		}
+	mutex_unlock(&core_lock);
+	return busy;
+}
+
 int ant_core_command(u32 opcode, const u8 *args, size_t args_len,
 		     void *reply, size_t capacity, size_t *reply_len)
 {
diff --git a/kernel/antinomie/process_core.h b/kernel/antinomie/process_core.h
index 53a83f875..cd98ed4b6 100644
--- a/kernel/antinomie/process_core.h
+++ b/kernel/antinomie/process_core.h
@@ -31,5 +31,6 @@ void ant_core_finish_launch(struct ant_core *core, bool executed);
 int ant_core_command(u32 opcode, const u8 *args, size_t args_len,
 		     void *reply, size_t capacity, size_t *reply_len);
 void ant_core_shutdown(void);
+bool ant_core_run_busy(u64 root_cookie);
 
 #endif
diff --git a/kernel/antinomie/run.c b/kernel/antinomie/run.c
index 0fe4e9341..f032a7bfa 100644
--- a/kernel/antinomie/run.c
+++ b/kernel/antinomie/run.c
@@ -3,14 +3,30 @@
 #include <linux/errno.h>
 #include <linux/sched.h>
 #include <linux/sched/signal.h>
+#include <linux/sched/task.h>
 #include <linux/spinlock.h>
 #include <linux/unaligned.h>
+#include <linux/workqueue.h>
 
 #include "control_wire.h"
+#include "process_core.h"
 #include "run.h"
 
 #define ANT_RUN_COUNT 64
 
+/* Stop escalation. STOP_RUN sends SIGTERM to every task of a run; a task that
+ * ignores or blocks it would then run on for ever. The guest therefore sends
+ * SIGKILL to the whole run after a grace period, with no help from the host.
+ * A process core being copied is not interrupted: the escalation waits for it,
+ * but never longer than ANT_STOP_CORE_WAIT_MS past the grace period. SIGKILL
+ * is repeated every ANT_STOP_RECHECK_MS while tasks of the run are still live
+ * (a fork that raced the first pass), at most ANT_STOP_PASSES times.
+ */
+#define ANT_STOP_GRACE_DEFAULT_MS 4000U
+#define ANT_STOP_CORE_WAIT_MS 15000U
+#define ANT_STOP_RECHECK_MS 250U
+#define ANT_STOP_PASSES 20U
+
 struct ant_run {
 	u64 root_cookie;
 	u64 generation;
@@ -21,6 +37,9 @@ struct ant_run {
 	u32 flags;
 	s32 root_status;
 	bool core_armed;
+	bool stop_armed;
+	u32 stop_passes;
+	unsigned long kill_at, kill_hard;
 };
 
 /* Boot-lifetime objects never move or disappear. Task and async ownership can
@@ -29,6 +48,11 @@ struct ant_run {
 static struct ant_run runs[ANT_RUN_COUNT];
 static unsigned int run_count;
 static DEFINE_SPINLOCK(run_lock);
+static void stop_escalate(struct work_struct *work);
+static DECLARE_DELAYED_WORK(stop_work, stop_escalate);
+/* Whether stop_work is queued and when it fires; both under run_lock. */
+static bool stop_scheduled;
+static unsigned long stop_next;
 
 static struct ant_run *find_run(u64 cookie)
 {
@@ -214,3 +238,125 @@ void ant_run_async_incomplete(u64 root_cookie)
 {
 	async_update(root_cookie, 0, false);
 }
+
+/* Signal every task that carries this run's launch cookie. RCU protects the
+ * traversal; each signal uses a referenced task, never a PID, so membership
+ * survives PTY reaping and root exit. A fork that races the pass can escape it.
+ * Returns the first error other than -ESRCH, else 0 if a signal was issued, else
+ * -ESRCH.
+ */
+int ant_run_signal(u64 root_cookie, int sig, bool *issued)
+{
+	struct task_struct *process, *task;
+	int error, first_error = 0;
+
+	*issued = false;
+	rcu_read_lock();
+	for_each_process_thread(process, task) {
+		if (!READ_ONCE(task->ant_cookie) ||
+		    READ_ONCE(task->ant_root_cookie) != root_cookie)
+			continue;
+		get_task_struct(task);
+		error = send_sig(sig, task, 1);
+		put_task_struct(task);
+		if (!error)
+			*issued = true;
+		else if (error != -ESRCH && !first_error)
+			first_error = error;
+	}
+	rcu_read_unlock();
+	if (first_error)
+		return first_error;
+	return *issued ? 0 : -ESRCH;
+}
+
+/* Schedule the escalation check for the earliest deadline. Caller holds
+ * run_lock, which orders this against the work's own reschedule.
+ */
+static void stop_schedule_locked(unsigned long at)
+{
+	if (stop_scheduled && !time_before(at, stop_next))
+		return;
+	stop_scheduled = true;
+	stop_next = at;
+	mod_delayed_work(system_unbound_wq, &stop_work, at > jiffies ? at - jiffies : 0);
+}
+
+/* Arm the SIGKILL escalation of a run whose Stop was accepted. A repeated Stop
+ * can only bring the deadline forward. grace_ms 0 selects the default.
+ */
+void ant_run_stop_arm(u64 root_cookie, u32 grace_ms)
+{
+	struct ant_run *run;
+	unsigned long irqflags, at;
+
+	at = jiffies + msecs_to_jiffies(grace_ms ?: ANT_STOP_GRACE_DEFAULT_MS);
+	spin_lock_irqsave(&run_lock, irqflags);
+	run = find_run(root_cookie);
+	if (run && !(run->flags & ANTC_RUN_TREE_EXITED)) {
+		if (!run->stop_armed || time_before(at, run->kill_at)) {
+			run->kill_at = at;
+			run->kill_hard = at + msecs_to_jiffies(ANT_STOP_CORE_WAIT_MS);
+		}
+		if (!run->stop_armed)
+			run->stop_passes = 0;
+		run->stop_armed = true;
+		stop_schedule_locked(run->kill_at);
+	}
+	spin_unlock_irqrestore(&run_lock, irqflags);
+}
+
+static void stop_escalate(struct work_struct *work)
+{
+	u64 cookies[ANT_RUN_COUNT];
+	bool hard[ANT_RUN_COUNT], busy[ANT_RUN_COUNT];
+	unsigned int i, due = 0, n;
+	unsigned long irqflags, now;
+	struct ant_run *run;
+	bool issued;
+
+	spin_lock_irqsave(&run_lock, irqflags);
+	now = jiffies;
+	stop_scheduled = false;
+	for (i = 0; i < run_count; i++) {
+		run = &runs[i];
+		if (!run->stop_armed)
+			continue;
+		if (run->flags & ANTC_RUN_TREE_EXITED) {
+			run->stop_armed = false;
+		} else if (!time_before(now, run->kill_at)) {
+			cookies[due] = run->root_cookie;
+			hard[due++] = !time_before(now, run->kill_hard);
+		}
+	}
+	spin_unlock_irqrestore(&run_lock, irqflags);
+
+	for (n = 0; n < due; n++) {
+		busy[n] = !hard[n] && ant_core_run_busy(cookies[n]);
+		issued = false;
+		if (!busy[n])
+			ant_run_signal(cookies[n], SIGKILL, &issued);
+		spin_lock_irqsave(&run_lock, irqflags);
+		run = find_run(cookies[n]);
+		if (run && run->stop_armed) {
+			if (busy[n]) {
+				run->kill_at = jiffies + msecs_to_jiffies(ANT_STOP_RECHECK_MS);
+			} else {
+				if (issued && !(run->flags & ANTC_RUN_KILL_ESCALATED)) {
+					run->flags |= ANTC_RUN_KILL_ESCALATED;
+					run->generation++;
+				}
+				run->kill_at = jiffies + msecs_to_jiffies(ANT_STOP_RECHECK_MS);
+				if (++run->stop_passes >= ANT_STOP_PASSES)
+					run->stop_armed = false;
+			}
+		}
+		spin_unlock_irqrestore(&run_lock, irqflags);
+	}
+
+	spin_lock_irqsave(&run_lock, irqflags);
+	for (i = 0; i < run_count; i++)
+		if (runs[i].stop_armed && !(runs[i].flags & ANTC_RUN_TREE_EXITED))
+			stop_schedule_locked(runs[i].kill_at);
+	spin_unlock_irqrestore(&run_lock, irqflags);
+}
diff --git a/kernel/antinomie/run.h b/kernel/antinomie/run.h
index e8ae99a40..273938e80 100644
--- a/kernel/antinomie/run.h
+++ b/kernel/antinomie/run.h
@@ -9,6 +9,8 @@ struct task_struct;
 int ant_run_launch(struct task_struct *task, u64 cookie);
 void ant_run_fork(struct task_struct *parent, struct task_struct *child);
 bool ant_run_exit(struct task_struct *task, bool group_dead);
+int ant_run_signal(u64 root_cookie, int sig, bool *issued);
+void ant_run_stop_arm(u64 root_cookie, u32 grace_ms);
 void ant_run_core_arm(u64 root_cookie, bool armed);
 void ant_run_async_start(u64 root_cookie);
 void ant_run_async_finish(u64 root_cookie);
