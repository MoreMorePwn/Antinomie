+#ifdef ANT_ABI_COMPAT
+/* A compat program's call: its registers' low halves as its arguments, the
+ * 32-bit signed ones sign-extended as a native call's are, and the native
+ * call to capture it as, if the arm table names one (ant_compat_natives).
+ */
+/* prctl reads an arch-sized object behind some options (PR_SET_MM's map,
+ * PR_SET_SECCOMP's program, PR_GET_AUXV's vector), so the arm table gives it
+ * no native counterpart. The options whose objects have one layout on ILP32
+ * and LP64 are captured by the native code: the task name, an int result
+ * and an anonymous mapping's name.
+ */
+static bool compat_prctl_native(u64 nr, u64 option)
+{
+	if (nr != __NR_compat32_prctl)
+		return false;
+	switch (option) {
+	case PR_SET_NAME: case PR_GET_NAME: case PR_GET_PDEATHSIG:
+	case PR_GET_CHILD_SUBREAPER: case PR_SET_VMA:
+		return true;
+	}
+	return false;
+}
+
+static void compat_entry(struct ant_task *ctx)
+{
+	const struct ant_compat_syscall *twin = NULL;
+	u64 nr = ctx->nr;
+	int i;
+
+	ctx->compat = ctx->abi == ANT_ABI_COMPAT;
+	if (!ctx->compat)
+		return;
+	ctx->wire_nr = nr;
+	ctx->arg_count = 255;
+	if (nr < ARRAY_SIZE(ant_compat_syscalls) && ant_compat_syscalls[nr].valid) {
+		ctx->arg_count = ant_compat_syscalls[nr].argc;
+		twin = &ant_compat_natives[nr];
+	}
+	for (i = 0; i < 6; i++) {
+		u64 value = lower_32_bits(ctx->args[i]);
+
+		if (ctx->arg_count != 255 && i >= ctx->arg_count)
+			value = 0;
+		else if (twin && (twin->signed_mask & BIT(i)))
+			value = (u64)(s64)(s32)value;
+		ctx->args[i] = value;
+	}
+	if (twin && twin->native) {
+		ctx->nr = twin->native - 1;
+		ctx->abi = ANT_ABI_NATIVE;
+	} else if (compat_prctl_native(nr, ctx->args[0])) {
+		ctx->nr = __NR_prctl;
+		ctx->abi = ANT_ABI_NATIVE;
+	}
+}
