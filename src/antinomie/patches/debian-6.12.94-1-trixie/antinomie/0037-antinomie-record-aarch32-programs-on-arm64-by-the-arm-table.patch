+		      U64_MAX, U64_MAX, ANT_NO_DECODER);
+		return;
+	}
+	schema = &ant_compat_syscalls[ctx->wire_nr];
+	for (i = 0; i < ctx->arg_count && !ctx->failed_count; i++) {
+		if (!(schema->pointer_mask & BIT(i)))
+			continue;
+		if (schema->string_mask & BIT(i)) {
+			scnprintf(key, sizeof(key), "arg%d.path", i);
+			user_string(ctx, i, key, ctx->args[i], PATH_MAX);
+			continue;
+		}
+		scnprintf(key, sizeof(key), "arg%d.%s", i,
+			  schema->argument_names[i] ?: "pointer");
+		field(ctx, i, key, "", 1, ctx->args[i], NULL, U64_MAX, U64_MAX,
+		      ctx->args[i] ? ANT_NO_DECODER : ANT_NULL_POINTER);
+	}
+}
