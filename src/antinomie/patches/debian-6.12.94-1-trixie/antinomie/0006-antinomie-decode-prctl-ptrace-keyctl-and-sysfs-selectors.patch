+/* Selector families (slice 2B). Pointer roles follow the pinned kernel/sys.c,
+ * kernel/ptrace.c, arch/x86/kernel/ptrace.c, security/keys and fs/filesystems.c.
+ */
+#define ANT_ANON_VMA_NAME_MAX 80	/* ANON_VMA_NAME_MAX_LEN, kernel/sys.c */
+#define ANT_KEY_TYPE_MAX 32		/* char type[32], security/keys/keyctl.c */
+#define ANT_KEY_DESC_MAX 4096		/* KEY_MAX_DESC_SIZE, security/keys/keyctl.c */
+#define ANT_KEY_UPDATE_MAX PAGE_SIZE	/* keyctl_update_key() payload limit */
+#define ANT_KEY_PAYLOAD_MAX (1024 * 1024 - 1)	/* keyctl_instantiate_key() */
+#define ANT_KDF_HASH_MAX 128		/* CRYPTO_MAX_ALG_NAME */
+#define ANT_KDF_OTHERINFO_MAX 64	/* KEYCTL_KDF_MAX_OI_LEN, security/keys/internal.h */
+
+static void capture_fixed(struct ant_task *ctx, u8 arg, const char *key, const char *layout,
+			  u64 address, u64 size)
+{
+	ant_capture_field(ctx, arg, key, layout, 3, address, NULL, size, size, ANT_COMPLETE);
+}
+
+/* A fixed struct in the caller's memory: input of a SET request at entry, or
+ * output of the paired GET request after success.
+ */
+static void capture_paired(struct ant_task *ctx, bool output, long result, bool get,
+			   const char *key, const char *layout, u64 address, u64 size)
+{
+	if (output == get && (!output || result == 0))
+		capture_fixed(ctx, 3, key, layout, address, size);
+}
+
+/* The kernel returns the full length but copies only what fits the caller's buffer. */
+static void capture_truncated(struct ant_task *ctx, u8 arg, const char *key,
+			      const char *layout, u64 address, u64 capacity, long result)
+{
+	if (address && result >= 0)
+		ant_capture_field(ctx, arg, key, layout, 1, address, NULL,
+				  min_t(u64, capacity, result), result, ANT_COMPLETE);
+}
+
+static void capture_bounded(struct ant_task *ctx, u8 arg, const char *key, u64 address,
+			    u64 length, u64 ceiling)
+{
+	if (address || length)
+		ant_capture_field(ctx, arg, key, "", 1, address, NULL,
+				  min(length, ceiling), length,
+				  length > ceiling ? ANT_INVALID_EXTENT : ANT_COMPLETE);
+}
+
+static void capture_prctl_mm(struct ant_task *ctx, const u64 args[6], bool output, long result)
+{
+	const u64 auxv_max = sizeof_field(struct mm_struct, saved_auxv);
+	struct prctl_mm_map map;
+	enum ant_status status;
+
+	switch (args[1]) {
+	case PR_SET_MM_MAP:
+		if (output)
+			return;
+		if (args[3] != sizeof(map)) {
+			ant_capture_field(ctx, 2, "arg2.mm_map", LAYOUT("prctl_mm_map"), 3, args[2],
+					  NULL, min_t(u64, args[3], sizeof(map)), args[3],
+					  ANT_INVALID_EXTENT);
+			return;
+		}
+		status = copy_from_user_nofault(&map, (void __user *)(unsigned long)args[2],
+						sizeof(map)) ? ANT_COPY_FAULT : ANT_COMPLETE;
+		ant_capture_field(ctx, 2, "arg2.mm_map", LAYOUT("prctl_mm_map"), 3, args[2],
+				  &map, sizeof(map), sizeof(map), status);
+		if (status == ANT_COMPLETE && map.auxv && !ant_capture_lost(ctx))
+			ant_capture_field(ctx, 2, "arg2.mm_map.auxv", LAYOUT("unsigned_long[]"), 3,
+					  (unsigned long)map.auxv, NULL,
+					  min_t(u64, map.auxv_size, auxv_max), map.auxv_size,
+					  map.auxv_size > auxv_max ? ANT_INVALID_EXTENT :
+					  ANT_COMPLETE);
+		return;
+	case PR_SET_MM_MAP_SIZE:
+		if (output && result == 0)
+			capture_fixed(ctx, 2, "arg2.size", LAYOUT("u32"), args[2], sizeof(u32));
+		return;
+	case PR_SET_MM_AUXV:
+		if (!output)
+			ant_capture_field(ctx, 2, "arg2.auxv", LAYOUT("unsigned_long[]"), 3,
+					  args[2],
+					  NULL, min(args[3], auxv_max), args[3],
+					  args[3] > auxv_max ? ANT_INVALID_EXTENT : ANT_COMPLETE);
+		return;
+	case PR_SET_MM_START_CODE: case PR_SET_MM_END_CODE: case PR_SET_MM_START_DATA:
+	case PR_SET_MM_END_DATA: case PR_SET_MM_START_STACK: case PR_SET_MM_START_BRK:
+	case PR_SET_MM_BRK: case PR_SET_MM_ARG_START: case PR_SET_MM_ARG_END:
+	case PR_SET_MM_ENV_START: case PR_SET_MM_ENV_END: case PR_SET_MM_EXE_FILE:
+		return;
+	default:
+		if (!output)
+			capture_gap(ctx, "prctl.unknown_selector", ANT_NO_DECODER);
+	}
+}
+
+static void capture_prctl(struct ant_task *ctx, const u64 args[6], bool output, long result)
+{
+	switch ((u32)args[0]) {
+	case PR_SET_NAME:
+		if (!output)
+			ant_capture_string(ctx, 1, "arg1.name", args[1], TASK_COMM_LEN);
+		return;
+	case PR_GET_NAME:
+		if (output && result == 0)
+			capture_fixed(ctx, 1, "arg1.name", LAYOUT("char[16]"), args[1],
+				      TASK_COMM_LEN);
+		return;
+	case PR_GET_PDEATHSIG: case PR_GET_CHILD_SUBREAPER: case PR_GET_TSC:
+		if (output && result == 0)
+			capture_fixed(ctx, 1, "arg1.value", LAYOUT("int"), args[1], sizeof(int));
+		return;
+	case PR_GET_TID_ADDRESS:
+		if (output && result == 0)
+			capture_fixed(ctx, 1, "arg1.tid_address", LAYOUT("address"), args[1],
+				      sizeof(unsigned long));
+		return;
+	case PR_GET_AUXV:
+		if (output)
+			capture_truncated(ctx, 1, "arg1.auxv", LAYOUT("unsigned_long[]"), args[1],
+					  args[2], result);
+		return;
+	case PR_SET_SECCOMP:
+		if (!output && args[1] == SECCOMP_MODE_FILTER)
+			capture_fprog(ctx, 2, args[2], sizeof(struct sock_fprog), "arg2.program");
+		return;
+	case PR_SET_MM:
+		capture_prctl_mm(ctx, args, output, result);
+		return;
+	case PR_SET_VMA:
+		if (output)
+			return;
+		if (args[1] == PR_SET_VMA_ANON_NAME) {
+			if (args[4])
+				ant_capture_string(ctx, 4, "arg4.name", args[4],
+						   ANT_ANON_VMA_NAME_MAX);
+		} else {
+			capture_gap(ctx, "prctl.unknown_selector", ANT_NO_DECODER);
+		}
+		return;
+	case PR_SET_SYSCALL_USER_DISPATCH:
+		/* The kernel reads the selector byte later, on every syscall. */
+		if (!output && args[1] == PR_SYS_DISPATCH_ON && args[4])
+			ant_capture_field(ctx, 4, "arg4.selector", LAYOUT("u8"), 3, args[4], NULL,
+					  1, 1, ANT_ASYNC_UNOBSERVED);
+		return;
+	case PR_SCHED_CORE:
+		if (output && result == 0 && args[1] == PR_SCHED_CORE_GET)
+			capture_fixed(ctx, 4, "arg4.cookie", LAYOUT("u64"), args[4], sizeof(u64));
+		return;
+	case PR_SET_PDEATHSIG: case PR_GET_DUMPABLE: case PR_SET_DUMPABLE:
+	case PR_GET_UNALIGN: case PR_SET_UNALIGN: case PR_GET_KEEPCAPS: case PR_SET_KEEPCAPS:
+	case PR_GET_FPEMU: case PR_SET_FPEMU: case PR_GET_FPEXC: case PR_SET_FPEXC:
+	case PR_GET_TIMING: case PR_SET_TIMING: case PR_GET_ENDIAN: case PR_SET_ENDIAN:
+	case PR_GET_SECCOMP: case PR_CAPBSET_READ: case PR_CAPBSET_DROP: case PR_SET_TSC:
+	case PR_GET_SECUREBITS: case PR_SET_SECUREBITS: case PR_GET_TIMERSLACK:
+	case PR_SET_TIMERSLACK: case PR_TASK_PERF_EVENTS_DISABLE:
+	case PR_TASK_PERF_EVENTS_ENABLE: case PR_MCE_KILL: case PR_MCE_KILL_GET:
+	case PR_SET_PTRACER: case PR_SET_CHILD_SUBREAPER: case PR_SET_NO_NEW_PRIVS:
+	case PR_GET_NO_NEW_PRIVS: case PR_SET_THP_DISABLE: case PR_GET_THP_DISABLE:
+	case PR_MPX_ENABLE_MANAGEMENT: case PR_MPX_DISABLE_MANAGEMENT:
+	case PR_SET_FP_MODE: case PR_GET_FP_MODE: case PR_CAP_AMBIENT:
+	case PR_SVE_SET_VL: case PR_SVE_GET_VL: case PR_GET_SPECULATION_CTRL:
+	case PR_SET_SPECULATION_CTRL: case PR_PAC_RESET_KEYS: case PR_SET_TAGGED_ADDR_CTRL:
+	case PR_GET_TAGGED_ADDR_CTRL: case PR_SET_IO_FLUSHER: case PR_GET_IO_FLUSHER:
+	case PR_PAC_SET_ENABLED_KEYS: case PR_PAC_GET_ENABLED_KEYS:
+	case PR_SME_SET_VL: case PR_SME_GET_VL: case PR_SET_MDWE: case PR_GET_MDWE:
+	case PR_SET_MEMORY_MERGE: case PR_GET_MEMORY_MERGE: case PR_RISCV_V_SET_CONTROL:
+	case PR_RISCV_V_GET_CONTROL: case PR_RISCV_SET_ICACHE_FLUSH_CTX:
+	case PR_PPC_GET_DEXCR: case PR_PPC_SET_DEXCR:
+		return;
+	default:
+		if (!output)
+			capture_gap(ctx, "prctl.unknown_selector", ANT_NO_DECODER);
+	}
+}
+
+struct ant_regset_state {
+	struct iovec iov;
+};
+
+/* Largest native regset in bytes, for SETREGSET input. */
+static u64 regset_ceiling(void)
+{
+	const struct user_regset_view *view = task_user_regset_view(current);
+	u64 ceiling = 0;
+	unsigned int index;
+
+	for (index = 0; index < view->n; index++)
+		ceiling = max_t(u64, ceiling,
+				(u64)view->regsets[index].n * view->regsets[index].size);
+	return ceiling;
+}
+
+static void capture_regset(struct ant_task *ctx, const u64 args[6], bool output, long result,
+			   bool set)
+{
+	struct ant_regset_state *state;
+	enum ant_status status;
+	u64 length, ceiling;
+
+	if (!output) {
+		state = kzalloc(sizeof(*state), GFP_NOWAIT);
+		if (!state) {
+			ant_capture_field(ctx, 3, "arg3.iovec", LAYOUT("iovec"), 3, args[3], NULL,
+					  sizeof(struct iovec), sizeof(struct iovec),
+					  ANT_RESOURCE_EXHAUSTED);
+			return;
+		}
+		status = copy_from_user_nofault(&state->iov, (void __user *)(unsigned long)args[3],
+						sizeof(state->iov)) ? ANT_COPY_FAULT : ANT_COMPLETE;
+		ant_capture_field(ctx, 3, "arg3.iovec", LAYOUT("iovec"), 3, args[3], &state->iov,
+				  sizeof(state->iov), sizeof(state->iov), status);
+		if (status != ANT_COMPLETE) {
+			kfree(state);
+			return;
+		}
+		ant_capture_set_state(ctx, state, release_allocation);
+		if (set && !ant_capture_lost(ctx)) {
+			ceiling = regset_ceiling();
+			ant_capture_field(ctx, 3, "arg3.iovec.data", "", 1,
+					  (unsigned long)state->iov.iov_base, NULL,
+					  min_t(u64, state->iov.iov_len, ceiling),
+					  state->iov.iov_len,
+					  state->iov.iov_len > ceiling ? ANT_INVALID_EXTENT :
+					  ANT_COMPLETE);
+		}
+		return;
+	}
+	if (result || ant_capture_lost(ctx))
+		return;
+	state = ant_capture_state(ctx);
+	status = copy_from_user_nofault(&length, (void __user *)(unsigned long)
+					(args[3] + offsetof(struct iovec, iov_len)),
+					sizeof(length)) ? ANT_COPY_FAULT : ANT_COMPLETE;
+	ant_capture_field(ctx, 3, "arg3.iov_len", LAYOUT("u64"), 3,
+			  args[3] + offsetof(struct iovec, iov_len), &length, sizeof(length),
+			  sizeof(length), status);
+	if (set || ant_capture_lost(ctx))
+		return;
+	if (!state || status != ANT_COMPLETE) {
+		ant_capture_field(ctx, 3, "arg3.iovec.data", "", 1, 0, NULL, U64_MAX, U64_MAX,
+				  ANT_CONTEXT_MISSING);
+		return;
+	}
+	ant_capture_field(ctx, 3, "arg3.iovec.data", "", 1, (unsigned long)state->iov.iov_base,
+			  NULL, min_t(u64, length, state->iov.iov_len), length,
+			  length > state->iov.iov_len ? ANT_INVALID_EXTENT : ANT_COMPLETE);
+}
+
+static bool arch_prctl_returns_value(u64 code)
+{
+	switch (code) {
+	case ARCH_GET_FS: case ARCH_GET_GS: case ARCH_GET_XCOMP_SUPP:
+	case ARCH_GET_XCOMP_PERM: case ARCH_GET_XCOMP_GUEST_PERM:
+	case ARCH_GET_UNTAG_MASK: case ARCH_GET_MAX_TAG_BITS: case ARCH_SHSTK_STATUS:
+		return true;
+	default:
+		return false;
+	}
+}
+
+static void capture_ptrace(struct ant_task *ctx, const u64 args[6], bool output, long result)
+{
+	struct ptrace_peeksiginfo_args peek;
+	u8 data = 3;
+
+	switch (args[0]) {
+	case PTRACE_PEEKTEXT: case PTRACE_PEEKDATA:
+		/* Tracee addresses are in another address space; never dereference them. */
+		if (!output)
+			ant_capture_field(ctx, 2, "arg2.tracee_address", LAYOUT("unsigned_long"), 3,
+					  args[2], NULL, sizeof(unsigned long),
+					  sizeof(unsigned long), ANT_ADDRESS_ONLY);
+		fallthrough;
+	case PTRACE_PEEKUSR:
+		if (output && result == 0)
+			capture_fixed(ctx, data, "arg3.word", LAYOUT("unsigned_long"), args[data],
+				      sizeof(unsigned long));
+		return;
+	case PTRACE_POKETEXT: case PTRACE_POKEDATA:
+		if (!output)
+			ant_capture_field(ctx, 2, "arg2.tracee_address", LAYOUT("unsigned_long"), 3,
+					  args[2], NULL, sizeof(unsigned long),
+					  sizeof(unsigned long), ANT_ADDRESS_ONLY);
+		return;
+	case PTRACE_GETREGS: case PTRACE_SETREGS:
+		capture_paired(ctx, output, result, args[0] == PTRACE_GETREGS, "arg3.regs",
+			       LAYOUT("user_regs_struct"), args[data],
+			       sizeof(struct user_regs_struct));
+		return;
+	case PTRACE_GETFPREGS: case PTRACE_SETFPREGS:
+		capture_paired(ctx, output, result, args[0] == PTRACE_GETFPREGS, "arg3.fpregs",
+			       LAYOUT("user_i387_struct"), args[data],
+			       sizeof(struct user_i387_struct));
+		return;
+	case PTRACE_GETREGSET: case PTRACE_SETREGSET:
+		capture_regset(ctx, args, output, result, args[0] == PTRACE_SETREGSET);
+		return;
+	case PTRACE_GETSIGINFO: case PTRACE_SETSIGINFO:
+		capture_paired(ctx, output, result, args[0] == PTRACE_GETSIGINFO, "arg3.siginfo",
+			       LAYOUT("siginfo_t"), args[data], sizeof(siginfo_t));
+		return;
+	case PTRACE_PEEKSIGINFO:
+		if (!output) {
+			capture_fixed(ctx, 2, "arg2.args", LAYOUT("ptrace_peeksiginfo_args"),
+				      args[2],
+				      sizeof(peek));
+		} else if (result > 0 && result <= INT_MAX) {
+			capture_fixed(ctx, data, "arg3.siginfo", LAYOUT("siginfo_t[]"), args[data],
+				      (u64)result * sizeof(siginfo_t));
+		}
+		return;
+	case PTRACE_GETSIGMASK: case PTRACE_SETSIGMASK:
+		if (args[2] == sizeof(sigset_t))
+			capture_paired(ctx, output, result, args[0] == PTRACE_GETSIGMASK,
+				       "arg3.sigmask", LAYOUT("sigset_t"), args[data],
+				       sizeof(sigset_t));
+		return;
+	case PTRACE_GETEVENTMSG:
+		if (output && result == 0)
+			capture_fixed(ctx, data, "arg3.message", LAYOUT("unsigned_long"),
+				      args[data],
+				      sizeof(unsigned long));
+		return;
+	case PTRACE_GET_THREAD_AREA: case PTRACE_SET_THREAD_AREA:
+		capture_paired(ctx, output, result, args[0] == PTRACE_GET_THREAD_AREA, "arg3.desc",
+			       LAYOUT("user_desc"), args[data], sizeof(struct user_desc));
+		return;
+	case PTRACE_ARCH_PRCTL:
+		/* arch_ptrace() calls do_arch_prctl_64(child, data, addr): data is the
+		 * arch_prctl code and addr the value or output pointer.
+		 */
+		if (output && result == 0 && arch_prctl_returns_value(args[3]))
+			capture_fixed(ctx, 2, "arg2.value", LAYOUT("unsigned_long"), args[2],
+				      sizeof(unsigned long));
+		return;
+	case PTRACE_GET_SYSCALL_INFO:
+		if (output)
+			capture_truncated(ctx, data, "arg3.info", LAYOUT("ptrace_syscall_info"),
+					  args[data], args[2], result);
+		return;
+	case PTRACE_GET_RSEQ_CONFIGURATION:
+		if (output)
+			capture_truncated(ctx, data, "arg3.config",
+					  LAYOUT("ptrace_rseq_configuration"),
+					  args[data], args[2], result);
+		return;
+	case PTRACE_SECCOMP_GET_FILTER:
+		if (output && result > 0 && result <= BPF_MAXINSNS && args[data])
+			capture_fixed(ctx, data, "arg3.filter", LAYOUT("sock_filter[]"), args[data],
+				      (u64)result * sizeof(struct sock_filter));
+		return;
+	case PTRACE_SECCOMP_GET_METADATA:
+		if (!output && args[2] >= sizeof(u64))
+			capture_fixed(ctx, data, "arg3.filter_off", LAYOUT("u64"), args[data],
+				      sizeof(u64));
+		else if (output && result >= 0)
+			ant_capture_field(ctx, data, "arg3.metadata", LAYOUT("seccomp_metadata"), 3,
+					  args[data], NULL,
+					  min_t(u64, args[2], sizeof(struct seccomp_metadata)),
+					  args[2], ANT_COMPLETE);
+		return;
+	case PTRACE_SET_SYSCALL_USER_DISPATCH_CONFIG:
+	case PTRACE_GET_SYSCALL_USER_DISPATCH_CONFIG:
+		if (args[2] == sizeof(struct ptrace_sud_config))
+			capture_paired(ctx, output, result,
+				       args[0] == PTRACE_GET_SYSCALL_USER_DISPATCH_CONFIG,
+				       "arg3.config", LAYOUT("ptrace_sud_config"), args[data],
+				       sizeof(struct ptrace_sud_config));
+		return;
+	case PTRACE_TRACEME: case PTRACE_ATTACH: case PTRACE_SEIZE: case PTRACE_INTERRUPT:
+	case PTRACE_LISTEN: case PTRACE_CONT: case PTRACE_SYSCALL: case PTRACE_SINGLESTEP:
+	case PTRACE_SINGLEBLOCK: case PTRACE_SYSEMU: case PTRACE_SYSEMU_SINGLESTEP:
+	case PTRACE_KILL: case PTRACE_DETACH: case PTRACE_SETOPTIONS:
+	case PTRACE_OLDSETOPTIONS: case PTRACE_POKEUSR:
+	case PTRACE_GETFPXREGS: case PTRACE_SETFPXREGS:
+		return;
+	default:
+		if (!output)
+			capture_gap(ctx, "ptrace.unknown_selector", ANT_NO_DECODER);
+	}
+}
+
+struct ant_pkey_state {
+	struct keyctl_pkey_params params;
+};
+
+static void capture_keyctl_pkey(struct ant_task *ctx, const u64 args[6], bool output,
+				long result)
+{
+	struct ant_pkey_state *state;
+	enum ant_status status;
+
+	if (!output) {
+		state = kzalloc(sizeof(*state), GFP_NOWAIT);
+		status = !state ? ANT_RESOURCE_EXHAUSTED :
+			copy_from_user_nofault(&state->params,
+					       (void __user *)(unsigned long)args[1],
+					       sizeof(state->params)) ?
+			ANT_COPY_FAULT : ANT_COMPLETE;
+		ant_capture_field(ctx, 1, "arg1.params", LAYOUT("keyctl_pkey_params"), 3, args[1],
+				  state ? &state->params : NULL, sizeof(state->params),
+				  sizeof(state->params), status);
+		if (!ant_capture_lost(ctx))
+			ant_capture_string(ctx, 2, "arg2.info", args[2], PAGE_SIZE);
+		if (status != ANT_COMPLETE) {
+			kfree(state);
+			return;
+		}
+		ant_capture_set_state(ctx, state, release_allocation);
+		if (!ant_capture_lost(ctx))
+			capture_bounded(ctx, 3, "arg3.input", args[3], state->params.in_len,
+					ANT_KEY_PAYLOAD_MAX);
+		if ((u32)args[0] == KEYCTL_PKEY_VERIFY && !ant_capture_lost(ctx))
+			capture_bounded(ctx, 4, "arg4.signature", args[4], state->params.in2_len,
+					ANT_KEY_PAYLOAD_MAX);
+		return;
+	}
+	if ((u32)args[0] == KEYCTL_PKEY_VERIFY || result < 0 || ant_capture_lost(ctx))
+		return;
+	state = ant_capture_state(ctx);
+	if (!state)
+		ant_capture_field(ctx, 4, "arg4.output", "", 1, args[4], NULL, U64_MAX, U64_MAX,
+				  ANT_CONTEXT_MISSING);
+	else
+		capture_truncated(ctx, 4, "arg4.output", "", args[4], state->params.out_len,
+				  result);
+}
+
+static void capture_keyctl_dh(struct ant_task *ctx, const u64 args[6], bool output, long result)
+{
+	struct keyctl_kdf_params kdf;
+	enum ant_status status;
+
+	if (output) {
+		capture_truncated(ctx, 2, "arg2.buffer", "", args[2], args[3], result);
+		return;
+	}
+	capture_fixed(ctx, 1, "arg1.params", LAYOUT("keyctl_dh_params"), args[1],
+		      sizeof(struct keyctl_dh_params));
+	if (!args[4] || ant_capture_lost(ctx))
+		return;
+	status = copy_from_user_nofault(&kdf, (void __user *)(unsigned long)args[4],
+					sizeof(kdf)) ? ANT_COPY_FAULT : ANT_COMPLETE;
+	ant_capture_field(ctx, 4, "arg4.kdf", LAYOUT("keyctl_kdf_params"), 3, args[4], &kdf,
+			  sizeof(kdf), sizeof(kdf), status);
+	if (status != ANT_COMPLETE || ant_capture_lost(ctx))
+		return;
+	if (kdf.hashname)
+		ant_capture_string(ctx, 4, "arg4.kdf.hashname", (unsigned long)kdf.hashname,
+				   ANT_KDF_HASH_MAX);
+	if (!ant_capture_lost(ctx))
+		capture_bounded(ctx, 4, "arg4.kdf.otherinfo", (unsigned long)kdf.otherinfo,
+				kdf.otherinfolen, ANT_KDF_OTHERINFO_MAX);
+}
+
+static void capture_keyctl(struct ant_task *ctx, const u64 args[6], bool output, long result)
+{
+	struct ant_vector_state *vector;
+
+	switch ((u32)args[0]) {
+	case KEYCTL_JOIN_SESSION_KEYRING:
+		if (!output && args[1])
+			ant_capture_string(ctx, 1, "arg1.name", args[1], ANT_KEY_DESC_MAX);
+		return;
+	case KEYCTL_UPDATE:
+		if (!output)
+			capture_bounded(ctx, 2, "arg2.payload", args[2], args[3],
+					ANT_KEY_UPDATE_MAX);
+		return;
+	case KEYCTL_INSTANTIATE:
+		if (!output)
+			capture_bounded(ctx, 2, "arg2.payload", args[2], args[3],
+					ANT_KEY_PAYLOAD_MAX);
+		return;
+	case KEYCTL_INSTANTIATE_IOV:
+		if (output)
+			return;
+		vector = save_vector(ctx, 2, args[2], args[3], "arg2.iov");
+		if (vector)
+			vector_data(ctx, vector, 2, "arg2.iov", ANT_KEY_PAYLOAD_MAX);
+		kfree(vector);
+		return;
+	case KEYCTL_DESCRIBE: case KEYCTL_READ: case KEYCTL_GET_SECURITY:
+		if (output)
+			capture_truncated(ctx, 2, "arg2.buffer", "", args[2], args[3], result);
+		return;
+	case KEYCTL_SEARCH:
+		if (output)
+			return;
+		ant_capture_string(ctx, 2, "arg2.type", args[2], ANT_KEY_TYPE_MAX);
+		if (!ant_capture_lost(ctx))
+			ant_capture_string(ctx, 3, "arg3.description", args[3], ANT_KEY_DESC_MAX);
+		return;
+	case KEYCTL_RESTRICT_KEYRING:
+		if (output)
+			return;
+		if (args[2])
+			ant_capture_string(ctx, 2, "arg2.type", args[2], ANT_KEY_TYPE_MAX);
+		if (args[3] && !ant_capture_lost(ctx))
+			ant_capture_string(ctx, 3, "arg3.restriction", args[3], PAGE_SIZE);
+		return;
+	case KEYCTL_DH_COMPUTE:
+		capture_keyctl_dh(ctx, args, output, result);
+		return;
+	case KEYCTL_PKEY_QUERY:
+		if (!output)
+			ant_capture_string(ctx, 3, "arg3.info", args[3], PAGE_SIZE);
+		else if (result == 0)
+			capture_fixed(ctx, 4, "arg4.query", LAYOUT("keyctl_pkey_query"), args[4],
+				      sizeof(struct keyctl_pkey_query));
+		return;
+	case KEYCTL_PKEY_ENCRYPT: case KEYCTL_PKEY_DECRYPT: case KEYCTL_PKEY_SIGN:
+	case KEYCTL_PKEY_VERIFY:
+		capture_keyctl_pkey(ctx, args, output, result);
+		return;
+	case KEYCTL_CAPABILITIES:
+		if (output)
+			capture_truncated(ctx, 1, "arg1.buffer", "", args[1], args[2], result);
+		return;
+	case KEYCTL_GET_KEYRING_ID: case KEYCTL_REVOKE: case KEYCTL_CHOWN: case KEYCTL_SETPERM:
+	case KEYCTL_CLEAR: case KEYCTL_LINK: case KEYCTL_UNLINK: case KEYCTL_NEGATE:
+	case KEYCTL_SET_REQKEY_KEYRING: case KEYCTL_SET_TIMEOUT: case KEYCTL_ASSUME_AUTHORITY:
+	case KEYCTL_SESSION_TO_PARENT: case KEYCTL_REJECT: case KEYCTL_INVALIDATE:
+	case KEYCTL_GET_PERSISTENT: case KEYCTL_MOVE: case KEYCTL_WATCH_KEY:
+		return;
+	default:
+		if (!output)
+			capture_gap(ctx, "keyctl.unknown_selector", ANT_NO_DECODER);
+	}
+}
+
+static void capture_sysfs(struct ant_task *ctx, const u64 args[6], bool output, long result)
+{
+	switch (args[0]) {
+	case 1:
+		if (!output)
+			ant_capture_string(ctx, 1, "arg1.fsname", args[1], PATH_MAX);
+		return;
+	case 2:
+		/* The kernel writes the name and its NUL; read back exactly that string. */
+		if (output && result == 0)
+			ant_capture_string(ctx, 2, "arg2.fsname", args[2], PATH_MAX);
+		return;
+	case 3:
+		return;
+	default:
+		if (!output)
+			capture_gap(ctx, "sysfs.unknown_selector", ANT_NO_DECODER);
+	}
+}
