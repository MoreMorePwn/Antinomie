Description: antinomie: do not name guest workers after the recorder
Author: MikiMiku <jonathanirvinjo@gmail.com>
Origin: project
Forwarded: no
Last-Update: 2026-10-21

A kworker shows the workqueue it last ran work for in its name (kworker/uN:M-<queue>, "+<queue>" while it runs it), in /proc/<pid>/comm, /proc/<pid>/stat and ps, for any user. The recorder's queues were named antinomie-control, antinomie_resources, antinomie-core and antinomie-debug: the control worker runs every tick and the host asks for a resource sample about once a second, so the guest's process list named the sandbox from the first second on.  The resource refresh now runs on system_unbound_wq: it is one work item and the running flag already keeps one refresh in flight, so a queue of its own added nothing. The control (ordered), process core and debug queues keep their ordering and limits and are named events_unbound, after the system queue whose workers they share, so their workers read like every other unbound worker.

---
diff --git a/kernel/antinomie/debug.c b/kernel/antinomie/debug.c
index a5b185e5e..cc9d489b5 100644
--- a/kernel/antinomie/debug.c
+++ b/kernel/antinomie/debug.c
@@ -3546,7 +3546,8 @@ bool ant_debug_active(void)
 
 static int __init ant_debug_init(void)
 {
-	dbg_worker = alloc_workqueue("antinomie-debug", WQ_UNBOUND, 1);
+	/* Named like the system's: a worker shows the queue it last ran for. */
+	dbg_worker = alloc_workqueue("events_unbound", WQ_UNBOUND, 1);
 	return dbg_worker ? 0 : -ENOMEM;
 }
 late_initcall(ant_debug_init);
diff --git a/kernel/antinomie/guest.c b/kernel/antinomie/guest.c
index 2e21f8ba7..b080ef5ea 100644
--- a/kernel/antinomie/guest.c
+++ b/kernel/antinomie/guest.c
@@ -461,9 +461,10 @@ static int __init ant_guest_init(void)
 	 * TTY queue events_unbound. WQ_MEM_RECLAIM makes that flush trip
 	 * check_flush_dependency. Flags stay 0 so the worker may complete
 	 * the read. The queue stays ordered, so commands, EOF and shutdown
-	 * keep one sequence.
+	 * keep one sequence. A worker shows the name of the queue it last ran
+	 * work for (kworker/uN:M-name), so it is named like the system's.
 	 */
-	worker = alloc_ordered_workqueue("antinomie-control", 0);
+	worker = alloc_ordered_workqueue("events_unbound", 0);
 	if (!worker) goto free_rings;
 	control->geometry.version = ANT_ABI;
 	control->geometry.session = get_random_u64() ?: 1;
diff --git a/kernel/antinomie/manual_core.c b/kernel/antinomie/manual_core.c
index 13696d102..5b4543676 100644
--- a/kernel/antinomie/manual_core.c
+++ b/kernel/antinomie/manual_core.c
@@ -656,7 +656,8 @@ int ant_manual_command(u32 opcode, const u8 *args, size_t args_len,
 
 static int __init ant_manual_init(void)
 {
-	manual_worker = alloc_workqueue("antinomie-core", WQ_UNBOUND, 1);
+	/* Named like the system's: a worker shows the queue it last ran for. */
+	manual_worker = alloc_workqueue("events_unbound", WQ_UNBOUND, 1);
 	return manual_worker ? 0 : -ENOMEM;
 }
 late_initcall(ant_manual_init);
diff --git a/kernel/antinomie/resources.c b/kernel/antinomie/resources.c
index 3d8d1728c..04a3e10bc 100644
--- a/kernel/antinomie/resources.c
+++ b/kernel/antinomie/resources.c
@@ -2,10 +2,11 @@
 /* Kernel-native guest resource sample: RAM accounting and root filesystem use.
  *
  * The control handler never blocks on the filesystem. It returns the latest
- * completed sample and, when that sample is old, queues one refresh on a
- * dedicated single-slot workqueue. At most one refresh is in flight, so a
- * statfs that blocks leaves the previous sample visibly aging instead of
- * stalling the control worker or accumulating work.
+ * completed sample and, when that sample is old, queues one refresh on the
+ * system unbound workqueue. At most one refresh is in flight, so a statfs that
+ * blocks leaves the previous sample visibly aging instead of stalling the
+ * control worker or accumulating work. (A workqueue of its own would name
+ * every worker that ran a refresh after it in the guest's process list.)
  */
 #include <linux/fs.h>
 #include <linux/fs_struct.h>
@@ -37,7 +38,6 @@ struct ant_resource_sample {
 };
 
 static DEFINE_SPINLOCK(lock);
-static struct workqueue_struct *res_wq;
 static struct ant_resource_sample latest;
 static bool running;
 static u64 started_ns;
@@ -156,8 +156,6 @@ int ant_resources_command(const void *args, size_t args_len, void *reply,
 
 	if (args_len != ANTC_HEADER_SIZE || capacity < ANTC_RESOURCES_SIZE)
 		return -EINVAL;
-	if (!res_wq)
-		return -EOPNOTSUPP;
 	now = ktime_get_ns();
 	spin_lock_irqsave(&lock, flags);
 	if (!running && (!latest.sequence || now - latest.done_ns >= REFRESH_NS)) {
@@ -172,7 +170,7 @@ int ant_resources_command(const void *args, size_t args_len, void *reply,
 	}
 	spin_unlock_irqrestore(&lock, flags);
 	if (start)
-		queue_work(res_wq, &refresh_work);
+		queue_work(system_unbound_wq, &refresh_work);
 	if (sample.sequence)
 		age = (now - sample.done_ns) / NSEC_PER_MSEC;
 
@@ -194,10 +192,3 @@ int ant_resources_command(const void *args, size_t args_len, void *reply,
 	*reply_len = ANTC_RESOURCES_SIZE;
 	return 0;
 }
-
-static int __init ant_resources_init(void)
-{
-	res_wq = alloc_workqueue("antinomie_resources", WQ_UNBOUND, 1);
-	return 0;
-}
-late_initcall(ant_resources_init);
