diff --git a/kernel/antinomie/async_capture.c b/kernel/antinomie/async_capture.c
index 5887132e9..9b3e11a33 100644
--- a/kernel/antinomie/async_capture.c
+++ b/kernel/antinomie/async_capture.c
@@ -21,6 +21,16 @@
 #define ANT_PBUF_COUNT 65535
 #define ANT_SQ_COUNT 32768
 #define ANT_CQ_COUNT (2 * ANT_SQ_COUNT)
+/* io_submit() entries read at entry. The kernel itself handles at most the
+ * context's nr_events of them and none for a context that does not exist,
+ * neither of which the recorder can know before the call; a larger nr is a
+ * prefix and one field for the rest. Each entry is up to four fields of the
+ * one Entry record, so the record keeps about as many fields as a writev()
+ * of UIO_MAXIOV vectors: the host assembles a record's fields as they
+ * arrive, at a cost that grows with the fields it already holds, and under
+ * never-drop the call waits for it.
+ */
+#define ANT_AIO_SUBMIT_MAX 256U
 
 struct ant_uring_setup {
 	struct io_uring_params params;
@@ -76,15 +86,25 @@ static void signal_mask(struct ant_task *ctx, u8 arg, u64 address, u64 size)
 
 static void aio_submission(struct ant_task *ctx, const u64 a[6])
 {
-	u64 ptr, index, count = a[1];
+	u64 ptr, index, count = a[1], read;
 	struct iocb iocb;
 	char key[96];
 
-	array_field(ctx, 2, "arg2.iocbpp", ANT_LAYOUT("pointer[]"),
-		    a[2], count, sizeof(ptr), LONG_MAX / sizeof(ptr));
-	if ((s64)count < 0 || count > LONG_MAX / sizeof(ptr))
+	if ((s64)count < 0 || count > LONG_MAX / sizeof(ptr)) {
+		array_field(ctx, 2, "arg2.iocbpp", ANT_LAYOUT("pointer[]"),
+			    a[2], count, sizeof(ptr), LONG_MAX / sizeof(ptr));
 		return;
-	for (index = 0; index < count && !ant_capture_lost(ctx); index++) {
+	}
+	read = min_t(u64, count, ANT_AIO_SUBMIT_MAX);
+	array_field(ctx, 2, "arg2.iocbpp", ANT_LAYOUT("pointer[]"),
+		    a[2], read, sizeof(ptr), ANT_AIO_SUBMIT_MAX);
+	if (read < count && a[2] <= ULONG_MAX - read * sizeof(ptr)) {
+		/* The entries from index ANT_AIO_SUBMIT_MAX on, not read. */
+		scnprintf(key, sizeof(key), "arg2.iocbpp[%llu]", read);
+		bytes_field(ctx, 2, key, ANT_LAYOUT("pointer[]"), a[2] + read * sizeof(ptr),
+			    (count - read) * sizeof(ptr), ANT_RESOURCE_EXHAUSTED);
+	}
+	for (index = 0; index < read && !ant_capture_lost(ctx); index++) {
 		if (a[2] > ULONG_MAX - index * sizeof(ptr))
 			return;
 		scnprintf(key, sizeof(key), "arg2.iocbpp[%llu]", index);
