Description: antinomie: observe async requests in their address space and at AIO reap
Author: MikiMiku <jonathanirvinjo@gmail.com>
Origin: project
Forwarded: no
Last-Update: 2026-10-08


---
diff --git a/fs/aio.c b/fs/aio.c
index 492c0c141..488871fb6 100644
--- a/fs/aio.c
+++ b/fs/aio.c
@@ -899,6 +899,7 @@ void exit_aio(struct mm_struct *mm)
 	struct ctx_rq_wait wait;
 	int i, skipped;
 
+	ant_monitor_aio_exit(mm);
 	if (!table)
 		return;
 
@@ -1601,6 +1602,7 @@ static int aio_read(struct kiocb *req, const struct iocb *iocb,
 	struct aio_kiocb *tracked = container_of(req, struct aio_kiocb, rw);
 	struct iov_iter observed;
 	ssize_t result;
+	u64 deferred;
 #endif
 
 	ret = aio_prep_rw(req, iocb, READ);
@@ -1618,8 +1620,17 @@ static int aio_read(struct kiocb *req, const struct iocb *iocb,
 	ret = rw_verify_area(READ, file, &req->ki_pos, iov_iter_count(&iter));
 	if (!ret) {
 #ifdef CONFIG_ANTINOMIE
+		/* A queued read may complete in interrupt context, where its
+		 * buffer cannot be read; io_getevents() reads it instead.
+		 */
+		deferred = vectored ? 0 :
+			ant_monitor_aio_defer(&tracked->ant_async, tracked->ki_ctx->user_id,
+					      tracked->ki_res.obj, tracked->ki_res.data,
+					      iocb->aio_buf, iocb->aio_nbytes);
 		observed = iter;
 		result = file->f_op->read_iter(req, &iter);
+		if (result != -EIOCBQUEUED)
+			ant_monitor_aio_undefer(&tracked->ant_async, deferred);
 		if (result >= 0)
 			ant_monitor_async_iter(&tracked->ant_async, &observed, result, 0, true);
 		aio_rw_done(req, result);
@@ -2274,6 +2285,8 @@ static long do_io_getevents(aio_context_t ctx_id,
 			ret = read_events(ioctx, min_nr, nr, events, until);
 		percpu_ref_put(&ioctx->users);
 	}
+	if (ret > 0)
+		ant_monitor_aio_reaped(ctx_id, events, ret);
 
 	return ret;
 }
