diff --git a/io_uring/uring_cmd.c b/io_uring/uring_cmd.c
index e5d0cc8a8..a1e69b9bb 100644
--- a/io_uring/uring_cmd.c
+++ b/io_uring/uring_cmd.c
@@ -252,6 +252,23 @@ int io_uring_cmd(struct io_kiocb *req, unsigned int issue_flags)
 	}
 
 	ret = file->f_op->uring_cmd(ioucmd, issue_flags);
+#ifdef CONFIG_ANTINOMIE
+	/* Socket option commands record their operand; any other command is
+	 * driver-specific and stays an explicit gap.
+	 */
+	if (ret != -EAGAIN) {
+		bool socket_cmd = false;
+#if defined(CONFIG_NET)
+		socket_cmd = sock_from_file(file) != NULL;
+#endif
+		if (socket_cmd && (ioucmd->cmd_op == SOCKET_URING_OP_SIOCINQ ||
+				   ioucmd->cmd_op == SOCKET_URING_OP_SIOCOUTQ))
+			ant_uring_scalar(req);
+		else if (!socket_cmd || (ioucmd->cmd_op != SOCKET_URING_OP_GETSOCKOPT &&
+					 ioucmd->cmd_op != SOCKET_URING_OP_SETSOCKOPT))
+			ant_uring_gap(req, "async.operand.uring_cmd", 0);
+	}
+#endif
 	if (ret == -EAGAIN) {
 		struct uring_cache *cache = req->async_data;
 
@@ -285,6 +302,8 @@ void io_uring_cmd_issue_blocking(struct io_uring_cmd *ioucmd)
 	io_req_queue_iowq(req);
 }
 
+#define ANT_URING_OPTVAL_MAX (128 * 1024)
+
 static inline int io_uring_cmd_getsockopt(struct socket *sock,
 					  struct io_uring_cmd *cmd,
 					  unsigned int issue_flags)
@@ -304,8 +323,13 @@ static inline int io_uring_cmd_getsockopt(struct socket *sock,
 	err = do_sock_getsockopt(sock, compat, level, optname,
 				 USER_SOCKPTR(optval),
 				 KERNEL_SOCKPTR(&optlen));
-	if (err)
+	if (err) {
+		ant_uring_scalar(cmd_to_io_kiocb(cmd));
 		return err;
+	}
+	ant_uring_memory(cmd_to_io_kiocb(cmd), "async.operand.optval", "", 1,
+			 (unsigned long)optval, NULL, min(optlen, ANT_URING_OPTVAL_MAX),
+			 true, true);
 
 	/* On success, return optlen */
 	return optlen;
@@ -325,6 +349,11 @@ static inline int io_uring_cmd_setsockopt(struct socket *sock,
 	optlen = READ_ONCE(cmd->sqe->optlen);
 	level = READ_ONCE(cmd->sqe->level);
 	optval_s = USER_SOCKPTR(optval);
+	/* Raw by optlen, as slice 2A records options without a decoder. */
+	if (optlen >= 0)
+		ant_uring_memory(cmd_to_io_kiocb(cmd), "async.operand.optval", "", 1,
+				 (unsigned long)optval, NULL,
+				 min(optlen, ANT_URING_OPTVAL_MAX), false, true);
 
 	return do_sock_setsockopt(sock, compat, level, optname, optval_s,
 				  optlen);
