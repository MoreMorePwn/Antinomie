+
+/* Fixed-structure lifecycle records published for a traced call. */
+
+/* Identity of the traced call now in progress, for a record published later
+ * by a worker. False when the caller is not inside a traced call. The caller
+ * takes its own reference on ev->origin.
+ */
+bool ant_monitor_identity(struct ant_async_event *ev, u64 *nr);
+/* Publish one record in the calling task's own traced call. */
+bool ant_monitor_note(const char *key, const char *layout, const void *data,
+		      size_t len);
+/* Publish one record for an earlier call, from a worker. ctx comes from
+ * ant_monitor_async_capture_alloc() and is reused for any number of records.
+ */
+int ant_monitor_note_publish(struct ant_task *ctx, const struct ant_async_event *event,
+			     u64 nr, const char *key, const char *layout,
+			     const void *data, size_t len);
