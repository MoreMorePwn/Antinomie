+/* Credential records (control_wire.h, lifecycle.creds). Every change of a
+ * traced task's credentials goes through commit_creds(): setuid and friends,
+ * capset, and exec of a setuid, setgid or file-capability image. The record is
+ * published in the call that made the change, so the host orders it with that
+ * call. The first record of a task is written at its first traced call.
+ */
+static u32 id_value(kuid_t uid)
+{
+	return from_kuid(&init_user_ns, uid);
+}
+
+static void creds_emit(struct ant_task *ctx, u32 reason, const struct cred *cred)
+{
+	u8 rec[ANTC_CREDS_SIZE];
+
+	memset(rec, 0, sizeof(rec));
+	put_unaligned_le32(id_value(cred->uid), rec);
+	put_unaligned_le32(id_value(cred->euid), rec + 4);
+	put_unaligned_le32(id_value(cred->suid), rec + 8);
+	put_unaligned_le32(id_value(cred->fsuid), rec + 12);
+	put_unaligned_le32(from_kgid(&init_user_ns, cred->gid), rec + 16);
+	put_unaligned_le32(from_kgid(&init_user_ns, cred->egid), rec + 20);
+	put_unaligned_le32(from_kgid(&init_user_ns, cred->sgid), rec + 24);
+	put_unaligned_le32(from_kgid(&init_user_ns, cred->fsgid), rec + 28);
+	put_unaligned_le32(id_value(audit_get_loginuid(current)), rec + 32);
+	put_unaligned_le32(audit_get_sessionid(current), rec + 36);
+	put_unaligned_le32(reason, rec + 40);
+	put_unaligned_le32(IS_ENABLED(CONFIG_AUDIT) ? ANTC_CRED_AUDIT : 0, rec + 44);
+	put_unaligned_le64(cred->cap_effective.val, rec + 48);
+	put_unaligned_le64(cred->cap_permitted.val, rec + 56);
+	put_unaligned_le64(cred->cap_inheritable.val, rec + 64);
+	event_begin(ctx, 3, 0);
+	ctx->kernel_imported = true;
+	field(ctx, 255, "lifecycle.creds", "antinomie.creds/1", 3, 0, rec, sizeof(rec),
+	      sizeof(rec), ANT_COMPLETE);
+	ctx->kernel_imported = false;
+	event_end(ctx);
+}
+
+static void creds_note(struct ant_task *ctx, u32 reason, const struct cred *cred)
+{
+	u64 capture_cookie;
+
+	if (ctx->busy || !ctx->creds_seen)
+		return;
+	if (!ctx->active) {
+		capture_cookie = ant_observer_admit(current);
+		if (!READ_ONCE(current->ant_root_cookie) && !capture_cookie)
+			return;
+		ctx->capture_cookie = capture_cookie;
+	}
+	ctx->busy = true;
+	creds_emit(ctx, reason, cred);
+	ctx->busy = false;
+}
+
+static u32 creds_reason(const struct ant_task *ctx, const struct cred *old,
+			const struct cred *new)
+{
+	bool ids = !uid_eq(old->uid, new->uid) || !uid_eq(old->euid, new->euid) ||
+		!uid_eq(old->suid, new->suid) || !gid_eq(old->gid, new->gid) ||
+		!gid_eq(old->egid, new->egid) || !gid_eq(old->sgid, new->sgid);
+
+	if (!ctx->active || ctx->abi != 1)
+		return ANTC_CRED_OTHER;
+	switch (ctx->nr) {
+	case 105: case 113: /* setuid, setreuid */
+		return ANTC_CRED_SETUID;
+	case 106: case 114: /* setgid, setregid */
+		return ANTC_CRED_SETGID;
+	case 117: case 119: /* setresuid, setresgid */
+		return ANTC_CRED_SETRES;
+	case 122: case 123: /* setfsuid, setfsgid */
+		return ANTC_CRED_SETFS;
+	case 126: /* capset */
+		return ANTC_CRED_CAPSET;
+	case 59: case 322: /* execve, execveat */
+		if (ids)
+			return ANTC_CRED_EXEC_SETID;
+		if (!cap_isidentical(old->cap_permitted, new->cap_permitted) ||
+		    !cap_isidentical(old->cap_effective, new->cap_effective))
+			return ANTC_CRED_EXEC_CAPS;
+	}
+	return ANTC_CRED_OTHER;
+}
+
+void ant_monitor_creds(const struct cred *old, const struct cred *new)
+{
+	struct ant_task *ctx = current->ant_monitor;
+
+	if (!ctx || ctx->busy || !ctx->creds_seen)
+		return;
+	if (uid_eq(old->uid, new->uid) && uid_eq(old->euid, new->euid) &&
+	    uid_eq(old->suid, new->suid) && uid_eq(old->fsuid, new->fsuid) &&
+	    gid_eq(old->gid, new->gid) && gid_eq(old->egid, new->egid) &&
+	    gid_eq(old->sgid, new->sgid) && gid_eq(old->fsgid, new->fsgid) &&
+	    cap_isidentical(old->cap_effective, new->cap_effective) &&
+	    cap_isidentical(old->cap_permitted, new->cap_permitted) &&
+	    cap_isidentical(old->cap_inheritable, new->cap_inheritable))
+		return;
+	creds_note(ctx, creds_reason(ctx, old, new), new);
+}
+
+void ant_monitor_loginuid(void)
+{
+	struct ant_task *ctx = current->ant_monitor;
+
+	if (ctx)
+		creds_note(ctx, ANTC_CRED_LOGINUID, current_cred());
+}
+
+/* A record of the call in progress, or of an earlier call when a worker
+ * publishes it (ant_monitor_note_publish). Both use a lifecycle event with one
+ * fixed-structure field.
+ */
+bool ant_monitor_note(const char *key, const char *layout, const void *data, size_t len)
+{
+	struct ant_task *ctx = current->ant_monitor;
+	bool sent;
+
+	if (!ctx || !ctx->active || ctx->busy)
+		return false;
+	ctx->busy = true;
+	event_begin(ctx, 3, 0);
+	ctx->kernel_imported = true;
+	field(ctx, 255, key, layout, 3, 0, data, len, len, ANT_COMPLETE);
+	ctx->kernel_imported = false;
+	event_end(ctx);
+	sent = !ctx->failed_count;
+	ctx->busy = false;
+	return sent;
+}
+
+bool ant_monitor_identity(struct ant_async_event *ev, u64 *nr)
+{
+	struct ant_task *ctx = current->ant_monitor;
+	const struct cred *cred = current_cred();
+
+	if (!ctx || !ctx->active || ctx->busy)
+		return false;
+	ev->origin = current;
+	ev->task_cookie = current->ant_cookie;
+	ev->root_cookie = READ_ONCE(current->ant_root_cookie);
+	ev->capture_cookie = ctx->capture_cookie;
+	ev->start_boot_ns = current->start_boottime;
+	ev->parent_call_id = ctx->call_id;
+	ev->entry_ns = ctx->entry_ns;
+	ev->timestamp_ns = ktime_get_ns();
+	ev->pid = task_tgid_nr(current);
+	ev->tid = task_pid_nr(current);
+	ev->cpu = raw_smp_processor_id();
+	ev->uid = from_kuid(&init_user_ns, cred->uid);
+	ev->gid = from_kgid(&init_user_ns, cred->gid);
+	ev->euid = from_kuid(&init_user_ns, cred->euid);
+	ev->egid = from_kgid(&init_user_ns, cred->egid);
+	*nr = ctx->nr;
+	return true;
+}
+
+int ant_monitor_note_publish(struct ant_task *ctx, const struct ant_async_event *event,
+			     u64 nr, const char *key, const char *layout,
+			     const void *data, size_t len)
+{
+	int error;
+
+	ctx->async_event = event;
+	ctx->call_id = event->parent_call_id;
+	ctx->entry_ns = event->entry_ns;
+	ctx->nr = nr;
+	ctx->abi = 1;
+	event_begin(ctx, 3, 0);
+	ctx->kernel_imported = true;
+	field(ctx, 255, key, layout, 3, 0, data, len, len, ANT_COMPLETE);
+	ctx->kernel_imported = false;
+	event_end(ctx);
+	error = ctx->failed_count ? -ENOSPC : 0;
+	ctx->async_event = NULL;
+	return error;
+}
