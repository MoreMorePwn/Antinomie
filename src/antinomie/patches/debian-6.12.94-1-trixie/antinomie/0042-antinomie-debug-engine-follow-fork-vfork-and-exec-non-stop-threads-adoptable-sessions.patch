+/* EVENTS: the unacknowledged events of a non-stop session, or (CURRENT) the event
+ * of an all-stop session's stop. Reading changes nothing; ack_seq forgets.
+ */
+static int cmd_events(struct ant_dbg *s, const u8 *args, size_t args_len, u8 *reply,
+		      size_t capacity, size_t *reply_len)
+{
+	u32 ack = get_unaligned_le32(args + 16), max = get_unaligned_le32(args + 20);
+	u32 mode = get_unaligned_le32(args + 24);
+	unsigned int count = 0, i;
+
+	if (args_len != ANTC_DEBUG_EVENTS_SIZE || get_unaligned_le32(args + 28) || !max ||
+	    max > ANTC_DEBUG_EVENT_MAX || (mode & ~ANTC_DEBUG_EVENTS_CURRENT) ||
+	    capacity < 16 + ANTC_DEBUG_EVENT_MAX * ANTC_DEBUG_EVENT_ENTRY_SIZE)
+		return -EINVAL;
+	memset(reply, 0, 16);
+	spin_lock_irq(&s->lock);
+	if (mode & ANTC_DEBUG_EVENTS_CURRENT) {
+		if (s->cur.kind) {
+			put_event(reply + 16, &s->cur);
+			count = 1;
+		}
+	} else {
+		ev_ack(s, ack);
+		for (i = 0; i < s->qcount && count < max; i++)
+			put_event(reply + 16 + count++ * ANTC_DEBUG_EVENT_ENTRY_SIZE,
+				  &s->queue[(s->qhead + i) % EVENT_QUEUE]);
+		put_unaligned_le32(s->qdropped, reply + 4);
+	}
+	spin_unlock_irq(&s->lock);
+	put_unaligned_le32(count, reply);
+	*reply_len = 16 + count * ANTC_DEBUG_EVENT_ENTRY_SIZE;
+	return 0;
+}
