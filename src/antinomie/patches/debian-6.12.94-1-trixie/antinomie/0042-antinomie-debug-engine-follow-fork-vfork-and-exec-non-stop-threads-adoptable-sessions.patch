+	if (args_len != 8 && args_len != ANTC_DEBUG_CAPS_EXT_SIZE)
+		return -EINVAL;
+	ext = args_len == ANTC_DEBUG_CAPS_EXT_SIZE;
+	if (ext && (get_unaligned_le32(args + 8) != ANTC_DEBUG_CAPS_EXT || get_unaligned_le32(args + 12)))
+		return -EINVAL;
+	if (capacity < ANTC_DEBUG_CAPS_SIZE + ANT_DBG_MAX_REGSETS * ANTC_DEBUG_REGSET_SIZE)
+		return -EMSGSIZE;
+	ant_dbg_arch_caps(&caps);
+	memset(reply, 0, ANTC_DEBUG_CAPS_SIZE);
+	put_unaligned_le32(ANTC_DEBUG_ABI, reply);
+	put_unaligned_le32(caps.arch, reply + 4);
+	put_unaligned_le32(caps.flags | ANTC_DEBUG_CAP_SHADOW_READS | ANTC_DEBUG_CAP_MULTI_THREAD |
+			   ANTC_DEBUG_CAP_SIGNALS | ANTC_DEBUG_CAP_BATCH_REGS | ANTC_DEBUG_CAP_START |
+			   ANTC_DEBUG_CAP_AUXV, reply + 8);
+	put_unaligned_le32(caps.swbp_len_mask, reply + 12);
+	put_unaligned_le32(caps.hw_breakpoints, reply + 16);
+	put_unaligned_le32(caps.hw_watchpoints, reply + 20);
+	put_unaligned_le32(caps.hw_watch_len_mask, reply + 24);
+	put_unaligned_le32(MAX_LIVE_THREADS, reply + 28);
+	put_unaligned_le32(ANTC_DEBUG_TRANSFER_MAX, reply + 32);
+	put_unaligned_le32(caps.regset_count, reply + 36);
+	/* The second word only for a host that asked: an earlier host rejects it. */
+	if (ext)
