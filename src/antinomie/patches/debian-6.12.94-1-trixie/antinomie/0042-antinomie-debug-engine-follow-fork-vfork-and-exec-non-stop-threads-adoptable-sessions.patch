+				   ANTC_DEBUG_CAP2_ADOPT | ANTC_DEBUG_CAP2_THREAD_HW, reply + 40);
+	for (i = 0; i < caps.regset_count; i++) {
+		u8 *entry = reply + ANTC_DEBUG_CAPS_SIZE + i * ANTC_DEBUG_REGSET_SIZE;
