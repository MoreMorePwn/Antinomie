+static void put_event(u8 *entry, const struct ant_dbg_event *ev)
+{
+	memset(entry, 0, ANTC_DEBUG_EVENT_ENTRY_SIZE);
+	put_unaligned_le32(ev->seq, entry);
+	put_unaligned_le32(ev->kind, entry + 4);
+	put_unaligned_le32(ev->tid, entry + 8);
+	put_unaligned_le32(ev->sig, entry + 12);
+	put_unaligned_le64(ev->pc, entry + 16);
+	put_unaligned_le64(ev->addr, entry + 24);
+	put_unaligned_le32(ev->aux, entry + 32);
+	put_unaligned_le32(ev->flags, entry + 36);
+	put_unaligned_le32(ev->child_tgid, entry + 40);
+	put_unaligned_le32(ev->parent_tid, entry + 44);
+	put_unaligned_le64(ev->child_session, entry + 48);
+	put_unaligned_le64(ev->child_cookie, entry + 56);
+	put_unaligned_le64(ev->child_start_ns, entry + 64);
+	put_unaligned_le32(ev->path_len, entry + 72);
+	memcpy(entry + 80, ev->path, ANTC_DEBUG_EVENT_PATH_SIZE);
+}
