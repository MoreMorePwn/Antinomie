+/* ---- following forks, execs and new threads ---------------------------------- */
+
+/* A thread created while the group runs gets the program's debug registers
+ * before its first instruction, from its own context.
+ */
+struct ant_dbg_thread_init {
+	struct callback_head work;
+	struct ant_dbg *session;
+};
+
+static void thread_init_work(struct callback_head *work)
+{
+	struct ant_dbg_thread_init *init = container_of(work, struct ant_dbg_thread_init, work);
+	struct ant_dbg *s = init->session;
+	struct ant_dbg_thread *t;
+	unsigned int slot;
+
+	mutex_lock(&s->hw_lock);
+	rcu_read_lock();
+	t = find_thread(s, current);
+	rcu_read_unlock();
+	if (t && !READ_ONCE(s->teardown))
+		for (slot = 0; slot < ANT_DBG_MAX_HW; slot++)
+			if (s->hw[slot].used)
+				hw_register(s, t, slot);
+	mutex_unlock(&s->hw_lock);
+	session_put(s);
+	kfree(init);
+}
+
+static void thread_created(struct ant_dbg *s, struct task_struct *child)
+{
+	struct ant_dbg_thread_init *init;
+
+	if (!record_add(s, child, NULL) || !hw_used(s) || !refcount_inc_not_zero(&s->refs))
+		return;
+	init = kmalloc(sizeof(*init), GFP_KERNEL);
+	if (!init) {
+		session_put(s);
+		return;
+	}
+	init->session = s;
+	init_task_work(&init->work, thread_init_work);
+	if (task_work_add(child, &init->work, TWA_RESUME)) {
+		session_put(s);
+		kfree(init);
+	}
+}
