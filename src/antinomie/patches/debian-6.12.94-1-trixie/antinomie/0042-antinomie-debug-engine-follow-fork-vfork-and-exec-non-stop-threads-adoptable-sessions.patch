+/* A task of the program was created (kernel_clone, before it runs). */
+void ant_dbg_fork(struct task_struct *child, u64 clone_flags)
+{
+	struct ant_dbg_event *ev, *done = NULL;
+	struct ant_dbg_thread *t;
+	struct ant_dbg *s, *c;
+	bool vfork = clone_flags & CLONE_VFORK;
+	int error;
+
+	s = hook_session();
+	if (!s)
+		return;
+	/* A vfork child of a program with no session of its own is not followed. */
+	if (!same_thread_group(current, s->leader))
+		goto out;
+	if (clone_flags & CLONE_THREAD) {
+		thread_created(s, child);
+		goto out;
+	}
+	/* A shared address space that is not a vfork has no owner to follow. */
+	if (!(READ_ONCE(s->opts) & ANTC_DEBUG_OPT_FORK) ||
+	    ((clone_flags & CLONE_VM) && !vfork))
+		goto out;
+	t = current_record(s);
+	ev = kzalloc(sizeof(*ev), GFP_KERNEL);
+	if (!t || !ev)
+		goto fail;
+	if (vfork)
+		done = kzalloc(sizeof(*done), GFP_KERNEL);
+	if (vfork && !done)
+		goto fail;
+	c = child_session(s, child, vfork);
+	if (!c)
+		goto fail;
+	mutex_lock(&dbg_lock);
+	error = publish_session(c);
+	mutex_unlock(&dbg_lock);
+	if (error) {
+		spin_lock_irq(&s->lock);
+		s->last_error = error;
+		spin_unlock_irq(&s->lock);
+		/* Nobody can follow it: the child runs free. */
+		discard_session(c);
+		goto fail;
+	}
+	ev->kind = vfork ? ANTC_DEBUG_EVENT_VFORK : ANTC_DEBUG_EVENT_FORK;
+	ev->child_session = c->id;
+	ev->child_cookie = c->cookie;
+	ev->child_start_ns = c->start_ns;
+	ev->child_tgid = c->tgid;
+	ev->parent_tid = t->tid;
+	ev->flags = vfork ? ANTC_DEBUG_EVF_SHARED_MM : 0;
+	if (vfork) {
+		*done = *ev;
+		done->kind = ANTC_DEBUG_EVENT_VFORK_DONE;
+		/* The parent sleeps until the child execs or exits, then reports it. */
+		WRITE_ONCE(t->vfork_wait, true);
+		t->pending_ev = done;
+		WRITE_ONCE(t->pending, ANTC_DEBUG_EVENT_VFORK_DONE);
+		queue_thread(s, t);
+		report_without_park(s, t, ANTC_DEBUG_EVENT_VFORK, ev);
+		kfree(ev);
+	} else {
+		t->pending_ev = ev;
+		WRITE_ONCE(t->pending, ANTC_DEBUG_EVENT_FORK);
+		queue_thread(s, t);
+	}
+	/* The child parks at its first return to user mode. */
+	queue_thread_mode(c, list_first_entry(&c->threads, struct ant_dbg_thread, node), TWA_RESUME);
+	goto out;
+fail:
+	kfree(ev);
+	kfree(done);
+out:
+	session_put(s);
+}
