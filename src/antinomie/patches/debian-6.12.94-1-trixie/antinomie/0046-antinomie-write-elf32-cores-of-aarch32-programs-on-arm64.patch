+
+/* Program header i of the core: its type, file offset and file size. */
+static bool core_phdr(struct ant_core *core, u64 phoff, u32 i, bool elf32,
+		      u32 *type, u64 *offset, u64 *filesz)
+{
+	size_t size = elf32 ? sizeof(struct elf32_phdr) : sizeof(struct elf64_phdr);
+	u64 available;
+	void *ph = core_span(core, phoff + (u64)i * size, &available);
+
+	if (!ph || available < size)
+		return false;
+	if (elf32) {
+		struct elf32_phdr *p = ph;
+
+		*type = p->p_type;
+		*offset = p->p_offset;
+		*filesz = p->p_filesz;
+	} else {
+		struct elf64_phdr *p = ph;
+
+		*type = p->p_type;
+		*offset = p->p_offset;
+		*filesz = p->p_filesz;
+	}
+	return true;
+}
+
+/* The core flag that names its format, once its header is in. */
+static u32 core_format_flag(struct ant_core *core)
+{
+	u64 phoff;
+	u32 phnum;
+	bool elf32;
+
+	if (!core_header(core, &phoff, &phnum, &elf32))
 		return 0;
+	if (elf32 && ELF_CLASS == ELFCLASS64)
+		return ANTC_CORE_COMPAT_ELF32;
+	return elf32 ? ANTC_CORE_NATIVE_ELF32 : ANTC_CORE_NATIVE_ELF64;
+}
