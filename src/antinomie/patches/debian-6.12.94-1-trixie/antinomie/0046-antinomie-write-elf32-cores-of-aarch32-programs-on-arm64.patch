 #include <linux/signal_types.h>
 #include <linux/types.h>
+#include <linux/elf-em.h>
+#include <linux/antinomie_monitor.h>
+
+/* An AArch32 task of an arm64 guest has its core written by its own binary
+ * format, fs/compat_binfmt_elf.c's: ELFCLASS32 EM_ARM, the compat NT_PRSTATUS
+ * of user_aarch32_view, NT_ARM_VFP, the compat NT_SIGINFO, a 32-bit NT_FILE
+ * and auxv (contract revision 21, ANTC_CORE_COMPAT_ELF32). Other compat ABIs
+ * (ia32 on x86-64) get no core.
+ */
+#if defined(CONFIG_ARM64) && defined(CONFIG_COMPAT_BINFMT_ELF)
+#define ANT_CORE_COMPAT_MACHINE EM_ARM
+#endif
+
+static __always_inline bool ant_core_abi_ok(void)
+{
+#ifdef ANT_CORE_COMPAT_MACHINE
+	return true;
+#else
+	return !ant_arch_compat_task();
+#endif
+}
 
