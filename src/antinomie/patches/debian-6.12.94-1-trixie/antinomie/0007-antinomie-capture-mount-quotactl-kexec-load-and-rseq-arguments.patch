+/* Slice 2C: mount, quota control, kexec_load and rseq. Roles follow the pinned
+ * fs/namespace.c, fs/quota/quota.c, kernel/kexec.c and kernel/rseq.c.
+ */
+
+/* copy_mount_options() reads up to one page and stops at the first unreadable
+ * byte. Pages are readable as a whole, so probing each page's first byte gives
+ * the same prefix. A non-resident page may also read as unreadable here.
+ */
+static void capture_mount_data(struct ant_task *ctx, u64 address)
+{
+	u64 first = PAGE_SIZE - offset_in_page(address), prefix;
+	char byte;
+
+	if (!address)
+		return;
+	if (copy_from_user_nofault(&byte, (void __user *)(unsigned long)address, 1))
+		prefix = 0;
+	else if (first >= PAGE_SIZE ||
+		 !copy_from_user_nofault(&byte, (void __user *)(unsigned long)(address + first), 1))
+		prefix = PAGE_SIZE;
+	else
+		prefix = first;
+	if (prefix)
+		ant_capture_field(ctx, 4, "arg4.data", LAYOUT("mount_options"), 1, address, NULL,
+				  prefix, PAGE_SIZE, ANT_COMPLETE);
+	if (prefix < PAGE_SIZE && !ant_capture_lost(ctx))
+		ant_capture_field(ctx, 4, "arg4.data.tail", "", 1, address + prefix, NULL,
+				  PAGE_SIZE - prefix, PAGE_SIZE - prefix, ANT_COPY_FAULT);
+}
+
+static void capture_mount(struct ant_task *ctx, const u64 args[6], bool output)
+{
+	if (output)
+		return;
+	if (args[0])
+		ant_capture_string(ctx, 0, "arg0.dev_name", args[0], PATH_MAX);
+	if (!ant_capture_lost(ctx))
+		ant_capture_string(ctx, 1, "arg1.dir_name", args[1], PATH_MAX);
+	if (args[2] && !ant_capture_lost(ctx))
+		ant_capture_string(ctx, 2, "arg2.type", args[2], PATH_MAX);
+	if (!ant_capture_lost(ctx))
+		capture_mount_data(ctx, args[4]);
+}
+
+/* quotactl(cmd, special, id, addr) and quotactl_fd(fd, cmd, id, addr) share
+ * the subcommand roles of addr (argument 3 in both).
+ */
+static void capture_quota_addr(struct ant_task *ctx, u32 cmd, u64 address, bool output,
+			       long result, bool fd_variant)
+{
+	switch (cmd >> SUBCMDSHIFT) {
+	case Q_QUOTAON:
+		/* quotactl_fd rejects Q_QUOTAON; it has no path argument. */
+		if (!output && !fd_variant)
+			ant_capture_string(ctx, 3, "arg3.quota_file", address, PATH_MAX);
+		return;
+	case Q_GETFMT:
+		capture_paired(ctx, output, result, true, "arg3.format", LAYOUT("u32"), address,
+			       sizeof(u32));
+		return;
+	case Q_GETINFO: case Q_SETINFO:
+		capture_paired(ctx, output, result, cmd >> SUBCMDSHIFT == Q_GETINFO, "arg3.info",
+			       LAYOUT("if_dqinfo"), address, sizeof(struct if_dqinfo));
+		return;
+	case Q_GETQUOTA: case Q_SETQUOTA:
+		capture_paired(ctx, output, result, cmd >> SUBCMDSHIFT == Q_GETQUOTA, "arg3.dqblk",
+			       LAYOUT("if_dqblk"), address, sizeof(struct if_dqblk));
+		return;
+	case Q_GETNEXTQUOTA:
+		capture_paired(ctx, output, result, true, "arg3.dqblk", LAYOUT("if_nextdqblk"),
+			       address, sizeof(struct if_nextdqblk));
+		return;
+	case Q_XQUOTAON: case Q_XQUOTAOFF: case Q_XQUOTARM:
+		capture_paired(ctx, output, result, false, "arg3.flags", LAYOUT("u32"), address,
+			       sizeof(u32));
+		return;
+	case Q_XGETQSTAT:
+		capture_paired(ctx, output, result, true, "arg3.stat", LAYOUT("fs_quota_stat"),
+			       address, sizeof(struct fs_quota_stat));
+		return;
+	case Q_XGETQSTATV:
+		/* The kernel reads only qs_version before writing the whole result. */
+		if (!output)
+			capture_fixed(ctx, 3, "arg3.qs_version", LAYOUT("u8"), address, 1);
+		else
+			capture_paired(ctx, output, result, true, "arg3.stat",
+				       LAYOUT("fs_quota_statv"), address,
+				       sizeof(struct fs_quota_statv));
+		return;
+	case Q_XSETQLIM: case Q_XGETQUOTA: case Q_XGETNEXTQUOTA:
+		capture_paired(ctx, output, result, cmd >> SUBCMDSHIFT != Q_XSETQLIM, "arg3.dquot",
+			       LAYOUT("fs_disk_quota"), address, sizeof(struct fs_disk_quota));
+		return;
+	case Q_QUOTAOFF: case Q_SYNC: case Q_XQUOTASYNC:
+		return;
+	default:
+		if (!output)
+			capture_gap(ctx, "quotactl.unknown_selector", ANT_NO_DECODER);
+	}
+}
+
+/* The user layout of struct kexec_segment; uapi/linux/kexec.h hides it from
+ * kernel code, and the kernel's own copy adds a kbuf union.
+ */
+struct ant_kexec_segment {
+	u64 buf;
+	u64 bufsz;
+	u64 mem;
+	u64 memsz;
+};
+
+static_assert(sizeof(struct ant_kexec_segment) == 4 * sizeof(unsigned long));
+
+static void capture_kexec_load(struct ant_task *ctx, const u64 args[6], bool output)
+{
+	struct ant_kexec_segment segments[KEXEC_SEGMENT_MAX];
+	enum ant_status status;
+	u64 count = args[1], size;
+	unsigned int index;
+	char key[48];
+
+	if (output)
+		return;
+	size = count <= U64_MAX / sizeof(segments[0]) ? count * sizeof(segments[0]) : U64_MAX;
+	if (count > KEXEC_SEGMENT_MAX) {
+		ant_capture_field(ctx, 2, "arg2.segments", LAYOUT("kexec_segment[]"), 3, args[2],
+				  NULL, size, size, ANT_INVALID_EXTENT);
+		return;
+	}
+	status = count && copy_from_user_nofault(segments, (void __user *)(unsigned long)args[2],
+						 size) ? ANT_COPY_FAULT : ANT_COMPLETE;
+	ant_capture_field(ctx, 2, "arg2.segments", LAYOUT("kexec_segment[]"), 3, args[2],
+			  segments, size, size, status);
+	if (status != ANT_COMPLETE)
+		return;
+	for (index = 0; index < count && !ant_capture_lost(ctx); index++) {
+		if (!segments[index].bufsz)
+			continue;
+		scnprintf(key, sizeof(key), "arg2.segments[%u].buf", index);
+		/* Bounded like write(); larger images are flagged, not truncated silently. */
+		ant_capture_field(ctx, 2, key, "", 1, segments[index].buf, NULL,
+				  min_t(u64, segments[index].bufsz, MAX_RW_COUNT),
+				  segments[index].bufsz,
+				  segments[index].bufsz > MAX_RW_COUNT ? ANT_INVALID_EXTENT :
+				  ANT_COMPLETE);
+	}
+}
+
+static void capture_rseq(struct ant_task *ctx, const u64 args[6], bool output, long result)
+{
+	u64 size = min_t(u64, (u32)args[1], sizeof(struct rseq));
+
+	if (!output) {
+		ant_capture_field(ctx, 0, "arg0.rseq", LAYOUT("rseq"), 3, args[0], NULL, size,
+				  (u32)args[1], ANT_COMPLETE);
+	} else if (result == 0 && ((u32)args[2] & RSEQ_FLAG_UNREGISTER)) {
+		capture_fixed(ctx, 0, "arg0.rseq", LAYOUT("rseq"), args[0], size);
+	} else if (result == 0) {
+		/* The kernel writes the CPU, node and mm ids on later returns to user. */
+		ant_capture_field(ctx, 0, "arg0.rseq.updates", LAYOUT("rseq"), 3, args[0], NULL,
+				  sizeof(struct rseq), sizeof(struct rseq), ANT_ASYNC_UNOBSERVED);
+	}
+}
+
 /* Socket options. The table below was reviewed against the pinned
  * net/core/sock.c, net/ipv4/ip_sockglue.c, net/ipv6/ipv6_sockglue.c and
  * net/ipv4/tcp.c handlers. A (level, optname) pair absent from it is still
@@ -2782,6 +2950,24 @@ u8 ant_native_capture(struct ant_task *ctx, u64 nr, const u64 args[6],
 	case 101:
 		capture_ptrace(ctx, args, output, result);
 		return ANT_CAPTURE_OWNED | BIT(2) | BIT(3);
+	case 165:
+		capture_mount(ctx, args, output);
+		return ANT_CAPTURE_OWNED | BIT(0) | BIT(1) | BIT(2) | BIT(4);
+	case 179:
+		if (!output && args[1])
+			ant_capture_string(ctx, 1, "arg1.special", args[1], PATH_MAX);
+		if (!ant_capture_lost(ctx))
+			capture_quota_addr(ctx, args[0], args[3], output, result, false);
+		return ANT_CAPTURE_OWNED | BIT(1) | BIT(3);
+	case 443:
+		capture_quota_addr(ctx, args[1], args[3], output, result, true);
+		return ANT_CAPTURE_OWNED | BIT(3);
+	case 246:
+		capture_kexec_load(ctx, args, output);
+		return ANT_CAPTURE_OWNED | BIT(2);
+	case 334:
+		capture_rseq(ctx, args, output, result);
+		return ANT_CAPTURE_OWNED | BIT(0);
 	case 139:
 		capture_sysfs(ctx, args, output, result);
 		return ANT_CAPTURE_OWNED | BIT(1) | BIT(2);
