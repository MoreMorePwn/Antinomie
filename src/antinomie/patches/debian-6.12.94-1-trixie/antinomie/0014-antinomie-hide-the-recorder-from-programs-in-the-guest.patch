diff --git a/kernel/antinomie/sections.h b/kernel/antinomie/sections.h
new file mode 100644
index 0000000..d369e62
--- /dev/null
+++ b/kernel/antinomie/sections.h
@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* A label at the start (section_begin.c, linked first in this directory) and
+ * at the end (section_end.c, linked last) of each section the recorder's
+ * objects put symbols in. The linker keeps one directory's input sections of
+ * a kind together and in link order, so each pair brackets exactly this
+ * directory's functions and data (ant_symbol_hidden()).
+ */
+#ifndef ANT_SECTIONS_H
+#define ANT_SECTIONS_H
+
+#include <linux/objtool.h>
+
+/* The text labels are addresses, never call targets: no ENDBR (objtool). */
+#define ANT_SECTION_LABEL(name, section, flags, note)	\
+	asm(".pushsection " section "," flags "\n"	\
+	    ".globl " #name "\n"			\
+	    #name ":\n"					\
+	    note					\
+	    ".popsection\n")
+
+#define ANT_SECTION_LABELS(where)							\
+	ANT_SECTION_LABEL(ant_text_##where, ".text", "\"ax\"", ANNOTATE_NOENDBR);	\
+	ANT_SECTION_LABEL(ant_rodata_##where, ".rodata", "\"a\"", "");		\
+	ANT_SECTION_LABEL(ant_data_##where, ".data", "\"aw\"", "");		\
+	ANT_SECTION_LABEL(ant_bss_##where, ".bss", "\"aw\",@nobits", "");	\
+	ANT_SECTION_LABEL(ant_percpu_##where, ".data..percpu", "\"aw\"", "")
+
+extern const char ant_text_begin[], ant_text_end[];
+extern const char ant_rodata_begin[], ant_rodata_end[];
+extern const char ant_data_begin[], ant_data_end[];
+extern const char ant_bss_begin[], ant_bss_end[];
+extern const char ant_percpu_begin[], ant_percpu_end[];
+#endif
diff --git a/kernel/antinomie/stealth.c b/kernel/antinomie/stealth.c
new file mode 100644
index 0000000..6f72f09
--- /dev/null
+++ b/kernel/antinomie/stealth.c
@@ -0,0 +1,123 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* What the guest kernel keeps from the programs it runs: Antinomie's own
+ * traces in interfaces any program can read.
+ *
+ * The host passes its boot options (antinomie_boot_gpa=, antinomie_ring_kib=)
+ * on the kernel command line. They are taken out of it before the kernel
+ * first prints it, applied here, and never reach the saved command line:
+ * /proc/cmdline and the kernel log show the rest of the line only.
+ *
+ * The recorder's symbols (this directory's functions and data, and the hooks
+ * elsewhere named ant_*) are left out of what programs read by name:
+ * /proc/kallsyms and /proc/<pid>/wchan. The kernel itself still has them, so
+ * stack traces, kprobes and every internal lookup work as before.
+ *
+ * QEMU's own ACPI devices (HID QEMU0001 pvpanic, QEMU0002 fw_cfg, ...) are not
+ * enumerated: no driver of this kernel uses them, and enumerated they appear
+ * in /sys/bus/acpi/devices and /proc/ioports by their QEMU names.
+ */
+#include <linux/acpi.h>
+#include <linux/antinomie_stealth.h>
+#include <linux/ctype.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <asm/setup.h>
+#include "sections.h"
+
+#define ANT_OPTION_PREFIX "antinomie_"
+
+static char ant_options[COMMAND_LINE_SIZE] __initdata;
+
+/* Remove every antinomie_* option from cmdline, in place, and apply them as
+ * early parameters. Other options, quoted values and their order are kept;
+ * the spaces around a removed option collapse to one. */
+void __init ant_cmdline_take(char *cmdline)
+{
+	char *in = cmdline, *out = cmdline;
+	size_t taken = 0;
+
+	while (*in) {
+		const char *start;
+		bool quoted = false;
+		size_t len;
+
+		if (isspace(*in)) {
+			*out++ = *in++;
+			continue;
+		}
+		start = in;
+		while (*in && (quoted || !isspace(*in))) {
+			if (*in == '"')
+				quoted = !quoted;
+			in++;
+		}
+		len = in - start;
+		if (len > strlen(ANT_OPTION_PREFIX) &&
+		    !strncmp(start, ANT_OPTION_PREFIX, strlen(ANT_OPTION_PREFIX))) {
+			if (taken + len + 2 <= sizeof(ant_options)) {
+				if (taken)
+					ant_options[taken++] = ' ';
+				memcpy(ant_options + taken, start, len);
+				taken += len;
+				ant_options[taken] = '\0';
+			}
+			/* Drop the space before it; the one after it stays. */
+			while (out > cmdline && isspace(out[-1]))
+				out--;
+			continue;
+		}
+		memmove(out, start, len);
+		out += len;
+	}
+	*out = '\0';
+	in = skip_spaces(cmdline);
+	if (in != cmdline)
+		memmove(cmdline, in, strlen(in) + 1);
+	if (taken)
+		parse_early_options(ant_options);
+}
+
+static const struct {
+	const char *begin, *end;
+} ant_sections[] = {
+	{ ant_text_begin, ant_text_end },
+	{ ant_rodata_begin, ant_rodata_end },
+	{ ant_data_begin, ant_data_end },
+	{ ant_bss_begin, ant_bss_end },
+	/* Per-CPU symbols are offsets into the per-CPU area, in kallsyms too. */
+	{ ant_percpu_begin, ant_percpu_end },
+};
+
+/* ant_* and what the build names after it: __pfx_ant_*, __ksymtab_ant_*,
+ * __setup_ant_*, the initcall entries (__initcall__kmod_..._ant_*_init). */
+static bool ant_symbol_name(const char *name)
+{
+	return !strncmp(name, "ant_", 4) || strstr(name, "_ant_") || strstr(name, "antinomie");
+}
+
+bool ant_symbol_hidden(unsigned long address, const char *name)
+{
+	size_t i;
+
+	for (i = 0; i < ARRAY_SIZE(ant_sections); i++)
+		if (address >= (unsigned long)ant_sections[i].begin &&
+		    address < (unsigned long)ant_sections[i].end)
+			return true;
+	return name && ant_symbol_name(name);
+}
+
+#ifdef CONFIG_ACPI
+bool ant_acpi_device_hidden(void *handle)
+{
+	struct acpi_device_info *info;
+	bool hidden;
+
+	if (ACPI_FAILURE(acpi_get_object_info(handle, &info)))
+		return false;
+	hidden = (info->valid & ACPI_VALID_HID) && !strncmp(info->hardware_id.string, "QEMU", 4);
+	kfree(info);
+	return hidden;
+}
+#endif
