diff --git a/kernel/antinomie/control_wire.h b/kernel/antinomie/control_wire.h
index 3f3f873..87464f8 100644
--- a/kernel/antinomie/control_wire.h
+++ b/kernel/antinomie/control_wire.h
@@ -22,9 +22,24 @@
 #define ANTC_TERMINAL_READ 0x1012
 #define ANTC_TERMINAL_RESIZE 0x1013
 #define ANTC_SIGNAL 0x1014
+#define ANTC_STATS 0x1020
 #define ANTC_INFO 0x1021
 #define ANTC_INFO_SIZE 160
 #define ANTC_SHUTDOWN 0x1030
+#define ANTC_PROCESS_LIST 0x1050
+#define ANTC_CAPTURE_ATTACH 0x1051
+#define ANTC_CAPTURE_ALL 0x1052
+#define ANTC_CAPTURE_STOP 0x1053
+#define ANTC_CAPTURE_STATUS 0x1054
+#define ANTC_PROCESS_PAGE_MAX 64
+#define ANTC_PROCESS_ENTRY_SIZE 64
+#define ANTC_CAPTURE_STATUS_SIZE 32
+#define ANTC_CAPTURE_RETAINED 64
+#define ANTC_CAPTURE_ACTIVE 1
+#define ANTC_CAPTURE_STOPPED 2
+#define ANTC_CAPTURE_TAILS_POSSIBLE 4
+#define ANTC_CAPTURE_PROCESS 1
+#define ANTC_CAPTURE_USERSPACE 2
 #define ANTC_UPLOAD_OVERWRITE 1
 #define ANTC_UPLOAD_EXECUTABLE 2
 
@@ -56,12 +71,43 @@
  * SIGNAL: header, u64 session_id at 8, u32 signal at 16,
  * u32 reserved=0 at 20. Signals launch process group. Empty success reply.
  *
+ * STATS: header only. Reply: ten u64 counters in order: stream_id,
+ * tasks_created, tasks_live, calls_entered, events_attempted,
+ * packets_attempted, packets_failed, copy_faults, schema_gaps,
+ * context_failures (80 bytes). Counters persist despite telemetry loss.
  * INFO: header only. Reply (160 bytes): u32 revision at 0 (ANTC_REVISION),
  * u32 reserved=0 at 4, source id at 8 (80 bytes), kernel release at 88
  * (64 bytes), reserved zero at 152. Strings are NUL terminated and padded.
  * The source id is CONFIG_ANTINOMIE_SOURCE_ID, "<revision>:<series sha256>",
  * or empty for an unversioned build. Kernels before revision 9 return
- * -EOPNOTSUPP.
+ * -EOPNOTSUPP. INFO is registered before every other opcode, so INFO
+ * unsupported while STATS succeeds identifies such a kernel.
+ * PROCESS_LIST: header flags=0, u32 after_pid at 8, u32 capacity at 12,
+ * 1..64. Non-atomic live pagination of userspace process leaders, ascending
+ * PID. Reply: u64 stream_id at 0, u32 count at 8, u32 next_pid at 12
+ * (0 ends enumeration), then count 64-byte entries: u64 task_cookie at 0,
+ * u64 start_boottime at 8, u32 tgid at 16, u32 parent_tgid at 20,
+ * u32 uid/gid/thread_count at 24/28/32, u32 flags=0 at 36, comm[16] at 40
+ * (NUL terminated), reserved zeros at 56..63. PID is not authorization.
+ * CAPTURE_ATTACH: header flags=0, u64 leader task_cookie at 8,
+ * u64 start_boottime at 16, u32 tgid at 24, u32 reserved=0 at 28.
+ * Validates live identity, includes current thread group and future descendants
+ * only. CAPTURE_ALL: header only; existing/future userspace observations.
+ * Both reply with u64 capture_cookie at 0 and u64 stream_id at 8 (16 bytes).
+ * One active observer at a time. Capture IDs count up from 1 and are never
+ * reused within a boot; there is no per-boot capture limit (revision 12).
+ * STOP and STATUS address the 64 most recent captures; an older cookie
+ * returns -ESRCH like an unknown one (such a capture has necessarily stopped).
+ * Existing launched-run root ownership and PTYs remain unchanged.
+ * CAPTURE_STOP / STATUS: header flags=0, u64 capture_cookie at 8.
+ * STATUS cookie=0 queries the active observer (all-zero reply if none).
+ * STOP requires a nonzero known cookie, is idempotent, never signals tasks.
+ * Both return 32-byte status: u64 cookie at 0, u32 flags at 8, u32 mode at 12,
+ * u64 start_ns at 16, u64 stop_ns at 24. STOP closes admission; admitted calls
+ * and async requests retain their old capture ID and may publish later tails.
+ * STOPPED|TAILS_POSSIBLE does not promise delivery/drain or complete capture.
+ * ANTT minor 2 / 144-byte header adds capture_cookie at offset 136, preserving
+ * launched root cookie at 128. Capture attribution is frozen on admission.
  * SHUTDOWN: header only; empty success reply, delayed kernel_power_off.
  */
 #endif
diff --git a/kernel/antinomie/observer.c b/kernel/antinomie/observer.c
new file mode 100644
index 0000000..acf19c9
--- /dev/null
+++ b/kernel/antinomie/observer.c
@@ -0,0 +1,227 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/antinomie_monitor.h>
+#include <linux/cred.h>
+#include <linux/errno.h>
+#include <linux/ktime.h>
+#include <linux/rcupdate.h>
+#include <linux/sched/signal.h>
+#include <linux/unaligned.h>
+
+#include "control_wire.h"
+#include "observer.h"
+
+struct ant_observer {
+	u64 cookie;
+	u64 start_ns;
+	u64 stop_ns;
+	u32 mode;
+};
+
+/* The control owner serializes writes. A ring keeps the most recent captures
+ * addressable; cookies count up for the whole boot and are never reused, so a
+ * recycled slot cannot alias an older capture. A slot is recycled only after
+ * its capture stopped and an RCU grace period passed, so admission readers
+ * never see its immutable fields change under them.
+ */
+static struct ant_observer observers[ANTC_CAPTURE_RETAINED];
+static u64 last_cookie;
+static struct ant_observer __rcu *active_observer;
+
+static struct ant_observer *slot(u64 cookie)
+{
+	return &observers[(cookie - 1) % ANTC_CAPTURE_RETAINED];
+}
+
+u64 ant_observer_admit(struct task_struct *task)
+{
+	struct ant_observer *observer;
+	u64 cookie = 0;
+
+	rcu_read_lock();
+	observer = rcu_dereference(active_observer);
+	if (observer && !(READ_ONCE(task->flags) & (PF_KTHREAD | PF_USER_WORKER)) &&
+	    (observer->mode == ANTC_CAPTURE_USERSPACE ||
+	     READ_ONCE(task->ant_observer_cookie) == observer->cookie))
+		cookie = observer->cookie;
+	rcu_read_unlock();
+	return cookie;
+}
+
+static int process_list(const u8 *args, size_t args_len, u8 *reply,
+			size_t capacity, size_t *reply_len)
+{
+	struct task_struct *page[ANTC_PROCESS_PAGE_MAX + 1], *task;
+	const struct cred *cred;
+	u32 after, limit, count = 0, pid;
+	unsigned int i, pos;
+	u8 *entry;
+
+	if (args_len != 16)
+		return -EINVAL;
+	after = get_unaligned_le32(args + 8);
+	limit = get_unaligned_le32(args + 12);
+	if (!limit || limit > ANTC_PROCESS_PAGE_MAX)
+		return -EINVAL;
+	if (capacity < 16 + limit * ANTC_PROCESS_ENTRY_SIZE)
+		return -EMSGSIZE;
+
+	/* Retain one extra leader to distinguish a full final page. tasklist_lock
+	 * protects leader/thread-group lifetimes through encoding the bounded page.
+	 */
+	read_lock(&tasklist_lock);
+	for_each_process(task) {
+		pid = task_tgid_nr(task);
+		if (pid <= after || task->flags & (PF_KTHREAD | PF_USER_WORKER) ||
+		    !atomic_read(&task->signal->live))
+			continue;
+		for (pos = 0; pos < count; pos++)
+			if (pid < task_tgid_nr(page[pos]))
+				break;
+		if (pos > limit)
+			continue;
+		if (count < limit + 1)
+			count++;
+		for (i = count - 1; i > pos; i--)
+			page[i] = page[i - 1];
+		page[pos] = task;
+	}
+	memset(reply, 0, 16 + min(count, limit) * ANTC_PROCESS_ENTRY_SIZE);
+	put_unaligned_le64(ant_monitor_stream_id(), reply);
+	put_unaligned_le32(min(count, limit), reply + 8);
+	if (count > limit)
+		put_unaligned_le32(task_tgid_nr(page[limit - 1]), reply + 12);
+	for (i = 0; i < min(count, limit); i++) {
+		task = page[i];
+		entry = reply + 16 + i * ANTC_PROCESS_ENTRY_SIZE;
+		put_unaligned_le64(ant_monitor_cookie(task), entry);
+		put_unaligned_le64(task->start_boottime, entry + 8);
+		put_unaligned_le32(task_tgid_nr(task), entry + 16);
+		put_unaligned_le32(task_tgid_nr(task->real_parent), entry + 20);
+		cred = get_task_cred(task);
+		put_unaligned_le32(from_kuid(&init_user_ns, cred->uid), entry + 24);
+		put_unaligned_le32(from_kgid(&init_user_ns, cred->gid), entry + 28);
+		put_cred(cred);
+		put_unaligned_le32(get_nr_threads(task), entry + 32);
+		__get_task_comm((char *)entry + 40, TASK_COMM_LEN, task);
+	}
+	read_unlock(&tasklist_lock);
+	*reply_len = 16 + min(count, limit) * ANTC_PROCESS_ENTRY_SIZE;
+	return 0;
+}
+
+static void status_reply(const struct ant_observer *observer, u8 *reply)
+{
+	memset(reply, 0, ANTC_CAPTURE_STATUS_SIZE);
+	if (!observer)
+		return;
+	put_unaligned_le64(observer->cookie, reply);
+	put_unaligned_le32(observer->stop_ns ?
+		ANTC_CAPTURE_STOPPED | ANTC_CAPTURE_TAILS_POSSIBLE : ANTC_CAPTURE_ACTIVE,
+		reply + 8);
+	put_unaligned_le32(observer->mode, reply + 12);
+	put_unaligned_le64(observer->start_ns, reply + 16);
+	put_unaligned_le64(observer->stop_ns, reply + 24);
+}
+
+static int start(u32 opcode, const u8 *args, size_t args_len, u8 *reply,
+		 size_t capacity, size_t *reply_len)
+{
+	struct ant_observer *observer;
+	struct task_struct *leader = NULL, *task;
+	u64 cookie = 0, start_ns = 0;
+	u32 pid = 0;
+
+	if (opcode == ANTC_CAPTURE_ATTACH) {
+		if (args_len != 32 || get_unaligned_le32(args + 28))
+			return -EINVAL;
+		cookie = get_unaligned_le64(args + 8);
+		start_ns = get_unaligned_le64(args + 16);
+		pid = get_unaligned_le32(args + 24);
+		if (!cookie || !pid)
+			return -EINVAL;
+	} else if (args_len != 8) {
+		return -EINVAL;
+	}
+	if (capacity < 16)
+		return -EMSGSIZE;
+	if (rcu_access_pointer(active_observer))
+		return -EBUSY;
+	if (last_cookie == U64_MAX)
+		return -ENOSPC;
+	observer = slot(last_cookie + 1);
+	/* The slot's previous capture stopped (only one is ever active); wait out
+	 * admission readers that loaded it before the stop.
+	 */
+	if (observer->cookie)
+		synchronize_rcu();
+
+	/* Fork copies the marker before publication under this same lock. An
+	 * attach therefore includes exactly the threads present at this boundary.
+	 */
+	write_lock_irq(&tasklist_lock);
+	if (opcode == ANTC_CAPTURE_ATTACH) {
+		for_each_process(task)
+			if (task_tgid_nr(task) == pid) {
+				leader = task;
+				break;
+			}
+		if (!leader || leader->flags & (PF_KTHREAD | PF_USER_WORKER) ||
+		    !atomic_read(&leader->signal->live) ||
+		    READ_ONCE(leader->ant_cookie) != cookie ||
+		    leader->start_boottime != start_ns) {
+			write_unlock_irq(&tasklist_lock);
+			return -ESRCH;
+		}
+	}
+	observer->cookie = ++last_cookie;
+	observer->stop_ns = 0;
+	observer->mode = opcode == ANTC_CAPTURE_ATTACH ?
+		ANTC_CAPTURE_PROCESS : ANTC_CAPTURE_USERSPACE;
+	observer->start_ns = ktime_get_ns();
+	if (leader) {
+		WRITE_ONCE(leader->ant_observer_cookie, observer->cookie);
+		for_each_thread(leader, task)
+			WRITE_ONCE(task->ant_observer_cookie, observer->cookie);
+	}
+	rcu_assign_pointer(active_observer, observer);
+	write_unlock_irq(&tasklist_lock);
+	put_unaligned_le64(observer->cookie, reply);
+	put_unaligned_le64(ant_monitor_stream_id(), reply + 8);
+	*reply_len = 16;
+	return 0;
+}
+
+int ant_observer_command(u32 opcode, const u8 *args, size_t args_len,
+			 void *reply, size_t capacity, size_t *reply_len)
+{
+	struct ant_observer *observer;
+	u64 cookie;
+
+	if (opcode == ANTC_PROCESS_LIST)
+		return process_list(args, args_len, reply, capacity, reply_len);
+	if (opcode == ANTC_CAPTURE_ATTACH || opcode == ANTC_CAPTURE_ALL)
+		return start(opcode, args, args_len, reply, capacity, reply_len);
+	if (args_len != 16)
+		return -EINVAL;
+	if (capacity < ANTC_CAPTURE_STATUS_SIZE)
+		return -EMSGSIZE;
+	cookie = get_unaligned_le64(args + 8);
+	if (!cookie && opcode == ANTC_CAPTURE_STOP)
+		return -EINVAL;
+	if (!cookie && opcode == ANTC_CAPTURE_STATUS) {
+		observer = rcu_access_pointer(active_observer);
+	} else {
+		if (!cookie || cookie > last_cookie)
+			return -ESRCH;
+		observer = slot(cookie);
+		if (observer->cookie != cookie)
+			return -ESRCH;
+	}
+	if (opcode == ANTC_CAPTURE_STOP && !observer->stop_ns) {
+		observer->stop_ns = ktime_get_ns();
+		rcu_assign_pointer(active_observer, NULL);
+	}
+	status_reply(observer, reply);
+	*reply_len = ANTC_CAPTURE_STATUS_SIZE;
+	return 0;
+}
