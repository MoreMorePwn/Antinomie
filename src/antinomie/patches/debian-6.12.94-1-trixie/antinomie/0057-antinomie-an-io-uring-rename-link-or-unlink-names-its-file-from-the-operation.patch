Description: antinomie: an io_uring rename, link or unlink names its file from the operation
Author: MikiMiku <jonathanirvinjo@gmail.com>
Origin: project
Forwarded: no
Last-Update: 2026-10-22

An io_uring RENAMEAT, LINKAT or UNLINKAT runs on a worker with no traced call, so its file identity came from a lookup of the name just before the operation, with the link count the operation would leave. Two such requests on one file run side by side on a guest with several vCPUs: an UNLINKAT of each of a file's two names both looked it up while it still had two links and both said one link remains, so the file was never seen deleted.  The worker now marks the request it runs (task_struct ant_async_target) around do_renameat2(), do_linkat(), do_unlinkat() and do_rmdir(), and the identity those publish when they succeed goes to the request as its operand, with the link count the operation left, exactly as for the system call. A request that failed has none, as a system call that failed has none.  The contract revision stays 17: the operand and its layout are unchanged; the comment on lifecycle.file_id says where it now comes from.

---
diff --git a/include/linux/sched.h b/include/linux/sched.h
index ae3ed7344..b220f8f0f 100644
--- a/include/linux/sched.h
+++ b/include/linux/sched.h
@@ -806,6 +806,10 @@ struct task_struct {
 	u64 ant_observer_cookie;
 	struct ant_task *ant_monitor;
 	struct ant_run *ant_run;
+	/* The io_uring request whose operation this worker is running: the
+	 * file identity the operation publishes is that request's operand.
+	 */
+	struct ant_async **ant_async_target;
 	atomic64_t ant_event_seq;
 	atomic64_t ant_packet_seq;
 	bool ant_root_process;
diff --git a/io_uring/fs.c b/io_uring/fs.c
index 2734f02e2..0d3fdbf16 100644
--- a/io_uring/fs.c
+++ b/io_uring/fs.c
@@ -47,31 +47,18 @@ struct io_link {
 	int				flags;
 };
 
-#ifdef CONFIG_ANTINOMIE
-/* Record which file a name leads to just before the operation that moves,
- * links or removes it, as an operand of the request, with the link count the
- * operation leaves when it succeeds (@nlink_delta from the count now). A rename, link or unlink
- * runs on a worker with no traced call of its own, so the hooks that publish
- * this for a system call have nowhere to put it. The lookup is the
- * operation's own a moment earlier; if the name is changed in between, the
- * identity is that of the file the name meant at this lookup.
+/* A rename, link or unlink runs on a worker with no traced call of its own:
+ * the identity the operation publishes when it succeeded (do_renameat2,
+ * do_linkat, do_unlinkat, do_rmdir) goes to the request as its operand, with
+ * the link count the operation left. Two requests on one file, run beside
+ * each other, each say what their own operation did.
  */
-static void ant_uring_name_id(struct io_kiocb *req, u8 kind, int dfd,
-			      struct filename *name, unsigned int lookup_flags,
-			      int nlink_delta)
+static inline void ant_uring_target(struct io_kiocb *req, bool on)
 {
-	struct path path;
-
-	if (!req->ant_async || filename_lookup(dfd, name, lookup_flags, &path, NULL))
-		return;
-	ant_uring_file_id(req, kind, d_inode(path.dentry), nlink_delta);
-	path_put(&path);
-}
-#else
-static inline void ant_uring_name_id(struct io_kiocb *req, u8 kind, int dfd,
-				     struct filename *name, unsigned int lookup_flags,
-				     int nlink_delta) {}
+#ifdef CONFIG_ANTINOMIE
+	current->ant_async_target = on ? &req->ant_async : NULL;
 #endif
+}
 
 int io_renameat_prep(struct io_kiocb *req, const struct io_uring_sqe *sqe)
 {
@@ -115,9 +102,10 @@ int io_renameat(struct io_kiocb *req, unsigned int issue_flags)
 
 	WARN_ON_ONCE(issue_flags & IO_URING_F_NONBLOCK);
 
-	ant_uring_name_id(req, ANT_FILE_ID_RENAME, ren->old_dfd, ren->oldpath, 0, 0);
+	ant_uring_target(req, true);
 	ret = do_renameat2(ren->old_dfd, ren->oldpath, ren->new_dfd,
 				ren->newpath, ren->flags);
+	ant_uring_target(req, false);
 
 	req->flags &= ~REQ_F_NEED_CLEANUP;
 	io_req_set_res(req, ret, 0);
@@ -167,11 +155,12 @@ int io_unlinkat(struct io_kiocb *req, unsigned int issue_flags)
 
 	WARN_ON_ONCE(issue_flags & IO_URING_F_NONBLOCK);
 
-	ant_uring_name_id(req, ANT_FILE_ID_UNLINK, un->dfd, un->filename, 0, -1);
+	ant_uring_target(req, true);
 	if (un->flags & AT_REMOVEDIR)
 		ret = do_rmdir(un->dfd, un->filename);
 	else
 		ret = do_unlinkat(un->dfd, un->filename);
+	ant_uring_target(req, false);
 
 	req->flags &= ~REQ_F_NEED_CLEANUP;
 	io_req_set_res(req, ret, 0);
@@ -320,10 +309,10 @@ int io_linkat(struct io_kiocb *req, unsigned int issue_flags)
 
 	WARN_ON_ONCE(issue_flags & IO_URING_F_NONBLOCK);
 
-	ant_uring_name_id(req, ANT_FILE_ID_LINK, lnk->old_dfd, lnk->oldpath,
-			  lnk->flags & AT_SYMLINK_FOLLOW ? LOOKUP_FOLLOW : 0, 1);
+	ant_uring_target(req, true);
 	ret = do_linkat(lnk->old_dfd, lnk->oldpath, lnk->new_dfd,
 				lnk->newpath, lnk->flags);
+	ant_uring_target(req, false);
 
 	req->flags &= ~REQ_F_NEED_CLEANUP;
 	io_req_set_res(req, ret, 0);
diff --git a/kernel/antinomie/control_wire.h b/kernel/antinomie/control_wire.h
index f694bd1ed..103ac5d42 100644
--- a/kernel/antinomie/control_wire.h
+++ b/kernel/antinomie/control_wire.h
@@ -266,8 +266,8 @@
  * number from the file that held it before), u32 mode at 28 (i_mode). Only
  * calls that succeeded publish one. An io_uring request carries the same
  * record as its operand "async.operand.file_id", with the same layout name; for
- * RENAMEAT, LINKAT and UNLINKAT, which look the name up before they run, nlink is
- * the count the operation leaves if it succeeds.
+ * RENAMEAT, LINKAT and UNLINKAT the operation publishes it when it succeeded,
+ * with the link count it left, as for the system call.
  * lifecycle.exec_image, layout "antinomie.execimg/1" (optional, additive):
  * published once per execve at the commit point. u32 flags at 0 (bit0
  * INTERPRETER: the image is a script's interpreter, bit1 INTERP_TRUNCATED,
diff --git a/kernel/antinomie/fileid.c b/kernel/antinomie/fileid.c
index 0b5a906fb..8be3f03d2 100644
--- a/kernel/antinomie/fileid.c
+++ b/kernel/antinomie/fileid.c
@@ -44,13 +44,19 @@ void ant_fileid_pack(u8 *rec, u8 kind, struct inode *inode, int nlink_delta)
 	put_unaligned_le32(mode, rec + 28);
 }
 
-/* Publish the identity of @inode in the calling task's traced call. */
+/* Publish the identity of @inode in the calling task's traced call, or, on
+ * an io_uring worker running a request's operation, as that request's operand.
+ */
 void ant_monitor_file_id(u8 kind, struct inode *inode)
 {
 	u8 rec[ANTC_FILEID_SIZE];
 
 	if (!inode)
 		return;
+	if (current->ant_async_target) {
+		ant_monitor_async_file_id(current->ant_async_target, kind, inode, 0);
+		return;
+	}
 	ant_fileid_pack(rec, kind, inode, 0);
 	ant_monitor_note(ANT_FILEID_KEY, ANT_FILEID_LAYOUT, rec, sizeof(rec));
 }
diff --git a/kernel/fork.c b/kernel/fork.c
index 3b12b9899..2cb277bfc 100644
--- a/kernel/fork.c
+++ b/kernel/fork.c
@@ -1144,6 +1144,7 @@ static struct task_struct *dup_task_struct(struct task_struct *orig, int node)
 	tsk->ant_observer_cookie = 0;
 	tsk->ant_monitor = NULL;
 	tsk->ant_run = NULL;
+	tsk->ant_async_target = NULL;
 	atomic64_set(&tsk->ant_event_seq, 0);
 	atomic64_set(&tsk->ant_packet_seq, 0);
 	tsk->ant_root_process = false;
