+/* The identity of a file the request acted on, as an operand of the request
+ * ("async.operand.file_id", layout antinomie.fileid/1). A request that uses
+ * one file publishes it once, at its first issue, whatever the number of
+ * retries. It never changes the payload-gap state: it is additional evidence.
+ */
+void ant_monitor_async_file_id(struct ant_async **slot, u8 kind, struct inode *inode,
+			       int nlink_delta)
+{
+	struct ant_async *request;
+	unsigned long irqflags;
+	bool repeat = false;
+	u8 rec[ANTC_FILEID_SIZE];
+
+	if (!inode)
+		return;
+	request = get_request(slot, false);
+	if (!request)
+		return;
+	if (kind == ANTC_FILEID_ISSUE) {
+		spin_lock_irqsave(&request_lock, irqflags);
+		repeat = request->file_id_issued;
+		request->file_id_issued = true;
+		spin_unlock_irqrestore(&request_lock, irqflags);
+	}
+	put_request(request);
+	if (repeat)
+		return;
+	ant_fileid_pack(rec, kind, inode, nlink_delta);
+	ant_monitor_async_memory(slot, ANT_FILEID_OPERAND, ANT_FILEID_LAYOUT, 3, 0, rec,
+				 sizeof(rec), kind != ANTC_FILEID_ISSUE, false);
+}
+
 /* The request has no payload beyond its scalar submission (contract 14.4). */
 void ant_monitor_async_scalar(struct ant_async **slot)
 {
diff --git a/kernel/antinomie/control_wire.h b/kernel/antinomie/control_wire.h
index 16341cb33..a2f56f004 100644
--- a/kernel/antinomie/control_wire.h
+++ b/kernel/antinomie/control_wire.h
@@ -225,7 +225,47 @@
  * and u32 hashing time in microseconds at 64/68, u32 cumulative records
  * lost since boot at 72 (queue, budget, memory or ring loss), zero at 76.
  * Published after the call returned, by a worker, with the call's identity.
+ * lifecycle.file_id, layout "antinomie.fileid/1", 32 bytes (optional, additive:
+ * a guest from before it publishes none, a host that does not know it shows an
+ * unknown lifecycle field): the identity of the file inode a call acted on, so
+ * one file can be followed across names. u8 kind at 0 (OPEN: the file an open
+ * returned; RENAME: the inode moved; LINK: the inode that got a new name;
+ * UNLINK: the inode whose name was removed; ISSUE: the file an io_uring or AIO
+ * request used; EXEC: the executed image), u8 flags at 1 (bit0 directory,
+ * bit1 regular file, bit2 symbolic link), zero at 2, u32 nlink at 4 (after the
+ * call), u64 dev at 8 (new_encode_dev of the superblock), u64 ino at 16,
+ * u32 generation at 24 (i_generation; with dev and ino it tells a reused inode
+ * number from the file that held it before), u32 mode at 28 (i_mode). Only
+ * calls that succeeded publish one. An io_uring request carries the same
+ * record as its operand "async.operand.file_id", with the same layout name; for
+ * RENAMEAT, LINKAT and UNLINKAT, which look the name up before they run, nlink is
+ * the count the operation leaves if it succeeds.
+ * lifecycle.exec_image, layout "antinomie.execimg/1" (optional, additive):
+ * published once per execve at the commit point. u32 flags at 0 (bit0
+ * INTERPRETER: the image is a script's interpreter, bit1 INTERP_TRUNCATED,
+ * bit2 PATH_TRUNCATED), u32 interp_len at 4 and u32 path_len at 8 (bytes
+ * including the NUL; 0 = absent), u32 nlink at 12, u64 dev at 16, u64 ino at 24,
+ * u32 generation at 32, u32 mode at 36, then at 40 the interpreter exactly as
+ * the script's "#!" line names it (bprm->interp), then the resolved path of the
+ * image that was loaded (for a script, the interpreter's file), each NUL
+ * terminated and cut at 511 bytes. dev, ino, generation and mode are those of
+ * the loaded image.
  */
+#define ANTC_FILEID_SIZE 32
+#define ANTC_FILEID_OPEN 1
+#define ANTC_FILEID_RENAME 2
+#define ANTC_FILEID_LINK 3
+#define ANTC_FILEID_UNLINK 4
+#define ANTC_FILEID_ISSUE 5
+#define ANTC_FILEID_EXEC 6
+#define ANTC_FILEID_DIR 1
+#define ANTC_FILEID_REGULAR 2
+#define ANTC_FILEID_SYMLINK 4
+#define ANTC_EXECIMG_HEADER 40
+#define ANTC_EXECIMG_PATH_MAX 512
+#define ANTC_EXECIMG_INTERPRETER 1
+#define ANTC_EXECIMG_INTERP_TRUNCATED 2
+#define ANTC_EXECIMG_PATH_TRUNCATED 4
 #define ANTC_CREDS_SIZE 96
 #define ANTC_CRED_START 1
 #define ANTC_CRED_SETUID 2
diff --git a/kernel/antinomie/fileid.c b/kernel/antinomie/fileid.c
new file mode 100644
index 000000000..0b5a906fb
--- /dev/null
+++ b/kernel/antinomie/fileid.c
@@ -0,0 +1,110 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Identity of the files a traced call acted on.
+ *
+ * A path is a name: the same file has several (hard links, renames) and the
+ * same name can mean different files over time. The records here carry the
+ * device and inode of the file itself, so the host can follow one file through
+ * its names and tell a recycled name from the file it replaced. They are
+ * additive: a call that succeeded publishes one, in its own traced call, and
+ * an io_uring request attaches it to itself as an operand.
+ */
+#include <linux/antinomie_monitor.h>
+#include <linux/dcache.h>
+#include <linux/err.h>
+#include <linux/fs.h>
+#include <linux/kdev_t.h>
+#include <linux/sched.h>
+#include <linux/slab.h>
+#include <linux/stat.h>
+#include <linux/string.h>
+#include <linux/unaligned.h>
+
+#include "control_wire.h"
+#include "fileid.h"
+#include "notes.h"
+
+static_assert(ANT_FILE_ID_OPEN == ANTC_FILEID_OPEN && ANT_FILE_ID_RENAME == ANTC_FILEID_RENAME &&
+	      ANT_FILE_ID_LINK == ANTC_FILEID_LINK && ANT_FILE_ID_UNLINK == ANTC_FILEID_UNLINK &&
+	      ANT_FILE_ID_ISSUE == ANTC_FILEID_ISSUE);
+
+void ant_fileid_pack(u8 *rec, u8 kind, struct inode *inode, int nlink_delta)
+{
+	umode_t mode = inode->i_mode;
+	int nlink = (int)inode->i_nlink + nlink_delta;
+
+	memset(rec, 0, ANTC_FILEID_SIZE);
+	rec[0] = kind;
+	rec[1] = (S_ISDIR(mode) ? ANTC_FILEID_DIR : 0) |
+		 (S_ISREG(mode) ? ANTC_FILEID_REGULAR : 0) |
+		 (S_ISLNK(mode) ? ANTC_FILEID_SYMLINK : 0);
+	put_unaligned_le32(max(nlink, 0), rec + 4);
+	put_unaligned_le64(new_encode_dev(inode->i_sb->s_dev), rec + 8);
+	put_unaligned_le64(inode->i_ino, rec + 16);
+	put_unaligned_le32(inode->i_generation, rec + 24);
+	put_unaligned_le32(mode, rec + 28);
+}
+
+/* Publish the identity of @inode in the calling task's traced call. */
+void ant_monitor_file_id(u8 kind, struct inode *inode)
+{
+	u8 rec[ANTC_FILEID_SIZE];
+
+	if (!inode)
+		return;
+	ant_fileid_pack(rec, kind, inode, 0);
+	ant_monitor_note(ANT_FILEID_KEY, ANT_FILEID_LAYOUT, rec, sizeof(rec));
+}
+
+/* The image an execve loaded, and the interpreter a script named. Called at
+ * the commit point, where the old image is gone and the call is still ours.
+ */
+void ant_monitor_exec_image(struct file *file, const char *interp)
+{
+	struct inode *inode = file_inode(file);
+	u8 *rec, *at;
+	char *path;
+	size_t interp_len = 0, path_len = 0;
+	u32 flags = 0;
+
+	if (!current->ant_monitor)
+		return;
+	rec = kzalloc(ANTC_EXECIMG_HEADER + 2 * ANTC_EXECIMG_PATH_MAX, GFP_KERNEL);
+	path = kmalloc(ANTC_EXECIMG_PATH_MAX, GFP_KERNEL);
+	if (!rec || !path)
+		goto out;
+	at = rec + ANTC_EXECIMG_HEADER;
+	if (interp) {
+		flags |= ANTC_EXECIMG_INTERPRETER;
+		interp_len = strnlen(interp, ANTC_EXECIMG_PATH_MAX);
+		if (interp_len == ANTC_EXECIMG_PATH_MAX) {
+			interp_len--;
+			flags |= ANTC_EXECIMG_INTERP_TRUNCATED;
+		}
+		memcpy(at, interp, interp_len);
+		at[interp_len++] = 0;
+		at += interp_len;
+	}
+	{
+		char *name = d_path(&file->f_path, path, ANTC_EXECIMG_PATH_MAX);
+
+		if (IS_ERR(name)) {
+			flags |= ANTC_EXECIMG_PATH_TRUNCATED;
+		} else {
+			path_len = strlen(name) + 1;
+			memcpy(at, name, path_len);
+		}
+	}
+	put_unaligned_le32(flags, rec);
+	put_unaligned_le32(interp_len, rec + 4);
+	put_unaligned_le32(path_len, rec + 8);
+	put_unaligned_le32(inode->i_nlink, rec + 12);
+	put_unaligned_le64(new_encode_dev(inode->i_sb->s_dev), rec + 16);
+	put_unaligned_le64(inode->i_ino, rec + 24);
+	put_unaligned_le32(inode->i_generation, rec + 32);
+	put_unaligned_le32(inode->i_mode, rec + 36);
+	ant_monitor_note("lifecycle.exec_image", "antinomie.execimg/1", rec,
+			 ANTC_EXECIMG_HEADER + interp_len + path_len);
+out:
+	kfree(path);
+	kfree(rec);
+}
