+DECLARE_STATIC_KEY_FALSE(ant_dbg_shadow_key);
+void ant_dbg_shadow_read(struct mm_struct *mm, unsigned long addr, void *buf, int len);
+/* Reads of a debugged process's own memory never reveal an engine breakpoint. */
+static inline void ant_monitor_shadow_read(struct mm_struct *mm, unsigned long addr,
+					   void *buf, int len)
+{
+	if (static_branch_unlikely(&ant_dbg_shadow_key))
+		ant_dbg_shadow_read(mm, addr, buf, len);
+}
+bool ant_dbg_wants_signals(struct task_struct *task);
+bool ant_dbg_syscall_step(struct pt_regs *regs);
+void ant_dbg_fork(struct task_struct *child, u64 clone_flags);
+void ant_dbg_exec(void);
+/* A stepped system call returns: the step ends here (taken before the single-step
+ * report of ptrace, which a debugged program never sees).
+ */
+static inline bool ant_monitor_syscall_step(struct pt_regs *regs)
+{
+	if (static_branch_unlikely(&ant_dbg_shadow_key))
+		return ant_dbg_syscall_step(regs);
+	return false;
+}
+/* A task of a debugged program is created: a new thread gets its debug
+ * registers, a new process may be followed (before the child runs).
+ */
+static inline void ant_monitor_debug_fork(struct task_struct *child, u64 clone_flags)
+{
+	if (static_branch_unlikely(&ant_dbg_shadow_key))
+		ant_dbg_fork(child, clone_flags);
+}
+/* The program executed a new image. */
+static inline void ant_monitor_debug_exec(void)
+{
+	if (static_branch_unlikely(&ant_dbg_shadow_key))
+		ant_dbg_exec();
+}
+int ant_dbg_signal(int signr, struct kernel_siginfo *info, enum pid_type type);
+void ant_dbg_signal_delivered(void);
+/* A signal about to be delivered to a debugged thread stops the group first.
+ * Called with the signal lock held; returns the signal to deliver, 0 to drop it.
+ */
+static inline int ant_monitor_signal(int signr, struct kernel_siginfo *info,
+				     enum pid_type type)
+{
+	if (static_branch_unlikely(&ant_dbg_shadow_key))
+		return ant_dbg_signal(signr, info, type);
+	return signr;
+}
+/* A signal that would end the whole group at once (its default action) is queued
+ * instead, so the debugger sees it before it takes effect, as with a tracer.
+ */
+static inline bool ant_monitor_debugged(struct task_struct *task)
+{
+	return static_branch_unlikely(&ant_dbg_shadow_key) && ant_dbg_wants_signals(task);
+}
+static inline void ant_monitor_signal_delivered(void)
+{
+	if (static_branch_unlikely(&ant_dbg_shadow_key))
+		ant_dbg_signal_delivered();
+}
 void ant_monitor_enter(struct pt_regs *regs, long nr);
 void ant_monitor_exit(struct pt_regs *regs);
 void ant_monitor_fork(struct task_struct *child);
@@ -112,6 +174,18 @@ void ant_monitor_aio_ctx_free(const void *ioctx);
 void ant_monitor_operand(u8 arg, const char *key, const char *layout, const void *data,
 			 size_t size);
 #else
+static inline void ant_monitor_shadow_read(struct mm_struct *mm, unsigned long addr,
+					   void *buf, int len) {}
+static inline int ant_monitor_signal(int signr, struct kernel_siginfo *info,
+				     enum pid_type type)
+{
+	return signr;
+}
+static inline bool ant_monitor_debugged(struct task_struct *task) { return false; }
+static inline void ant_monitor_signal_delivered(void) {}
+static inline bool ant_monitor_syscall_step(struct pt_regs *regs) { return false; }
+static inline void ant_monitor_debug_fork(struct task_struct *child, u64 clone_flags) {}
+static inline void ant_monitor_debug_exec(void) {}
 static inline void ant_monitor_enter(struct pt_regs *regs, long nr) {}
 static inline void ant_monitor_exit(struct pt_regs *regs) {}
 static inline void ant_monitor_fork(struct task_struct *child) {}
