 		break;
 	case SECCOMP_SET_MODE_FILTER:
-		if (output)
-			return;
-		status = copy_from_user_nofault(&program, (void __user *)(unsigned long)args[2],
-						sizeof(program)) ?
-			ANT_COPY_FAULT : ANT_COMPLETE;
-		ant_capture_field(ctx, 2, "arg2.program", LAYOUT("sock_fprog"), 3,
-				  args[2], &program, sizeof(program), sizeof(program), status);
-		if (status == ANT_COMPLETE && !ant_capture_lost(ctx)) {
-			size = (u64)program.len * sizeof(struct sock_filter);
-			ant_capture_field(ctx, 2, "arg2.program.filter", LAYOUT("sock_filter[]"), 3,
-					  (unsigned long)program.filter, NULL, size, size,
-					  program.len && program.len <= BPF_MAXINSNS ?
-					  ANT_COMPLETE : ANT_INVALID_EXTENT);
-		}
+		if (!output)
+			capture_fprog(ctx, 2, args[2], sizeof(struct sock_fprog), "arg2.program");
 		break;
 	case SECCOMP_GET_ACTION_AVAIL:
 		if (!output)
