+static const struct ant_sockopt_rule *sockopt_rule(s32 level, s32 name)
+{
+	unsigned int index;
+
+	for (index = 0; index < ARRAY_SIZE(sockopt_rules); index++)
+		if (sockopt_rules[index].level == level && sockopt_rules[index].name == name)
+			return &sockopt_rules[index];
+	return NULL;
+}
+
+/* netfilter table replacement and queries carry nested counter pointers and
+ * variable entry blobs. The IP handlers pass only options they do not know to
+ * netfilter (IPV6_RECVTCLASS and IPV6_TCLASS share this range), so this applies
+ * only when no rule matched.
+ */
+static bool sockopt_netfilter(const struct ant_sockopt_rule *rule, s32 level, s32 name)
+{
+	return !rule && (level == IPPROTO_IP || level == IPPROTO_IPV6) &&
+		name >= ANT_IPT_SO_BASE && name <= ANT_IPT_SO_LAST;
+}
+
+static void sockopt_raw(struct ant_task *ctx, const char *key, const char *layout,
+			u64 address, s32 length, u64 ceiling)
+{
+	ant_capture_field(ctx, 3, key, layout, 1, address, NULL,
+			  min_t(u64, length, ceiling), length,
+			  length > ceiling ? ANT_INVALID_EXTENT : ANT_COMPLETE);
+}
+
+static void capture_setsockopt(struct ant_task *ctx, const u64 args[6])
+{
+	const struct ant_sockopt_rule *rule = sockopt_rule(args[1], args[2]);
+	s32 length = args[4];
+	u64 address = args[3];
+	enum ant_status status;
+	u64 size;
+
+	if (length < 0)
+		return;
+	if (sockopt_netfilter(rule, args[1], args[2])) {
+		sockopt_raw(ctx, "arg3.optval", LAYOUT("ipt_replace"), address, length,
+			    ANT_SOCKOPT_CEILING);
+		capture_gap(ctx, "sockopt.unsupported_nested", ANT_NO_DECODER);
+		return;
+	}
+	switch (rule ? rule->set : ANT_SET_UNKNOWN) {
+	case ANT_SET_INT:
+	case ANT_SET_INT_OR_BYTE:
+		if (rule->set == ANT_SET_INT_OR_BYTE && length && length < sizeof(int)) {
+			ant_capture_field(ctx, 3, "arg3.optval", rule->alt_layout, 3, address,
+					  NULL, 1, length, ANT_COMPLETE);
+			return;
+		}
+		fallthrough;
+	case ANT_SET_FIXED:
+		size = min_t(u64, length, rule->size);
+		status = length >= rule->size ? ANT_COMPLETE : ANT_INVALID_EXTENT;
+		ant_capture_field(ctx, 3, "arg3.optval", rule->layout, 3, address, NULL,
+				  size, length, status);
+		return;
+	case ANT_SET_BY_LENGTH:
+		if (length >= rule->size)
+			ant_capture_field(ctx, 3, "arg3.optval", rule->layout, 3, address,
+					  NULL, rule->size, length, ANT_COMPLETE);
+		else
+			ant_capture_field(ctx, 3, "arg3.optval", rule->alt_layout, 3, address,
+					  NULL, min_t(u64, length, rule->alt_size), length,
+					  length >= rule->alt_size ? ANT_COMPLETE :
+					  ANT_INVALID_EXTENT);
+		return;
+	case ANT_SET_BYTES:
+		/* The kernel copies at most this many bytes and terminates them itself. */
+		ant_capture_field(ctx, 3, "arg3.optval", rule->layout, 1, address, NULL,
+				  min_t(u64, length, rule->size), length, ANT_COMPLETE);
+		return;
+	case ANT_SET_FPROG:
+		capture_fprog(ctx, 3, address, length, "arg3.optval");
+		return;
+	case ANT_SET_LABELED:
+		sockopt_raw(ctx, "arg3.optval", rule->layout, address, length, rule->size);
+		return;
+	case ANT_SET_NESTED:
+		sockopt_raw(ctx, "arg3.optval", rule->layout, address, length,
+			    ANT_SOCKOPT_CEILING);
+		capture_gap(ctx, "sockopt.unsupported_nested", ANT_NO_DECODER);
+		return;
+	default:
+		sockopt_raw(ctx, "arg3.optval", "", address, length, ANT_SOCKOPT_CEILING);
+		capture_gap(ctx, "sockopt.unknown_option", ANT_NO_DECODER);
+	}
+}
+
+static void capture_getsockopt(struct ant_task *ctx, const u64 args[6],
+			       bool output, long result)
+{
+	const struct ant_sockopt_rule *rule = sockopt_rule(args[1], args[2]);
+	u8 get = rule ? rule->get : ANT_GET_UNKNOWN;
+	struct ant_sockopt_state *state;
+	enum ant_status status;
+	const char *layout;
+	s32 length;
+	u64 size, ceiling;
+
+	if (sockopt_netfilter(rule, args[1], args[2]))
+		get = ANT_GET_INPUT_NESTED;
+	status = copy_from_user_nofault(&length, (void __user *)(unsigned long)args[4],
+					sizeof(length)) ? ANT_COPY_FAULT : ANT_COMPLETE;
+	if (output && result)
+		return;
+	ant_capture_field(ctx, 4, "arg4.optlen", LAYOUT("int"), 3, args[4], &length,
+			  sizeof(length), sizeof(length), status);
+	if (!output) {
+		if (get == ANT_GET_UNKNOWN)
+			capture_gap(ctx, "sockopt.unknown_option", ANT_NO_DECODER);
+		if (status != ANT_COMPLETE || ant_capture_lost(ctx))
+			return;
+		if (get == ANT_GET_INPUT_NESTED && length > 0) {
+			sockopt_raw(ctx, "arg3.optval_in", rule ? rule->layout : "",
+				    args[3], length, ANT_SOCKOPT_CEILING);
+			capture_gap(ctx, "sockopt.unsupported_nested", ANT_NO_DECODER);
+		}
+		state = kzalloc(sizeof(*state), GFP_NOWAIT);
+		if (!state)
+			return;
+		state->capacity = length;
+		ant_capture_set_state(ctx, state, release_allocation);
+		return;
+	}
+	if (ant_capture_lost(ctx))
+		return;
+	state = ant_capture_state(ctx);
+	if (!state || status != ANT_COMPLETE) {
+		ant_capture_field(ctx, 3, "arg3.optval", "", 1, args[3], NULL,
+				  U64_MAX, U64_MAX, ANT_CONTEXT_MISSING);
+		return;
+	}
+	layout = rule ? rule->layout : "";
+	ceiling = ANT_SOCKOPT_CEILING;
+	switch (get) {
+	case ANT_GET_INT_OR_BYTE:
+		if (length < sizeof(int))
+			layout = rule->alt_layout;
+		fallthrough;
+	case ANT_GET_INT:
+	case ANT_GET_FIXED:
+		ceiling = rule->size;
+		break;
+	case ANT_GET_FILTER_COUNT:
+		/* SO_GET_FILTER counts instructions, not bytes, in optlen. */
+		if (length < 0 || length > BPF_MAXINSNS)
+			length = -1;
+		else
+			length *= sizeof(struct sock_filter);
+		ceiling = BPF_MAXINSNS * sizeof(struct sock_filter);
+		break;
+	case ANT_GET_UNKNOWN:
+		layout = "";
+		break;
+	}
+	if (length < 0 || (get != ANT_GET_FILTER_COUNT && length > state->capacity)) {
+		ant_capture_field(ctx, 3, "arg3.optval", layout, 1, args[3], NULL,
+				  U64_MAX, length, ANT_INVALID_EXTENT);
+		return;
+	}
+	size = min_t(u64, length, ceiling);
+	ant_capture_field(ctx, 3, "arg3.optval", layout, 1, args[3], NULL, size, length,
+			  length > ceiling ? ANT_INVALID_EXTENT : ANT_COMPLETE);
+}
