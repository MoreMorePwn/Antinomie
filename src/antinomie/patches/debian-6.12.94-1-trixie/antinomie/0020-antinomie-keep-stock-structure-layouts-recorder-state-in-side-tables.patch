+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _ANTINOMIE_STATE_H
+#define _ANTINOMIE_STATE_H
+
+#include <linux/atomic.h>
+#include <linux/sched.h>
+#include <linux/types.h>
+
+struct ant_task;
+struct ant_run;
+struct ant_coredump_live;
+
+/* What the recorder keeps per task. It lives in the task's security blob
+ * (task->security), at an offset reserved after every LSM's own part when the
+ * LSMs are set up (ant_task_state_reserve()), never in struct task_struct, so
+ * that structure keeps Debian's layout and module ABI. The blob is allocated
+ * zeroed with the task (security_task_alloc(), after dup_task_struct() copied
+ * the parent) and freed after ant_monitor_release() (security_task_free()), so
+ * a task never sees its parent's state, and a pointer to a task that is still
+ * referenced reaches valid state.
+ */
+struct ant_task_state {
+	u64 cookie;
+	u64 root_cookie;
+	u64 observer_cookie;
+	struct ant_task *monitor;
+	struct ant_run *run;
+	/* The io_uring request whose operation this worker is running: the
+	 * file identity the operation publishes is that request's operand.
+	 */
+	const void *async_target;
+	/* The process core this task is writing (ant_coredump_attach()). */
+	struct ant_coredump_live *coredump_live;
+	unsigned long coredump_deadline;
+	atomic64_t event_seq;
+	atomic64_t packet_seq;
+	bool root_process;
+	bool counted;
+};
+
+extern int ant_task_state_offset;
+
+/* The recorder's state of a task between security_task_alloc() and
+ * security_task_free(): every task the recorder can see.
+ */
+static __always_inline struct ant_task_state *ant_state(const struct task_struct *task)
+{
+	return (struct ant_task_state *)((char *)task->security + ant_task_state_offset);
+}
+
+#endif
