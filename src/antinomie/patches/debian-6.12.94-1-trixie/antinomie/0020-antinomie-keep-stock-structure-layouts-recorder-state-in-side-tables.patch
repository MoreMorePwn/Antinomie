diff --git a/kernel/antinomie/state.c b/kernel/antinomie/state.c
new file mode 100644
index 0000000..ffd81c2
--- /dev/null
+++ b/kernel/antinomie/state.c
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* The recorder's per-task state, outside struct task_struct (state.h). */
+#include <linux/antinomie_monitor.h>
+#include <linux/coredump.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+
+#include "state.h"
+
+int ant_task_state_offset __ro_after_init;
+
+/* Called once with the task blob size the LSMs need (security.c's
+ * blob_sizes.lbs_task, after every LSM took its part): the recorder's state
+ * goes after them, aligned as lsm_set_blob_size() aligns theirs. Nothing
+ * registers an LSM, so /sys/kernel/security/lsm, lsm_list_modules() and the
+ * boot log list Debian's set and order.
+ */
+void __init ant_task_state_reserve(int *task_blob_size)
+{
+	ant_task_state_offset = ALIGN(*task_blob_size, sizeof(void *));
+	*task_blob_size = ant_task_state_offset + sizeof(struct ant_task_state);
+}
+
+/* The file identity an io_uring worker's operation publishes belongs to this
+ * request (NULL: none). io_uring/fs.c brackets the operation with it.
+ */
+void ant_monitor_async_target(const void *request)
+{
+	ant_state(current)->async_target = request;
+}
+
+/* A process core the recorder asks for is written by the calling task, in one
+ * call of the ELF writer (fs/coredump.c): while it runs, the writer finds the
+ * recorder's part of it as the task's dump. A core Linux writes for a signal
+ * has none.
+ */
+void ant_coredump_attach(struct ant_coredump_live *live, unsigned long deadline)
+{
+	struct ant_task_state *state = ant_state(current);
+
+	state->coredump_live = live;
+	state->coredump_deadline = deadline;
+}
+
+struct ant_coredump_live *ant_coredump_live(void)
+{
+	return ant_state(current)->coredump_live;
+}
+
+unsigned long ant_coredump_deadline(void)
+{
+	return ant_state(current)->coredump_deadline;
+}
