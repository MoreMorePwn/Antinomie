Description: antinomie: launch programs without leading their session
Author: MikiMiku <jonathanirvinjo@gmail.com>
Origin: project
Forwarded: no
Last-Update: 2026-10-12


---
diff --git a/kernel/antinomie/control.c b/kernel/antinomie/control.c
index 78a9d1bbf..e12954ca2 100644
--- a/kernel/antinomie/control.c
+++ b/kernel/antinomie/control.c
@@ -13,6 +13,7 @@
 #include <linux/pid.h>
 #include <linux/reboot.h>
 #include <linux/sched/signal.h>
+#include <linux/sched/task.h>
 #include <linux/sched/user.h>
 #include <linux/slab.h>
 #include <linux/syscalls.h>
@@ -223,6 +224,14 @@ static int launch_init(struct subprocess_info *info, struct cred *cred)
 		close_fd(fd);
 	if (error)
 		return error;
+	/* The terminal is now the session's controlling terminal. The program
+	 * keeps it, but does not lead the session, as under a terminal's shell:
+	 * a session leader's exit hangs up the foreground process group, which
+	 * would kill a child the program forked before that child could call
+	 * setsid() (a daemonizing program, most malware). */
+	write_lock_irq(&tasklist_lock);
+	current->signal->leader = 0;
+	write_unlock_irq(&tasklist_lock);
 	error = ant_monitor_launch(launch->path, launch->argv, launch->envp);
 	if (error)
 		return error;
