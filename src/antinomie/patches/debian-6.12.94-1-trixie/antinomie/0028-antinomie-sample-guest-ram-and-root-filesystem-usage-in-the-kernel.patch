+#define ANTC_RESOURCES_SIZE 96
+#define ANTC_RESOURCES_MEMORY_VALID 1
+#define ANTC_RESOURCES_FILESYSTEM_VALID 2
+#define ANTC_RESOURCES_REFRESHING 4
 #define ANTC_UPLOAD_OVERWRITE 1
