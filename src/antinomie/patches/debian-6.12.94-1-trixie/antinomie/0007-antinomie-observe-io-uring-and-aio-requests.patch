+	ctx = kzalloc(sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+	async_context(ctx, event);
+	if (event->descriptor_len) {
+		ctx->kernel_imported = true;
+		field(ctx, 255, "async.submission", event->system == ANT_ASYNC_IO_URING ?
+		      ANT_LAYOUT("io_uring_sqe") : ANT_LAYOUT("iocb"),
+		      3, 0, event->descriptor, event->descriptor_len,
+		      event->descriptor_len, ANT_COMPLETE);
