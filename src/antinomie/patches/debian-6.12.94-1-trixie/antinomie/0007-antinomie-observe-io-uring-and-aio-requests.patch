index 0000000..f9666e2
--- /dev/null
+++ b/kernel/antinomie/async.c
@@ -0,0 +1,911 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/antinomie_monitor.h>
+#include <linux/antinomie.h>
+#include <linux/atomic.h>
+#include <linux/cred.h>
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/jiffies.h>
+#include <linux/ktime.h>
+#include <linux/overflow.h>
+#include <linux/refcount.h>
+#include <linux/sched/mm.h>
+#include <linux/sched/task.h>
+#include <linux/sched/signal.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/uio.h>
+#include <linux/workqueue.h>
+#include <uapi/linux/io_uring.h>
+
+#include "abi.h"
+#include "async.h"
+#include "capture_api.h"
+#include "run.h"
+#include "observer.h"
+
+#define ANT_ASYNC_REQUEST_COUNT 256
+#define ANT_ASYNC_RECORD_COUNT 1024
+#define ANT_AIO_REAP_COUNT 64
+
+struct ant_async {
+	struct ant_async_event event;
+	struct ant_task *capture;
+	refcount_t refs;
+	atomic_t capture_busy;
+	u64 output_end;
+	bool payload_failed;
+	/* The reap table owns the missing output (contract 14.2). */
+	bool payload_deferred;
+};
+
+/* An AIO read whose completion could not read user memory. Its output is
+ * read when the submitting address space reaps the event (stage 7). The ring
+ * is writable by the process, so reaping is matched on the ring slot and
+ * result the kernel recorded at completion, never on event contents.
+ */
+struct ant_aio_reap {
+	struct ant_async_event event;
+	struct mm_struct *mm;
+	const void *ioctx;	/* compared only */
+	u64 buf, len;
+	/* A vectored read: the kernel's copy of its iovec array, owned here. */
+	struct iovec *iov;
+	unsigned long nr_segs;
+	s64 res;
+	unsigned int ring_slot;
+	bool completed, used;
+};
+
+struct ant_async_record {
+	struct ant_async_event event;
+	size_t packet_len;
+	u8 packet[144 + 4096];
+};
+
+static atomic_t request_count = ATOMIC_INIT(0);
+static atomic64_t request_ids = ATOMIC64_INIT(0);
+static struct ant_async_record records[ANT_ASYNC_RECORD_COUNT];
+static unsigned int record_head, record_tail, record_count;
+static DEFINE_SPINLOCK(record_lock);
+/* Slot publication/detachment and request metadata share this lock. Taking a
+ * reference while the slot is protected closes the final-completion race.
+ * Never acquire request_lock while holding record_lock.
+ */
+static DEFINE_SPINLOCK(request_lock);
+static void publish_records(struct work_struct *work);
+static DECLARE_WORK(publish_work, publish_records);
+static struct ant_aio_reap reaps[ANT_AIO_REAP_COUNT];
+static atomic_t reap_used = ATOMIC_INIT(0);
+/* Taken from interrupt completions too; request_lock may nest inside it and
+ * it nests inside the AIO completion_lock.
+ */
+static DEFINE_SPINLOCK(reap_lock);
+
+static void event_hold(const struct ant_async_event *event)
+{
+	get_task_struct(event->origin);
+	if (event->owner)
+		get_task_struct(event->owner);
+}
+
+static void event_release(const struct ant_async_event *event)
+{
+	if (event->owner)
+		put_task_struct(event->owner);
+	put_task_struct(event->origin);
+}
+
+/* How long a record waits for room in the staging queue: about what one
+ * send waits for room in its ring when the host asks senders to wait.
+ */
+#define ANT_ASYNC_STAGE_WAIT_MS 1000
+
+/* Take record_lock with room for one record. When the queue is full and the
+ * caller may sleep while the host asks senders to wait instead of dropping
+ * (never-drop mode), wait for the publisher to make room, as a send would
+ * wait for its ring; an interrupt completion or a caller holding a lock
+ * cannot, nor can anyone once the wait ran out. False, unlocked, when there
+ * is no room.
+ */
+static bool stage_lock(unsigned long *irqflags)
+{
+	unsigned long deadline = 0;
+
+	for (;;) {
+		spin_lock_irqsave(&record_lock, *irqflags);
+		if (record_count < ANT_ASYNC_RECORD_COUNT)
+			return true;
+		spin_unlock_irqrestore(&record_lock, *irqflags);
+		if (!in_task() || !preemptible() || rcu_preempt_depth() || !ant_send_waits())
+			return false;
+		if (!deadline)
+			deadline = jiffies + msecs_to_jiffies(ANT_ASYNC_STAGE_WAIT_MS);
+		else if (time_after(jiffies, deadline))
+			return false;
+		schedule_work(&publish_work);
+		usleep_range(100, 200);
+	}
+}
+
+static void stage_record(struct ant_async *request, u32 stage, s64 result,
+			 u64 flags, bool final)
+{
+	struct ant_async_event *event;
+	struct ant_async_event observed;
+	unsigned long irqflags;
+
+	spin_lock_irqsave(&request_lock, irqflags);
+	observed = request->event;
+	spin_unlock_irqrestore(&request_lock, irqflags);
+	/* The subsystem owns request until this hook returns. A queued record
+	 * takes a separate task reference and never retains the request pointer.
+	 */
+	if (!stage_lock(&irqflags)) {
+		ant_run_async_loss(request->event.root_cookie);
+		return;
+	}
+	records[record_tail].packet_len = 0;
+	event = &records[record_tail].event;
+	*event = observed;
+	event->stage = stage;
+	event->result = result;
+	event->flags |= flags;
+	event->final = final;
+	event->timestamp_ns = ktime_get_ns();
+	event->cpu = raw_smp_processor_id();
+	if (stage != 1)
+		event->descriptor_len = 0;
+	event_hold(event);
+	record_tail = (record_tail + 1) % ANT_ASYNC_RECORD_COUNT;
+	record_count++;
+	spin_unlock_irqrestore(&record_lock, irqflags);
+	schedule_work(&publish_work);
+}
+
+/* A burst of queued records is published by one worker on one CPU. Before
+ * each record it waits, up to ANT_ASYNC_PACE_MS, until that CPU's ring has
+ * room to spare, so the burst cannot crowd out the syscall events of tasks
+ * running there: half the ring when a full ring drops a send, an eighth when
+ * senders wait for room instead (never-drop mode), which is still room for a
+ * sender that cannot wait long (one in atomic context spins briefly). After
+ * the wait it publishes anyway; drops are counted. Half a ring in never-drop
+ * mode was too much: a busy guest's rings are always fuller than that, and at
+ * 10 ms a record the worker could not keep up with one io_uring submission of
+ * a few hundred requests.
+ */
+#define ANT_ASYNC_PACE_MS 10
+
+static void await_room(void)
+{
+	unsigned long deadline = jiffies + msecs_to_jiffies(ANT_ASYNC_PACE_MS);
+	u32 spare = ant_ring_size() / (ant_send_waits() ? 8 : 2);
+
+	while (ant_send_room() < spare && time_before(jiffies, deadline))
+		usleep_range(100, 200);
+}
+
+static void publish_records(struct work_struct *work)
+{
+	static struct ant_async_record record;
+	unsigned long irqflags;
+	int error;
+
+	for (;;) {
+		spin_lock_irqsave(&record_lock, irqflags);
+		if (!record_count) {
+			spin_unlock_irqrestore(&record_lock, irqflags);
+			return;
+		}
+		record = records[record_head];
+		record_head = (record_head + 1) % ANT_ASYNC_RECORD_COUNT;
+		record_count--;
+		spin_unlock_irqrestore(&record_lock, irqflags);
+		await_room();
+		if (record.packet_len) {
+			error = ant_send(record.packet, record.packet_len);
+			if (error)
+				ant_monitor_async_send_failed();
+		} else {
+			error = ant_monitor_async_publish(&record.event);
+		}
+		if (error)
+			ant_run_async_loss(record.event.root_cookie);
+		event_release(&record.event);
+		cond_resched();
+	}
+}
+
+int ant_async_stage_packet(const struct ant_async_event *event,
+			   const void *packet, size_t packet_len)
+{
+	struct ant_async_record *record;
+	unsigned long irqflags;
+
+	if (packet_len > sizeof(record->packet))
+		return -EMSGSIZE;
+	if (!stage_lock(&irqflags)) {
+		ant_run_async_loss(event->root_cookie);
+		return -ENOSPC;
+	}
+	record = &records[record_tail];
+	record->event = *event;
+	record->packet_len = packet_len;
+	memcpy(record->packet, packet, packet_len);
+	event_hold(event);
+	record_tail = (record_tail + 1) % ANT_ASYNC_RECORD_COUNT;
+	record_count++;
+	spin_unlock_irqrestore(&record_lock, irqflags);
+	schedule_work(&publish_work);
+	return 0;
+}
+
+static struct ant_async *begin(struct task_struct *owner, u64 root_cookie, u64 task_cookie,
+			       u64 capture_cookie,
+			       u8 system, u32 opcode, u64 user_data, u32 flags,
+			       const void *descriptor, size_t descriptor_len)
+{
+	const struct cred *cred = current_cred();
+	struct ant_async *request;
+	struct ant_async_event *event;
+
+	if (descriptor_len > sizeof(event->descriptor)) {
+		ant_run_async_incomplete(root_cookie);
+		return NULL;
+	}
+	if (!atomic_add_unless(&request_count, 1, ANT_ASYNC_REQUEST_COUNT)) {
+		ant_run_async_loss(root_cookie);
+		ant_run_async_incomplete(root_cookie);
+		return NULL;
+	}
+	request = kzalloc(sizeof(*request), GFP_NOWAIT);
+	if (!request) {
+		atomic_dec(&request_count);
+		ant_run_async_loss(root_cookie);
+		ant_run_async_incomplete(root_cookie);
+		return NULL;
+	}
+	event = &request->event;
+	refcount_set(&request->refs, 1);
+	atomic_set(&request->capture_busy, 0);
+	request->capture = ant_monitor_async_capture_alloc();
+	event->origin = current;
+	get_task_struct(current);
+	if (owner) {
+		event->owner = owner;
+		get_task_struct(owner);
+	}
+	event->mm = current->mm;
+	event->request_id = atomic64_inc_return(&request_ids);
+	/* An attributed request was not submitted by a call of its owner. */
+	event->parent_call_id = owner ? 0 : ant_monitor_parent_call_id();
+	event->entry_ns = ktime_get_ns();
+	event->cpu = raw_smp_processor_id();
+	event->root_cookie = root_cookie;
+	event->capture_cookie = capture_cookie;
+	event->task_cookie = task_cookie;
+	event->start_boot_ns = current->start_boottime;
+	event->pid = task_tgid_nr(current);
+	event->tid = task_pid_nr(current);
+	event->opcode = opcode;
+	event->user_data = user_data;
+	event->flags = flags;
+	event->system = system;
+	event->uid = from_kuid(&init_user_ns, cred->uid);
+	event->gid = from_kgid(&init_user_ns, cred->gid);
+	event->euid = from_kuid(&init_user_ns, cred->euid);
+	event->egid = from_kgid(&init_user_ns, cred->egid);
+	event->descriptor_len = descriptor_len;
+	memcpy(event->descriptor, descriptor, descriptor_len);
+	ant_run_async_start(event->root_cookie);
+	/* A writer that is not proven to be the submitting process. */
+	if (flags & ~(ANT_ASYNC_PAYLOAD_GAP | ANT_ASYNC_PRODUCER_PROCESS))
+		ant_run_async_incomplete(event->root_cookie);
+	stage_record(request, 1, 0, 0, false);
+	return request;
+}
+
+struct ant_async *ant_monitor_async_begin(u8 system, u32 opcode, u64 user_data,
+					  u32 flags, const void *descriptor, size_t descriptor_len)
+{
+	u64 capture_cookie = ant_observer_admit(current);
+
+	if (!READ_ONCE(current->ant_root_cookie) && !capture_cookie)
+		return NULL;
+	return begin(NULL, READ_ONCE(current->ant_root_cookie), ant_monitor_cookie(current),
+		     capture_cookie, system, opcode,
+		     user_data, flags, descriptor, descriptor_len);
+}
+
+/* Contract 14.3: the submitting task is not the ring's producer of record. */
+struct ant_async *ant_monitor_async_begin_attributed(struct task_struct *owner,
+						     u64 root_cookie, u64 task_cookie,
+						     u8 system, u32 opcode, u64 user_data,
+						     u32 flags, const void *descriptor,
+						     size_t descriptor_len)
+{
+	u64 capture_cookie = ant_observer_admit(owner);
+
+	if (!root_cookie && !capture_cookie)
+		return NULL;
+	return begin(owner, root_cookie, task_cookie ?: ant_monitor_cookie(owner),
+		     capture_cookie, system, opcode, user_data,
+		     flags | ANT_ASYNC_PRODUCER_UNKNOWN, descriptor, descriptor_len);
+}
+
+static struct ant_async *get_request(struct ant_async **slot, bool final)
+{
+	struct ant_async *request;
+	unsigned long irqflags;
+
+	spin_lock_irqsave(&request_lock, irqflags);
+	request = *slot;
+	if (request) {
+		if (final)
+			*slot = NULL;
+		else
+			refcount_inc(&request->refs);
+	}
+	spin_unlock_irqrestore(&request_lock, irqflags);
+	return request;
+}
+
+static void put_request(struct ant_async *request)
+{
+	if (!refcount_dec_and_test(&request->refs))
+		return;
+	event_release(&request->event);
+	ant_monitor_async_capture_free(request->capture);
+	kfree(request);
+	atomic_dec(&request_count);
+}
+
+static void finish_request(struct ant_async *request)
+{
+	unsigned long irqflags;
+	bool payload_missing;
+
+	spin_lock_irqsave(&request_lock, irqflags);
+	payload_missing = (request->event.flags & ANT_ASYNC_PAYLOAD_GAP) &&
+		!request->payload_failed && !request->payload_deferred;
+	spin_unlock_irqrestore(&request_lock, irqflags);
+	if (payload_missing)
+		ant_run_async_loss(request->event.root_cookie);
+	ant_run_async_finish(request->event.root_cookie);
+	put_request(request);
+}
+
+bool ant_async_iter_covers_payload(const struct ant_async_event *event)
+{
+	const struct io_uring_sqe *sqe = (const void *)event->descriptor;
+
+	if (event->system == ANT_ASYNC_AIO)
+		return true;
+	switch (event->opcode) {
+	case IORING_OP_READV: case IORING_OP_WRITEV:
+	case IORING_OP_READ_FIXED: case IORING_OP_WRITE_FIXED:
+	case IORING_OP_READ: case IORING_OP_WRITE:
+	case IORING_OP_RECV:
+		return true;
+	case IORING_OP_SEND: case IORING_OP_SEND_ZC:
+		return !sqe->addr2;
+	default:
+		/* An iterator does not include msg_name, msg_control or other
+		 * opcode-specific nested operands. Keep their gap explicit.
+		 */
+		return false;
+	}
+}
+
+static bool rw_output(const struct ant_async_event *event)
+{
+	if (event->system == ANT_ASYNC_AIO)
+		return true;
+	return event->opcode == IORING_OP_READ || event->opcode == IORING_OP_READV ||
+		event->opcode == IORING_OP_READ_FIXED;
+}
+
+void ant_monitor_async_iter(struct ant_async **slot,
+			    const struct iov_iter *iter, size_t size,
+			    u64 result_offset, bool output)
+{
+	struct ant_async *request = get_request(slot, false);
+	struct ant_async_event event;
+	unsigned long irqflags;
+	u64 output_end = 0;
+	bool acquired, failed, gap = false;
+
+	if (!request)
+		return;
+	spin_lock_irqsave(&request_lock, irqflags);
+	event = request->event;
+	if (output && rw_output(&event)) {
+		/* A successful tail cannot establish observation of a missing prefix. */
+		gap = result_offset > request->output_end ||
+			check_add_overflow(result_offset, (u64)size, &output_end);
+		if (gap) {
+			request->event.flags |= ANT_ASYNC_PAYLOAD_GAP;
+			request->payload_failed = true;
+			event.flags |= ANT_ASYNC_PAYLOAD_GAP;
+		}
+	}
+	spin_unlock_irqrestore(&request_lock, irqflags);
+	acquired = !atomic_cmpxchg(&request->capture_busy, 0, 1);
+	if (!acquired) {
+		failed = true;
+	} else {
+		failed = !request->capture || ant_monitor_async_capture(request->capture,
+				&event, iter, size, result_offset, output);
+	}
+	spin_lock_irqsave(&request_lock, irqflags);
+	if (!failed && output && rw_output(&event) && !gap)
+		request->output_end = max(request->output_end, output_end);
+	if (failed) {
+		request->event.flags |= ANT_ASYNC_PAYLOAD_GAP;
+		request->payload_failed = true;
+	} else if (!request->payload_failed && ant_async_iter_covers_payload(&event)) {
+		request->event.flags &= ~ANT_ASYNC_PAYLOAD_GAP;
+	}
+	spin_unlock_irqrestore(&request_lock, irqflags);
+	if (acquired)
+		atomic_set_release(&request->capture_busy, 0);
+	if (failed || gap)
+		ant_run_async_loss(request->event.root_cookie);
+	put_request(request);
+}
+
+void ant_monitor_async_memory(struct ant_async **slot, const char *key,
+			      const char *layout, u16 encoding, u64 address,
+			      const void *snapshot, u64 size, bool output, bool complete)
+{
+	struct ant_async *request = get_request(slot, false);
+	struct ant_async_event event;
+	unsigned long irqflags;
+	bool failed;
+
+	if (!request)
+		return;
+	spin_lock_irqsave(&request_lock, irqflags);
+	event = request->event;
+	spin_unlock_irqrestore(&request_lock, irqflags);
+	if (atomic_cmpxchg(&request->capture_busy, 0, 1)) {
+		failed = true;
+	} else {
+		failed = !request->capture || ant_monitor_async_capture_memory(request->capture,
+				&event, key, layout, encoding, address, snapshot, size,
+				output ? 4 : 1, -1);
+		atomic_set_release(&request->capture_busy, 0);
+	}
+	spin_lock_irqsave(&request_lock, irqflags);
+	if (failed) {
+		request->event.flags |= ANT_ASYNC_PAYLOAD_GAP;
+		request->payload_failed = true;
+	} else if (complete && !request->payload_failed) {
+		request->event.flags &= ~ANT_ASYNC_PAYLOAD_GAP;
+	}
+	spin_unlock_irqrestore(&request_lock, irqflags);
+	if (failed)
+		ant_run_async_loss(request->event.root_cookie);
+	put_request(request);
+}
+
+/* A request that ends with an error moved no data: whatever payload it
+ * would have had was never transferred, so there is nothing left to observe.
+ * Its final record carries no payload gap and finishing it counts no loss.
+ * A capture that had already failed keeps its gap (and was counted then).
+ */
+static void failed_without_payload(struct ant_async *request, s64 result)
+{
+	unsigned long irqflags;
+
+	if (result >= 0)
+		return;
+	spin_lock_irqsave(&request_lock, irqflags);
+	if (!request->payload_failed)
+		request->event.flags &= ~ANT_ASYNC_PAYLOAD_GAP;
+	spin_unlock_irqrestore(&request_lock, irqflags);
+}
+
+void ant_monitor_async_accepted(struct ant_async **slot, int result)
+{
+	struct ant_async *request = get_request(slot, result < 0);
+
+	if (!request)
+		return;
+	if (result < 0) {
+		failed_without_payload(request, result);
+		stage_record(request, 3, result, 0, true);
+		finish_request(request);
+	} else {
+		stage_record(request, 2, result, 0, false);
+		put_request(request);
+	}
+}
+
+void ant_monitor_async_complete(struct ant_async **slot, s64 result,
+				u32 flags, bool final)
+{
+	struct ant_async *request = get_request(slot, final);
+
+	if (!request)
+		return;
+	if (final)
+		failed_without_payload(request, result);
+	stage_record(request, result == -ECANCELED ? 5 : 4, result,
+		     (u64)flags << 32, final);
+	if (final)
+		finish_request(request);
+	else
+		put_request(request);
+}
+
+void ant_monitor_async_abandon(struct ant_async **slot)
+{
+	struct ant_async *request = get_request(slot, true);
+
+	if (!request)
+		return;
+	ant_run_async_incomplete(request->event.root_cookie);
+	stage_record(request, 6, -ENODATA, ANT_ASYNC_ABANDONED, true);
+	finish_request(request);
+}
+
+void ant_monitor_async_link_completion(struct ant_async **source,
+				       struct ant_async **target, s64 result, u32 flags)
+{
+	struct ant_async *request = get_request(source, false);
+	unsigned long irqflags;
+	bool transferred = false;
+
+	if (!request)
+		return;
+	stage_record(request, result == -ECANCELED ? 5 : 4, result,
+		     (u64)flags << 32, false);
+	/* Both subsystem objects remain owned by the caller. Transfer the slot
+	 * reference, not the origin identity or an additional pending request.
+	 */
+	spin_lock_irqsave(&request_lock, irqflags);
+	if (*source == request && !*target) {
+		*target = request;
+		*source = NULL;
+		transferred = true;
+	}
+	spin_unlock_irqrestore(&request_lock, irqflags);
+	if (!transferred)
+		ant_run_async_incomplete(request->event.root_cookie);
+	put_request(request);
+}
+
+void ant_monitor_async_unavailable(void)
+{
+	if (READ_ONCE(current->ant_root_cookie))
+		ant_run_async_incomplete(current->ant_root_cookie);
+}
+
+/* The request has no payload beyond its scalar submission (contract 14.4). */
+void ant_monitor_async_scalar(struct ant_async **slot)
+{
+	struct ant_async *request = get_request(slot, false);
+	unsigned long irqflags;
+
+	if (!request)
+		return;
+	spin_lock_irqsave(&request_lock, irqflags);
+	if (!request->payload_failed)
+		request->event.flags &= ~ANT_ASYNC_PAYLOAD_GAP;
+	spin_unlock_irqrestore(&request_lock, irqflags);
+	put_request(request);
+}
+
+static void status_field(struct ant_async **slot, const char *key, const char *layout,
+			 u64 address, u64 size, bool output, int status, bool complete)
+{
+	struct ant_async *request = get_request(slot, false);
+	struct ant_async_event event;
+	unsigned long irqflags;
+	bool failed;
+
+	if (!request)
+		return;
+	spin_lock_irqsave(&request_lock, irqflags);
+	event = request->event;
+	spin_unlock_irqrestore(&request_lock, irqflags);
+	if (atomic_cmpxchg(&request->capture_busy, 0, 1)) {
+		failed = true;
+	} else {
+		failed = !request->capture || ant_monitor_async_capture_memory(request->capture,
+				&event, key, layout, 3, address, NULL, size,
+				output ? 4 : 1, status);
+		atomic_set_release(&request->capture_busy, 0);
+	}
+	spin_lock_irqsave(&request_lock, irqflags);
+	if (failed) {
+		request->event.flags |= ANT_ASYNC_PAYLOAD_GAP;
+		request->payload_failed = true;
+	} else if (complete && !request->payload_failed) {
+		request->event.flags &= ~ANT_ASYNC_PAYLOAD_GAP;
+	}
+	spin_unlock_irqrestore(&request_lock, irqflags);
+	if (failed)
+		ant_run_async_loss(request->event.root_cookie);
+	put_request(request);
+}
+
+/* Memory the kernel compares, wakes or hands out later: its address and
+ * extent are the operand, its bytes are not.
+ */
+void ant_monitor_async_address(struct ant_async **slot, const char *key,
+			       const char *layout, u64 address, u64 size)
+{
+	status_field(slot, key, layout, address, size, false, ANT_ADDRESS_ONLY, true);
+}
+
+/* An operand whose extent is beyond the recorder's ceiling: its declared size
+ * is recorded with no bytes, and the payload gap stays set.
+ */
+void ant_monitor_async_extent(struct ant_async **slot, const char *key, const char *layout,
+			      u64 address, u64 size)
+{
+	status_field(slot, key, layout, address, size, false, ANT_INVALID_EXTENT, false);
+}
+
+/* An operand without a decoder. The request's payload gap stays set. */
+void ant_monitor_async_gap(struct ant_async **slot, const char *key, u64 address)
+{
+	status_field(slot, key, "", address, U64_MAX, false, ANT_NO_DECODER, false);
+}
+
+/* Register an AIO read before it is started, so an interrupt completion that
+ * races with read_iter() cannot count the missing output before it is owned.
+ */
+u64 ant_monitor_aio_defer(struct ant_async **slot, const void *ioctx,
+			  const struct iov_iter *iter)
+{
+	struct ant_async *request;
+	struct ant_aio_reap *entry = NULL;
+	struct iovec *iov = NULL;
+	unsigned long irqflags, reapflags, nr_segs = 0;
+	u64 buf = 0, request_id = 0;
+	int i;
+
+	/* PREAD imports a single user buffer. PREADV with more than one
+	 * segment keeps the iovec array the kernel imported, so the reap reads
+	 * exactly the buffers the read filled, whatever the process later
+	 * writes to its own array.
+	 */
+	if (iter_is_ubuf(iter)) {
+		buf = (unsigned long)iter->ubuf + iter->iov_offset;
+	} else if (iter_is_iovec(iter) && !iter->iov_offset) {
+		nr_segs = iter->nr_segs;
+		iov = kmemdup_array(iter_iov(iter), nr_segs, sizeof(*iov),
+				    GFP_KERNEL | __GFP_NOWARN);
+		if (!iov)
+			return 0;
+	} else {
+		return 0;
+	}
+	request = get_request(slot, false);
+	if (!request) {
+		kfree(iov);
+		return 0;
+	}
+	spin_lock_irqsave(&reap_lock, reapflags);
+	for (i = 0; i < ANT_AIO_REAP_COUNT; i++) {
+		if (!reaps[i].used) {
+			entry = &reaps[i];
+			break;
+		}
+	}
+	if (entry) {
+		spin_lock_irqsave(&request_lock, irqflags);
+		entry->event = request->event;
+		request->payload_deferred = true;
+		spin_unlock_irqrestore(&request_lock, irqflags);
+		event_hold(&entry->event);
+		entry->mm = current->mm;
+		entry->ioctx = ioctx;
+		entry->buf = buf;
+		entry->len = iov_iter_count(iter);
+		entry->iov = iov;
+		entry->nr_segs = nr_segs;
+		entry->res = 0;
+		entry->completed = false;
+		entry->used = true;
+		atomic_inc(&reap_used);
+		request_id = entry->event.request_id;
+	}
+	spin_unlock_irqrestore(&reap_lock, reapflags);
+	/* A full table leaves the gap to finish_request(), which counts it. */
+	if (!entry)
+		kfree(iov);
+	put_request(request);
+	return request_id;
+}
+
+static void reap_release(struct ant_aio_reap *entry)
+{
+	kfree(entry->iov);
+	event_release(&entry->event);
+}
+
+/* Removes the entry for request_id; the caller releases its event. */
+static bool reap_take(struct ant_aio_reap *out, u64 request_id)
+{
+	unsigned long flags;
+	bool found = false;
+	int i;
+
+	spin_lock_irqsave(&reap_lock, flags);
+	for (i = 0; i < ANT_AIO_REAP_COUNT; i++) {
+		if (reaps[i].used && reaps[i].event.request_id == request_id) {
+			*out = reaps[i];
+			reaps[i].used = false;
+			atomic_dec(&reap_used);
+			found = true;
+			break;
+		}
+	}
+	spin_unlock_irqrestore(&reap_lock, flags);
+	return found;
+}
+
+/* read_iter() did not queue the request: its result is observed inline. */
+void ant_monitor_aio_undefer(struct ant_async **slot, u64 request_id)
+{
+	struct ant_async *request;
+	struct ant_aio_reap entry;
+	unsigned long irqflags;
+
+	if (!request_id || !reap_take(&entry, request_id))
+		return;
+	reap_release(&entry);
+	request = get_request(slot, false);
+	if (!request)
+		return;
+	spin_lock_irqsave(&request_lock, irqflags);
+	request->payload_deferred = false;
+	spin_unlock_irqrestore(&request_lock, irqflags);
+	put_request(request);
+}
+
+u64 ant_monitor_async_id(struct ant_async **slot)
+{
+	struct ant_async *request;
+	unsigned long irqflags;
+	u64 id = 0;
+
+	spin_lock_irqsave(&request_lock, irqflags);
+	request = *slot;
+	if (request)
+		id = request->event.request_id;
+	spin_unlock_irqrestore(&request_lock, irqflags);
+	return id;
+}
+
+/* Called under the AIO completion_lock as the event is written to ring_slot.
+ * A read without output has nothing to observe: its entry is dropped.
+ */
+void ant_monitor_aio_completed(u64 request_id, const void *ioctx, unsigned int ring_slot,
+			       s64 res)
+{
+	struct ant_aio_reap dropped;
+	unsigned long flags;
+	bool drop = false;
+	int i;
+
+	if (!request_id || !atomic_read(&reap_used))
+		return;
+	spin_lock_irqsave(&reap_lock, flags);
+	for (i = 0; i < ANT_AIO_REAP_COUNT; i++) {
+		struct ant_aio_reap *entry = &reaps[i];
+
+		if (!entry->used || entry->event.request_id != request_id ||
+		    entry->ioctx != ioctx)
+			continue;
+		if (res <= 0) {
+			dropped = *entry;
+			entry->used = false;
+			atomic_dec(&reap_used);
+			drop = true;
+		} else {
+			entry->ring_slot = ring_slot;
+			entry->res = res;
+			entry->completed = true;
+		}
+		break;
+	}
+	spin_unlock_irqrestore(&reap_lock, flags);
+	if (drop)
+		reap_release(&dropped);
+}
+
+static int reap_capture(const struct ant_aio_reap *entry, u64 size)
+{
+	struct ant_task *ctx = ant_monitor_async_capture_alloc();
+	struct iov_iter iter;
+	int error;
+
+	if (!ctx)
+		return -ENOMEM;
+	if (entry->iov) {
+		iov_iter_init(&iter, ITER_DEST, entry->iov, entry->nr_segs, entry->len);
+		error = ant_monitor_async_capture_stage(ctx, &entry->event, &iter, size,
+							0, true, 7);
+	} else {
+		error = ant_monitor_async_capture_memory(ctx, &entry->event,
+							 "async.payload.output", "", 1,
+							 entry->buf, NULL, size, 7, -1);
+	}
+	ant_monitor_async_capture_free(ctx);
+	return error;
+}
+
+/* io_getevents() copied ring slots [first, first + count) to the process. */
+void ant_monitor_aio_consumed(const void *ioctx, unsigned int first, unsigned int count)
+{
+	struct ant_aio_reap entry;
+	unsigned long flags;
+	bool found;
+	int i;
+
+	while (atomic_read(&reap_used)) {
+		found = false;
+		spin_lock_irqsave(&reap_lock, flags);
+		for (i = 0; i < ANT_AIO_REAP_COUNT; i++) {
+			struct ant_aio_reap *candidate = &reaps[i];
+
+			if (!candidate->used || !candidate->completed ||
+			    candidate->ioctx != ioctx || candidate->mm != current->mm ||
+			    candidate->ring_slot - first >= count)
+				continue;
+			entry = *candidate;
+			candidate->used = false;
+			atomic_dec(&reap_used);
+			found = true;
+			break;
+		}
+		spin_unlock_irqrestore(&reap_lock, flags);
+		if (!found)
+			return;
+		entry.event.result = entry.res;
+		entry.event.flags &= ~ANT_ASYNC_PAYLOAD_GAP;
+		if (reap_capture(&entry, min_t(u64, entry.res, entry.len)))
+			ant_run_async_loss(entry.event.root_cookie);
+		reap_release(&entry);
+	}
+}
+
+/* Entries left unreaped when their context or address space goes away. */
+static void reap_drop(struct mm_struct *mm, const void *ioctx)
+{
+	struct ant_aio_reap entry;
+	unsigned long flags;
+	int i;
+
+	if (!atomic_read(&reap_used))
+		return;
+	for (i = 0; i < ANT_AIO_REAP_COUNT; i++) {
+		spin_lock_irqsave(&reap_lock, flags);
+		if (!reaps[i].used || (mm && reaps[i].mm != mm) ||
+		    (ioctx && reaps[i].ioctx != ioctx)) {
+			spin_unlock_irqrestore(&reap_lock, flags);
+			continue;
+		}
+		entry = reaps[i];
+		reaps[i].used = false;
+		atomic_dec(&reap_used);
+		spin_unlock_irqrestore(&reap_lock, flags);
+		ant_run_async_loss(entry.event.root_cookie);
+		reap_release(&entry);
+	}
+}
+
+void ant_monitor_aio_exit(struct mm_struct *mm)
+{
+	reap_drop(mm, NULL);
+}
+
+void ant_monitor_aio_ctx_free(const void *ioctx)
+{
+	reap_drop(NULL, ioctx);
+}
diff --git a/kernel/antinomie/async.h b/kernel/antinomie/async.h
new file mode 100644
index 0000000..5dff0c4
--- /dev/null
+++ b/kernel/antinomie/async.h
@@ -0,0 +1,64 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _ANTINOMIE_ASYNC_H
+#define _ANTINOMIE_ASYNC_H
+
+#include <linux/types.h>
+
+struct task_struct;
+struct mm_struct;
+struct ant_task;
+struct iov_iter;
+
+struct ant_async_event {
+	struct task_struct *origin;
+	/* Attributed requests (contract 14.3): the ring creator, whose task
+	 * cookie the event carries and whose counters sequence its packets.
+	 */
+	struct task_struct *owner;
+	/* Compared, never dereferenced: identifies the origin's address space. */
+	struct mm_struct *mm;
+	u64 request_id;
+	u64 parent_call_id;
+	u64 entry_ns;
+	u64 timestamp_ns;
+	u64 root_cookie;
+	u64 capture_cookie;
+	u64 task_cookie;
+	u64 start_boot_ns;
+	u64 user_data;
+	s64 result;
+	u32 opcode;
+	u32 stage;
+	u32 cpu;
+	u64 flags;
+	u32 pid, tid;
+	u32 uid, gid, euid, egid;
+	u16 descriptor_len;
+	u8 system;
+	bool final;
+	u8 descriptor[128];
+};
+
+u64 ant_monitor_parent_call_id(void);
+bool ant_async_iter_covers_payload(const struct ant_async_event *event);
+int ant_monitor_async_publish(const struct ant_async_event *event);
+struct ant_task *ant_monitor_async_capture_alloc(void);
+void ant_monitor_async_capture_free(struct ant_task *ctx);
+int ant_monitor_async_capture_memory(struct ant_task *ctx,
+				     const struct ant_async_event *event, const char *key,
+				     const char *layout, u16 encoding, u64 address,
+				     const void *snapshot, u64 size, u32 stage, int status);
+bool ant_async_same_space(const struct ant_async_event *event);
+int ant_monitor_async_capture(struct ant_task *ctx,
+			      const struct ant_async_event *event,
+			      const struct iov_iter *iter, size_t size,
+			      u64 result_offset, bool output);
+int ant_monitor_async_capture_stage(struct ant_task *ctx,
+				    const struct ant_async_event *event,
+				    const struct iov_iter *iter, size_t size,
+				    u64 result_offset, bool output, u32 stage);
+int ant_async_stage_packet(const struct ant_async_event *event,
+			   const void *packet, size_t packet_len);
+void ant_monitor_async_send_failed(void);
+
+#endif
diff --git a/kernel/antinomie/async_capture.c b/kernel/antinomie/async_capture.c
new file mode 100644
index 0000000..383c6ed
--- /dev/null
+++ b/kernel/antinomie/async_capture.c
@@ -0,0 +1,434 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/aio_abi.h>
+#include <linux/cpumask.h>
+#include <linux/fs.h>
+#include <linux/io_uring_types.h>
+#include <linux/log2.h>
+#include <linux/overflow.h>
+#include <linux/signal.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+#include <linux/uio.h>
+#include <uapi/linux/io_uring.h>
+
+#include "async_capture.h"
+#include "capture_api.h"
+
+/* Pinned registration ceilings from io_uring/rsrc.c and kbuf.c. */
+#define ANT_FIXED_FILE_COUNT BIT(20)
+#define ANT_REG_BUFFER_COUNT BIT(14)
+#define ANT_PBUF_COUNT 65535
+#define ANT_SQ_COUNT 32768
+#define ANT_CQ_COUNT (2 * ANT_SQ_COUNT)
+
+struct ant_uring_setup {
+	struct io_uring_params params;
+	u64 rings_size;
+	u64 sqes_size;
+	bool valid;
+};
+
+struct ant_aio_sigset {
+	u64 sigmask;
+	u64 sigset_size;
+};
+
+static void bytes_field(struct ant_task *ctx, u8 arg, const char *key,
+			const char *layout, u64 address, u64 size,
+			enum ant_status status)
+{
+	ant_capture_field(ctx, arg, key, layout, layout[0] ? 3 : 1, address,
+			  NULL, size, size, status);
+}
+
+static bool snapshot_field(struct ant_task *ctx, u8 arg, const char *key,
+			   const char *layout, u64 address, void *out, size_t size)
+{
+	int error = address ? copy_from_user_nofault(out,
+			(void __user *)(unsigned long)address, size) : -EFAULT;
+
+	ant_capture_field(ctx, arg, key, layout, 3, address, error ? NULL : out,
+			  size, size, !address ? ANT_NULL_POINTER :
+			  error ? ANT_COPY_FAULT : ANT_COMPLETE);
+	return !error;
+}
+
+static void array_field(struct ant_task *ctx, u8 arg, const char *key,
+			const char *layout, u64 address, u64 count,
+			u64 unit, u64 ceiling)
+{
+	u64 size;
+	bool invalid = count > ceiling || check_mul_overflow(count, unit, &size);
+
+	if (invalid)
+		size = U64_MAX;
+	bytes_field(ctx, arg, key, layout, address, size,
+		    invalid ? ANT_INVALID_EXTENT : ANT_COMPLETE);
+}
+
+static void signal_mask(struct ant_task *ctx, u8 arg, u64 address, u64 size)
+{
+	bytes_field(ctx, arg, "signal.mask", ANT_LAYOUT("sigset_t"),
+		    address, sizeof(sigset_t),
+		    size == sizeof(sigset_t) ? ANT_COMPLETE : ANT_INVALID_EXTENT);
+}
+
+static void aio_submission(struct ant_task *ctx, const u64 a[6])
+{
+	u64 ptr, index, count = a[1];
+	struct iocb iocb;
+	char key[96];
+
+	array_field(ctx, 2, "arg2.iocbpp", ANT_LAYOUT("pointer[]"),
+		    a[2], count, sizeof(ptr), LONG_MAX / sizeof(ptr));
+	if ((s64)count < 0 || count > LONG_MAX / sizeof(ptr))
+		return;
+	for (index = 0; index < count && !ant_capture_lost(ctx); index++) {
+		if (a[2] > ULONG_MAX - index * sizeof(ptr))
+			return;
+		scnprintf(key, sizeof(key), "arg2.iocbpp[%llu]", index);
+		if (!snapshot_field(ctx, 2, key, ANT_LAYOUT("pointer"),
+				    a[2] + index * sizeof(ptr), &ptr, sizeof(ptr)))
+			return;
+		scnprintf(key, sizeof(key), "arg2.iocb[%llu]", index);
+		if (!snapshot_field(ctx, 2, key, ANT_LAYOUT("iocb"), ptr,
+				    &iocb, sizeof(iocb)))
+			return;
+		if (iocb.aio_lio_opcode == IOCB_CMD_PREADV ||
+		    iocb.aio_lio_opcode == IOCB_CMD_PWRITEV) {
+			scnprintf(key, sizeof(key), "arg2.iocb[%llu].iov", index);
+			array_field(ctx, 2, key, ANT_LAYOUT("iovec[]"),
+				    iocb.aio_buf, iocb.aio_nbytes, sizeof(struct iovec),
+				    UIO_MAXIOV);
+		} else if (iocb.aio_lio_opcode == IOCB_CMD_PWRITE) {
+			scnprintf(key, sizeof(key), "arg2.iocb[%llu].input", index);
+			array_field(ctx, 2, key, "", iocb.aio_buf, iocb.aio_nbytes,
+				    1, MAX_RW_COUNT);
+		} else if (iocb.aio_lio_opcode == IOCB_CMD_PREAD) {
+			scnprintf(key, sizeof(key), "arg2.iocb[%llu].output", index);
+			bytes_field(ctx, 2, key, "", iocb.aio_buf, iocb.aio_nbytes,
+				    ANT_ASYNC_UNOBSERVED);
+		} else if (iocb.aio_lio_opcode != IOCB_CMD_FSYNC &&
+			   iocb.aio_lio_opcode != IOCB_CMD_FDSYNC &&
+			   iocb.aio_lio_opcode != IOCB_CMD_POLL) {
+			scnprintf(key, sizeof(key), "arg2.iocb[%llu].variant", index);
+			bytes_field(ctx, 2, key, "", iocb.aio_buf, U64_MAX, ANT_NO_DECODER);
+		}
+	}
+}
+
+struct registration {
+	u16 size;
+	u8 phases;
+	bool array;
+	const char *layout;
+	s16 arg_count;
+};
+
+#define REG(op, type, phases_) \
+	[op] = { sizeof(struct type), phases_, false, ANT_LAYOUT(#type), 1 }
+#define REG_COUNT(op, type, phases_, count_) \
+	[op] = { sizeof(struct type), phases_, false, ANT_LAYOUT(#type), count_ }
+#define REGS(op, type, phases_) \
+	[op] = { sizeof(struct type), phases_, true, ANT_LAYOUT(#type "[]") }
+#define REG_INT(op, phases_) \
+	[op] = { sizeof(u32), phases_, false, ANT_LAYOUT("int"), 1 }
+
+static const struct registration registrations[IORING_REGISTER_LAST] = {
+	REGS(IORING_REGISTER_BUFFERS, iovec, 1),
+	[IORING_REGISTER_FILES] = { sizeof(u32), 1, true, ANT_LAYOUT("int[]") },
+	REG_INT(IORING_REGISTER_EVENTFD, 1),
+	REG_INT(IORING_REGISTER_EVENTFD_ASYNC, 1),
+	REG_COUNT(IORING_REGISTER_FILES_UPDATE, io_uring_files_update, 1, 0),
+	REGS(IORING_REGISTER_RESTRICTIONS, io_uring_restriction, 1),
+	REG_COUNT(IORING_REGISTER_FILES2, io_uring_rsrc_register, 1, -1),
+	REG_COUNT(IORING_REGISTER_BUFFERS2, io_uring_rsrc_register, 1, -1),
+	REG_COUNT(IORING_REGISTER_FILES_UPDATE2, io_uring_rsrc_update2, 1, -1),
+	REG_COUNT(IORING_REGISTER_BUFFERS_UPDATE, io_uring_rsrc_update2, 1, -1),
+	[IORING_REGISTER_IOWQ_AFF] = { 1, 1, true, ANT_LAYOUT("cpumask") },
+	[IORING_REGISTER_IOWQ_MAX_WORKERS] = { 2 * sizeof(u32), 3, false,
+		ANT_LAYOUT("int[2]"), 2 },
+	REGS(IORING_REGISTER_RING_FDS, io_uring_rsrc_update, 3),
+	REGS(IORING_UNREGISTER_RING_FDS, io_uring_rsrc_update, 1),
+	REG(IORING_REGISTER_PBUF_RING, io_uring_buf_reg, 1),
+	REG(IORING_UNREGISTER_PBUF_RING, io_uring_buf_reg, 1),
+	REG(IORING_REGISTER_SYNC_CANCEL, io_uring_sync_cancel_reg, 1),
+	REG_COUNT(IORING_REGISTER_FILE_ALLOC_RANGE, io_uring_file_index_range, 1, -2),
+	REG(IORING_REGISTER_PBUF_STATUS, io_uring_buf_status, 3),
+	REG(IORING_REGISTER_NAPI, io_uring_napi, 3),
+	REG(IORING_UNREGISTER_NAPI, io_uring_napi, 2),
+	REG_COUNT(IORING_REGISTER_CLOCK, io_uring_clock_register, 1, -2),
+	REG(IORING_REGISTER_CLONE_BUFFERS, io_uring_clone_buffers, 1),
+};
+
+static void registration_nested(struct ant_task *ctx, u32 opcode,
+				const u64 a[6])
+{
+	struct io_uring_rsrc_register reg;
+	struct io_uring_rsrc_update2 update;
+	struct io_uring_buf_reg pbuf;
+	u32 count = a[3];
+	u64 address = a[2];
+	bool buffers = opcode == IORING_REGISTER_BUFFERS2 ||
+		opcode == IORING_REGISTER_BUFFERS_UPDATE;
+	u64 ceiling = buffers ? ANT_REG_BUFFER_COUNT : ANT_FIXED_FILE_COUNT;
+
+	if (opcode == IORING_REGISTER_FILES2 || opcode == IORING_REGISTER_BUFFERS2) {
+		if (count != sizeof(reg))
+			return;
+		if (copy_from_user_nofault(&reg, (void __user *)(unsigned long)address,
+					   sizeof(reg)))
+			goto copy_fault;
+		if (!(reg.flags & IORING_RSRC_REGISTER_SPARSE))
+			array_field(ctx, 2, "arg2.resources", buffers ?
+				    ANT_LAYOUT("iovec[]") : ANT_LAYOUT("int[]"),
+				    reg.data, reg.nr, buffers ? sizeof(struct iovec) : sizeof(u32),
+				    ceiling);
+		if (reg.tags)
+			array_field(ctx, 2, "arg2.tags", ANT_LAYOUT("u64[]"),
+				    reg.tags, reg.nr, sizeof(u64), ceiling);
+	} else if (opcode == IORING_REGISTER_FILES_UPDATE ||
+		   opcode == IORING_REGISTER_FILES_UPDATE2 ||
+		   opcode == IORING_REGISTER_BUFFERS_UPDATE) {
+		memset(&update, 0, sizeof(update));
+		if (copy_from_user_nofault(&update, (void __user *)(unsigned long)address,
+					   opcode == IORING_REGISTER_FILES_UPDATE ?
+					   sizeof(struct io_uring_rsrc_update) : sizeof(update)))
+			goto copy_fault;
+		if (opcode != IORING_REGISTER_FILES_UPDATE && count != sizeof(update))
+			return;
+		array_field(ctx, 2, "arg2.resources", buffers ?
+			    ANT_LAYOUT("iovec[]") : ANT_LAYOUT("int[]"),
+			    update.data, opcode == IORING_REGISTER_FILES_UPDATE ? count : update.nr,
+			    buffers ? sizeof(struct iovec) : sizeof(u32), ceiling);
+		if (update.tags)
+			array_field(ctx, 2, "arg2.tags", ANT_LAYOUT("u64[]"),
+				    update.tags, update.nr, sizeof(u64), ceiling);
+	} else if (opcode == IORING_REGISTER_PBUF_RING) {
+		if (copy_from_user_nofault(&pbuf, (void __user *)(unsigned long)address,
+					   sizeof(pbuf)))
+			goto copy_fault;
+		if (!(pbuf.flags & IOU_PBUF_RING_MMAP))
+			array_field(ctx, 2, "arg2.buffer_ring",
+				    ANT_LAYOUT("io_uring_buf[]"),
+				    pbuf.ring_addr, pbuf.ring_entries, sizeof(struct io_uring_buf),
+				    ANT_PBUF_COUNT);
+	}
+	return;
+copy_fault:
+	bytes_field(ctx, 2, "arg2.nested", "", address, U64_MAX, ANT_COPY_FAULT);
+}
+
+static void uring_register(struct ant_task *ctx, const u64 a[6], bool output)
+{
+	u32 opcode = (u32)a[1] & ~IORING_REGISTER_USE_REGISTERED_RING;
+	u32 count = a[3];
+	const struct registration *reg;
+	u64 size;
+
+	if (opcode >= ARRAY_SIZE(registrations)) {
+		if (!output)
+			bytes_field(ctx, 2, "arg2.register_variant", "", a[2], U64_MAX,
+				    ANT_NO_DECODER);
+		return;
+	}
+	if (opcode == IORING_REGISTER_PROBE) {
+		size = sizeof(struct io_uring_probe) +
+			min_t(u32, count, IORING_OP_LAST) * sizeof(struct io_uring_probe_op);
+		bytes_field(ctx, 2, "arg2.probe", ANT_LAYOUT("io_uring_probe"),
+			    a[2], size, count <= 256 ? ANT_COMPLETE : ANT_INVALID_EXTENT);
+		return;
+	}
+	reg = &registrations[opcode];
+	if (!reg->size || !(reg->phases & (output ? 2 : 1)))
+		return;
+	size = reg->array ? (u64)count * reg->size : reg->size;
+	if (opcode == IORING_REGISTER_IOWQ_AFF)
+		size = min_t(u64, size, cpumask_size());
+	if (reg->arg_count && count != (reg->arg_count == -1 ? reg->size :
+				       reg->arg_count == -2 ? 0 : reg->arg_count)) {
+		ant_capture_field(ctx, 2, "arg2.register", reg->layout, 3, a[2],
+				  NULL, size, count, ANT_INVALID_EXTENT);
+		return;
+	}
+	if ((opcode == IORING_REGISTER_BUFFERS && count > ANT_REG_BUFFER_COUNT) ||
+	    (opcode == IORING_REGISTER_FILES && count > ANT_FIXED_FILE_COUNT) ||
+	    ((opcode == IORING_REGISTER_RING_FDS || opcode == IORING_UNREGISTER_RING_FDS) &&
+	     (!count || count > IO_RINGFD_REG_MAX)) ||
+	    (opcode == IORING_REGISTER_RESTRICTIONS && count >
+	     IORING_RESTRICTION_LAST + IORING_REGISTER_LAST + IORING_OP_LAST)) {
+		bytes_field(ctx, 2, "arg2.register", reg->layout, a[2], size,
+			    ANT_INVALID_EXTENT);
+		return;
+	}
+	bytes_field(ctx, 2, "arg2.register", reg->layout, a[2], size, ANT_COMPLETE);
+	if (!output && !ant_capture_lost(ctx))
+		registration_nested(ctx, opcode, a);
+}
+
+static void uring_enter(struct ant_task *ctx, const u64 a[6])
+{
+	struct io_uring_getevents_arg arg;
+
+	if (!a[4])
+		return;
+	if ((u32)a[3] & IORING_ENTER_EXT_ARG) {
+		if (a[5] != sizeof(arg)) {
+			bytes_field(ctx, 4, "arg4.ext_arg",
+				    ANT_LAYOUT("io_uring_getevents_arg"),
+				    a[4], a[5], ANT_INVALID_EXTENT);
+			return;
+		}
+		if (!snapshot_field(ctx, 4, "arg4.ext_arg",
+				    ANT_LAYOUT("io_uring_getevents_arg"),
+				    a[4], &arg, sizeof(arg)))
+			return;
+		if (arg.sigmask)
+			signal_mask(ctx, 4, arg.sigmask, arg.sigmask_sz);
+		if (arg.ts)
+			bytes_field(ctx, 4, "arg4.timeout", ANT_LAYOUT("timespec"),
+				    arg.ts, sizeof(struct __kernel_timespec), ANT_COMPLETE);
+	} else {
+		signal_mask(ctx, 4, a[4], a[5]);
+	}
+}
+
+static void setup_release(void *state)
+{
+	kfree(state);
+}
+
+/* Mirror the pinned setup validation and rings_size layout. The stored entry
+ * addresses/capacities prevent a changed output params block redirecting capture.
+ */
+static bool setup_sizes(struct ant_uring_setup *state, u64 requested)
+{
+	struct io_uring_params *p = &state->params;
+	u64 sq, cq, size;
+
+	requested = (u32)requested;
+	if (!requested || (requested > ANT_SQ_COUNT && !(p->flags & IORING_SETUP_CLAMP)))
+		return false;
+	sq = roundup_pow_of_two(min_t(u64, requested, ANT_SQ_COUNT));
+	if (p->flags & IORING_SETUP_CQSIZE) {
+		cq = p->cq_entries;
+		if (!cq || (cq > ANT_CQ_COUNT && !(p->flags & IORING_SETUP_CLAMP)))
+			return false;
+		cq = roundup_pow_of_two(min_t(u64, cq, ANT_CQ_COUNT));
+		if (cq < sq)
+			return false;
+	} else {
+		cq = 2 * sq;
+	}
+	size = sizeof(struct io_rings) + cq * sizeof(struct io_uring_cqe);
+	if (p->flags & IORING_SETUP_CQE32)
+		size *= 2;
+#ifdef CONFIG_SMP
+	size = ALIGN(size, SMP_CACHE_BYTES);
+#endif
+	if (!(p->flags & IORING_SETUP_NO_SQARRAY))
+		size += sq * sizeof(u32);
+	state->rings_size = size;
+	state->sqes_size = sq * sizeof(struct io_uring_sqe) *
+		(p->flags & IORING_SETUP_SQE128 ? 2 : 1);
+	return true;
+}
+
+static void uring_setup(struct ant_task *ctx, const u64 a[6], bool output, long result)
+{
+	struct ant_uring_setup *state = ant_capture_state(ctx);
+	struct io_uring_params params;
+	enum ant_status status;
+
+	if (output && result < 0)
+		return;
+	if (!snapshot_field(ctx, 1, "arg1.params", ANT_LAYOUT("io_uring_params"),
+			    a[1], &params, sizeof(params)))
+		return;
+	if (!output) {
+		if (!(params.flags & IORING_SETUP_NO_MMAP))
+			return;
+		state = kzalloc(sizeof(*state), GFP_NOWAIT);
+		if (!state) {
+			bytes_field(ctx, 1, "arg1.user_memory", "", 0, U64_MAX,
+				    ANT_RESOURCE_EXHAUSTED);
+			return;
+		}
+		state->params = params;
+		state->valid = setup_sizes(state, a[0]);
+		ant_capture_set_state(ctx, state, setup_release);
+	} else if (!state) {
+		if (params.flags & IORING_SETUP_NO_MMAP)
+			bytes_field(ctx, 1, "arg1.user_memory", "", 0, U64_MAX,
+				    ANT_CONTEXT_MISSING);
+		return;
+	}
+	status = state->valid ? ANT_COMPLETE : ANT_INVALID_EXTENT;
+	/* sq_off.user_addr backs SQEs; cq_off.user_addr backs the shared rings. */
+	bytes_field(ctx, 1, "arg1.user_rings", ANT_LAYOUT("io_rings"),
+		    state->params.cq_off.user_addr, state->valid ? state->rings_size : U64_MAX,
+		    status);
+	bytes_field(ctx, 1, "arg1.user_sqes", ANT_LAYOUT("io_uring_sqe[]"),
+		    state->params.sq_off.user_addr, state->valid ? state->sqes_size : U64_MAX,
+		    status);
+}
+
+u8 ant_async_capture(struct ant_task *ctx, u64 nr, const u64 a[6],
+		     bool output, long result)
+{
+	struct ant_aio_sigset sig;
+	u8 mask;
+
+	switch (nr) {
+	case __NR_io_setup:
+		mask = BIT(1);
+		if (!output || !result)
+			bytes_field(ctx, 1, "arg1.context_id", ANT_LAYOUT("aio_context_t"),
+				    a[1], sizeof(u64), ANT_COMPLETE);
+		break;
+	case __NR_io_getevents: case __NR_io_pgetevents:
+		mask = BIT(3) | BIT(4) | (nr == __NR_io_pgetevents ? BIT(5) : 0);
+		if (output && result > 0)
+			array_field(ctx, 3, "arg3.events", ANT_LAYOUT("io_event[]"),
+				    a[3], result, sizeof(struct io_event), a[2]);
+		if (!output && a[4])
+			bytes_field(ctx, 4, "arg4.timeout", ANT_LAYOUT("timespec"),
+				    a[4], sizeof(struct __kernel_timespec), ANT_COMPLETE);
+		if (!output && nr == __NR_io_pgetevents && a[5] &&
+		    snapshot_field(ctx, 5, "arg5.sigset", ANT_LAYOUT("__aio_sigset"),
+				   a[5], &sig, sizeof(sig)) && sig.sigmask)
+			signal_mask(ctx, 5, sig.sigmask, sig.sigset_size);
+		break;
+	case __NR_io_submit:
+		mask = BIT(2);
+		if (!output)
+			aio_submission(ctx, a);
+		break;
+	case __NR_io_cancel:
+		mask = BIT(1) | BIT(2);
+		if (!output)
+			bytes_field(ctx, 1, "arg1.iocb", ANT_LAYOUT("iocb"),
+				    a[1], sizeof(struct iocb), ANT_COMPLETE);
+		else if (!result)
+			bytes_field(ctx, 2, "arg2.event", ANT_LAYOUT("io_event"),
+				    a[2], sizeof(struct io_event), ANT_COMPLETE);
+		break;
+	case __NR_io_uring_setup:
+		mask = BIT(1);
+		uring_setup(ctx, a, output, result);
+		break;
+	case __NR_io_uring_enter:
+		mask = BIT(4);
+		if (!output)
+			uring_enter(ctx, a);
+		break;
+	case __NR_io_uring_register:
+		mask = BIT(2);
+		if (!output || result >= 0)
+			uring_register(ctx, a, output);
+		break;
+	default:
+		return 0;
+	}
+	return ANT_CAPTURE_OWNED | mask;
+}
