diff --git a/fs/aio.c b/fs/aio.c
index e892017..db8658a 100644
--- a/fs/aio.c
+++ b/fs/aio.c
@@ -12,6 +12,7 @@
 #define pr_fmt(fmt) "%s: " fmt, __func__
 
 #include <linux/kernel.h>
+#include <linux/antinomie_monitor.h>
 #include <linux/init.h>
 #include <linux/errno.h>
 #include <linux/time.h>
@@ -195,6 +196,9 @@ struct poll_iocb {
  * or directly as just 'ki_filp' in this struct.
  */
 struct aio_kiocb {
+#ifdef CONFIG_ANTINOMIE
+	struct ant_async		*ant_async;
+#endif
 	union {
 		struct file		*ki_filp;
 		struct kiocb		rw;
@@ -619,6 +623,7 @@ static void free_ioctx(struct work_struct *work)
 					  free_rwork);
 	pr_debug("freeing %p\n", ctx);
 
+	ant_monitor_aio_ctx_free(ctx);
 	aio_free_ring(ctx);
 	free_percpu(ctx->cpu);
 	percpu_ref_exit(&ctx->reqs);
@@ -895,6 +900,7 @@ void exit_aio(struct mm_struct *mm)
 	struct ctx_rq_wait wait;
 	int i, skipped;
 
+	ant_monitor_aio_exit(mm);
 	if (!table)
 		return;
 
@@ -1065,6 +1071,9 @@ static inline struct aio_kiocb *aio_get_req(struct kioctx *ctx)
 	}
 
 	percpu_ref_get(&ctx->reqs);
+#ifdef CONFIG_ANTINOMIE
+	req->ant_async = NULL;
+#endif
 	req->ki_ctx = ctx;
 	INIT_LIST_HEAD(&req->ki_list);
 	refcount_set(&req->ki_refcnt, 2);
@@ -1102,6 +1111,9 @@ out:
 
 static inline void iocb_destroy(struct aio_kiocb *iocb)
 {
+#ifdef CONFIG_ANTINOMIE
+	ant_monitor_async_abandon(&iocb->ant_async);
+#endif
 	if (iocb->ki_eventfd)
 		eventfd_ctx_put(iocb->ki_eventfd);
 	if (iocb->ki_filp)
@@ -1125,7 +1137,11 @@ static void aio_complete(struct aio_kiocb *iocb)
 	struct io_event	*ev_page, *event;
 	unsigned tail, pos, head, avail;
 	unsigned long	flags;
+#ifdef CONFIG_ANTINOMIE
+	u64 ant_request = ant_monitor_async_id(&iocb->ant_async);
 
+	ant_monitor_async_complete(&iocb->ant_async, iocb->ki_res.res, 0, true);
+#endif
 	/*
 	 * Add a completion event to the ring buffer. Must be done holding
 	 * ctx->completion_lock to prevent other code from messing with the tail
@@ -1143,6 +1159,11 @@ static void aio_complete(struct aio_kiocb *iocb)
 	event = ev_page + pos % AIO_EVENTS_PER_PAGE;
 
 	*event = iocb->ki_res;
+#ifdef CONFIG_ANTINOMIE
+	/* Before the tail moves, so a reader cannot consume an unstamped slot. */
+	ant_monitor_aio_completed(ant_request, ctx, pos - AIO_EVENTS_OFFSET,
+				  iocb->ki_res.res);
+#endif
 
 	flush_dcache_folio(ctx->ring_folios[pos / AIO_EVENTS_PER_PAGE]);
 
@@ -1275,6 +1296,7 @@ static long aio_read_events_ring(struct kioctx *ctx,
 			ret = -EFAULT;
 			goto out;
 		}
+		ant_monitor_aio_consumed(ctx, head, avail);
 
 		ret += avail;
 		head += avail;
@@ -1584,6 +1606,12 @@ static int aio_read(struct kiocb *req, const struct iocb *iocb,
 	struct iov_iter iter;
 	struct file *file;
 	int ret;
+#ifdef CONFIG_ANTINOMIE
+	struct aio_kiocb *tracked = container_of(req, struct aio_kiocb, rw);
+	struct iov_iter observed;
+	ssize_t result;
+	u64 deferred;
+#endif
 
 	ret = aio_prep_rw(req, iocb, READ);
 	if (ret)
@@ -1598,8 +1626,27 @@ static int aio_read(struct kiocb *req, const struct iocb *iocb,
 	if (ret < 0)
 		return ret;
 	ret = rw_verify_area(READ, file, &req->ki_pos, iov_iter_count(&iter));
-	if (!ret)
+	if (!ret) {
+#ifdef CONFIG_ANTINOMIE
+		/* A queued read may complete in interrupt context, where its
+		 * buffers cannot be read; io_getevents() reads them instead.
+		 */
+		deferred = ant_monitor_aio_defer(&tracked->ant_async, tracked->ki_ctx,
+						 &iter);
+		observed = iter;
+		result = file->f_op->read_iter(req, &iter);
+		if (result != -EIOCBQUEUED)
+			ant_monitor_aio_undefer(&tracked->ant_async, deferred);
+		/* A failed read wrote no output, so there is no payload to miss. */
+		if (result < 0 && result != -EIOCBQUEUED)
+			ant_monitor_async_scalar(&tracked->ant_async);
+		if (result >= 0)
+			ant_monitor_async_iter(&tracked->ant_async, &observed, result, 0, true);
+		aio_rw_done(req, result);
+#else
 		aio_rw_done(req, file->f_op->read_iter(req, &iter));
+#endif
+	}
 	kfree(iovec);
 	return ret;
 }
@@ -1627,6 +1674,11 @@ static int aio_write(struct kiocb *req, const struct iocb *iocb,
 		return ret;
 	ret = rw_verify_area(WRITE, file, &req->ki_pos, iov_iter_count(&iter));
 	if (!ret) {
+#ifdef CONFIG_ANTINOMIE
+		struct aio_kiocb *tracked = container_of(req, struct aio_kiocb, rw);
+
+		ant_monitor_async_iter(&tracked->ant_async, &iter, iov_iter_count(&iter), 0, false);
+#endif
 		if (S_ISREG(file_inode(file)->i_mode))
 			kiocb_start_write(req);
 		req->ki_flags |= IOCB_WRITE;
@@ -2049,7 +2101,19 @@ static int io_submit_one(struct kioctx *ctx, struct iocb __user *user_iocb,
 	if (unlikely(!req))
 		return -EAGAIN;
 
+#ifdef CONFIG_ANTINOMIE
+	req->ant_async = ant_monitor_async_begin(ANT_ASYNC_AIO,
+						 iocb.aio_lio_opcode, iocb.aio_data,
+						 compat || iocb.aio_lio_opcode == IOCB_CMD_PREAD ||
+						 iocb.aio_lio_opcode == IOCB_CMD_PWRITE ||
+						 iocb.aio_lio_opcode == IOCB_CMD_PREADV ||
+						 iocb.aio_lio_opcode == IOCB_CMD_PWRITEV ?
+						 ANT_ASYNC_PAYLOAD_GAP : 0, &iocb, sizeof(iocb));
+#endif
 	err = __io_submit_one(ctx, &iocb, user_iocb, req, compat);
+#ifdef CONFIG_ANTINOMIE
+	ant_monitor_async_accepted(&req->ant_async, err);
+#endif
 
 	/* Done with the synchronous reference */
 	iocb_put(req);
