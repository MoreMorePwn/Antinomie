+static void async_fields(struct ant_task *ctx, const struct ant_async_event *event)
+{
+	static const char * const keys[] = {
+		"async.request_id", "async.stage", "async.parent_call_id",
+		"async.result", "async.final", "async.opcode", "async.user_data",
+		"async.flags",
+	};
