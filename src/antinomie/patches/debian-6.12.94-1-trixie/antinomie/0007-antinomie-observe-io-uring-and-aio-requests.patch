+ * the origin's address space (the submitter, its io-wq workers, the SQPOLL
+ * thread), never from interrupt context. The origin reference keeps its
+ * signal_struct alive, so a recycled mm pointer cannot match another group.
+ */
+bool ant_async_same_space(const struct ant_async_event *event)
+{
+	return !in_interrupt() && current->mm && current->mm == event->mm &&
+		current->signal == event->origin->signal;
+}
+
+/* status < 0 derives the status from the context; otherwise it is recorded
+ * as given with no bytes copied (ADDRESS_ONLY, NO_DECODER).
+ */
+int ant_monitor_async_capture_memory(struct ant_task *ctx,
+				     const struct ant_async_event *event, const char *key,
+				     const char *layout, u16 encoding, u64 address,
+				     const void *snapshot, u64 size, u32 stage, int status)
+{
+	struct ant_async_event observed = *event;
+	enum ant_status observed_status = ANT_COMPLETE;
+	int error;
+
+	observed.stage = stage;
+	observed.final = false;
+	observed.descriptor_len = 0;
+	observed.timestamp_ns = ktime_get_ns();
+	observed.cpu = raw_smp_processor_id();
+	if (status >= 0)
+		observed_status = status;
+	else if (size && !snapshot && !ant_async_same_space(event))
+		observed_status = ANT_ASYNC_UNOBSERVED;
+	ctx->async_staged = true;
+	ctx->async_output = stage != 1;
+	async_context(ctx, &observed);
+	ctx->flags |= ANT_OBSERVATIONAL;
+	ctx->kernel_imported = !!snapshot;
+	field(ctx, 255, key, layout, encoding, address, snapshot, size,
+	      size, observed_status);
+	ctx->kernel_imported = false;
+	event_end(ctx);
+	error = ctx->failed_count || (ctx->state & 1) ? -ENODATA : 0;
+	ctx->async_event = NULL;
