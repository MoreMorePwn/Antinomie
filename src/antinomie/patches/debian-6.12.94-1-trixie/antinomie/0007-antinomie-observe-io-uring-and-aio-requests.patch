diff --git a/kernel/antinomie/run.c b/kernel/antinomie/run.c
index 55e595e..de88fad 100644
--- a/kernel/antinomie/run.c
+++ b/kernel/antinomie/run.c
@@ -172,6 +172,51 @@ void ant_monitor_run_stopped(u64 root_cookie)
 	spin_unlock_irqrestore(&run_lock, irqflags);
 }
 
+static void async_update(u64 root_cookie, int change, bool loss)
+{
+	struct ant_run *run;
+	unsigned long irqflags;
+
+	spin_lock_irqsave(&run_lock, irqflags);
+	run = find_run(root_cookie);
+	if (run) {
+		if (change > 0)
+			run->async_count++;
+		else if (change < 0 && run->async_count)
+			run->async_count--;
+		else if (change < 0)
+			run->flags |= ANTC_RUN_OBSERVATION_INCOMPLETE;
+		if (!change) {
+			if (loss)
+				run->async_losses++;
+			else
+				run->flags |= ANTC_RUN_OBSERVATION_INCOMPLETE;
+		}
+		run->generation++;
+	}
+	spin_unlock_irqrestore(&run_lock, irqflags);
+}
+
+void ant_run_async_start(u64 root_cookie)
+{
+	async_update(root_cookie, 1, false);
+}
+
+void ant_run_async_finish(u64 root_cookie)
+{
+	async_update(root_cookie, -1, false);
+}
+
+void ant_run_async_loss(u64 root_cookie)
+{
+	async_update(root_cookie, 0, true);
+}
+
+void ant_run_async_incomplete(u64 root_cookie)
+{
+	async_update(root_cookie, 0, false);
+}
