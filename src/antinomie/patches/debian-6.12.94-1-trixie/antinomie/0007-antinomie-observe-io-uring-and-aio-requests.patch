+	ctx->call_id = event->parent_call_id;
+	ctx->entry_ns = event->entry_ns;
+	ctx->nr = event->parent_call_id ?
+		(event->system == ANT_ASYNC_IO_URING ? __NR_io_uring_enter : __NR_io_submit) :
+		U64_MAX;
+	ctx->abi = ANT_ABI_NATIVE;
+	event_begin(ctx, 3, 0);
+	async_fields(ctx, event);
