+	} else if (user_backed_iter(source)) {
+		/* IRQ completions and foreign address spaces cannot read the
+		 * iterator's user memory; they report unavailable content.
+		 */
+		if (size && !ant_async_same_space(event))
+			status = ANT_ASYNC_UNOBSERVED;
+	} else if (!iov_iter_is_bvec(source) && !iov_iter_is_kvec(source)) {
+		status = ANT_NO_DECODER;
+	}
+	if (status == ANT_COMPLETE) {
+		if (ant_async_iter_covers_payload(event))
+			observed.flags &= ~ANT_ASYNC_PAYLOAD_GAP;
+	} else {
+		observed.flags |= ANT_ASYNC_PAYLOAD_GAP;
+	}
+	ctx->async_staged = true;
+	ctx->async_output = output;
+	async_context(ctx, &observed);
+	ctx->flags |= ANT_OBSERVATIONAL;
+	for (i = 0; i < ARRAY_SIZE(values) && !ctx->failed_count; i++) {
+		put_unaligned_le64(values[i], scalar);
+		field(ctx, 255, keys[i], "", 4, 0, scalar, sizeof(scalar),
+		      sizeof(scalar), ANT_COMPLETE);
+	}
+	if (iter_is_iovec(source)) {
+		ctx->kernel_imported = true;
+		field(ctx, 255, "async.payload.iov", ANT_LAYOUT("iovec[]"),
+		      3, 0, iter_iov(source), source->nr_segs * sizeof(struct iovec),
+		      source->nr_segs * sizeof(struct iovec), ANT_COMPLETE);
+		ctx->kernel_imported = false;
+	}
+	ctx->iter_source = &iter;
+	field(ctx, 255, output ? "async.payload.output" : "async.payload.input",
+	      "", 1, 0, NULL, size, source->count, status);
+	ctx->iter_source = NULL;
+	event_end(ctx);
+	error = ctx->failed_count || (ctx->state & 1) ? -ENODATA : 0;
+	ctx->busy = false;
+	ctx->async_event = NULL;
+	return error;
+}
+
+void ant_monitor_async_send_failed(void)
+{
+	atomic64_inc(&packets_failed);
+}
