+/* Whether @task's run holds its processes at their exit. */
+bool ant_run_holds_exit(struct task_struct *task)
+{
+	struct ant_run *run = READ_ONCE(ant_state(task)->run);
+
+	return run && READ_ONCE(run->exit_hold);
+}
