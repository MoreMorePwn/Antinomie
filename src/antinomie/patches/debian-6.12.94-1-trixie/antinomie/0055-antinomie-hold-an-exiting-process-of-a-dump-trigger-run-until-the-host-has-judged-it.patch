+/* Arm or disarm the exit hold of run @root_cookie. */
+int ant_run_exit_hold(u64 root_cookie, bool armed)
+{
+	struct ant_run *run;
+	unsigned long flags;
+
+	spin_lock_irqsave(&run_lock, flags);
+	run = find_run(root_cookie);
+	if (run)
+		WRITE_ONCE(run->exit_hold, armed);
+	spin_unlock_irqrestore(&run_lock, flags);
+	return run ? 0 : -ESRCH;
+}
