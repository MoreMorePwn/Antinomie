@@ -141,6 +146,30 @@
 /* Revision 21: the core is the ELF32 file (ELFCLASS32 EM_ARM) of an AArch32
  * task of an arm64 guest, as fs/compat_binfmt_elf.c writes it. */
 #define ANTC_CORE_COMPAT_ELF32 0x100
+/* Revision 22: the core of a process held at its exit (EXIT_HOLD), written by
+ * the process itself with the exit core's writer: every page, resident or
+ * not; RESIDENT_ONLY is clear. */
+#define ANTC_CORE_EXIT_HELD 0x200
+/* EXIT_HOLD (revision 22, with EXEC_EXIT_HOLD): header flags=0, u64 cookie
+ * at 8, u32 action at 16, u32 reserved=0 at 20; empty reply.
+ * ARM / DISARM: cookie is a run's root cookie (-ESRCH: no such run); DISARM
+ * also releases its held processes. RELEASE: cookie is a held process's
+ * (its leader's task cookie, or that of the task that sent its hold record),
+ * or 0 for every held process (-ESRCH: none with that cookie).
+ * In an armed run, a process that ends (exit_group, its last thread's exit,
+ * a fatal or core-dumping signal; never SIGKILL, never one whose own exit
+ * core is armed) first sends lifecycle.exit_hold, a scalar of
+ * EXIT_HOLD_MS | (u64)wait_status << 32, in its leader's process, then waits
+ * at most EXIT_HOLD_MS, before anything of it is torn down, for CORE_CAPTURE
+ * of its identity (the core is written by the process itself: CORE_EXIT_HELD,
+ * status and read as a manual core's) or RELEASE. A stopped run (STOP_RUN),
+ * SIGKILL and the timeout end the wait. At most eight processes wait at once.
+ */
+#define ANTC_EXIT_HOLD 0x1068
+#define ANTC_EXIT_HOLD_ARM 1
+#define ANTC_EXIT_HOLD_DISARM 2
+#define ANTC_EXIT_HOLD_RELEASE 3
+#define ANTC_EXIT_HOLD_MS 50
 #define ANTC_RESOURCES 0x1070
 #define ANTC_RESOURCES_SIZE 96
 #define ANTC_RESOURCES_MEMORY_VALID 1
diff --git a/kernel/antinomie/exit_hold.c b/kernel/antinomie/exit_hold.c
new file mode 100644
index 000000000..24dfec903
--- /dev/null
+++ b/kernel/antinomie/exit_hold.c
@@ -0,0 +1,189 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* The exit hold of a run's dump trigger (contract revision 22).
+ *
+ * The host's dump trigger judges each call as it arrives and asks for a core
+ * of the process that made a suspicious one. A process that exits a
+ * millisecond after that call is gone before the request comes. In a run armed
+ * for it (EXEC flag EXIT_HOLD, or the EXIT_HOLD command), a process that ends
+ * (exit_group, the last thread's exit, a fatal signal, a core-dumping signal)
+ * is parked here, at the start of its exit and before anything of it is torn
+ * down, for at most ANTC_EXIT_HOLD_MS: the exit-hold record tells the host,
+ * which then asks for the core as for any live process (CORE_CAPTURE by its
+ * identity) or lets it go (EXIT_HOLD RELEASE). The core is written by the
+ * parked task itself, with the exit core's writer, so its address space and
+ * threads are whole. SIGKILL, a process whose own exit core is armed, and a
+ * task with no address space are never held; a killed or stopped run releases
+ * at once. At most ANT_EXIT_HOLD_SLOTS tasks wait at a time; the next ones
+ * exit unheld.
+ */
+#include <linux/antinomie_monitor.h>
+#include <linux/completion.h>
+#include <linux/jiffies.h>
+#include <linux/sched.h>
+#include <linux/sched/signal.h>
+#include <linux/spinlock.h>
+#include <linux/unaligned.h>
+#include "control_wire.h"
+#include "exit_hold.h"
+#include "notes.h"
+#include "process_core.h"
+#include "run.h"
+#include "state.h"
+
+#define ANT_EXIT_HOLD_SLOTS 8
+
+struct ant_exit_hold {
+	struct completion done;
+	struct ant_core *core;
+	/* cookie: the leader's (the process's identity); thread_cookie: the
+	 * task that sent the hold record, which RELEASE may name instead.
+	 */
+	u64 cookie, thread_cookie, root_cookie, start_ns;
+	u32 tgid;
+	bool used, released;
+};
+
+static DEFINE_SPINLOCK(hold_lock);
+static struct ant_exit_hold holds[ANT_EXIT_HOLD_SLOTS];
+
+static struct ant_exit_hold *hold_find(const struct ant_core_identity *identity)
+{
+	unsigned int i;
+
+	for (i = 0; i < ANT_EXIT_HOLD_SLOTS; i++)
+		if (holds[i].used && !holds[i].released && !holds[i].core &&
+		    holds[i].cookie == identity->cookie &&
+		    holds[i].start_ns == identity->start_ns && holds[i].tgid == identity->tgid)
+			return &holds[i];
+	return NULL;
+}
+
+bool ant_exit_hold(int wait_status, const kernel_siginfo_t *siginfo)
+{
+	/* The process's identity is its leader's, as PROCESS_LIST gives it. */
+	struct task_struct *leader = current->group_leader;
+	struct ant_task_state *state = ant_state(leader);
+	struct ant_exit_hold *hold = NULL;
+	struct ant_core *core;
+	unsigned int i;
+
+	if (READ_ONCE(state->exit_held) || !ant_run_holds_exit(current) || !current->mm ||
+	    (current->flags & (PF_KTHREAD | PF_USER_WORKER)) || ant_monitor_core_pending(current))
+		return false;
+	/* Once per process: its exit reaches the core hook more than once, and
+	 * from more than one thread (a sibling zapped by exit_group).
+	 */
+	WRITE_ONCE(state->exit_held, true);
+	if (fatal_signal_pending(current))
+		return false;
+	spin_lock(&hold_lock);
+	for (i = 0; i < ANT_EXIT_HOLD_SLOTS; i++)
+		if (!holds[i].used) {
+			hold = &holds[i];
+			init_completion(&hold->done);
+			hold->core = NULL;
+			hold->cookie = READ_ONCE(state->cookie);
+			hold->thread_cookie = READ_ONCE(ant_state(current)->cookie);
+			hold->root_cookie = ant_run_root_cookie(current);
+			hold->start_ns = leader->start_boottime;
+			hold->tgid = task_tgid_nr(current);
+			hold->released = false;
+			hold->used = true;
+			break;
+		}
+	spin_unlock(&hold_lock);
+	if (!hold)
+		return false;
+	/* The host learns of the hold from the record, then decides. */
+	ant_monitor_lifecycle_note("lifecycle.exit_hold",
+				   ANTC_EXIT_HOLD_MS | (u64)(u32)wait_status << 32);
+	wait_for_completion_killable_timeout(&hold->done, msecs_to_jiffies(ANTC_EXIT_HOLD_MS));
+	spin_lock(&hold_lock);
+	core = hold->core;
+	hold->used = false;
+	spin_unlock(&hold_lock);
+	if (!core)
+		return false;
+	ant_core_held_write(core, wait_status, siginfo);
+	ant_core_put(core);
+	return true;
+}
+
+int ant_exit_hold_claim(const struct ant_core_identity *identity, void *reply)
+{
+	struct ant_exit_hold *hold;
+	struct ant_core *core;
+	bool found;
+
+	spin_lock(&hold_lock);
+	found = hold_find(identity) != NULL;
+	spin_unlock(&hold_lock);
+	if (!found)
+		return -ESRCH;
+	core = ant_core_held_create(identity);
+	if (IS_ERR(core))
+		return PTR_ERR(core);
+	ant_core_reply(core, reply);
+	spin_lock(&hold_lock);
+	hold = hold_find(identity);
+	if (hold) {
+		/* The parked task writes the core and drops this reference. */
+		hold->core = core;
+		complete(&hold->done);
+	}
+	spin_unlock(&hold_lock);
+	if (hold)
+		return 0;
+	/* The hold ended while the handle was made: the host gets no handle. */
+	ant_core_discard(core);
+	return -ESRCH;
+}
+
+int ant_exit_hold_command(const u8 *args, size_t args_len)
+{
+	u64 cookie;
+	u32 action;
+	unsigned int i, released = 0;
+
+	if (args_len != 24 || get_unaligned_le32(args + 20))
+		return -EINVAL;
+	cookie = get_unaligned_le64(args + 8);
+	action = get_unaligned_le32(args + 16);
+	switch (action) {
+	case ANTC_EXIT_HOLD_ARM:
+	case ANTC_EXIT_HOLD_DISARM:
+		if (!cookie)
+			return -EINVAL;
+		if (action == ANTC_EXIT_HOLD_DISARM)
+			ant_exit_hold_release_run(cookie);
+		return ant_run_exit_hold(cookie, action == ANTC_EXIT_HOLD_ARM);
+	case ANTC_EXIT_HOLD_RELEASE:
+		spin_lock(&hold_lock);
+		for (i = 0; i < ANT_EXIT_HOLD_SLOTS; i++)
+			if (holds[i].used && !holds[i].released && !holds[i].core &&
+			    (!cookie || holds[i].cookie == cookie ||
+			     holds[i].thread_cookie == cookie)) {
+				holds[i].released = true;
+				complete(&holds[i].done);
+				released++;
+			}
+		spin_unlock(&hold_lock);
+		return released || !cookie ? 0 : -ESRCH;
+	default:
+		return -EINVAL;
+	}
+}
+
+void ant_exit_hold_release_run(u64 root_cookie)
+{
+	unsigned int i;
+
+	spin_lock(&hold_lock);
+	for (i = 0; i < ANT_EXIT_HOLD_SLOTS; i++)
+		if (holds[i].used && !holds[i].released && !holds[i].core &&
+		    holds[i].root_cookie == root_cookie) {
+			holds[i].released = true;
+			complete(&holds[i].done);
+		}
+	spin_unlock(&hold_lock);
+}
