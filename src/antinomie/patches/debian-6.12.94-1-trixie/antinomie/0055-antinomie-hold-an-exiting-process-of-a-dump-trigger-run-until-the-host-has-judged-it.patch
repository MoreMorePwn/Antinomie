+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef ANT_EXIT_HOLD_H
+#define ANT_EXIT_HOLD_H
+
+#include <linux/signal_types.h>
+#include <linux/types.h>
+
+struct ant_core_identity;
+
+/* exit_hold.c: park a process of an armed run at its exit until the host asks
+ * for its core or lets it go. True when the parked task wrote a core.
+ */
+bool ant_exit_hold(int wait_status, const kernel_siginfo_t *siginfo);
+/* CORE_CAPTURE of a held process: hand it a core handle (reply: the 24-byte
+ * arm reply). -ESRCH when no held process has that identity.
+ */
+int ant_exit_hold_claim(const struct ant_core_identity *identity, void *reply);
+/* EXIT_HOLD command (control_wire.h). */
+int ant_exit_hold_command(const u8 *args, size_t args_len);
+/* Let every held process of a run go (STOP_RUN, DISARM). */
+void ant_exit_hold_release_run(u64 root_cookie);
+
+#endif
