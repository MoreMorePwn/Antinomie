+/* The core of a process held at its exit (exit_hold.c): a live handle, as
+ * CORE_CAPTURE makes one, that the parked task writes itself with the exit
+ * core's writer, which reads every page, resident or not.
+ */
+struct ant_core *ant_core_held_create(const struct ant_core_identity *identity)
+{
+	struct ant_core *core = ant_core_live_create(identity);
+
+	if (IS_ERR(core))
+		return core;
+	mutex_lock(&core_lock);
+	core->flags = (core->flags & ~ANTC_CORE_RESIDENT_ONLY) | ANTC_CORE_EXIT_HELD;
+	mutex_unlock(&core_lock);
+	return core;
+}
+
+/* A handle nobody will write or read: off the list, and freed. */
+void ant_core_discard(struct ant_core *core)
+{
+	bool removed = false;
+
+	mutex_lock(&core_lock);
+	WRITE_ONCE(core->canceled, true);
+	if (!list_empty(&core->node)) {
+		list_del_init(&core->node);
+		removed = true;
+	}
+	mutex_unlock(&core_lock);
+	if (removed)
+		ant_core_put(core);
+	ant_core_put(core);
+}
+
 int ant_core_live_lookup(const struct ant_core_identity *identity, bool admission,
 			 struct ant_core **result)
 {
@@ -807,6 +841,24 @@ void ant_core_live_finish(struct ant_core *core, int error, u32 thread_count, bo
 	mutex_unlock(&core_lock);
 }
 
+/* The held task writes the core the host asked for (ant_exit_hold()). */
+void ant_core_held_write(struct ant_core *core, int wait_status,
+			 const kernel_siginfo_t *siginfo)
+{
+	u32 threads = get_nr_threads(current);
+	struct file *file = NULL;
+	int error = ant_core_live_prepare(core, &file);
+
+	if (!error) {
+		ant_core_live_begin(core);
+		error = ant_coredump_to_file(file, RLIM_INFINITY, wait_status, siginfo,
+					     core->deadline);
