diff --git a/kernel/antinomie/core_writer.c b/kernel/antinomie/core_writer.c
new file mode 100644
index 0000000..d49d281
--- /dev/null
+++ b/kernel/antinomie/core_writer.c
@@ -0,0 +1,404 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* The process cores the recorder writes with Linux's own ELF writer.
+ *
+ * An exit core runs fs/coredump.c's sequence (stop the other threads, take
+ * the VMA snapshot, write, release the threads), a live core only the
+ * writer. The stock helpers are static to fs/coredump.c, and calling them
+ * from a second place would make the compiler emit inlined helpers out of
+ * line, each a function of their own in the kernel's BTF and function tracer
+ * that Debian's build does not have; so the recorder carries its own copies
+ * of them (Linux 6.12.94's zap_process(), zap_threads(), coredump_wait(),
+ * coredump_finish(), dump_interrupted(), always_dump_vma(), vma_dump_size(),
+ * coredump_next_vma(), free_vma_snapshot(), cmp_vma_size() and
+ * dump_vma_snapshot()), named writer_* so that no symbol of the recorder has
+ * a stock function's name.
+ */
+#include <linux/antinomie_monitor.h>
+#include <linux/binfmts.h>
+#include <linux/coredump.h>
+#include <linux/elf.h>
+#include <linux/file.h>
+#include <linux/freezer.h>
+#include <linux/hugetlb.h>
+#include <linux/mm.h>
+#include <linux/sched/coredump.h>
+#include <linux/sched/signal.h>
+#include <linux/sched/task.h>
+#include <linux/slab.h>
+#include <linux/sort.h>
+#include <linux/uaccess.h>
+
+#include "process_core.h"
+
+static int writer_zap_process(struct signal_struct *signal, int exit_code)
+{
+	struct task_struct *t;
+	int nr = 0;
+
+	signal->flags = SIGNAL_GROUP_EXIT;
+	signal->group_exit_code = exit_code;
+	signal->group_stop_count = 0;
+
+	__for_each_thread(signal, t) {
+		task_clear_jobctl_pending(t, JOBCTL_PENDING_MASK);
+		if (t != current && !(t->flags & PF_POSTCOREDUMP)) {
+			sigaddset(&t->pending.signal, SIGKILL);
+			signal_wake_up(t, 1);
+			nr++;
+		}
+	}
+
+	return nr;
+}
+
+static int writer_zap_threads(struct task_struct *tsk, struct core_state *core_state,
+			      int exit_code)
+{
+	struct signal_struct *signal = tsk->signal;
+	int nr = -EAGAIN;
+
+	spin_lock_irq(&tsk->sighand->siglock);
+	if (!(signal->flags & SIGNAL_GROUP_EXIT) && !signal->group_exec_task) {
+		/* Allow SIGKILL, see prepare_signal() */
+		signal->core_state = core_state;
+		nr = writer_zap_process(signal, exit_code);
+		clear_tsk_thread_flag(tsk, TIF_SIGPENDING);
+		tsk->flags |= PF_DUMPCORE;
+		atomic_set(&core_state->nr_threads, nr);
+	}
+	spin_unlock_irq(&tsk->sighand->siglock);
+	return nr;
+}
+
+static int writer_wait(int exit_code, struct core_state *core_state)
+{
+	struct task_struct *tsk = current;
+	int core_waiters = -EBUSY;
+
+	init_completion(&core_state->startup);
+	core_state->dumper.task = tsk;
+	core_state->dumper.next = NULL;
+
+	core_waiters = writer_zap_threads(tsk, core_state, exit_code);
+	if (core_waiters > 0) {
+		struct core_thread *ptr;
+
+		wait_for_completion_state(&core_state->startup,
+					  TASK_UNINTERRUPTIBLE | TASK_FREEZABLE);
+		/* The thread context (extended register state) reaches memory. */
+		ptr = core_state->dumper.next;
+		while (ptr) {
+			wait_task_inactive(ptr->task, TASK_ANY);
+			ptr = ptr->next;
+		}
+	}
+
+	return core_waiters;
+}
+
+static void writer_finish(bool core_dumped)
+{
+	struct core_thread *curr, *next;
+	struct task_struct *task;
+
+	spin_lock_irq(&current->sighand->siglock);
+	if (core_dumped && !__fatal_signal_pending(current))
+		current->signal->group_exit_code |= 0x80;
+	next = current->signal->core_state->dumper.next;
+	current->signal->core_state = NULL;
+	spin_unlock_irq(&current->sighand->siglock);
+
+	while ((curr = next) != NULL) {
+		next = curr->next;
+		task = curr->task;
+		/* See coredump_task_exit(): curr->task must not see ->task == NULL
+		 * before we read ->next.
+		 */
+		smp_mb();
+		curr->task = NULL;
+		wake_up_process(task);
+	}
+}
+
+/* SIGKILL or freezing() interrupt the coredumping. */
+static bool writer_interrupted(void)
+{
+	return fatal_signal_pending(current) || freezing(current);
+}
+
+/* Special kernel mappings (vDSO, vsyscall) are in every core. */
+static bool writer_always_dump_vma(struct vm_area_struct *vma)
+{
+	if (vma == get_gate_vma(vma->vm_mm))
+		return true;
+	if (vma->vm_ops && vma->vm_ops->name && vma->vm_ops->name(vma))
+		return true;
+	if (arch_vma_name(vma))
+		return true;
+	return false;
+}
+
+#define DUMP_SIZE_MAYBE_ELFHDR_PLACEHOLDER 1
+
+/* How much of @vma's contents goes into a core (fs/coredump.c). */
+static unsigned long writer_vma_size(struct vm_area_struct *vma, unsigned long mm_flags)
+{
+#define FILTER(type)	(mm_flags & (1UL << MMF_DUMP_##type))
+
+	if (writer_always_dump_vma(vma))
+		goto whole;
+
+	if (vma->vm_flags & VM_DONTDUMP)
+		return 0;
+
+	if (vma_is_dax(vma)) {
+		if ((vma->vm_flags & VM_SHARED) && FILTER(DAX_SHARED))
+			goto whole;
+		if (!(vma->vm_flags & VM_SHARED) && FILTER(DAX_PRIVATE))
+			goto whole;
+		return 0;
+	}
+
+	if (is_vm_hugetlb_page(vma)) {
+		if ((vma->vm_flags & VM_SHARED) && FILTER(HUGETLB_SHARED))
+			goto whole;
+		if (!(vma->vm_flags & VM_SHARED) && FILTER(HUGETLB_PRIVATE))
+			goto whole;
+		return 0;
+	}
+
+	if (vma->vm_flags & VM_IO)
+		return 0;
+
+	if (vma->vm_flags & VM_SHARED) {
+		if (file_inode(vma->vm_file)->i_nlink == 0 ?
+		    FILTER(ANON_SHARED) : FILTER(MAPPED_SHARED))
+			goto whole;
+		return 0;
+	}
+
+	if ((!IS_ENABLED(CONFIG_MMU) || vma->anon_vma) && FILTER(ANON_PRIVATE))
+		goto whole;
+	if (!vma->vm_file)
+		return 0;
+
+	if (FILTER(MAPPED_PRIVATE))
+		goto whole;
+
+	/* The first page of an executable file mapping; of a library (not
+	 * always executable) only when it starts with the ELF magic, checked
+	 * after the mmap lock is dropped (writer_vma_snapshot()).
+	 */
+	if (FILTER(ELF_HEADERS) && vma->vm_pgoff == 0 && (vma->vm_flags & VM_READ)) {
+		if ((READ_ONCE(file_inode(vma->vm_file)->i_mode) & 0111) != 0)
+			return PAGE_SIZE;
+		return DUMP_SIZE_MAYBE_ELFHDR_PLACEHOLDER;
+	}
+
+#undef	FILTER
+
+	return 0;
+
+whole:
+	return vma->vm_end - vma->vm_start;
+}
+
+unsigned long ant_coredump_vma_size(struct vm_area_struct *vma, unsigned long flags)
+{
+	return writer_vma_size(vma, flags);
+}
+
+/* The VMAs in order, then the gate VMA. */
+static struct vm_area_struct *writer_next_vma(struct vma_iterator *vmi,
+					      struct vm_area_struct *vma,
+					      struct vm_area_struct *gate_vma)
+{
+	if (gate_vma && vma == gate_vma)
+		return NULL;
+
+	vma = vma_next(vmi);
+	if (vma)
+		return vma;
+	return gate_vma;
+}
+
+static void writer_free_vmas(struct coredump_params *cprm)
+{
+	int i;
+
+	if (!cprm->vma_meta)
+		return;
+	for (i = 0; i < cprm->vma_count; i++)
+		if (cprm->vma_meta[i].file)
+			fput(cprm->vma_meta[i].file);
+	kvfree(cprm->vma_meta);
+	cprm->vma_meta = NULL;
+}
+
+static int writer_cmp_vma_size(const void *lhs_ptr, const void *rhs_ptr)
+{
+	const struct core_vma_metadata *lhs = lhs_ptr, *rhs = rhs_ptr;
+
+	if (lhs->dump_size < rhs->dump_size)
+		return -1;
+	if (lhs->dump_size > rhs->dump_size)
+		return 1;
+	return 0;
+}
+
+/* Under the mmap lock, a snapshot of the task's VMAs (fs/coredump.c). */
+static bool writer_vma_snapshot(struct coredump_params *cprm)
+{
+	struct vm_area_struct *gate_vma, *vma = NULL;
+	struct mm_struct *mm = current->mm;
+
+	VMA_ITERATOR(vmi, mm, 0);
+	int i = 0;
+
+	if (mmap_write_lock_killable(mm))
+		return false;
+
+	cprm->vma_data_size = 0;
+	gate_vma = get_gate_vma(mm);
+	cprm->vma_count = mm->map_count + (gate_vma ? 1 : 0);
+
+	cprm->vma_meta = kvmalloc_array(cprm->vma_count, sizeof(*cprm->vma_meta), GFP_KERNEL);
+	if (!cprm->vma_meta) {
+		mmap_write_unlock(mm);
+		return false;
+	}
+
+	while ((vma = writer_next_vma(&vmi, vma, gate_vma)) != NULL) {
+		struct core_vma_metadata *m = cprm->vma_meta + i;
+
+		m->start = vma->vm_start;
+		m->end = vma->vm_end;
+		m->flags = vma->vm_flags;
+		m->dump_size = writer_vma_size(vma, cprm->mm_flags);
+		m->pgoff = vma->vm_pgoff;
+		m->file = vma->vm_file;
+		if (m->file)
+			get_file(m->file);
+		i++;
+	}
+
+	mmap_write_unlock(mm);
+
+	for (i = 0; i < cprm->vma_count; i++) {
+		struct core_vma_metadata *m = cprm->vma_meta + i;
+
+		if (m->dump_size == DUMP_SIZE_MAYBE_ELFHDR_PLACEHOLDER) {
+			char elfmag[SELFMAG];
+
+			if (copy_from_user(elfmag, (void __user *)m->start, SELFMAG) ||
+			    memcmp(elfmag, ELFMAG, SELFMAG) != 0)
+				m->dump_size = 0;
+			else
+				m->dump_size = PAGE_SIZE;
+		}
+
+		cprm->vma_data_size += m->dump_size;
+	}
+
+	if (ant_coredump_sort_vma())
+		sort(cprm->vma_meta, cprm->vma_count, sizeof(*cprm->vma_meta),
+		     writer_cmp_vma_size, NULL);
+
+	return true;
+}
+
+/* Nonfatal acquisition (manual_core.c): this path never calls
+ * coredump_wait/finish or installs signal->core_state.
+ */
+int ant_coredump_live_to_file(struct file *file, unsigned long limit,
+			      struct core_vma_metadata *vmas, unsigned int vma_count,
+			      struct ant_coredump_live *live)
+{
+	kernel_siginfo_t info = { .si_code = SI_KERNEL };
+	struct coredump_params cprm = {
+		.siginfo = &info, .file = file, .limit = limit,
+		.mm_flags = READ_ONCE(current->mm->flags),
+		.cpu = raw_smp_processor_id(), .vma_meta = vmas,
+		.vma_count = vma_count,
+	};
+	unsigned int i;
+	int error;
+
+	if (!current->mm->binfmt || !current->mm->binfmt->core_dump ||
+	    ant_arch_compat_task())
+		return -EOPNOTSUPP;
+	for (i = 0; i < vma_count; i++)
+		cprm.vma_data_size += vmas[i].dump_size;
+	ant_coredump_attach(live, live->deadline);
+	error = current->mm->binfmt->core_dump(&cprm) ? 0 : -EIO;
+	if (cprm.to_skip) {
+		cprm.to_skip--;
+		if (!dump_emit(&cprm, "", 1) && !error)
+			error = -EIO;
+	}
+	ant_coredump_attach(NULL, 0);
+	if (live->aborted(live->context) || writer_interrupted())
+		return -EINTR;
+	return error ?: (live->incomplete ? -ENODATA : 0);
+}
+
+/* Opt-in host acquisition shares the native ELF writer/rendezvous, but never
+ * synthesizes a core bit in the parent-visible wait status. No guest path or
+ * helper is used. The caller owns the bounded anonymous sink for this call.
+ */
+int ant_coredump_to_file(struct file *file, unsigned long limit, int wait_status,
+			 const kernel_siginfo_t *siginfo, unsigned long deadline)
+{
+	struct mm_struct *mm = current->mm;
+	struct core_state core_state;
+	kernel_siginfo_t normal_info = {
+		.si_signo = wait_status & 0x7f, .si_code = SI_KERNEL,
+	};
+	struct coredump_params cprm = {
+		.siginfo = siginfo ? siginfo : &normal_info,
+		.file = file,
+		.limit = limit,
+		.cpu = raw_smp_processor_id(),
+	};
+	int error;
+
+	if (!mm || !mm->binfmt || !mm->binfmt->core_dump || ant_arch_compat_task())
+		return -EOPNOTSUPP;
+	/* Bound metadata before the Linux writer allocates its snapshots. */
+	if (get_nr_threads(current) > 256)
+		return -E2BIG;
+	cprm.mm_flags = READ_ONCE(mm->flags);
+	error = writer_wait(wait_status, &core_state);
+	if (error < 0)
+		return error;
+	if (get_nr_threads(current) > 256) {
+		error = -E2BIG;
+		goto finish;
+	}
+	mmap_read_lock(mm);
+	error = mm->map_count > 4096 ? -E2BIG : 0;
+	mmap_read_unlock(mm);
+	if (error)
+		goto finish;
+	if (!writer_vma_snapshot(&cprm)) {
+		error = -ENOMEM;
+		goto finish;
+	}
+	/* Linux returns 'has_dumped' even after a short write. The sink and
+	 * ELF program-header extents provide the actual completion decision.
+	 */
+	ant_coredump_attach(NULL, deadline);
+	error = mm->binfmt->core_dump(&cprm) ? 0 : -EIO;
+	if (cprm.to_skip) {
+		cprm.to_skip--;
+		if (!dump_emit(&cprm, "", 1) && !error)
+			error = -EIO;
+	}
+	ant_coredump_attach(NULL, 0);
+	writer_free_vmas(&cprm);
+	if (writer_interrupted())
+		error = -EINTR;
+finish:
+	writer_finish(false);
+	return error;
+}
