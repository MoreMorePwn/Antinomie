+/* Whether every page of [address, address + size) can be read without
+ * faulting; a recaptured field is published only then.
+ */
+static bool resident(u64 address, u64 size)
+{
+	u64 page, last;
+	u8 byte;
+
+	if (check_add_overflow(address, size - 1, &last))
+		return false;
+	for (page = address & PAGE_MASK;; page += PAGE_SIZE) {
+		if (copy_from_user_nofault(&byte,
+				(void __user *)(unsigned long)max(page, address), 1))
+			return false;
+		if (page == (last & PAGE_MASK))
+			return true;
+	}
+}
+
+static void recapture_field(struct ant_task *ctx, const struct ant_recapture *r)
+{
+	u64 size = r->size;
+	long len;
+
+	if (r->string) {
+		len = strnlen_user_nofault((void __user *)(unsigned long)r->address,
+					   r->declared_size);
+		if (len <= 0 || len > r->declared_size)
+			return;
+		size = len;
+		ctx->string_field = true;
+	} else if (!size || size == U64_MAX || !resident(r->address, size)) {
+		return;
+	}
+	field(ctx, r->arg_index, r->key, r->layout, r->encoding, r->address, NULL,
+	      size, r->declared_size, ANT_COMPLETE);
+	ctx->string_field = false;
+}
+
+/* After a successful exec the caller's memory is gone, but the kernel copied
+ * the argument and environment strings to the new image's stack, which no
+ * user code has run on yet: [arg_start, arg_end) and [env_start, env_end).
+ * The strings from the resume point on are read from there. An interpreter
+ * (a script, binfmt_misc) rewrote the argument list, so only its environment
+ * is recovered.
+ */
+static void exec_recover(struct ant_task *ctx, int slot)
+{
+	const struct ant_exec_resume *resume = &ctx->exec_resume[slot];
+	struct mm_struct *mm = current->mm;
+	u64 start, end, count = slot ? ctx->exec_envc : ctx->exec_argc, i, limit;
+	char key[80];
+	long len;
+
+	if (!resume->pending || !mm || (!slot && !ctx->exec_argv_intact))
+		return;
+	spin_lock(&mm->arg_lock);
+	start = slot ? mm->env_start : mm->arg_start;
+	end = slot ? mm->env_end : mm->arg_end;
+	spin_unlock(&mm->arg_lock);
+	for (i = 0; i < count && start < end && !ctx->failed_count; i++) {
+		limit = min_t(u64, end - start, MAX_ARG_STRLEN);
+		len = strnlen_user_nofault((void __user *)(unsigned long)start, limit);
+		if (len <= 0 || len > limit)
+			return;
+		if (i >= resume->index) {
+			scnprintf(key, sizeof(key), "arg%u.string[%llu]", resume->arg_index, i);
+			ctx->string_field = true;
+			field(ctx, resume->arg_index, key, "", 2, start, NULL, len,
+			      MAX_ARG_STRLEN, ANT_COMPLETE);
+			ctx->string_field = false;
+		}
+		start += len;
+	}
+}
+
+/* Contract 22, at the end of the Exit: each input the Entry recorded
+ * NOT_RESIDENT is read again, still without faulting, and published only if
+ * all of it is resident now, marked RECAPTURED. If the call replaced the
+ * address space (a successful exec), the caller's memory is gone: the path is
+ * the exec's own copy and the vectors are read from the new image, marked
+ * KERNEL_COPY too; nothing else is read.
+ */
+static void recapture(struct ant_task *ctx)
+{
+	bool same_mm = current->mm == ctx->entry_mm;
+	const struct ant_recapture *r;
+	int i;
+
+	if (!ctx->recapture_count && !ctx->exec_resume[0].pending &&
+	    !ctx->exec_resume[1].pending)
+		return;
+	ctx->field_mark = ANT_FIELD_RECAPTURED;
+	for (i = 0; i < ctx->recapture_count && !ctx->failed_count; i++) {
+		r = &ctx->recapture[i];
+		if (r->done)
+			continue;
+		if (same_mm) {
+			recapture_field(ctx, r);
+		} else if (r->exec_path && ctx->exec_name) {
+			ctx->field_mark |= ANT_FIELD_KERNEL_COPY;
+			ctx->kernel_imported = true;
+			field(ctx, r->arg_index, r->key, "", 2, r->address, ctx->exec_name,
+			      strlen(ctx->exec_name) + 1, r->declared_size, ANT_COMPLETE);
+			ctx->kernel_imported = false;
+			ctx->field_mark = ANT_FIELD_RECAPTURED;
+		}
+	}
+	for (i = 0; i < ARRAY_SIZE(ctx->exec_resume) && !ctx->failed_count; i++) {
+		if (!ctx->exec_resume[i].pending)
+			continue;
+		if (same_mm) {
+			exec_vector(ctx, i, ctx->exec_resume[i].arg_index,
+				    ctx->exec_resume[i].vector, ctx->exec_resume[i].index,
+				    &ctx->exec_budget);
+		} else if (ctx->exec_committed) {
+			ctx->field_mark |= ANT_FIELD_KERNEL_COPY;
+			exec_recover(ctx, i);
+			ctx->field_mark = ANT_FIELD_RECAPTURED;
+		}
+	}
+	ctx->field_mark = 0;
+}
+
+static void recapture_reset(struct ant_task *ctx)
+{
+	ctx->recapture_count = 0;
+	memset(ctx->exec_resume, 0, sizeof(ctx->exec_resume));
+	ctx->exec_committed = false;
+	kfree(ctx->exec_name);
+	ctx->exec_name = NULL;
+}
+
+/* At an exec's commit, still inside the traced call: the exec's own copy of
+ * the path, kept only when the Entry could not read it, and what the exit
+ * needs to find the strings on the new image's stack.
+ */
+void ant_monitor_exec_names(const struct linux_binprm *bprm)
+{
+	struct ant_task *ctx = current->ant_monitor;
+	const char *name = bprm->filename;
+	char prefix[24];
+	int i, n;
+
+	if (!ctx || !ctx->active || ctx->busy || ctx->abi != 1 ||
+	    (ctx->nr != 59 && ctx->nr != 322))
+		return;
+	ctx->exec_committed = true;
+	ctx->exec_argv_intact = bprm->interp == bprm->filename;
+	ctx->exec_argc = bprm->argc;
+	ctx->exec_envc = bprm->envc;
+	for (i = 0; i < ctx->recapture_count; i++) {
+		if (!ctx->recapture[i].exec_path || ctx->exec_name)
+			continue;
+		/* execveat relative to a descriptor names "/dev/fd/N" (empty path)
+		 * or "/dev/fd/N/<path>"; the caller's string is what follows.
+		 */
+		if (bprm->fdpath) {
+			n = scnprintf(prefix, sizeof(prefix), "/dev/fd/%d", (int)ctx->args[0]);
+			if (strncmp(name, prefix, n))
+				return;
+			name += n;
+			if (*name == '/')
+				name++;
+			else if (*name)
+				return;
+		}
+		ctx->exec_name = kstrdup(name, GFP_KERNEL | __GFP_NOWARN);
+	}
+}
