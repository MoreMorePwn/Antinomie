Description: antinomie: count io_uring workers in the run, so the root's exit is not lost
Author: MikiMiku <jonathanirvinjo@gmail.com>
Origin: project
Forwarded: no
Last-Update: 2026-10-21

An io_uring worker or SQPOLL thread is a thread of the process that created its ring, but the run did not count it. When it was the last thread to leave the group (after a native core rendezvous, or a group exit with requests still on the workers) nothing recorded the root's wait status: the leader had already taken the live count to zero, so RUN_STATUS reported TREE_EXITED without ROOT_EXITED, which the host rejects as an inconsistent reply.  The workers now join the run as members. They get no cookie and are not observed, but they are counted in the live and total task counts, and the thread that leaves the group last records the root status whatever it is. A worker never starts or signals the process core rendezvous; when it is the last out of an armed run the core is published as unavailable, as for any other last exit that bypassed acquisition.

---
diff --git a/include/linux/antinomie_monitor.h b/include/linux/antinomie_monitor.h
index 22961da56..84442a6ce 100644
--- a/include/linux/antinomie_monitor.h
+++ b/include/linux/antinomie_monitor.h
@@ -97,6 +97,7 @@ struct ant_hash_job *ant_monitor_delete_prepare(const struct path *parent,
 void ant_monitor_delete_done(struct ant_hash_job *job, int error);
 void ant_monitor_specimen_exec(struct file *file);
 bool ant_monitor_core_armed(struct task_struct *task);
+bool ant_monitor_core_pending(struct task_struct *task);
 bool ant_monitor_core_exit(int wait_status, const struct kernel_siginfo *siginfo);
 void ant_monitor_core_unavailable(int wait_status);
 void ant_monitor_task_exit(bool group_dead);
@@ -174,6 +175,10 @@ static inline bool ant_monitor_core_armed(struct task_struct *task)
 {
 	return false;
 }
+static inline bool ant_monitor_core_pending(struct task_struct *task)
+{
+	return false;
+}
 static inline bool ant_monitor_core_exit(int wait_status,
 					 const struct kernel_siginfo *siginfo)
 {
diff --git a/kernel/antinomie/process_core.c b/kernel/antinomie/process_core.c
index 8ae8db4f7..9198338a1 100644
--- a/kernel/antinomie/process_core.c
+++ b/kernel/antinomie/process_core.c
@@ -741,7 +741,8 @@ bool ant_monitor_core_exit(int wait_status, const kernel_siginfo_t *siginfo)
 	if ((siginfo && siginfo->si_signo == SIGKILL) ||
 	    (!siginfo && (wait_status & 0x7f) == SIGKILL))
 		return false;
-	if (!current->ant_root_process || !current->mm)
+	if (!current->ant_root_process || !current->mm ||
+	    (current->flags & PF_USER_WORKER))
 		return false;
 	mutex_lock(&core_lock);
 	list_for_each_entry(core, &cores, node)
@@ -808,9 +809,9 @@ bool ant_monitor_core_exit(int wait_status, const kernel_siginfo_t *siginfo)
 void ant_monitor_core_unavailable(int wait_status)
 {
 	struct ant_core *core;
-	u64 root_cookie = current->ant_root_cookie;
+	u64 root_cookie = ant_run_root_cookie(current);
 
-	if (!ant_monitor_core_armed(current))
+	if (!ant_monitor_core_pending(current))
 		return;
 	mutex_lock(&core_lock);
 	list_for_each_entry(core, &cores, node)
diff --git a/kernel/antinomie/recorder.c b/kernel/antinomie/recorder.c
index 670d3d3ad..3811e9d8a 100644
--- a/kernel/antinomie/recorder.c
+++ b/kernel/antinomie/recorder.c
@@ -1311,8 +1311,18 @@ u64 ant_monitor_stream_id(void)
 void ant_monitor_fork_prepare(struct task_struct *child)
 {
 	WRITE_ONCE(child->ant_observer_cookie, READ_ONCE(current->ant_observer_cookie));
-	if (!current->ant_run || child->flags & PF_USER_WORKER)
+	if (!current->ant_run)
 		return;
+	/* An io_uring worker is a thread of the creating process, but not a
+	 * task the program started: it is invisible to the observer and carries
+	 * no cookie. The run still counts it, because the process is not gone,
+	 * and its status not final, until the group's last thread has exited,
+	 * and that can be a worker (see ant_run_exit()).
+	 */
+	if (child->flags & PF_USER_WORKER) {
+		ant_run_fork(current, child);
+		return;
+	}
 	ant_monitor_cookie(child);
 	WRITE_ONCE(child->ant_root_cookie, READ_ONCE(current->ant_root_cookie));
 	ant_run_fork(current, child);
diff --git a/kernel/antinomie/run.c b/kernel/antinomie/run.c
index f032a7bfa..f440bcdc2 100644
--- a/kernel/antinomie/run.c
+++ b/kernel/antinomie/run.c
@@ -68,13 +68,30 @@ static struct ant_run *find_run(u64 cookie)
  * bit under sighand->siglock without nesting a sleepable acquisition lock.
  * Only the launched root thread group changes fatal-signal rendezvous policy.
  */
-bool ant_monitor_core_armed(struct task_struct *task)
+bool ant_monitor_core_pending(struct task_struct *task)
 {
 	struct ant_run *run = READ_ONCE(task->ant_run);
 
 	return READ_ONCE(task->ant_root_process) && run && READ_ONCE(run->core_armed);
 }
 
+/* An io_uring worker belongs to the launched process, but a signal aimed at
+ * it never starts the process rendezvous.
+ */
+bool ant_monitor_core_armed(struct task_struct *task)
+{
+	return !(READ_ONCE(task->flags) & PF_USER_WORKER) &&
+		ant_monitor_core_pending(task);
+}
+
+/* The launch cookie of the run @task belongs to, or 0. */
+u64 ant_run_root_cookie(struct task_struct *task)
+{
+	struct ant_run *run = READ_ONCE(task->ant_run);
+
+	return run ? run->root_cookie : 0;
+}
+
 void ant_run_core_arm(u64 root_cookie, bool armed)
 {
 	struct ant_run *run;
@@ -125,6 +142,12 @@ void ant_run_fork(struct task_struct *parent, struct task_struct *child)
 	spin_unlock_irqrestore(&run_lock, irqflags);
 }
 
+/* Every thread of a run's process counts, including the io_uring workers
+ * (iou-wrk, iou-sqp) the kernel adds to it: the root's wait status is taken by
+ * the thread that leaves the group last, and with a core rendezvous or a
+ * group exit that can be a worker well after the leader has gone. A worker
+ * that was not counted left the run with TREE_EXITED and no ROOT_EXITED.
+ */
 bool ant_run_exit(struct task_struct *task, bool group_dead)
 {
 	struct ant_run *run = task->ant_run;
diff --git a/kernel/antinomie/run.h b/kernel/antinomie/run.h
index 273938e80..1638169d2 100644
--- a/kernel/antinomie/run.h
+++ b/kernel/antinomie/run.h
@@ -12,6 +12,7 @@ bool ant_run_exit(struct task_struct *task, bool group_dead);
 int ant_run_signal(u64 root_cookie, int sig, bool *issued);
 void ant_run_stop_arm(u64 root_cookie, u32 grace_ms);
 void ant_run_core_arm(u64 root_cookie, bool armed);
+u64 ant_run_root_cookie(struct task_struct *task);
 void ant_run_async_start(u64 root_cookie);
 void ant_run_async_finish(u64 root_cookie);
 void ant_run_async_loss(u64 root_cookie);
diff --git a/kernel/exit.c b/kernel/exit.c
index d75d953c3..8f08eb2f8 100644
--- a/kernel/exit.c
+++ b/kernel/exit.c
@@ -925,7 +925,7 @@ void __noreturn do_exit(long code)
 	audit_free(tsk);
 
 	tsk->exit_code = code;
-	if (group_dead && ant_monitor_core_armed(tsk))
+	if (group_dead && ant_monitor_core_pending(tsk))
 		ant_monitor_core_unavailable(tsk->signal->flags & SIGNAL_GROUP_EXIT ?
 					     tsk->signal->group_exit_code :
 					     tsk->group_leader->exit_code);
