diff --git a/arch/x86/entry/common.c b/arch/x86/entry/common.c
index 040ff04e3..0c6bdd0c2 100644
--- a/arch/x86/entry/common.c
+++ b/arch/x86/entry/common.c
@@ -20,6 +20,7 @@
 #include <linux/syscalls.h>
 #include <linux/uaccess.h>
 #include <linux/init.h>
+#include <linux/antinomie_monitor.h>
 
 #include <asm/apic.h>
 #include <asm/desc.h>
@@ -74,11 +75,13 @@ __visible noinstr bool do_syscall_64(struct pt_regs *regs, int nr)
 	nr = syscall_enter_from_user_mode(regs, nr);
 
 	instrumentation_begin();
+	ant_monitor_enter(regs, nr);
 
 	if (!do_syscall_x64(regs, nr) && !do_syscall_x32(regs, nr) && nr != -1) {
 		/* Invalid system call, but still a system call. */
 		regs->ax = __x64_sys_ni_syscall(regs);
 	}
+	ant_monitor_exit(regs);
 
 	instrumentation_end();
 	syscall_exit_to_user_mode(regs);
@@ -155,12 +158,15 @@ static __always_inline void do_syscall_32_irqs_on(struct pt_regs *regs, int nr)
 	 */
 	unsigned int unr = nr;
 
+	ant_monitor_enter(regs, nr);
+
 	if (likely(unr < IA32_NR_syscalls)) {
 		unr = array_index_nospec(unr, IA32_NR_syscalls);
 		regs->ax = ia32_sys_call(regs, unr);
 	} else if (nr != -1) {
 		regs->ax = __ia32_sys_ni_syscall(regs);
 	}
+	ant_monitor_exit(regs);
 }
 
