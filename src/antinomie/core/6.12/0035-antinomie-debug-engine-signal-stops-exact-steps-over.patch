@@ -489,6 +590,15 @@ static bool bp_at(struct ant_dbg *s, u64 addr)
 
 /* ---- trap glue (exception context, interrupts off) --------------------- */
 
+/* The thread is part of the debugged program: a thread of the group, or a
+ * vfork child that shares its address space until it execs.
+ */
+static bool is_member(struct ant_dbg *s)
+{
+	return same_thread_group(current, s->leader) ||
+		(s->mm && READ_ONCE(current->mm) == s->mm);
+}
+
 /* A thread created since the last stop has no record. Hand it one of the
  * spares allocated ahead of time (no allocation in exception context) so its
  * breakpoint is a stop, not a SIGTRAP. The worker refills the spares.
@@ -498,7 +608,7 @@ static struct ant_dbg_thread *adopt_current(struct ant_dbg *s)
 	struct ant_dbg_thread *t = NULL;
 	unsigned long flags;
 
-	if (!same_thread_group(current, s->leader))
+	if (!is_member(s))
 		return NULL;
 	spin_lock_irqsave(&s->lock, flags);
 	if (s->nspare && s->records < MAX_RECORDS) {
@@ -517,25 +627,128 @@ static struct ant_dbg_thread *adopt_current(struct ant_dbg *s)
 	return t;
 }
 
+/* The record of the running thread, made on the spot (task context, may
+ * sleep): signals reach threads the engine has not seen yet.
+ */
+static struct ant_dbg_thread *current_record(struct ant_dbg *s)
+{
+	struct ant_dbg_thread *t, *fresh;
+
+	rcu_read_lock();
+	t = find_thread(s, current);
+	rcu_read_unlock();
+	if (t)
+		return t;
+	t = adopt_current(s);
+	if (t)
+		return t;
+	fresh = kzalloc(sizeof(*fresh), GFP_KERNEL);
+	if (!fresh)
+		return NULL;
+	fresh->session = s;
+	fresh->task = current;
+	fresh->tid = task_pid_nr(current);
+	fresh->state = T_RUNNING;
+	init_task_work(&fresh->work, park_work);
+	spin_lock_irq(&s->lock);
+	rcu_read_lock();
+	t = find_thread(s, current);
+	rcu_read_unlock();
+	if (!t && s->records < MAX_RECORDS) {
+		get_task_struct(current);
+		s->records++;
+		list_add_tail_rcu(&fresh->node, &s->threads);
+		s->want |= W_SYNC;
+		t = fresh;
+		fresh = NULL;
+	}
+	spin_unlock_irq(&s->lock);
+	kfree(fresh);
+	return t;
+}
+
+/* A forked child has its own copy of the memory, and with it the byte of a
+ * breakpoint that was in when it forked. Put the original back, from the
+ * child's own context, and let it run: it must not die of a SIGTRAP the
+ * debugger never sees.
+ */
+struct ant_dbg_repair {
+	struct callback_head work;
+	u64 addr;
+	u32 len;
+	u8 orig[ANT_DBG_MAX_BP_LEN];
+};
+
+static void repair_work(struct callback_head *work)
+{
+	struct ant_dbg_repair *r = container_of(work, struct ant_dbg_repair, work);
+
+	access_process_vm(current, r->addr, r->orig, r->len, FOLL_FORCE | FOLL_WRITE);
+	kfree(r);
+}
+
+static bool repair_foreign(struct ant_dbg *s, struct pt_regs *regs, u64 addr)
+{
+	struct ant_dbg_repair *r;
+	unsigned long flags;
+	unsigned int i;
+	bool found = false;
+
+	if (!s->mm || READ_ONCE(current->mm) == s->mm || !READ_ONCE(current->ant_root_cookie) ||
+	    READ_ONCE(current->ant_root_cookie) != READ_ONCE(s->leader->ant_root_cookie))
+		return false;
+	r = kmalloc(sizeof(*r), GFP_ATOMIC | __GFP_NOWARN);
+	if (!r)
+		return false;
+	spin_lock_irqsave(&s->lock, flags);
+	for (i = 0; i < HIST_ENTRIES; i++)
+		if (s->hist[i].addr == addr) {
+			r->addr = addr;
+			r->len = s->hist[i].len;
+			memcpy(r->orig, s->hist[i].orig, r->len);
+			found = true;
+			break;
+		}
+	spin_unlock_irqrestore(&s->lock, flags);
+	if (!found) {
+		kfree(r);
+		return false;
+	}
+	init_task_work(&r->work, repair_work);
+	if (task_work_add(current, &r->work, TWA_RESUME)) {
+		kfree(r);
+		return false;
+	}
+	ant_dbg_arch_set_pc(regs, addr);
+	return true;
+}
