+
+/* The temporary breakpoint of a step that runs to the next instruction. */
+static int tmp_insert(struct ant_dbg *s, u64 addr)
+{
+	u8 insn[ANT_DBG_MAX_BP_LEN], orig[ANT_DBG_MAX_BP_LEN];
+	unsigned int len = ant_dbg_arch_bp_insn(1, insn);
+
+	if (!len || mem_access(s, addr, orig, len, false) != len ||
+	    mem_access(s, addr, insn, len, true) != len)
+		return -EFAULT;
+	spin_lock_irq(&s->lock);
+	s->tmp_addr = addr;
+	s->tmp_len = len;
+	memcpy(s->tmp_orig, orig, len);
+	s->tmp_inserted = true;
+	hist_note(s, addr, orig, len);
+	spin_unlock_irq(&s->lock);
+	return 0;
+}
+
+static void restore_byte(struct ant_dbg *s, u64 addr, const u8 *orig, unsigned int len);
+
+static void tmp_remove(struct ant_dbg *s)
+{
+	u8 orig[ANT_DBG_MAX_BP_LEN];
+	u64 addr;
+	u32 len;
+
+	spin_lock_irq(&s->lock);
+	if (!s->tmp_inserted) {
 		spin_unlock_irq(&s->lock);
+		return;
 	}
+	addr = s->tmp_addr;
+	len = s->tmp_len;
+	memcpy(orig, s->tmp_orig, len);
+	s->tmp_inserted = false;
+	spin_unlock_irq(&s->lock);
+	restore_byte(s, addr, orig, len);
+}
+
+/* Put the program's own bytes back where the engine's byte still is. The
+ * program may have rewritten the location while it ran (self-modifying code, a
+ * JIT): then the new bytes are its own and the old ones must not come back.
+ * The read must not be shadowed, so the breakpoint is marked out first.
+ */
+static void restore_byte(struct ant_dbg *s, u64 addr, const u8 *orig, unsigned int len)
+{
+	u8 insn[ANT_DBG_MAX_BP_LEN], now[ANT_DBG_MAX_BP_LEN];
+
+	if (ant_dbg_arch_bp_insn(len, insn) == len &&
+	    mem_access(s, addr, now, len, false) == len && !memcmp(now, insn, len))
+		mem_access(s, addr, (void *)orig, len, true);
 }
 
