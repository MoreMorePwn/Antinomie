 kernel/antinomie/control.c      |   4 +
 kernel/antinomie/control_wire.h |  18 +++
 kernel/antinomie/resources.c    | 203 ++++++++++++++++++++++++++++++++
 kernel/antinomie/resources.h    |   8 ++
 5 files changed, 234 insertions(+)
 create mode 100644 kernel/antinomie/resources.c
 create mode 100644 kernel/antinomie/resources.h

