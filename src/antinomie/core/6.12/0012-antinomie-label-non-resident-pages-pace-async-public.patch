diff --git a/kernel/antinomie/async.c b/kernel/antinomie/async.c
index 9924a38d2..05845bd92 100644
--- a/kernel/antinomie/async.c
+++ b/kernel/antinomie/async.c
@@ -3,7 +3,9 @@
 #include <linux/antinomie.h>
 #include <linux/atomic.h>
 #include <linux/cred.h>
+#include <linux/delay.h>
 #include <linux/errno.h>
+#include <linux/jiffies.h>
 #include <linux/ktime.h>
 #include <linux/overflow.h>
 #include <linux/refcount.h>
@@ -12,9 +14,11 @@
 #include <linux/sched/signal.h>
 #include <linux/slab.h>
 #include <linux/spinlock.h>
+#include <linux/uio.h>
 #include <linux/workqueue.h>
 #include <uapi/linux/io_uring.h>
 
+#include "abi.h"
 #include "async.h"
 #include "capture_api.h"
 #include "run.h"
@@ -44,6 +48,9 @@ struct ant_aio_reap {
 	struct mm_struct *mm;
 	const void *ioctx;	/* compared only */
 	u64 buf, len;
+	/* A vectored read: the kernel's copy of its iovec array, owned here. */
+	struct iovec *iov;
+	unsigned long nr_segs;
 	s64 res;
 	unsigned int ring_slot;
 	bool completed, used;
@@ -125,6 +132,22 @@ static void stage_record(struct ant_async *request, u32 stage, s64 result,
 	schedule_work(&publish_work);
 }
 
+/* A burst of queued records is published by one worker on one CPU. Before
+ * each record it waits, up to ANT_ASYNC_PACE_MS, until that CPU's ring is at
+ * most half full, so the burst cannot crowd out the syscall events of tasks
+ * running there. After the wait it publishes anyway; drops are counted.
+ */
+#define ANT_ASYNC_PACE_MS 10
+
+static void await_room(void)
+{
+	unsigned long deadline = jiffies + msecs_to_jiffies(ANT_ASYNC_PACE_MS);
+
+	while (ant_send_room() < ANT_TELEMETRY_RING_SIZE / 2 &&
+	       time_before(jiffies, deadline))
+		usleep_range(100, 200);
+}
+
 static void publish_records(struct work_struct *work)
 {
 	static struct ant_async_record record;
@@ -141,6 +164,7 @@ static void publish_records(struct work_struct *work)
 		record_head = (record_head + 1) % ANT_ASYNC_RECORD_COUNT;
 		record_count--;
 		spin_unlock_irqrestore(&record_lock, irqflags);
+		await_room();
 		if (record.packet_len) {
 			error = ant_send(record.packet, record.packet_len);
 			if (error)
@@ -568,16 +592,37 @@ void ant_monitor_async_gap(struct ant_async **slot, const char *key, u64 address
 /* Register an AIO read before it is started, so an interrupt completion that
  * races with read_iter() cannot count the missing output before it is owned.
  */
-u64 ant_monitor_aio_defer(struct ant_async **slot, const void *ioctx, u64 buf, u64 len)
+u64 ant_monitor_aio_defer(struct ant_async **slot, const void *ioctx,
+			  const struct iov_iter *iter)
 {
-	struct ant_async *request = get_request(slot, false);
+	struct ant_async *request;
 	struct ant_aio_reap *entry = NULL;
-	unsigned long irqflags, reapflags;
-	u64 request_id = 0;
+	struct iovec *iov = NULL;
+	unsigned long irqflags, reapflags, nr_segs = 0;
+	u64 buf = 0, request_id = 0;
 	int i;
 
-	if (!request)
+	/* PREAD imports a single user buffer. PREADV with more than one
+	 * segment keeps the iovec array the kernel imported, so the reap reads
+	 * exactly the buffers the read filled, whatever the process later
+	 * writes to its own array.
+	 */
+	if (iter_is_ubuf(iter)) {
+		buf = (unsigned long)iter->ubuf + iter->iov_offset;
+	} else if (iter_is_iovec(iter) && !iter->iov_offset) {
+		nr_segs = iter->nr_segs;
+		iov = kmemdup_array(iter_iov(iter), nr_segs, sizeof(*iov),
+				    GFP_KERNEL | __GFP_NOWARN);
+		if (!iov)
+			return 0;
+	} else {
 		return 0;
+	}
+	request = get_request(slot, false);
+	if (!request) {
+		kfree(iov);
+		return 0;
+	}
 	spin_lock_irqsave(&reap_lock, reapflags);
 	for (i = 0; i < ANT_AIO_REAP_COUNT; i++) {
 		if (!reaps[i].used) {
@@ -594,7 +639,9 @@ u64 ant_monitor_aio_defer(struct ant_async **slot, const void *ioctx, u64 buf, u
 		entry->mm = current->mm;
 		entry->ioctx = ioctx;
 		entry->buf = buf;
-		entry->len = len;
+		entry->len = iov_iter_count(iter);
+		entry->iov = iov;
+		entry->nr_segs = nr_segs;
 		entry->res = 0;
 		entry->completed = false;
 		entry->used = true;
@@ -603,10 +650,18 @@ u64 ant_monitor_aio_defer(struct ant_async **slot, const void *ioctx, u64 buf, u
 	}
 	spin_unlock_irqrestore(&reap_lock, reapflags);
 	/* A full table leaves the gap to finish_request(), which counts it. */
+	if (!entry)
+		kfree(iov);
 	put_request(request);
 	return request_id;
 }
 
+static void reap_release(struct ant_aio_reap *entry)
+{
+	kfree(entry->iov);
+	event_release(&entry->event);
+}
+
 /* Removes the entry for request_id; the caller releases its event. */
 static bool reap_take(struct ant_aio_reap *out, u64 request_id)
 {
@@ -637,7 +692,7 @@ void ant_monitor_aio_undefer(struct ant_async **slot, u64 request_id)
 
 	if (!request_id || !reap_take(&entry, request_id))
 		return;
-	event_release(&entry.event);
+	reap_release(&entry);
 	request = get_request(slot, false);
 	if (!request)
 		return;
@@ -695,18 +750,26 @@ void ant_monitor_aio_completed(u64 request_id, const void *ioctx, unsigned int r
 	}
 	spin_unlock_irqrestore(&reap_lock, flags);
 	if (drop)
-		event_release(&dropped.event);
+		reap_release(&dropped);
 }
 
 static int reap_capture(const struct ant_aio_reap *entry, u64 size)
 {
 	struct ant_task *ctx = ant_monitor_async_capture_alloc();
+	struct iov_iter iter;
 	int error;
 
 	if (!ctx)
 		return -ENOMEM;
-	error = ant_monitor_async_capture_memory(ctx, &entry->event, "async.payload.output",
-						 "", 1, entry->buf, NULL, size, 7, -1);
+	if (entry->iov) {
+		iov_iter_init(&iter, ITER_DEST, entry->iov, entry->nr_segs, entry->len);
+		error = ant_monitor_async_capture_stage(ctx, &entry->event, &iter, size,
+							0, true, 7);
+	} else {
+		error = ant_monitor_async_capture_memory(ctx, &entry->event,
+							 "async.payload.output", "", 1,
+							 entry->buf, NULL, size, 7, -1);
+	}
 	ant_monitor_async_capture_free(ctx);
 	return error;
 }
@@ -742,7 +805,7 @@ void ant_monitor_aio_consumed(const void *ioctx, unsigned int first, unsigned in
 		entry.event.flags &= ~ANT_ASYNC_PAYLOAD_GAP;
 		if (reap_capture(&entry, min_t(u64, entry.res, entry.len)))
 			ant_run_async_loss(entry.event.root_cookie);
-		event_release(&entry.event);
+		reap_release(&entry);
 	}
 }
 
@@ -767,7 +830,7 @@ static void reap_drop(struct mm_struct *mm, const void *ioctx)
 		atomic_dec(&reap_used);
 		spin_unlock_irqrestore(&reap_lock, flags);
 		ant_run_async_loss(entry.event.root_cookie);
-		event_release(&entry.event);
+		reap_release(&entry);
 	}
 }
 
