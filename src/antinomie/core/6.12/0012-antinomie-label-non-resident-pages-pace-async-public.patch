 	ANT_RESOURCE_EXHAUSTED, ANT_ABORTED_ON_LOSS, ANT_CONTEXT_MISSING,
-	ANT_NOT_WRITTEN,
+	ANT_NOT_WRITTEN, ANT_NOT_RESIDENT,
 };
 
 /* A native family returns this bit when it owns the whole syscall capture,
diff --git a/kernel/antinomie/guest.c b/kernel/antinomie/guest.c
index f4e7fe8ba..8e09fcd6c 100644
--- a/kernel/antinomie/guest.c
+++ b/kernel/antinomie/guest.c
@@ -85,6 +85,27 @@ int ant_send(const void *data, size_t payload_len)
 }
 EXPORT_SYMBOL_GPL(ant_send);
 
+u32 ant_send_room(void)
+{
+	struct ant_producer *p;
+	struct ant_queue *q;
+	u64 tail;
+	u32 room = U32_MAX;
+
+	/* Pairs with the release that publishes the rings at setup. */
+	if (!smp_load_acquire(&ready))
+		return room;
+	preempt_disable();
+	p = this_cpu_ptr(&producers);
+	q = &directory[p->index];
+	tail = ANT_ACQ(&q->tail);
+	if (!p->fault && tail <= p->head && p->head - tail <= ANT_TELEMETRY_RING_SIZE)
+		room = ANT_TELEMETRY_RING_SIZE - (p->head - tail);
+	preempt_enable();
+	return room;
+}
+EXPORT_SYMBOL_GPL(ant_send_room);
+
 int ant_register_command(u32 opcode, ant_command_handler fn, void *context)
 {
 	int i, free_slot = -1, error = -ENOSPC;
diff --git a/kernel/antinomie/recorder.c b/kernel/antinomie/recorder.c
index 24142a009..853a455de 100644
--- a/kernel/antinomie/recorder.c
+++ b/kernel/antinomie/recorder.c
@@ -189,6 +189,35 @@ static void event_end(struct ant_task *ctx)
 	publish(ctx, 5, 0, 0, 0, 32);
 }
 
+/* A no-fault copy fails on any page that is not resident, although the kernel
+ * would fault it in for the syscall. When every byte of [address, address +
+ * len) lies in readable mappings of the caller, the field is recorded as
+ * ANT_NOT_RESIDENT: mapped, not present, and never faulted in by the recorder.
+ * Otherwise, or when the classification would have to wait for mmap_lock,
+ * it stays ANT_COPY_FAULT.
+ */
+static enum ant_status fault_status(u64 address, u64 len)
+{
+	struct mm_struct *mm = current->mm;
+	struct vm_area_struct *vma;
+	enum ant_status status = ANT_COPY_FAULT;
+	u64 end;
+
+	if (!in_task() || !mm || (current->flags & PF_KTHREAD) || !address ||
+	    check_add_overflow(address, max_t(u64, len, 1), &end) ||
+	    end > TASK_SIZE_MAX || !mmap_read_trylock(mm))
+		return ANT_COPY_FAULT;
+	for (vma = vma_lookup(mm, address); vma && (vma->vm_flags & VM_READ);
+	     vma = vma_lookup(mm, vma->vm_end)) {
+		if (vma->vm_end >= end) {
+			status = ANT_NOT_RESIDENT;
+			break;
+		}
+	}
+	mmap_read_unlock(mm);
+	return status;
+}
+
 static void incomplete(struct ant_task *ctx, enum ant_status status)
 {
 	if (status == ANT_COMPLETE || status == ANT_NULL_POINTER ||
@@ -199,7 +228,7 @@ static void incomplete(struct ant_task *ctx, enum ant_status status)
 	if (status == ANT_NO_DECODER) {
 		ctx->state |= 8;
 		atomic64_inc(&schema_gaps);
-	} else if (status == ANT_COPY_FAULT) {
+	} else if (status == ANT_COPY_FAULT || status == ANT_NOT_RESIDENT) {
 		atomic64_inc(&copy_faults);
 	} else if (status == ANT_RESOURCE_EXHAUSTED || status == ANT_CONTEXT_MISSING) {
 		ctx->state |= 4;
@@ -249,6 +278,8 @@ static void field(struct ant_task *ctx, u8 arg_index, const char *key,
 			      declared_size > object_size ? 4 : 0), body + 36);
 	memcpy(body + 40, key, key_len);
 	memcpy(body + 40 + key_len, layout, layout_len);
+	if (status == ANT_COPY_FAULT && !snapshot)
+		status = fault_status(address, object_size == U64_MAX ? 1 : object_size);
 	if (publish(ctx, 2, id, 0, object_size, 40 + key_len + layout_len))
 		status = ANT_ABORTED_ON_LOSS;
 	if (!address && !snapshot && !ctx->iter_source && status == ANT_COMPLETE)
@@ -271,7 +302,8 @@ static void field(struct ant_task *ctx, u8 arg_index, const char *key,
 				(void __user *)(unsigned long)(address + captured_len),
 				chunk_size);
 		if (error) {
-			status = ANT_COPY_FAULT;
+			status = ctx->iter_source ? ANT_COPY_FAULT :
+				fault_status(address + captured_len, chunk_size);
 			break;
 		}
 		chunk_count++;
@@ -914,6 +946,15 @@ int ant_monitor_async_capture(struct ant_task *ctx,
 			      const struct ant_async_event *event,
 			      const struct iov_iter *source, size_t size,
 			      u64 result_offset, bool output)
+{
+	return ant_monitor_async_capture_stage(ctx, event, source, size, result_offset,
+					       output, output ? 4 : 1);
+}
+
+int ant_monitor_async_capture_stage(struct ant_task *ctx,
+				    const struct ant_async_event *event,
+				    const struct iov_iter *source, size_t size,
+				    u64 result_offset, bool output, u32 stage)
 {
 	struct ant_async_event observed = *event;
 	struct iov_iter iter = *source;
@@ -927,7 +968,7 @@ int ant_monitor_async_capture(struct ant_task *ctx,
 	if (ctx->busy)
 		return -EBUSY;
 	ctx->busy = true;
-	observed.stage = output ? 4 : 1;
+	observed.stage = stage;
 	observed.final = false;
 	observed.descriptor_len = 0;
 	observed.timestamp_ns = ktime_get_ns();
