 kernel/antinomie/guest.c          | 21 ++++++++
 kernel/antinomie/recorder.c       | 47 +++++++++++++++--
 8 files changed, 156 insertions(+), 22 deletions(-)

diff --git a/fs/aio.c b/fs/aio.c
index 1838acc1a..db8658aa1 100644
--- a/fs/aio.c
+++ b/fs/aio.c
@@ -1629,11 +1629,10 @@ static int aio_read(struct kiocb *req, const struct iocb *iocb,
 	if (!ret) {
 #ifdef CONFIG_ANTINOMIE
 		/* A queued read may complete in interrupt context, where its
-		 * buffer cannot be read; io_getevents() reads it instead.
+		 * buffers cannot be read; io_getevents() reads them instead.
 		 */
-		deferred = vectored ? 0 :
-			ant_monitor_aio_defer(&tracked->ant_async, tracked->ki_ctx,
-					      iocb->aio_buf, iocb->aio_nbytes);
+		deferred = ant_monitor_aio_defer(&tracked->ant_async, tracked->ki_ctx,
+						 &iter);
 		observed = iter;
 		result = file->f_op->read_iter(req, &iter);
 		if (result != -EIOCBQUEUED)
diff --git a/include/linux/antinomie.h b/include/linux/antinomie.h
index d68866bce..18ef86315 100644
--- a/include/linux/antinomie.h
+++ b/include/linux/antinomie.h
@@ -8,6 +8,11 @@
  * A zero-length message is valid. Maximum payload length is ring capacity minus framing.
  */
 int ant_send(const void *data, size_t payload_len);
+/* Bytes free in the telemetry ring of the CPU the caller runs on, as of the
+ * consumer's last published tail; U32_MAX when sends would fail regardless.
+ * Advisory: a caller that can sleep uses it to pace bulk publication.
+ */
+u32 ant_send_room(void);
 
 /* Handlers run in sleepable worker context. No recursive registration changes.
  * reply is transport-owned, valid only during the callback.
diff --git a/include/linux/antinomie_monitor.h b/include/linux/antinomie_monitor.h
