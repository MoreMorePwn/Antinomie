index 0000000..67d4107
--- /dev/null
+++ b/kernel/antinomie/manual_core.c
@@ -0,0 +1,667 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Cooperative nonfatal process acquisition. No signal/core teardown ownership. */
+#include <linux/antinomie_monitor.h>
+#include <linux/binfmts.h>
+#include <linux/coredump.h>
+#include <linux/elf.h>
+#include <linux/file.h>
+#include <linux/freezer.h>
+#include <linux/highmem.h>
+#include <linux/jiffies.h>
+#include <linux/mm.h>
+#include <linux/mutex.h>
+#include <linux/refcount.h>
+#include <linux/sched/mm.h>
+#include <linux/sched/signal.h>
+#include <linux/sched/task.h>
+#include <linux/sched/coredump.h>
+#include <linux/slab.h>
+#include <linux/task_work.h>
+#include <linux/unaligned.h>
+#include <linux/vmalloc.h>
+#include <linux/wait.h>
+#include <linux/workqueue.h>
+#include "control_wire.h"
+#include "process_core.h"
+
+#ifdef CONFIG_COREDUMP
+#define LIVE_THREADS 256U
+#define LIVE_EXTENTS 4096U
+#define LIVE_PROBES_MIN 65536U
+#define LIVE_AUX_SIZE (8U * 1024 * 1024)
+
+struct ant_manual;
+struct live_participant {
+	struct callback_head work;
+	struct ant_manual *session;
+	struct task_struct *task;
+	bool owner;
+};
+
+struct ant_manual {
+	struct work_struct work;
+	refcount_t refs;
+	spinlock_t lock;
+	wait_queue_head_t wait;
+	struct ant_core_identity identity;
+	struct ant_core *core;
+	struct mm_struct *mm;
+	struct file *file;
+	struct live_participant *participants;
+	struct core_vma_metadata *original, *extents;
+	struct ant_coredump_live live;
+	unsigned int task_count, original_count, extent_count, parked;
+	bool abort, released, owner_active, done;
+	int error;
+};
+
+/* One admitted session includes callbacks which have been detached but have
+ * not run yet. Their references pin the bounded arena, task refs and core.
+ * Lock order is manual_lock -> core_lock; callbacks never take manual_lock.
+ */
+static DEFINE_MUTEX(manual_lock);
+static struct ant_manual *active_manual;
+static struct workqueue_struct *manual_worker;
+
+static void manual_put(struct ant_manual *session)
+{
+	unsigned int i;
+
+	if (!refcount_dec_and_test(&session->refs))
+		return;
+	/* Keep admission closed until the old arena is actually freed. Clearing
+	 * the slot before vfree could briefly double the auxiliary budget.
+	 * done is already published, so fence readers do not touch the core.
+	 */
+	for (i = 0; i < session->task_count; i++)
+		put_task_struct(session->participants[i].task);
+	for (i = 0; i < session->original_count; i++)
+		if (session->original[i].file)
+			fput(session->original[i].file);
+	if (session->mm)
+		mmput(session->mm);
+	if (session->file)
+		fput(session->file);
+	vfree(session->live.arena);
+	ant_core_put(session->core);
+	mutex_lock(&manual_lock);
+	WARN_ON_ONCE(active_manual != session);
+	active_manual = NULL;
+	kfree(session);
+	mutex_unlock(&manual_lock);
+}
+
+static void manual_error(struct ant_manual *session, int error)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&session->lock, flags);
+	if (!session->error)
+		session->error = error;
+	session->abort = true;
+	/* An active writer still owns the frozen registers and pages. It must
+	 * stop touching them before peers leave their park.
+	 */
+	if (!session->owner_active)
+		session->released = true;
+	spin_unlock_irqrestore(&session->lock, flags);
+	wake_up_all(&session->wait);
+}
+
+static int abort_reason(struct ant_manual *session)
+{
+	unsigned int i;
+
+	if (ant_core_live_canceled(session->core))
+		return -ECANCELED;
+	if (time_after_eq(jiffies, session->live.deadline))
+		return -ETIMEDOUT;
+	if (READ_ONCE(session->abort))
+		return READ_ONCE(session->error) ?: -EINTR;
+	/* TWA_SIGNAL sets TIF_NOTIFY_SIGNAL itself. Only actual signal state
+	 * aborts acquisition; our rendezvous notification is not a signal.
+	 */
+	for (i = 0; i < session->task_count; i++)
+		if (task_sigpending(session->participants[i].task))
+			return -EINTR;
+	return 0;
+}
+
+static bool live_aborted(void *context)
+{
+	return abort_reason(context) != 0;
+}
+
+static void *manual_alloc(struct ant_manual *session, size_t size)
+{
+	struct coredump_params cprm = { .antinomie_live = &session->live };
+
+	return ant_coredump_live_alloc(&cprm, size);
+}
+
+static bool eligible(struct task_struct *task)
+{
+	return !(READ_ONCE(task->flags) & (PF_KTHREAD | PF_USER_WORKER | PF_EXITING)) &&
+		!READ_ONCE(task->ptrace) && !task_is_stopped_or_traced(task) &&
+		!(READ_ONCE(task->jobctl) & JOBCTL_STOP_PENDING) && !freezing(task) &&
+		!(READ_ONCE(task->__state) & TASK_UNINTERRUPTIBLE);
+}
+
+static int resolve_group(struct ant_manual *session)
+{
+	struct task_struct *leader, *task;
+	int error = -ESRCH;
+
+	read_lock(&tasklist_lock);
+	for_each_process(leader) {
+		if (task_tgid_nr(leader) != session->identity.tgid)
+			continue;
+		if (READ_ONCE(leader->ant_cookie) != session->identity.cookie ||
+		    leader->start_boottime != session->identity.start_ns)
+			break;
+		error = -EOPNOTSUPP;
+		if (!eligible(leader) || !READ_ONCE(leader->mm) ||
+		    get_nr_threads(leader) > LIVE_THREADS)
+			break;
+		get_task_struct(leader);
+		session->participants[0].task = leader;
+		session->participants[0].owner = true;
+		session->task_count = 1;
+		for_each_thread(leader, task) {
+			if (task == leader)
+				continue;
+			if (session->task_count == LIVE_THREADS || !eligible(task))
+				goto unlock;
+			get_task_struct(task);
+			session->participants[session->task_count++].task = task;
+		}
+		error = 0;
+		break;
+	}
+unlock:
+	read_unlock(&tasklist_lock);
+	if (error)
+		return error;
+	session->mm = get_task_mm(session->participants[0].task);
+	return session->mm ? 0 : -ESRCH;
+}
+
+/* This predicate runs under scheduler locks. Never wait_task_inactive(): that
+ * API may spin forever and has no acquisition deadline.
+ */
+static int parked_inactive(struct task_struct *task, void *unused)
+{
+	return !task_curr(task) && !READ_ONCE(task->on_rq) &&
+		(READ_ONCE(task->__state) & TASK_UNINTERRUPTIBLE);
+}
+
+static int frozen_identity(struct ant_manual *session)
+{
+	struct task_struct *task, *process;
+	unsigned int i, count = 0;
+	int error = 0;
+
+	if (current->mm != session->mm || current->ant_cookie != session->identity.cookie ||
+	    current->start_boottime != session->identity.start_ns ||
+	    task_tgid_nr(current) != session->identity.tgid ||
+	    !current->mm->binfmt || !current->mm->binfmt->core_dump ||
+	    ant_arch_compat_task() ||
+	    test_bit(MMF_MULTIPROCESS, &current->mm->flags) ||
+	    READ_ONCE(current->signal->core_state) ||
+	    READ_ONCE(current->signal->flags) & SIGNAL_GROUP_EXIT ||
+	    READ_ONCE(current->signal->group_exec_task))
+		return -EOPNOTSUPP;
+	read_lock(&tasklist_lock);
+	for_each_process_thread(process, task) {
+		if (READ_ONCE(task->mm) == session->mm && !same_thread_group(task, current)) {
+			error = -EOPNOTSUPP;
+			break;
+		}
+		if (!same_thread_group(task, current))
+			continue;
+		count++;
+		for (i = 0; i < session->task_count; i++)
+			if (session->participants[i].task == task)
+				break;
+		if (i == session->task_count || READ_ONCE(task->flags) & PF_EXITING) {
+			error = -EAGAIN;
+			break;
+		}
+	}
+	read_unlock(&tasklist_lock);
+	return error ?: (count == session->task_count ? 0 : -EAGAIN);
+}
+
+static int snapshot_vmas(struct ant_manual *session)
+{
+	struct mm_struct *mm = session->mm;
+	struct vm_area_struct *vma, *gate;
+	unsigned long flags = READ_ONCE(mm->flags);
+	int error = 0;
+
+	VMA_ITERATOR(iterator, mm, 0);
+
+	if (!down_write_trylock(&mm->mmap_lock))
+		return -EAGAIN;
+	gate = get_gate_vma(mm);
+	if (mm->map_count + !!gate > LIVE_EXTENTS) {
+		error = -E2BIG;
+		goto unlock;
+	}
+	vma = vma_next(&iterator);
+	while (vma) {
+		struct core_vma_metadata *meta = &session->original[session->original_count++];
+
+		meta->start = vma->vm_start;
+		meta->end = vma->vm_end;
+		meta->flags = vma->vm_flags;
+		meta->dump_size = ant_coredump_vma_size(vma, flags);
+		meta->pgoff = vma->vm_pgoff;
+		meta->file = vma->vm_file;
+		if (meta->file)
+			get_file(meta->file);
+		if (vma == gate)
+			break;
+		vma = vma_next(&iterator);
+		if (!vma)
+			vma = gate;
+	}
+unlock:
+	up_write(&mm->mmap_lock);
+	return error;
+}
+
+static int append_extent(struct ant_manual *session, struct core_vma_metadata *source,
+			 unsigned long start, unsigned long end, bool resident)
+{
+	struct core_vma_metadata *meta;
+	unsigned long offset = source->pgoff + ((start - source->start) >> PAGE_SHIFT);
+
+	if (start == end)
+		return 0;
+	if (session->extent_count) {
+		meta = &session->extents[session->extent_count - 1];
+		if (meta->end == start && meta->file == source->file &&
+		    meta->flags == source->flags &&
+		    meta->pgoff + ((start - meta->start) >> PAGE_SHIFT) == offset &&
+		    (!!meta->dump_size == resident)) {
+			meta->end = end;
+			if (resident)
+				meta->dump_size += end - start;
+			return 0;
+		}
+	}
+	if (session->extent_count == LIVE_EXTENTS)
+		return -E2BIG;
+	meta = &session->extents[session->extent_count++];
+	*meta = *source;
+	meta->start = start;
+	meta->end = end;
+	meta->pgoff = offset;
+	meta->dump_size = resident ? end - start : 0;
+	return 0;
+}
+
+static int pin_resident_ranges(struct ant_manual *session)
+{
+	unsigned int i, probes = 0;
+	int error;
+
+	for (i = 0; i < session->original_count; i++) {
+		struct core_vma_metadata *meta = &session->original[i];
+		unsigned long addr = meta->start, selected;
+
+		/* Linux's deferred ELF-header filter must not fault in a page. */
+		if (meta->dump_size == 1) {
+			char magic[SELFMAG];
+
+			if (copy_from_user_nofault(magic, (const void __user *)addr, SELFMAG)) {
+				meta->dump_size = 0;
+				session->live.incomplete = true;
+			} else {
+				meta->dump_size = memcmp(magic, ELFMAG, SELFMAG) ? 0 : PAGE_SIZE;
+			}
+		}
+		selected = addr + meta->dump_size;
+		while (addr < selected) {
+			struct page *page = NULL;
+			bool resident;
+
+			error = abort_reason(session);
+			if (error)
+				return error;
+			/* Reserve one unavailable tail for this and each remaining VMA.
+			 * The native writer will not confuse omitted pages with zero data.
+			 */
+			if (probes == max(LIVE_PROBES_MIN, 2 * (session->identity.max_size / PAGE_SIZE)) ||
+			    session->live.page_count == session->identity.max_size / PAGE_SIZE ||
+			    session->extent_count +
+			    session->original_count - i + 1 >= LIVE_EXTENTS) {
+				session->live.incomplete = true;
+				error = append_extent(session, meta, addr, selected, false);
+				if (error)
+					return error;
+				addr = selected;
+				break;
+			}
+			probes++;
+			resident = get_user_pages_fast_only(addr, 1, FOLL_FORCE, &page) == 1;
+			error = append_extent(session, meta, addr, addr + PAGE_SIZE, resident);
+			if (error) {
+				if (resident)
+					put_page(page);
+				return error;
+			}
+			if (resident)
+				session->live.pages[session->live.page_count++] = page;
+			else
+				session->live.incomplete = true;
+			addr += PAGE_SIZE;
+		}
+		error = append_extent(session, meta, addr, meta->end, false);
+		if (error)
+			return error;
+	}
+	return 0;
+}
+
+static int capture_frozen(struct ant_manual *session)
+{
+	unsigned int i;
+	int error;
+
+	if (!mutex_trylock(&current->signal->cred_guard_mutex))
+		return -EAGAIN;
+	if (!down_read_trylock(&current->signal->exec_update_lock)) {
+		mutex_unlock(&current->signal->cred_guard_mutex);
+		return -EAGAIN;
+	}
+	if (current->mm != session->mm || !eligible(current)) {
+		error = -EAGAIN;
+		goto unlock;
+	}
+	for (;;) {
+		error = abort_reason(session);
+		if (error)
+			goto unlock;
+		if (READ_ONCE(session->parked) + 1 == session->task_count) {
+			for (i = 1; i < session->task_count; i++)
+				if (!task_call_func(session->participants[i].task,
+						    parked_inactive, NULL))
+					break;
+			if (i == session->task_count)
+				break;
+		}
+		wait_event_timeout(session->wait, READ_ONCE(session->abort), 1);
+	}
+	error = frozen_identity(session);
+	if (!error)
+		error = snapshot_vmas(session);
+	if (!error)
+		error = pin_resident_ranges(session);
+	session->live.file_vmas = session->original;
+	session->live.file_vma_count = session->original_count;
+	if (!error)
+		error = ant_coredump_live_to_file(session->file, RLIM_INFINITY,
+						 session->extents, session->extent_count,
+						 &session->live);
+unlock:
+	up_read(&current->signal->exec_update_lock);
+	mutex_unlock(&current->signal->cred_guard_mutex);
+	return error;
+}
+
+static void participant_work(struct callback_head *work)
+{
+	struct live_participant *participant = container_of(work, struct live_participant, work);
+	struct ant_manual *session = participant->session;
+	unsigned long flags;
+	int error;
+
+	error = abort_reason(session);
+	if (!error && (!eligible(current) || current->mm != session->mm))
+		error = -EAGAIN;
+	if (error)
+		manual_error(session, error);
+	spin_lock_irqsave(&session->lock, flags);
+	if (session->abort || session->released) {
+		spin_unlock_irqrestore(&session->lock, flags);
+		goto put;
+	}
+	if (participant->owner)
+		session->owner_active = true;
+	else
+		session->parked++;
+	spin_unlock_irqrestore(&session->lock, flags);
+	wake_up_all(&session->wait);
+	if (participant->owner) {
+		ant_core_live_begin(session->core);
+		error = capture_frozen(session);
+		spin_lock_irqsave(&session->lock, flags);
+		if (!session->error)
+			session->error = error;
+		session->owner_active = false;
+		session->released = true;
+		spin_unlock_irqrestore(&session->lock, flags);
+		wake_up_all(&session->wait);
+	} else {
+		/* Signals are observed by the owner/watchdog. A peer cannot leave
+		 * before the writer stops reading its frozen register state.
+		 */
+		wait_event(session->wait, READ_ONCE(session->released));
+		spin_lock_irqsave(&session->lock, flags);
+		session->parked--;
+		spin_unlock_irqrestore(&session->lock, flags);
+		wake_up_all(&session->wait);
+	}
+put:
+	manual_put(session);
+}
+
+static void manual_work(struct work_struct *work)
+{
+	struct ant_manual *session = container_of(work, struct ant_manual, work);
+	unsigned int i, queued = 0;
+	int error;
+
+	/* The single admission owns exactly the bounded 8MiB auxiliary budget,
+	 * including the session itself. Output has its separate 128MiB pool.
+	 */
+	session->live.arena_size = LIVE_AUX_SIZE - sizeof(*session);
+	session->live.arena = __vmalloc(session->live.arena_size,
+		GFP_KERNEL | __GFP_ZERO | __GFP_NORETRY | __GFP_NOWARN);
+	if (!session->live.arena) {
+		error = -ENOMEM;
+		goto finish;
+	}
+	session->participants = manual_alloc(session,
+		LIVE_THREADS * sizeof(*session->participants));
+	session->live.tasks = manual_alloc(session, LIVE_THREADS * sizeof(*session->live.tasks));
+	session->original = manual_alloc(session, LIVE_EXTENTS * sizeof(*session->original));
+	session->extents = manual_alloc(session, LIVE_EXTENTS * sizeof(*session->extents));
+	session->live.pages = manual_alloc(session, (session->identity.max_size / PAGE_SIZE) *
+					   sizeof(*session->live.pages));
+	session->live.scratch = manual_alloc(session, PAGE_SIZE);
+	if (!session->participants || !session->live.tasks || !session->original ||
+	    !session->extents || !session->live.pages || !session->live.scratch) {
+		error = abort_reason(session) ?: -ENOMEM;
+		goto finish;
+	}
+	error = resolve_group(session);
+	if (error)
+		goto finish;
+	error = ant_core_live_prepare(session->core, &session->file);
+	if (error)
+		goto finish;
+	session->live.task_count = session->task_count;
+	for (i = 0; i < session->task_count; i++) {
+		session->live.tasks[i] = session->participants[i].task;
+		session->participants[i].session = session;
+		init_task_work(&session->participants[i].work, participant_work);
+	}
+	/* Queue the owner last; late callbacks never park after release. */
+	for (i = 1; i <= session->task_count; i++) {
+		struct live_participant *participant =
+			&session->participants[i % session->task_count];
+
+		refcount_inc(&session->refs);
+		error = task_work_add(participant->task, &participant->work,
+				      TWA_SIGNAL | TWAF_NO_ALLOC);
+		if (error) {
+			manual_put(session);
+			manual_error(session, error);
+			break;
+		}
+		queued++;
+	}
+	while (!READ_ONCE(session->released)) {
+		error = abort_reason(session);
+		if (error)
+			manual_error(session, error);
+		wait_event_timeout(session->wait, READ_ONCE(session->released), 1);
+	}
+	for (i = 1; i <= queued; i++) {
+		struct live_participant *participant =
+			&session->participants[i % session->task_count];
+
+		if (task_work_cancel(participant->task, &participant->work))
+			manual_put(session);
+	}
+	/* A detached callback pins its own session. The release gate prevents
+	 * it from becoming a new writer/park even if it starts after publication.
+	 */
+	wait_event(session->wait, !READ_ONCE(session->parked) && !READ_ONCE(session->owner_active));
+	error = READ_ONCE(session->error);
+finish:
+	if (error)
+		manual_error(session, error);
+	for (i = 0; i < session->live.page_count; i++)
+		put_page(session->live.pages[i]);
+	ant_core_live_finish(session->core, error, session->task_count, session->live.incomplete);
+	WRITE_ONCE(session->done, true);
+	manual_put(session);
+}
+
+void ant_manual_wake(struct ant_core *core)
+{
+	mutex_lock(&manual_lock);
+	if (active_manual && active_manual->core == core &&
+	    !READ_ONCE(active_manual->done) && !ant_core_live_terminal(core))
+		manual_error(active_manual, -ECANCELED);
+	mutex_unlock(&manual_lock);
+}
+
+bool ant_manual_fence(void)
+{
+	struct ant_manual *session;
+	bool released = true;
+
+	mutex_lock(&manual_lock);
+	session = active_manual;
+	if (session && !READ_ONCE(session->done) && !ant_core_live_terminal(session->core)) {
+		ant_core_live_cancel(session->core);
+		manual_error(session, -ECANCELED);
+		released = READ_ONCE(session->released) && !READ_ONCE(session->parked) &&
+			!READ_ONCE(session->owner_active);
+	}
+	mutex_unlock(&manual_lock);
+	return released;
+}
+
+int ant_manual_command(u32 opcode, const u8 *args, size_t args_len,
+		       void *reply, size_t capacity, size_t *reply_len)
+{
+	struct ant_core_identity identity = { };
+	struct ant_manual *session;
+	struct ant_core *core;
+	u8 status_args[16];
+	bool admission = opcode == ANTC_CORE_CAPTURE;
+	int error;
+
+	if (args_len != (admission ? 56 : 48) || get_unaligned_le32(args + 4) ||
+	    (!admission && get_unaligned_le32(args + 28)))
+		return -EINVAL;
+	if (capacity < (admission ? 24 : ANTC_CORE_STATUS_SIZE))
+		return -EMSGSIZE;
+	identity.cookie = get_unaligned_le64(args + 8);
+	identity.start_ns = get_unaligned_le64(args + 16);
+	identity.tgid = get_unaligned_le32(args + 24);
+	identity.nonce_lo = get_unaligned_le64(args + (admission ? 40 : 32));
+	identity.nonce_hi = get_unaligned_le64(args + (admission ? 48 : 40));
+	if (!identity.cookie || !identity.tgid || !(identity.nonce_lo | identity.nonce_hi))
+		return -EINVAL;
+	if (admission) {
+		identity.max_size = get_unaligned_le32(args + 28);
+		identity.timeout_ms = get_unaligned_le32(args + 32);
+		identity.policy = get_unaligned_le32(args + 36);
+		if (!identity.max_size || identity.max_size > ant_core_max_bytes() ||
+		    !identity.timeout_ms || identity.timeout_ms > ant_core_max_timeout_ms() ||
+		    identity.policy != 1)
+			return -EINVAL;
+	}
+	error = ant_core_live_lookup(&identity, admission, &core);
+	if (!error) {
+		if (admission) {
+			ant_core_reply(core, reply);
+			*reply_len = 24;
+		} else {
+			memcpy(status_args, args, 8);
+			put_unaligned_le64(ant_core_id(core), status_args + 8);
+			error = ant_core_command(ANTC_CORE_STATUS, status_args, sizeof(status_args),
+						 reply, capacity, reply_len);
+		}
+		ant_core_put(core);
+		return error;
+	}
+	if (!admission || error != -ESRCH)
+		return error;
+	mutex_lock(&manual_lock);
+	if (!manual_worker || active_manual) {
+		error = manual_worker ? -EBUSY : -EAGAIN;
+		goto unlock;
+	}
+	session = kzalloc(sizeof(*session), GFP_KERNEL | __GFP_NORETRY | __GFP_NOWARN);
+	if (!session) {
+		error = -ENOMEM;
+		goto unlock;
+	}
+	core = ant_core_live_create(&identity);
+	if (IS_ERR(core)) {
+		error = PTR_ERR(core);
+		kfree(session);
+		goto unlock;
+	}
+	session->core = core;
+	session->identity = identity;
+	session->live.deadline = ant_core_live_deadline(core);
+	session->live.aborted = live_aborted;
+	session->live.context = session;
+	refcount_set(&session->refs, 1);
+	spin_lock_init(&session->lock);
+	init_waitqueue_head(&session->wait);
+	INIT_WORK(&session->work, manual_work);
+	active_manual = session;
+	ant_core_reply(core, reply);
+	*reply_len = 24;
+	queue_work(manual_worker, &session->work);
+	error = 0;
+unlock:
+	mutex_unlock(&manual_lock);
+	return error;
+}
+
+static int __init ant_manual_init(void)
+{
+	manual_worker = alloc_workqueue("antinomie-core", WQ_UNBOUND, 1);
+	return manual_worker ? 0 : -ENOMEM;
+}
+late_initcall(ant_manual_init);
+#else
+int ant_manual_command(u32 opcode, const u8 *args, size_t args_len,
+		       void *reply, size_t capacity, size_t *reply_len)
+{
+	return -EOPNOTSUPP;
+}
+void ant_manual_wake(struct ant_core *core) {}
+bool ant_manual_fence(void) { return true; }
+#endif
diff --git a/kernel/antinomie/process_core.c b/kernel/antinomie/process_core.c
new file mode 100644
index 0000000..109f347
--- /dev/null
+++ b/kernel/antinomie/process_core.c
@@ -0,0 +1,1001 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/antinomie_monitor.h>
+#include <linux/anon_inodes.h>
+#include <linux/coredump.h>
+#include <linux/elf.h>
+#include <linux/file.h>
+#include <linux/jiffies.h>
+#include <linux/math.h>
+#include <linux/minmax.h>
+#include <linux/mm.h>
+#include <linux/mutex.h>
+#include <linux/overflow.h>
+#include <linux/refcount.h>
+#include <linux/resource.h>
+#include <linux/sched/signal.h>
+#include <linux/slab.h>
+#include <linux/timekeeping.h>
+#include <linux/uio.h>
+#include <linux/unaligned.h>
+#include <linux/vmalloc.h>
+#include <linux/workqueue.h>
+#include "control_wire.h"
+#include "process_core.h"
+#include "run.h"
+
+/* The budget a handle may ask for follows the guest's memory (see
+ * ant_core_max_bytes); the floor is the ceiling every earlier kernel had and is
+ * always accepted. The buffer grows in chunks while it is written, so a budget
+ * costs nothing until a process really is that large; an exit core reserves
+ * its first ANT_CORE_PREALLOC bytes when it is armed, as it always did.
+ */
+#define ANT_CORE_HARD_MAX (1024ULL << 20)
+#define ANT_CORE_FLOOR (64ULL << 20)
+#define ANT_CORE_PREALLOC (64ULL << 20)
+#define ANT_CORE_RESERVE (128ULL << 20)
+#define ANT_CORE_CHUNK_SHIFT 23
+#define ANT_CORE_CHUNK (1U << ANT_CORE_CHUNK_SHIFT)
+#define ANT_CORE_CHUNK_MASK (ANT_CORE_CHUNK - 1)
+#define ANT_CORE_TIMEOUT_MAX 60000U
+#define ANT_CORE_HANDLES 4
+#define ANT_CORE_IDLE (180 * HZ)
+/* A core file is sparse: Linux skips pages that are not resident, and the
+ * sink keeps only the bytes that were written, in extents. max_size bounds
+ * those bytes (the real memory the handle reserves), never the file offset a
+ * far-away segment sits at; the logical extent has its own, much larger bound.
+ * A gap of at most 64 bytes between two writes is stored as zeros rather than
+ * as a hole, which keeps the alignment padding of ELF notes in one extent.
+ */
+#define ANT_CORE_LOGICAL_MAX ANTC_CORE_LOGICAL_MAX
+#define ANT_CORE_EXTENTS 32768U
+#define ANT_CORE_FILL 64
+#define ANT_CORE_HOLE_MAX (1U << 30)
+
+struct ant_core_extent {
+	u64 offset;	/* file offset of the first byte */
+	u32 length;
+	u32 base;	/* where those bytes start in the data buffer */
+};
+
+struct ant_core {
+	struct list_head node;
+	refcount_t refs;
+	/* The stored bytes, in chunks that are allocated in order as they are written. */
+	void **chunks;
+	u32 chunk_count, chunk_max;
+	struct ant_core_extent *extents;
+	u32 extent_count, extent_max;
+	u64 id, root_cookie, start_ns, finish_ns, expected_size;
+	/* size: the file's logical end; stored: bytes in the buffer. */
+	size_t size, stored, max_size;
+	unsigned long touched, deadline;
+	u32 timeout_ms, state, flags, tgid, thread_count;
+	int status, wait_status, signal, sink_error;
+	bool canceled;
+	struct ant_core_identity identity;
+};
+
+/* Command worker, exiting processes and expiry share this lock. Allocation,
+ * core rendezvous, memory copy and final release never run while it is held.
+ * A retained-list reference and each active caller own independent references.
+ */
+static DEFINE_MUTEX(core_lock);
+static LIST_HEAD(cores);
+static size_t reserved_size;
+static unsigned int handle_count;
+static u64 next_id;
+
+/* The largest budget one handle may have: half of the memory less a base
+ * allowance, because the dumped process is still resident while its copy is
+ * made. A bound, not a promise: running out of memory ends the core as a
+ * labelled partial. Never below the floor, never above the hard cap.
+ */
+u64 ant_core_max_bytes(void)
+{
+	u64 ram = (u64)totalram_pages() << PAGE_SHIFT, half = ram / 2;
+
+	half = half > ANT_CORE_RESERVE ? half - ANT_CORE_RESERVE : 0;
+	return round_down(clamp(half, ANT_CORE_FLOOR, ANT_CORE_HARD_MAX), 1ULL << 20);
+}
+
+/* What the budgets of all open handles may add up to. */
+u64 ant_core_pool_bytes(void)
+{
+	return 2 * ant_core_max_bytes();
+}
+
+u32 ant_core_max_timeout_ms(void)
+{
+	return ANT_CORE_TIMEOUT_MAX;
+}
+
+/* A host that is reading a finished core asks for the next piece as soon as it
+ * has the last one, so the control worker polls at every tick for a short
+ * while after each read instead of every ANT_POLL_MS.
+ */
+static unsigned long core_read_until;
+
+static void ant_core_note_read(void)
+{
+	WRITE_ONCE(core_read_until, (jiffies + 2 * HZ) | 1);
+}
+
+bool ant_core_reading(void)
+{
+	unsigned long until = READ_ONCE(core_read_until);
+
+	return until && time_before(jiffies, until);
+}
+
+/* What CORE_CAPS tells the host about the limits above. */
+int ant_core_caps(const u8 *args, size_t args_len, void *reply, size_t capacity,
+		  size_t *reply_len)
+{
+	if (args_len != ANTC_HEADER_SIZE)
+		return -EINVAL;
+	if (capacity < ANTC_CORE_CAPS_SIZE)
+		return -EMSGSIZE;
+	memset(reply, 0, ANTC_CORE_CAPS_SIZE);
+	put_unaligned_le32(1, reply);
+	put_unaligned_le32(ANTC_CORE_CAPS_BUDGET | ANTC_CORE_CAPS_STORED |
+			   ANTC_CORE_CAPS_LONG_TIMEOUT | ANTC_CORE_CAPS_CHUNKED |
+			   ANTC_CORE_CAPS_FAST_READ, reply + 4);
+	put_unaligned_le64(ant_core_max_bytes(), reply + 8);
+	put_unaligned_le64(ant_core_pool_bytes(), reply + 16);
+	put_unaligned_le32(ANT_CORE_HANDLES, reply + 24);
+	put_unaligned_le32(ant_core_max_timeout_ms(), reply + 28);
+	put_unaligned_le64((u64)totalram_pages() << PAGE_SHIFT, reply + 32);
+	put_unaligned_le64(ANT_CORE_PREALLOC, reply + 40);
+	*reply_len = ANTC_CORE_CAPS_SIZE;
+	return 0;
+}
+
+void ant_core_put(struct ant_core *core)
+{
+	size_t reserved;
+	u32 i;
+
+	if (IS_ERR_OR_NULL(core) || !refcount_dec_and_test(&core->refs))
+		return;
+	reserved = core->max_size;
+	for (i = 0; i < core->chunk_count; i++)
+		vfree(core->chunks[i]);
+	kvfree(core->chunks);
+	vfree(core->extents);
+	kfree(core);
+	mutex_lock(&core_lock);
+	reserved_size -= reserved;
+	handle_count--;
+	mutex_unlock(&core_lock);
+}
+
+static struct ant_core *find_core(u64 id)
+{
+	struct ant_core *core;
+
+	list_for_each_entry(core, &cores, node)
+		if (core->id == id)
+			return core;
+	return NULL;
+}
+
+static void expire_cores(struct work_struct *work);
+static DECLARE_DELAYED_WORK(core_expiry_work, expire_cores);
+
+static void expire_cores(struct work_struct *work)
+{
+	struct ant_core *core, *next, *expired[ANT_CORE_HANDLES];
+	unsigned int expired_count = 0, i;
+	bool remaining;
+
+	mutex_lock(&core_lock);
+	list_for_each_entry_safe(core, next, &cores, node)
+		if (core->state >= ANTC_CORE_READY &&
+		    time_after_eq(jiffies, core->touched + ANT_CORE_IDLE)) {
+			list_del_init(&core->node);
+			expired[expired_count++] = core;
+		}
+	remaining = !list_empty(&cores);
+	mutex_unlock(&core_lock);
+	for (i = 0; i < expired_count; i++)
+		ant_core_put(expired[i]);
+	if (remaining)
+		schedule_delayed_work(&core_expiry_work, 30 * HZ);
+}
+
+static void *core_chunk_alloc(void)
+{
+	/* Not zeroed: only bytes the sink wrote are ever exposed. */
+	return __vmalloc(ANT_CORE_CHUNK, GFP_KERNEL | __GFP_NORETRY | __GFP_NOWARN);
+}
+
+/* Make the chunks that cover the first end bytes of the buffer exist. */
+static int core_reserve(struct ant_core *core, u64 end)
+{
+	u32 need = DIV_ROUND_UP(end, ANT_CORE_CHUNK);
+
+	if (need > core->chunk_max)
+		return -EFBIG;
+	while (core->chunk_count < need) {
+		void *chunk = core_chunk_alloc();
+
+		if (!chunk)
+			return -ENOMEM;
+		core->chunks[core->chunk_count++] = chunk;
+	}
+	return 0;
+}
+
+/* The chunk table and the extent table of one core, and the first prealloc
+ * bytes of the buffer; the rest of it is allocated as it is written.
+ */
+static bool core_buffers(struct ant_core *core, u64 prealloc)
+{
+	core->chunk_max = DIV_ROUND_UP(core->max_size, ANT_CORE_CHUNK);
+	core->extent_max = max_t(u32, ANT_CORE_EXTENTS,
+				 core->max_size / PAGE_SIZE + 4096);
+	core->chunks = kvcalloc(core->chunk_max, sizeof(*core->chunks),
+				GFP_KERNEL | __GFP_NORETRY | __GFP_NOWARN);
+	core->extents = __vmalloc(array_size(core->extent_max, sizeof(*core->extents)),
+				  GFP_KERNEL | __GFP_ZERO | __GFP_NORETRY | __GFP_NOWARN);
+	return core->chunks && core->extents &&
+	       !core_reserve(core, min_t(u64, prealloc, core->max_size));
+}
+
+static struct ant_core *core_create(u32 max_size, u32 timeout_ms, bool allocate)
+{
+	struct ant_core *core;
+
+	if (!max_size || max_size > ant_core_max_bytes() ||
+	    !timeout_ms || timeout_ms > ANT_CORE_TIMEOUT_MAX)
+		return ERR_PTR(-EINVAL);
+	core = kzalloc(sizeof(*core), GFP_KERNEL | __GFP_NORETRY | __GFP_NOWARN);
+	if (!core)
+		return ERR_PTR(-ENOMEM);
+	mutex_lock(&core_lock);
+	if (handle_count >= ANT_CORE_HANDLES ||
+	    max_size > ant_core_pool_bytes() - reserved_size || next_id == U64_MAX) {
+		mutex_unlock(&core_lock);
+		kfree(core);
+		return ERR_PTR(-ENOSPC);
+	}
+	handle_count++;
+	reserved_size += max_size;
+	core->id = ++next_id;
+	mutex_unlock(&core_lock);
+	core->max_size = max_size;
+	refcount_set(&core->refs, 1);
+	INIT_LIST_HEAD(&core->node);
+	/* Optional acquisition must not escalate reclaim to arm its buffer. */
+	if (allocate && !core_buffers(core, ANT_CORE_PREALLOC)) {
+		ant_core_put(core);
+		return ERR_PTR(-ENOMEM);
+	}
+	core->timeout_ms = timeout_ms;
+	core->state = ANTC_CORE_ARMED;
+	core->flags = ANTC_CORE_ROOT_ONLY | ANTC_CORE_FILTERED_MEMORY;
+	core->touched = jiffies;
+	mutex_lock(&core_lock);
+	refcount_inc(&core->refs);
+	list_add_tail(&core->node, &cores);
+	mutex_unlock(&core_lock);
+	schedule_delayed_work(&core_expiry_work, 30 * HZ);
+	return core;
+}
+
+struct ant_core *ant_core_create(u32 max_size, u32 timeout_ms)
+{
+	return core_create(max_size, timeout_ms, true);
+}
+
+struct ant_core *ant_core_live_create(const struct ant_core_identity *identity)
+{
+	struct ant_core *core = core_create(identity->max_size, identity->timeout_ms, false);
+
+	if (IS_ERR(core))
+		return core;
+	mutex_lock(&core_lock);
+	core->identity = *identity;
+	core->root_cookie = identity->cookie;
+	core->tgid = identity->tgid;
+	core->deadline = jiffies + msecs_to_jiffies(identity->timeout_ms);
+	core->flags = ANTC_CORE_MANUAL | ANTC_CORE_RESIDENT_ONLY | ANTC_CORE_FILTERED_MEMORY;
+	mutex_unlock(&core_lock);
+	return core;
+}
+
+int ant_core_live_lookup(const struct ant_core_identity *identity, bool admission,
+			 struct ant_core **result)
+{
+	struct ant_core *core;
+	int error = -ESRCH;
+
+	mutex_lock(&core_lock);
+	list_for_each_entry(core, &cores, node) {
+		if (!(core->flags & ANTC_CORE_MANUAL) ||
+		    core->identity.nonce_lo != identity->nonce_lo ||
+		    core->identity.nonce_hi != identity->nonce_hi)
+			continue;
+		error = -EINVAL;
+		if (core->identity.cookie != identity->cookie ||
+		    core->identity.start_ns != identity->start_ns || core->tgid != identity->tgid)
+			break;
+		if (admission && (core->max_size != identity->max_size ||
+		    core->timeout_ms != identity->timeout_ms ||
+		    core->identity.policy != identity->policy))
+			break;
+		refcount_inc(&core->refs);
+		*result = core;
+		error = 0;
+		break;
+	}
+	mutex_unlock(&core_lock);
+	return error;
+}
+
+u64 ant_core_id(struct ant_core *core)
+{
+	return core->id;
+}
+
+bool ant_core_live_canceled(struct ant_core *core)
+{
+	return READ_ONCE(core->canceled);
+}
+
+bool ant_core_live_terminal(struct ant_core *core)
+{
+	bool terminal;
+
+	mutex_lock(&core_lock);
+	terminal = core->state >= ANTC_CORE_READY;
+	mutex_unlock(&core_lock);
+	return terminal;
+}
+
+unsigned long ant_core_live_deadline(struct ant_core *core)
+{
+	return core->deadline;
+}
+
+void ant_core_live_cancel(struct ant_core *core)
+{
+	WRITE_ONCE(core->canceled, true);
+}
+
+void ant_core_bind(struct ant_core *core, u64 root_cookie)
+{
+	if (IS_ERR_OR_NULL(core))
+		return;
+	mutex_lock(&core_lock);
+	core->root_cookie = root_cookie;
+	core->tgid = task_tgid_nr(current);
+	mutex_unlock(&core_lock);
+	ant_run_core_arm(root_cookie, true);
+}
+
+void ant_core_reply(struct ant_core *core, void *reply)
+{
+	memset(reply, 0, 24);
+	if (IS_ERR_OR_NULL(core)) {
+		put_unaligned_le32(core ? PTR_ERR(core) : -ENOMEM, reply + 16);
+		return;
+	}
+	put_unaligned_le64(core->id, reply);
+	put_unaligned_le64(core->max_size, reply + 8);
+}
+
+void ant_core_finish_launch(struct ant_core *core, bool executed)
+{
+	bool removed = false;
+
+	if (IS_ERR_OR_NULL(core))
+		return;
+	if (!executed) {
+		mutex_lock(&core_lock);
+		WRITE_ONCE(core->canceled, true);
+		if (!list_empty(&core->node)) {
+			list_del_init(&core->node);
+			removed = true;
+		}
+		mutex_unlock(&core_lock);
+	}
+	if (!executed)
+		ant_run_core_arm(core->root_cookie, false);
+	if (removed)
+		ant_core_put(core);
+	ant_core_put(core);
+}
+
+/* This file is private to one exiting process. Only cancellation is shared;
+ * terminal publication under core_lock makes data/size immutable to readers.
+ */
+static int sink_check(struct ant_core *core)
+{
+	int error = READ_ONCE(core->canceled) ? -ECANCELED :
+		time_after_eq(jiffies, core->deadline) ? -ETIMEDOUT : 0;
+
+	if (error)
+		core->sink_error = error;
+	return error;
+}
+
+/* The extent holding file offset, or the first one after it (to find the end
+ * of a hole). Extents are in file order and never overlap.
+ */
+static unsigned int extent_search(const struct ant_core *core, u64 offset)
+{
+	unsigned int low = 0, high = core->extent_count;
+
+	while (low < high) {
+		unsigned int mid = low + (high - low) / 2;
+		const struct ant_core_extent *extent = &core->extents[mid];
+
+		if (offset >= extent->offset + extent->length)
+			low = mid + 1;
+		else
+			high = mid;
+	}
+	return low;
+}
+
+/* Where in the buffer the bytes of a file offset are, and how many of the
+ * extent follow it; false in a hole or past the end.
+ */
+static bool core_locate(const struct ant_core *core, u64 offset, u64 *base, u64 *available)
+{
+	unsigned int index;
+	const struct ant_core_extent *extent;
+
+	if (!core->chunks || !core->extents)
+		return false;
+	index = extent_search(core, offset);
+	if (index >= core->extent_count)
+		return false;
+	extent = &core->extents[index];
+	if (offset < extent->offset)
+		return false;
+	*available = extent->offset + extent->length - offset;
+	*base = extent->base + (offset - extent->offset);
+	return true;
+}
+
+/* The stored bytes at a file offset, and how many follow in the same extent
+ * and the same chunk; NULL where the offset is in a hole or past the end.
+ * The ELF header, program headers and notes are read this way: they are
+ * written first and sit inside the first chunk.
+ */
+static void *core_span(const struct ant_core *core, u64 offset, u64 *available)
+{
+	u64 base;
+
+	if (!core_locate(core, offset, &base, available) ||
+	    base >> ANT_CORE_CHUNK_SHIFT >= core->chunk_count)
+		return NULL;
+	*available = min_t(u64, *available, ANT_CORE_CHUNK - (base & ANT_CORE_CHUNK_MASK));
+	return core->chunks[base >> ANT_CORE_CHUNK_SHIFT] + (base & ANT_CORE_CHUNK_MASK);
+}
+
+/* Copy count stored bytes starting at buffer offset base out of the chunks. */
+static void core_copy_out(const struct ant_core *core, u64 base, void *to, u32 count)
+{
+	while (count) {
+		u32 piece = min_t(u64, count, ANT_CORE_CHUNK - (base & ANT_CORE_CHUNK_MASK));
+
+		memcpy(to, core->chunks[base >> ANT_CORE_CHUNK_SHIFT] + (base & ANT_CORE_CHUNK_MASK),
+		       piece);
+		to += piece;
+		base += piece;
+		count -= piece;
+	}
+}
+
+/* Append to the buffer at the end of the stored bytes: zeros (fill) or the
+ * bytes of an iterator, across chunk boundaries.
+ */
+static int core_append(struct ant_core *core, u64 fill, struct iov_iter *from, size_t count)
+{
+	u64 at = core->stored;
+	size_t left = fill + count;
+
+	while (left) {
+		void *to = core->chunks[at >> ANT_CORE_CHUNK_SHIFT] + (at & ANT_CORE_CHUNK_MASK);
+		size_t piece = min_t(u64, left, ANT_CORE_CHUNK - (at & ANT_CORE_CHUNK_MASK));
+
+		if (at - core->stored < fill) {
+			piece = min_t(u64, piece, fill - (at - core->stored));
+			memset(to, 0, piece);
+		} else if (copy_from_iter(to, piece, from) != piece) {
+			return -EFAULT;
+		}
+		at += piece;
+		left -= piece;
+	}
+	return 0;
+}
+
+static ssize_t core_write_iter(struct kiocb *iocb, struct iov_iter *from)
+{
+	struct ant_core *core = iocb->ki_filp->private_data;
+	size_t count = iov_iter_count(from);
+	loff_t pos = iocb->ki_pos;
+	struct ant_core_extent *extent;
+	u64 gap, fill;
+	int error = sink_check(core);
+
+	if (error)
+		return error;
+	/* The writer is sequential: it only skips forward. */
+	if (pos < 0 || (u64)pos < core->size) {
+		core->sink_error = -ESPIPE;
+		return -ESPIPE;
+	}
+	if ((u64)pos > ANT_CORE_LOGICAL_MAX || count > ANT_CORE_LOGICAL_MAX - pos) {
+		core->sink_error = -EOVERFLOW;
+		return -EOVERFLOW;
+	}
+	gap = pos - core->size;
+	extent = core->extent_count ? &core->extents[core->extent_count - 1] : NULL;
+	fill = extent && gap <= ANT_CORE_FILL ? gap : 0;
+	/* max_size bounds the bytes stored, not the file offset they sit at. This
+	 * is the only budget check (the writer is given no limit of its own), so
+	 * -EFBIG means exactly "the budget is spent".
+	 */
+	if (count + fill > core->max_size - core->stored) {
+		core->sink_error = -EFBIG;
+		return -EFBIG;
+	}
+	if (!(extent && fill == gap) && core->extent_count == core->extent_max) {
+		core->sink_error = -E2BIG;
+		return -E2BIG;
+	}
+	error = core_reserve(core, core->stored + fill + count);
+	if (!error)
+		error = core_append(core, fill, from, count);
+	if (error) {
+		core->sink_error = error;
+		return error;
+	}
+	if (extent && fill == gap) {
+		extent->length += fill + count;
+	} else {
+		extent = &core->extents[core->extent_count++];
+		extent->offset = pos;
+		extent->length = count;
+		extent->base = core->stored;
+	}
+	core->stored += fill + count;
+	iocb->ki_pos += count;
+	core->size = pos + count;
+	return count;
+}
+
+static loff_t core_llseek(struct file *file, loff_t offset, int whence)
+{
+	struct ant_core *core = file->private_data;
+	loff_t pos;
+	int error = sink_check(core);
+
+	if (error)
+		return error;
+	if (whence == SEEK_CUR) {
+		if (check_add_overflow(file->f_pos, offset, &pos))
+			return -EOVERFLOW;
+	} else if (whence == SEEK_SET) {
+		pos = offset;
+	} else {
+		return -EINVAL;
+	}
+	if (pos < 0 || pos > ANT_CORE_LOGICAL_MAX) {
+		core->sink_error = -EOVERFLOW;
+		return -EOVERFLOW;
+	}
+	file->f_pos = pos;
+	return pos;
+}
+
+static const struct file_operations core_fops = {
+	.write_iter = core_write_iter,
+	.llseek = core_llseek,
+};
+
+int ant_core_live_prepare(struct ant_core *core, struct file **file)
+{
+	int error = sink_check(core);
+
+	if (error)
+		return error;
+	if (!core_buffers(core, ANT_CORE_CHUNK))
+		return -ENOMEM;
+	*file = anon_inode_getfile("antinomie-live-core", &core_fops, core, O_RDWR);
+	if (IS_ERR(*file)) {
+		error = PTR_ERR(*file);
+		*file = NULL;
+		return error;
+	}
+	return sink_check(core);
+}
+
+void ant_core_live_begin(struct ant_core *core)
+{
+	mutex_lock(&core_lock);
+	core->state = ANTC_CORE_COPYING;
+	core->start_ns = ktime_get_ns();
+	mutex_unlock(&core_lock);
+}
+
+static u64 core_expected_size(struct ant_core *core)
+{
+	struct elf64_hdr *elf;
+	struct elf64_phdr *ph;
+	u64 available, table, size = 0, extent;
+	unsigned int i;
+
+	elf = core_span(core, 0, &available);
+	if (!elf || available < sizeof(*elf) ||
+	    memcmp(elf->e_ident, ELFMAG, SELFMAG) ||
+	    elf->e_ident[EI_CLASS] != ELFCLASS64 ||
+	    elf->e_ident[EI_DATA] != ELFDATA2LSB ||
+	    elf->e_type != ET_CORE || elf->e_machine != ELF_ARCH ||
+	    elf->e_phentsize != sizeof(*ph) || elf->e_phnum == PN_XNUM)
+		return 0;
+	/* The header and the program headers are written back to back, so they
+	 * sit in the first extent.
+	 */
+	table = (u64)elf->e_phnum * sizeof(*ph);
+	ph = core_span(core, elf->e_phoff, &available);
+	if (!ph || available < table)
+		return 0;
+	for (i = 0; i < elf->e_phnum; i++) {
+		if (check_add_overflow(ph[i].p_offset, ph[i].p_filesz, &extent))
+			return 0;
+		size = max(size, extent);
+	}
+	return size;
+}
+
+/* Count complete native PRSTATUS notes actually retained, rather than claim
+ * that the live-thread count sampled before rendezvous was fully recovered.
+ */
+static u32 core_thread_count(struct ant_core *core)
+{
+	struct elf64_hdr *elf;
+	struct elf64_phdr *ph;
+	u64 available;
+	u32 count = 0;
+	unsigned int i;
+
+	if (!core->expected_size)
+		return 0;
+	elf = core_span(core, 0, &available);
+	ph = elf ? core_span(core, elf->e_phoff, &available) : NULL;
+	if (!ph)
+		return 0;
+	for (i = 0; i < elf->e_phnum; i++) {
+		u64 at = 0, length;
+		u8 *notes;
+
+		if (ph[i].p_type != PT_NOTE)
+			continue;
+		notes = core_span(core, ph[i].p_offset, &available);
+		if (!notes)
+			continue;
+		length = min_t(u64, ph[i].p_filesz, available);
+		while (sizeof(struct elf_note) <= length - at) {
+			struct elf_note *note = (struct elf_note *)(notes + at);
+			u64 name_size = ALIGN((u64)note->n_namesz, 4);
+			u64 data_size = ALIGN((u64)note->n_descsz, 4);
+
+			at += sizeof(*note);
+			if (name_size > length - at || data_size > length - at - name_size)
+				break;
+			if (note->n_type == NT_PRSTATUS && note->n_namesz == 5 &&
+			    !memcmp(notes + at, "CORE", 5))
+				count++;
+			at += name_size + data_size;
+		}
+	}
+	return count;
+}
+
+void ant_core_live_finish(struct ant_core *core, int error, u32 thread_count, bool gap)
+{
+	u64 expected = core->chunks ? core_expected_size(core) : 0;
+	u32 retained = core->chunks ? core_thread_count(core) : 0;
+
+	/* The caller has released all owned parks and stopped writing. */
+	if (core->sink_error)
+		error = core->sink_error;
+	else if (time_after_eq(jiffies, core->deadline) && !error)
+		error = -ETIMEDOUT;
+	if (!error && (!expected || core->size < expected))
+		error = expected > ANT_CORE_LOGICAL_MAX ? -EOVERFLOW : -EIO;
+	if (retained != thread_count)
+		gap = true;
+	if (gap && !error)
+		error = -ENODATA;
+	mutex_lock(&core_lock);
+	core->expected_size = expected;
+	core->thread_count = retained;
+	core->flags |= ANTC_CORE_PAUSE_RELEASED;
+	if (expected)
+		core->flags |= ANTC_CORE_NATIVE_ELF64;
+	if (gap || error)
+		core->flags |= ANTC_CORE_COVERAGE_GAP;
+	core->status = error;
+	core->finish_ns = ktime_get_ns();
+	core->touched = jiffies;
+	core->state = core->canceled ? ANTC_CORE_CANCELED :
+		error ? (core->size ? ANTC_CORE_PARTIAL : ANTC_CORE_UNAVAILABLE) : ANTC_CORE_READY;
+	mutex_unlock(&core_lock);
+}
+
+bool ant_monitor_core_exit(int wait_status, const kernel_siginfo_t *siginfo)
+{
+	struct ant_core *core, *selected = NULL;
+	struct file *file;
+	u32 thread_count;
+	int error;
+
+	/* SIGKILL must retain immediate Linux teardown: no file or rendezvous. */
+	if ((siginfo && siginfo->si_signo == SIGKILL) ||
+	    (!siginfo && (wait_status & 0x7f) == SIGKILL))
+		return false;
+	if (!current->ant_root_process || !current->mm ||
+	    (current->flags & PF_USER_WORKER))
+		return false;
+	mutex_lock(&core_lock);
+	list_for_each_entry(core, &cores, node)
+		if (core->root_cookie == current->ant_root_cookie &&
+		    core->state == ANTC_CORE_ARMED && !(core->flags & ANTC_CORE_MANUAL) &&
+		    !core->canceled) {
+			selected = core;
+			refcount_inc(&core->refs);
+			core->state = ANTC_CORE_COPYING;
+			core->start_ns = ktime_get_ns();
+			core->wait_status = wait_status;
+			core->signal = siginfo ? siginfo->si_signo : wait_status & 0x7f;
+			core->tgid = task_tgid_nr(current);
+			core->thread_count = get_nr_threads(current);
+			break;
+		}
+	mutex_unlock(&core_lock);
+	if (!selected)
+		return false;
+	core = selected;
+	core->deadline = jiffies + msecs_to_jiffies(core->timeout_ms);
+	file = anon_inode_getfile("antinomie-core", &core_fops, core, O_RDWR);
+	if (IS_ERR(file)) {
+		error = PTR_ERR(file);
+	} else {
+		/* anon_inode_getfile recognizes llseek and write_iter itself. */
+		/* No writer limit: the sink enforces the budget (-EFBIG). */
+		error = ant_coredump_to_file(file, RLIM_INFINITY, wait_status, siginfo,
+					     core->deadline);
+		fput(file);
+	}
+	ant_run_core_arm(core->root_cookie, false);
+	core->expected_size = core_expected_size(core);
+	thread_count = core_thread_count(core);
+	if (core->sink_error)
+		error = core->sink_error;
+	else if (time_after_eq(jiffies, core->deadline))
+		error = -ETIMEDOUT;
+	if (!error && (!core->expected_size || core->size < core->expected_size))
+		error = core->expected_size > ANT_CORE_LOGICAL_MAX ? -EOVERFLOW : -EIO;
+	mutex_lock(&core_lock);
+	if (core->expected_size)
+		core->flags |= ANTC_CORE_NATIVE_ELF64;
+	if (thread_count < core->thread_count)
+		core->flags |= ANTC_CORE_COVERAGE_GAP;
+	core->thread_count = thread_count;
+	core->status = error;
+	core->finish_ns = ktime_get_ns();
+	core->touched = jiffies;
+	core->state = core->canceled ? ANTC_CORE_CANCELED :
+		error ? (core->size ? ANTC_CORE_PARTIAL : ANTC_CORE_UNAVAILABLE) :
+		ANTC_CORE_READY;
+	if (error)
+		core->flags |= ANTC_CORE_COVERAGE_GAP;
+	mutex_unlock(&core_lock);
+	ant_core_put(core);
+	return true;
+}
+
+/* Called from sleepable do_exit, never from the nonblocking telemetry hook.
+ * Last-root exit can bypass acquisition (notably SIGKILL or a missing mm).
+ * Publish a terminal reason without allocating a file or walking memory.
+ */
+void ant_monitor_core_unavailable(int wait_status)
+{
+	struct ant_core *core;
+	u64 root_cookie = ant_run_root_cookie(current);
+
+	if (!ant_monitor_core_pending(current))
+		return;
+	mutex_lock(&core_lock);
+	list_for_each_entry(core, &cores, node)
+		if (core->root_cookie == root_cookie &&
+		    core->state == ANTC_CORE_ARMED && !(core->flags & ANTC_CORE_MANUAL) &&
+		    !core->canceled) {
+			core->wait_status = wait_status;
+			core->signal = wait_status & 0x7f;
+			core->status = core->signal == SIGKILL ? -EINTR : -ENODATA;
+			core->finish_ns = ktime_get_ns();
+			core->touched = jiffies;
+			core->flags |= ANTC_CORE_COVERAGE_GAP;
+			core->state = ANTC_CORE_UNAVAILABLE;
+			break;
+		}
+	mutex_unlock(&core_lock);
+	ant_run_core_arm(root_cookie, false);
+}
+
+/* Whether a process core of this run is being copied right now. A SIGKILL sent
+ * then would abort the copy, so Stop's escalation waits (bounded) for it.
+ */
+bool ant_core_run_busy(u64 root_cookie)
+{
+	struct ant_core *core;
+	bool busy = false;
+
+	mutex_lock(&core_lock);
+	list_for_each_entry(core, &cores, node)
+		if (core->root_cookie == root_cookie && core->state == ANTC_CORE_COPYING) {
+			busy = true;
+			break;
+		}
+	mutex_unlock(&core_lock);
+	return busy;
+}
+
+int ant_core_command(u32 opcode, const u8 *args, size_t args_len,
+		     void *reply, size_t capacity, size_t *reply_len)
+{
+	struct ant_core *core;
+	u64 id, offset, available;
+	u32 count, flags, index;
+	u64 base;
+	int error = 0;
+	bool extended;
+	bool removed = false;
+
+	if (args_len != (opcode == ANTC_CORE_READ ? 32 : 16))
+		return -EINVAL;
+	/* STATUS alone takes a header flag: STORED asks for the longer reply. */
+	flags = get_unaligned_le32(args + 4);
+	if (flags & ~(opcode == ANTC_CORE_STATUS ? ANTC_CORE_STATUS_STORED : 0U))
+		return -EINVAL;
+	extended = flags & ANTC_CORE_STATUS_STORED;
+	id = get_unaligned_le64(args + 8);
+	if (!id)
+		return -EINVAL;
+	mutex_lock(&core_lock);
+	core = find_core(id);
+	if (!core) {
+		error = -ESRCH;
+		goto unlock;
+	}
+	refcount_inc(&core->refs);
+	core->touched = jiffies;
+	if (opcode == ANTC_CORE_CANCEL) {
+		if (!(core->flags & ANTC_CORE_MANUAL)) {
+			error = -EOPNOTSUPP;
+			goto put;
+		}
+		if (core->state < ANTC_CORE_READY)
+			WRITE_ONCE(core->canceled, true);
+	} else if (opcode == ANTC_CORE_RELEASE) {
+		WRITE_ONCE(core->canceled, true);
+		list_del_init(&core->node);
+		removed = true;
+	} else if (opcode == ANTC_CORE_STATUS) {
+		size_t reply_size = extended ? ANTC_CORE_STATUS_STORED_SIZE : ANTC_CORE_STATUS_SIZE;
+
+		if (capacity < reply_size) {
+			error = -EMSGSIZE;
+			goto put;
+		}
+		memset(reply, 0, reply_size);
+		put_unaligned_le64(core->id, reply);
+		put_unaligned_le64(core->root_cookie, reply + 8);
+		put_unaligned_le64(core->start_ns, reply + 16);
+		put_unaligned_le64(core->finish_ns, reply + 24);
+		/* Never race a writer by exposing its mutable length/metadata. */
+		if (core->state >= ANTC_CORE_READY) {
+			put_unaligned_le64(core->size, reply + 32);
+			put_unaligned_le64(core->expected_size, reply + 40);
+			if (extended)
+				put_unaligned_le64(core->stored, reply + 80);
+			ant_core_note_read();
+		}
+		put_unaligned_le32(core->state, reply + 48);
+		put_unaligned_le32(core->status, reply + 52);
+		put_unaligned_le32(core->wait_status, reply + 56);
+		put_unaligned_le32(core->signal, reply + 60);
+		put_unaligned_le32(core->flags, reply + 64);
+		put_unaligned_le32(core->tgid, reply + 68);
+		put_unaligned_le32(core->thread_count, reply + 72);
+		*reply_len = reply_size;
+	} else if (opcode == ANTC_CORE_READ) {
+		offset = get_unaligned_le64(args + 16);
+		count = get_unaligned_le32(args + 24);
+		if (get_unaligned_le32(args + 28) || !count || count > 16328 ||
+		    capacity < 24 || count > capacity - 24) {
+			error = -EINVAL;
+			goto put;
+		}
+		if (core->state != ANTC_CORE_READY && core->state != ANTC_CORE_PARTIAL) {
+			error = -EAGAIN;
+			goto put;
+		}
+		if (offset > core->size) {
+			error = -EINVAL;
+			goto put;
+		}
+		/* Retained caller reference pins the immutable terminal buffer. */
+		mutex_unlock(&core_lock);
+		count = min_t(u64, count, core->size - offset);
+		flags = 0;
+		ant_core_note_read();
+		if (count && core_locate(core, offset, &base, &available)) {
+			count = min_t(u64, count, available);
+			core_copy_out(core, base, reply + 24, count);
+			*reply_len = 24 + count;
+		} else if (count) {
+			/* A hole: the zeros up to the next stored byte are named,
+			 * not sent. The host writes them as a sparse range.
+			 */
+			index = extent_search(core, offset);
+			count = min_t(u64, (index < core->extent_count ?
+					    core->extents[index].offset : core->size) - offset,
+				      ANT_CORE_HOLE_MAX);
+			flags = ANTC_CORE_READ_HOLE;
+			*reply_len = 24;
+		} else {
+			*reply_len = 24;
+		}
+		put_unaligned_le64(offset, reply);
+		put_unaligned_le64(core->size, reply + 8);
+		put_unaligned_le32(count, reply + 16);
+		put_unaligned_le32(flags, reply + 20);
+		ant_core_put(core);
+		return 0;
+	}
+put:
+	mutex_unlock(&core_lock);
+	if (READ_ONCE(core->flags) & ANTC_CORE_MANUAL) {
+		if (removed || opcode == ANTC_CORE_CANCEL)
+			ant_manual_wake(core);
+	} else if (removed) {
+		ant_run_core_arm(core->root_cookie, false);
+	}
+	if (removed)
+		ant_core_put(core);
+	ant_core_put(core);
+	return error;
+unlock:
+	mutex_unlock(&core_lock);
+	return error;
+}
+
+void ant_core_shutdown(void)
+{
+	struct ant_core *core, *next, *canceled[ANT_CORE_HANDLES];
+	unsigned int canceled_count = 0, i;
+
+	mutex_lock(&core_lock);
+	list_for_each_entry_safe(core, next, &cores, node) {
+		WRITE_ONCE(core->canceled, true);
+		list_del_init(&core->node);
+		canceled[canceled_count++] = core;
+	}
+	mutex_unlock(&core_lock);
+	for (i = 0; i < canceled_count; i++) {
+		if (canceled[i]->flags & ANTC_CORE_MANUAL)
+			ant_manual_wake(canceled[i]);
+		else
+			ant_run_core_arm(canceled[i]->root_cookie, false);
+		ant_core_put(canceled[i]);
+	}
+}
