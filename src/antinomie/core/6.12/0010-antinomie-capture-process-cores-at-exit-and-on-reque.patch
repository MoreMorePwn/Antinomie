diff --git a/fs/coredump.c b/fs/coredump.c
index 64894ba..00bfd7a 100644
--- a/fs/coredump.c
+++ b/fs/coredump.c
@@ -1,5 +1,6 @@
 // SPDX-License-Identifier: GPL-2.0
 #include <linux/slab.h>
+#include <linux/antinomie_monitor.h>
 #include <linux/file.h>
 #include <linux/fdtable.h>
 #include <linux/freezer.h>
@@ -574,6 +575,119 @@ static int umh_coredump_setup(struct subprocess_info *info, struct cred *new)
 	return 0;
 }
 
+#ifdef CONFIG_ANTINOMIE
+/* Nonfatal acquisition owns its own thread list, page refs and metadata.
+ * This path never calls coredump_wait/finish or installs signal->core_state.
+ */
+void *ant_coredump_live_alloc(struct coredump_params *cprm, size_t size)
+{
+	struct ant_coredump_live *live = cprm->antinomie_live;
+	size_t offset = ALIGN(live->arena_used, __alignof__(unsigned long));
+	void *data;
+
+	if (live->aborted(live->context) || offset > live->arena_size ||
+	    size > live->arena_size - offset) {
+		live->incomplete = true;
+		return NULL;
+	}
+	data = live->arena + offset;
+	live->arena_used = offset + size;
+	memset(data, 0, size);
+	return data;
+}
+
+int ant_coredump_live_to_file(struct file *file, unsigned long limit,
+			     struct core_vma_metadata *vmas, unsigned int vma_count,
+			     struct ant_coredump_live *live)
+{
+	kernel_siginfo_t info = { .si_code = SI_KERNEL };
+	struct coredump_params cprm = {
+		.siginfo = &info, .file = file, .limit = limit,
+		.mm_flags = READ_ONCE(current->mm->flags),
+		.cpu = raw_smp_processor_id(), .vma_meta = vmas,
+		.vma_count = vma_count, .antinomie_live = live,
+		.antinomie_deadline = live->deadline,
+	};
+	unsigned int i;
+	int error;
+
+	if (!current->mm->binfmt || !current->mm->binfmt->core_dump ||
+	    ant_arch_compat_task())
+		return -EOPNOTSUPP;
+	for (i = 0; i < vma_count; i++)
+		cprm.vma_data_size += vmas[i].dump_size;
+	error = current->mm->binfmt->core_dump(&cprm) ? 0 : -EIO;
+	if (cprm.to_skip) {
+		cprm.to_skip--;
+		if (!dump_emit(&cprm, "", 1) && !error)
+			error = -EIO;
+	}
+	if (live->aborted(live->context) || dump_interrupted())
+		return -EINTR;
+	return error ?: (live->incomplete ? -ENODATA : 0);
+}
+
+/* Opt-in host acquisition shares the native ELF writer/rendezvous, but never
+ * synthesizes a core bit in the parent-visible wait status. No guest path or
+ * helper is used. The caller owns the bounded anonymous sink for this call.
+ */
+int ant_coredump_to_file(struct file *file, unsigned long limit, int wait_status,
+			 const kernel_siginfo_t *siginfo, unsigned long deadline)
+{
+	struct mm_struct *mm = current->mm;
+	struct core_state core_state;
+	kernel_siginfo_t normal_info = {
+		.si_signo = wait_status & 0x7f, .si_code = SI_KERNEL,
+	};
+	struct coredump_params cprm = {
+		.siginfo = siginfo ? siginfo : &normal_info,
+		.file = file,
+		.limit = limit,
+		.antinomie_deadline = deadline,
+		.cpu = raw_smp_processor_id(),
+	};
+	int error;
+
+	if (!mm || !mm->binfmt || !mm->binfmt->core_dump || ant_arch_compat_task())
+		return -EOPNOTSUPP;
+	/* Bound metadata before the Linux writer allocates its snapshots. */
+	if (get_nr_threads(current) > 256)
+		return -E2BIG;
+	cprm.mm_flags = READ_ONCE(mm->flags);
+	error = coredump_wait(wait_status, &core_state);
+	if (error < 0)
+		return error;
+	if (get_nr_threads(current) > 256) {
+		error = -E2BIG;
+		goto finish;
+	}
+	mmap_read_lock(mm);
+	error = mm->map_count > 4096 ? -E2BIG : 0;
+	mmap_read_unlock(mm);
+	if (error)
+		goto finish;
+	if (!dump_vma_snapshot(&cprm)) {
+		error = -ENOMEM;
+		goto finish;
+	}
+	/* Linux returns 'has_dumped' even after a short write. The sink and
+	 * ELF program-header extents provide the actual completion decision.
+	 */
+	error = mm->binfmt->core_dump(&cprm) ? 0 : -EIO;
+	if (cprm.to_skip) {
+		cprm.to_skip--;
+		if (!dump_emit(&cprm, "", 1) && !error)
+			error = -EIO;
+	}
+	free_vma_snapshot(&cprm);
+	if (dump_interrupted())
+		error = -EINTR;
+finish:
+	coredump_finish(false);
+	return error;
+}
+#endif
+
 void do_coredump(const kernel_siginfo_t *siginfo)
 {
 	struct core_state core_state;
@@ -603,6 +717,8 @@ void do_coredump(const kernel_siginfo_t *siginfo)
 		.cpu = raw_smp_processor_id(),
 	};
 
+	if (ant_monitor_core_exit(siginfo->si_signo, siginfo))
+		return;
 	audit_core_dumps(siginfo->si_signo);
 
 	binfmt = mm->binfmt;
@@ -980,6 +1096,29 @@ int dump_user_range(struct coredump_params *cprm, unsigned long start,
 	unsigned long addr;
 	struct page *dump_page;
 
+#ifdef CONFIG_ANTINOMIE
+	if (cprm->antinomie_live) {
+		struct ant_coredump_live *live = cprm->antinomie_live;
+		unsigned long size;
+
+		if (live->page_cursor > live->page_count || len % PAGE_SIZE ||
+		    len / PAGE_SIZE > live->page_count - live->page_cursor)
+			return 0;
+		for (size = 0; size < len; size += PAGE_SIZE) {
+			void *data;
+			bool failed;
+
+			if (live->aborted(live->context))
+				return 0;
+			data = kmap_local_page(live->pages[live->page_cursor++]);
+			failed = copy_mc_to_kernel(live->scratch, data, PAGE_SIZE);
+			kunmap_local(data);
+			if (failed || !dump_emit(cprm, live->scratch, PAGE_SIZE))
+				return 0;
+		}
+		return 1;
+	}
+#endif
 	dump_page = dump_page_alloc();
 	if (!dump_page)
 		return 0;
@@ -987,6 +1126,14 @@ int dump_user_range(struct coredump_params *cprm, unsigned long start,
 	for (addr = start; addr < start + len; addr += PAGE_SIZE) {
 		struct page *page;
 
+#ifdef CONFIG_ANTINOMIE
+		if (cprm->antinomie_deadline &&
+		    time_after_eq(jiffies, cprm->antinomie_deadline)) {
+			dump_page_free(dump_page);
+			return 0;
+		}
+#endif
+
 		/*
 		 * To avoid having to allocate page tables for virtual address
