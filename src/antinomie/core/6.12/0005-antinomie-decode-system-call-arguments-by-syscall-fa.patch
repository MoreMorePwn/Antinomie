diff --git a/kernel/antinomie/capture_api.h b/kernel/antinomie/capture_api.h
new file mode 100644
index 0000000..a87cfe0
--- /dev/null
+++ b/kernel/antinomie/capture_api.h
@@ -0,0 +1,73 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _ANTINOMIE_CAPTURE_API_H
+#define _ANTINOMIE_CAPTURE_API_H
+
+#include <linux/antinomie_monitor.h>
+#include <linux/bits.h>
+#include <linux/limits.h>
+#include <linux/types.h>
+
+struct ant_task;
+
+enum ant_status {
+	ANT_COMPLETE, ANT_COPY_FAULT, ANT_INVALID_EXTENT, ANT_UNKNOWN_EXTENT,
+	ANT_NO_DECODER, ANT_NULL_POINTER, ANT_ADDRESS_ONLY, ANT_ASYNC_UNOBSERVED,
+	ANT_RESOURCE_EXHAUSTED, ANT_ABORTED_ON_LOSS, ANT_CONTEXT_MISSING,
+	ANT_NOT_WRITTEN, ANT_NOT_RESIDENT,
+};
+
+/* A native family returns this bit when it owns the whole syscall capture,
+ * plus bits 0..5 for recognized pointer arguments across both phases.
+ */
+#define ANT_CAPTURE_OWNED BIT(7)
+
+void ant_capture_field(struct ant_task *ctx, u8 arg_index, const char *key,
+		       const char *layout, u16 encoding, u64 address,
+		       const void *snapshot, u64 object_size, u64 declared_size,
+		       enum ant_status status);
+u64 ant_capture_string(struct ant_task *ctx, u8 arg_index, const char *key,
+		       u64 address, u64 ceiling);
+bool ant_capture_lost(struct ant_task *ctx);
+void *ant_capture_state(struct ant_task *ctx);
+void ant_capture_set_state(struct ant_task *ctx, void *state,
+			   void (*release)(void *));
+
+/* A capture gap of the call (index 255) under key, unless capture already stopped. */
+static inline void capture_gap(struct ant_task *ctx, const char *key, enum ant_status status)
+{
+	if (!ant_capture_lost(ctx))
+		ant_capture_field(ctx, 255, key, "", 1, 0, NULL,
+				  U64_MAX, U64_MAX, status);
+}
+
+static inline void capture_fixed(struct ant_task *ctx, u8 arg, const char *key,
+				 const char *layout, u64 address, u64 size)
+{
+	ant_capture_field(ctx, arg, key, layout, 3, address, NULL, size, size, ANT_COMPLETE);
+}
+
+/* A fixed struct in the caller's memory: input of a SET request at entry, or
+ * output of the paired GET request after success.
+ */
+static inline void capture_paired(struct ant_task *ctx, bool output, long result, bool get,
+				  const char *key, const char *layout, u64 address, u64 size)
+{
+	if (output == get && (!output || result == 0))
+		capture_fixed(ctx, 3, key, layout, address, size);
+}
+
+/* Architecture decoders (capture_<arch>.c): system calls only the architecture
+ * has, the signal frame rt_sigreturn reads, and requests whose operand is an
+ * architecture structure.
+ *
+ * ant_arch_capture() returns what ant_native_capture() returns for the call
+ * (ANT_CAPTURE_OWNED and the pointer arguments it recognized), or 0 when the
+ * architecture has no decoder for it. ant_arch_capture_ptrace() is true when
+ * the ptrace request is the architecture's and was handled.
+ */
+u8 ant_arch_capture(struct ant_task *ctx, u64 nr, const u64 args[6],
+		    bool output, long result);
+bool ant_arch_capture_ptrace(struct ant_task *ctx, const u64 args[6],
+			     bool output, long result);
+
+#endif
diff --git a/kernel/antinomie/capture_x86.c b/kernel/antinomie/capture_x86.c
new file mode 100644
index 0000000..3393fb2
--- /dev/null
+++ b/kernel/antinomie/capture_x86.c
@@ -0,0 +1,180 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* x86-64 decoders (capture_api.h): the system calls only x86 has (arch_prctl,
+ * modify_ldt, uretprobe), the signal frame rt_sigreturn reads from the user
+ * stack, and the ptrace requests whose operand is an x86 structure or that
+ * only x86 defines. native_capture.c asks here for every call it has no
+ * family for, and capture_ptrace() for every request first.
+ */
+#include <linux/antinomie_monitor.h>
+#include <linux/ptrace.h>
+#include <linux/uaccess.h>
+#include <asm/ldt.h>
+#include <asm/prctl.h>
+#include <asm/user.h>
+#include <asm/fpu/types.h>
+#include <asm/sigframe.h>
+
+#include "capture_api.h"
+
+#define LAYOUT(name) ANT_LAYOUT(name)
+
+static void capture_arch_prctl(struct ant_task *ctx, const u64 args[6],
+			       bool output, long result)
+{
+	switch ((u32)args[0]) {
+	case ARCH_GET_FS: case ARCH_GET_GS: case ARCH_GET_XCOMP_SUPP:
+	case ARCH_GET_XCOMP_PERM: case ARCH_GET_XCOMP_GUEST_PERM:
+	case ARCH_GET_UNTAG_MASK: case ARCH_GET_MAX_TAG_BITS: case ARCH_SHSTK_STATUS:
+		if (output && result == 0)
+			ant_capture_field(ctx, 1, "arg1.arch_value", LAYOUT("unsigned_long"), 3,
+					  args[1], NULL, sizeof(unsigned long),
+					  sizeof(unsigned long), ANT_COMPLETE);
+		return;
+	case ARCH_SET_FS: case ARCH_SET_GS: case ARCH_SET_CPUID: case ARCH_GET_CPUID:
+	case ARCH_MAP_VDSO_X32: case ARCH_MAP_VDSO_32: case ARCH_MAP_VDSO_64:
+	case ARCH_REQ_XCOMP_PERM: case ARCH_REQ_XCOMP_GUEST_PERM:
+	case ARCH_ENABLE_TAGGED_ADDR: case ARCH_FORCE_TAGGED_SVA:
+	case ARCH_SHSTK_ENABLE: case ARCH_SHSTK_DISABLE: case ARCH_SHSTK_LOCK:
+	case ARCH_SHSTK_UNLOCK:
+		return;
+	default:
+		if (!output)
+			capture_gap(ctx, "arch_prctl.unknown_selector", ANT_NO_DECODER);
+	}
+}
+
+static bool arch_prctl_returns_value(u64 code)
+{
+	switch (code) {
+	case ARCH_GET_FS: case ARCH_GET_GS: case ARCH_GET_XCOMP_SUPP:
+	case ARCH_GET_XCOMP_PERM: case ARCH_GET_XCOMP_GUEST_PERM:
+	case ARCH_GET_UNTAG_MASK: case ARCH_GET_MAX_TAG_BITS: case ARCH_SHSTK_STATUS:
+		return true;
+	default:
+		return false;
+	}
+}
+
+static void capture_modify_ldt(struct ant_task *ctx, const u64 args[6],
+			       bool output, long result)
+{
+	bool input;
+
+	input = args[0] == 1 || args[0] == 0x11;
+	if (input && !output)
+		ant_capture_field(ctx, 1, "arg1.ldt_entry", LAYOUT("user_desc"), 3,
+				  args[1], NULL, sizeof(struct user_desc), args[2],
+				  args[2] == sizeof(struct user_desc) ?
+				  ANT_COMPLETE : ANT_INVALID_EXTENT);
+	else if (!input && (args[0] == 0 || args[0] == 2) && output && (s32)result >= 0)
+		ant_capture_field(ctx, 1, "arg1.ldt", "", 1, args[1], NULL,
+				  min_t(u64, (u32)result, args[2]), args[2], ANT_COMPLETE);
+	else if (!input && args[0] != 0 && args[0] != 2 && !output)
+		ant_capture_field(ctx, 1, "modify_ldt.unknown_selector", "", 1,
+				  args[1], NULL, U64_MAX, U64_MAX, ANT_NO_DECODER);
+}
+
+/* Slice 2E: frames the kernel reads from the user stack instead of an
+ * argument. Their fields use index 255 and context.* keys.
+ */
+static void capture_rt_sigreturn(struct ant_task *ctx)
+{
+	unsigned long address = user_stack_pointer(current_pt_regs()) - sizeof(long);
+	struct fxregs_state fx;
+	struct rt_sigframe frame;
+	struct _fpx_sw_bytes *sw = (struct _fpx_sw_bytes *)fx.sw_reserved;
+	enum ant_status status;
+	u64 fpstate, limit;
+	u32 magic2;
+
+	status = copy_from_user_nofault(&frame, (void __user *)address, sizeof(frame)) ?
+		ANT_COPY_FAULT : ANT_COMPLETE;
+	ant_capture_field(ctx, 255, "context.rt_sigframe", LAYOUT("rt_sigframe"), 3, address,
+			  &frame, sizeof(frame), sizeof(frame), status);
+	fpstate = (unsigned long)frame.uc.uc_mcontext.fpstate;
+	if (status != ANT_COMPLETE || !fpstate || ant_capture_lost(ctx))
+		return;
+	status = copy_from_user_nofault(&fx, (void __user *)(unsigned long)fpstate, sizeof(fx)) ?
+		ANT_COPY_FAULT : ANT_COMPLETE;
+	ant_capture_field(ctx, 255, "context.fpstate", LAYOUT("fxregs_state"), 3, fpstate, &fx,
+			  sizeof(fx), sizeof(fx), status);
+	/* check_xstate_in_sigframe(): if any check fails, the kernel ignores the
+	 * extension and restores the legacy state only, so nothing more is read.
+	 */
+	limit = min_t(u64, sw->extended_size, current->thread.fpu.fpstate->user_size);
+	if (status != ANT_COMPLETE || sw->magic1 != FP_XSTATE_MAGIC1 ||
+	    sw->xstate_size < sizeof(fx) + sizeof(struct xstate_header) ||
+	    sw->xstate_size > limit || ant_capture_lost(ctx) ||
+	    copy_from_user_nofault(&magic2, (void __user *)(unsigned long)
+				   (fpstate + sw->xstate_size), sizeof(magic2)) ||
+	    magic2 != FP_XSTATE_MAGIC2)
+		return;
+	ant_capture_field(ctx, 255, "context.fpstate.xstate", LAYOUT("xstate"), 3,
+			  fpstate + sizeof(fx), NULL, sw->xstate_size - sizeof(fx),
+			  sw->xstate_size - sizeof(fx), ANT_COMPLETE);
+}
+
+/* The uretprobe trampoline saves r11, rcx and rax at sp before the syscall. */
+static void capture_uretprobe(struct ant_task *ctx)
+{
+	ant_capture_field(ctx, 255, "context.uretprobe_regs", LAYOUT("uretprobe_regs"), 3,
+			  user_stack_pointer(current_pt_regs()), NULL, 3 * sizeof(unsigned long),
+			  3 * sizeof(unsigned long), ANT_COMPLETE);
+}
+
+u8 ant_arch_capture(struct ant_task *ctx, u64 nr, const u64 args[6],
+		    bool output, long result)
+{
+	switch (nr) {
+	case __NR_rt_sigreturn:
+		if (!output)
+			capture_rt_sigreturn(ctx);
+		return ANT_CAPTURE_OWNED;
+	case __NR_uretprobe:
+		if (!output)
+			capture_uretprobe(ctx);
+		return ANT_CAPTURE_OWNED;
+	case __NR_arch_prctl:
+		capture_arch_prctl(ctx, args, output, result);
+		return ANT_CAPTURE_OWNED | BIT(1);
+	case __NR_modify_ldt:
+		capture_modify_ldt(ctx, args, output, result);
+		return ANT_CAPTURE_OWNED | BIT(1);
+	default:
+		return 0;
+	}
+}
+
+bool ant_arch_capture_ptrace(struct ant_task *ctx, const u64 args[6],
+			     bool output, long result)
+{
+	switch (args[0]) {
+	case PTRACE_GETREGS: case PTRACE_SETREGS:
+		capture_paired(ctx, output, result, args[0] == PTRACE_GETREGS, "arg3.regs",
+			       LAYOUT("user_regs_struct"), args[3],
+			       sizeof(struct user_regs_struct));
+		return true;
+	case PTRACE_GETFPREGS: case PTRACE_SETFPREGS:
+		capture_paired(ctx, output, result, args[0] == PTRACE_GETFPREGS, "arg3.fpregs",
+			       LAYOUT("user_i387_struct"), args[3],
+			       sizeof(struct user_i387_struct));
+		return true;
+	case PTRACE_GET_THREAD_AREA: case PTRACE_SET_THREAD_AREA:
+		capture_paired(ctx, output, result, args[0] == PTRACE_GET_THREAD_AREA, "arg3.desc",
+			       LAYOUT("user_desc"), args[3], sizeof(struct user_desc));
+		return true;
+	case PTRACE_ARCH_PRCTL:
+		/* arch_ptrace() calls do_arch_prctl_64(child, data, addr): data is the
+		 * arch_prctl code and addr the value or output pointer.
+		 */
+		if (output && result == 0 && arch_prctl_returns_value(args[3]))
+			capture_fixed(ctx, 2, "arg2.value", LAYOUT("unsigned_long"), args[2],
+				      sizeof(unsigned long));
+		return true;
+	case PTRACE_SINGLEBLOCK: case PTRACE_SYSEMU: case PTRACE_SYSEMU_SINGLESTEP:
+	case PTRACE_OLDSETOPTIONS: case PTRACE_GETFPXREGS: case PTRACE_SETFPXREGS:
+		return true;
+	default:
+		return false;
+	}
+}
