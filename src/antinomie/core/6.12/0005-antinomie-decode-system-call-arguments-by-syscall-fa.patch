+static void capture_mount_queries(struct ant_task *ctx, u64 nr, const u64 args[6],
+				  bool output, long result)
+{
+	u32 written;
+	u64 size;
+	enum ant_status status;
+
+	if (!output) {
+		capture_sized_input(ctx, 0, args[0], 0, MNT_ID_REQ_SIZE_VER0,
+				    sizeof(struct mnt_id_req), "arg0.mount_request",
+				    LAYOUT("mnt_id_req"), false);
+		return;
+	}
+	if (result < 0)
+		return;
+	if (nr == __NR_listmount) {
+		size = min_t(u64, args[2], result) * sizeof(u64);
+		ant_capture_field(ctx, 1, "arg1.mount_ids", LAYOUT("u64[]"), 3,
+				  args[1], NULL, size, args[2] <= 1000000 ? args[2] *
+				  sizeof(u64) : U64_MAX,
+				  args[2] <= 1000000 ? ANT_COMPLETE : ANT_INVALID_EXTENT);
+		return;
+	}
+	if (args[2] < sizeof(written)) {
+		size = args[2];
+		status = ANT_COMPLETE;
+	} else {
+		status = copy_from_user_nofault(&written, (void __user *)(unsigned long)args[1],
+						sizeof(written)) ?
+			ANT_COPY_FAULT : ANT_COMPLETE;
+		size = status == ANT_COMPLETE ? written : U64_MAX;
+		if (status == ANT_COMPLETE &&
+		    (size > args[2] || size < min_t(u64, args[2], sizeof(struct statmount))))
+			status = ANT_INVALID_EXTENT;
+	}
+	ant_capture_field(ctx, 1, "arg1.statmount", LAYOUT("statmount"), 3,
+			  args[1], NULL, size, args[2], status);
+}
