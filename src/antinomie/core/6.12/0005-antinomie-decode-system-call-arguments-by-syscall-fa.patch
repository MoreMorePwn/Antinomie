+static void capture_message(struct ant_task *ctx, const u64 args[6],
+			    bool output, long result, bool input)
+{
+	struct ant_message_state *state;
+	struct user_msghdr observed;
+	enum ant_status status;
+	u64 size;
+
+	if (ant_capture_lost(ctx))
+		return;
+	if (!output) {
+		state = kzalloc(sizeof(*state), GFP_NOWAIT);
+		if (!state) {
+			ant_capture_field(ctx, 1, "arg1.msghdr", LAYOUT("msghdr"), 3,
+					  args[1], NULL, sizeof(observed), sizeof(observed),
+					  ANT_RESOURCE_EXHAUSTED);
+			return;
+		}
+		status = copy_from_user_nofault(&state->entry,
+						(void __user *)(unsigned long)args[1],
+						sizeof(state->entry)) ?
+			ANT_COPY_FAULT : ANT_COMPLETE;
+		ant_capture_field(ctx, 1, "arg1.msghdr", LAYOUT("msghdr"), 3,
+				  args[1], &state->entry, sizeof(state->entry),
+				  sizeof(state->entry), status);
+		if (status != ANT_COMPLETE) {
+			kfree(state);
+			return;
+		}
+		ant_capture_set_state(ctx, state, release_message);
+		if (ant_capture_lost(ctx))
+			return;
+		state->vector = save_vector(ctx, 1, (unsigned long)state->entry.msg_iov,
+					    state->entry.msg_iovlen, "arg1.msghdr.iov");
+		if (input && state->vector)
+			vector_data(ctx, state->vector, 1, "arg1.msghdr.iov", MAX_RW_COUNT);
+		if (input && !ant_capture_lost(ctx)) {
+			size = !state->entry.msg_name ? 0 : state->entry.msg_namelen < 0 ? U64_MAX :
+				min_t(u64, state->entry.msg_namelen,
+				      sizeof(struct sockaddr_storage));
+			ant_capture_field(ctx, 1, "arg1.msghdr.name", LAYOUT("sockaddr"), 3,
+					  (unsigned long)state->entry.msg_name, NULL,
+					  size, state->entry.msg_namelen,
+					  size == U64_MAX ? ANT_INVALID_EXTENT : ANT_COMPLETE);
+			if (!ant_capture_lost(ctx))
+				ant_capture_field(ctx, 1, "arg1.msghdr.control",
+						  LAYOUT("cmsghdr[]"), 3,
+						  (unsigned long)state->entry.msg_control, NULL,
+						  state->entry.msg_controllen,
+						  state->entry.msg_controllen,
+						  state->entry.msg_controllen > INT_MAX ?
+						  ANT_INVALID_EXTENT : ANT_COMPLETE);
+		}
+		return;
+	}
+	if (input || result < 0)
+		return;
+	state = ant_capture_state(ctx);
+	if (!state) {
+		ant_capture_field(ctx, 1, "arg1.msghdr.output", "", 1, args[1], NULL,
+				  U64_MAX, U64_MAX, ANT_CONTEXT_MISSING);
+		return;
+	}
+	status = copy_from_user_nofault(&observed,
+					(void __user *)(unsigned long)args[1], sizeof(observed)) ?
+		ANT_COPY_FAULT : ANT_COMPLETE;
+	ant_capture_field(ctx, 1, "arg1.msghdr.output", LAYOUT("msghdr"), 3,
+			  args[1], &observed, sizeof(observed), sizeof(observed), status);
+	if (state->vector && !ant_capture_lost(ctx))
+		vector_data(ctx, state->vector, 1, "arg1.msghdr.iov",
+			    min_t(u64, result, MAX_RW_COUNT));
+	else if (!ant_capture_lost(ctx))
+		ant_capture_field(ctx, 1, "arg1.msghdr.iov.output", "", 1,
+				  (unsigned long)state->entry.msg_iov, NULL,
+				  U64_MAX, U64_MAX, ANT_CONTEXT_MISSING);
+	if (status != ANT_COMPLETE || ant_capture_lost(ctx))
+		return;
+	size = !state->entry.msg_name ? 0 :
+		state->entry.msg_namelen < 0 || observed.msg_namelen < 0 ? U64_MAX :
+		min_t(u64, sizeof(struct sockaddr_storage),
+		      min(state->entry.msg_namelen, observed.msg_namelen));
+	ant_capture_field(ctx, 1, "arg1.msghdr.name", LAYOUT("sockaddr"), 3,
+			  (unsigned long)state->entry.msg_name, NULL, size,
+			  state->entry.msg_namelen,
+			  size == U64_MAX ? ANT_INVALID_EXTENT : ANT_COMPLETE);
+	if (!ant_capture_lost(ctx))
+		ant_capture_field(ctx, 1, "arg1.msghdr.control", LAYOUT("cmsghdr[]"), 3,
+				  (unsigned long)state->entry.msg_control, NULL,
+				  min(state->entry.msg_controllen, observed.msg_controllen),
+				  state->entry.msg_controllen, ANT_COMPLETE);
+}
+
+static void capture_address(struct ant_task *ctx, const u64 args[6],
+			    bool output, long result)
+{
+	struct ant_address_state *state;
+	int length;
+	enum ant_status status;
+
+	if (ant_capture_lost(ctx) || !args[1])
+		return;
+	if (!output) {
+		state = kzalloc(sizeof(*state), GFP_NOWAIT);
+		if (!state)
+			status = ANT_RESOURCE_EXHAUSTED;
+		else if (copy_from_user_nofault(&state->capacity,
+						(void __user *)(unsigned long)args[2],
+						sizeof(state->capacity)))
+			status = ANT_COPY_FAULT;
+		else
+			status = state->capacity < 0 ? ANT_INVALID_EXTENT : ANT_COMPLETE;
+		ant_capture_field(ctx, 2, "arg2.socklen.capacity", LAYOUT("socklen_t"), 3,
+				  args[2], state ? &state->capacity : NULL,
+				  sizeof(int), sizeof(int), status);
+		if (status != ANT_COMPLETE) {
+			kfree(state);
+			state = NULL;
+		}
+		ant_capture_set_state(ctx, state, release_allocation);
+		return;
+	}
+	if (result < 0)
+		return;
+	state = ant_capture_state(ctx);
+	status = copy_from_user_nofault(&length,
+					(void __user *)(unsigned long)args[2], sizeof(length)) ?
+		ANT_COPY_FAULT : ANT_COMPLETE;
+	ant_capture_field(ctx, 2, "arg2.socklen.output", LAYOUT("socklen_t"), 3,
+			  args[2], &length, sizeof(length), sizeof(length), status);
+	if (status != ANT_COMPLETE || ant_capture_lost(ctx))
+		return;
+	status = !state ? ANT_CONTEXT_MISSING : length < 0 ? ANT_INVALID_EXTENT : ANT_COMPLETE;
+	ant_capture_field(ctx, 1, "arg1.sockaddr", LAYOUT("sockaddr"), 3,
+			  args[1], NULL, status == ANT_COMPLETE ?
+			  min_t(u64, sizeof(struct sockaddr_storage),
+				min(length, state->capacity)) : U64_MAX,
+			  state ? state->capacity : U64_MAX, status);
+}
+
+/* The extended attribute calls by what they do: each names a file by path, by
+ * path without following a final link, or by descriptor.
+ */
+enum ant_xattr_op { ANT_XATTR_NONE, ANT_XATTR_SET, ANT_XATTR_GET, ANT_XATTR_LIST,
+		    ANT_XATTR_REMOVE };
+
+static enum ant_xattr_op xattr_op(u64 nr)
+{
+	switch (nr) {
+	case __NR_setxattr: case __NR_lsetxattr: case __NR_fsetxattr:
+		return ANT_XATTR_SET;
+	case __NR_getxattr: case __NR_lgetxattr: case __NR_fgetxattr:
+		return ANT_XATTR_GET;
+	case __NR_listxattr: case __NR_llistxattr: case __NR_flistxattr:
+		return ANT_XATTR_LIST;
+	case __NR_removexattr: case __NR_lremovexattr: case __NR_fremovexattr:
+		return ANT_XATTR_REMOVE;
+	default:
+		return ANT_XATTR_NONE;
+	}
+}
+
+static bool xattr_by_path(u64 nr)
+{
+	return nr != __NR_fsetxattr && nr != __NR_fgetxattr && nr != __NR_flistxattr &&
+		nr != __NR_fremovexattr;
+}
+
+static void capture_xattr(struct ant_task *ctx, enum ant_xattr_op op, bool path,
+			  const u64 args[6], bool output, long result)
+{
+	char key[64];
+	u64 capacity, size;
+	u8 index;
+
+	if (!output) {
+		if (path)
+			ant_capture_string(ctx, 0, "arg0.path", args[0], PATH_MAX);
+		if (op != ANT_XATTR_LIST) {
+			if (!ant_capture_lost(ctx))
+				ant_capture_string(ctx, 1, "arg1.xattr_name", args[1],
+						   XATTR_NAME_MAX + 1);
+		}
+	}
+	/* A value is input to SET; a value or name list is output of GET and LIST. */
+	if (ant_capture_lost(ctx) || op == ANT_XATTR_REMOVE ||
+	    (op != ANT_XATTR_SET && !output) || (op == ANT_XATTR_SET && output))
+		return;
+	if (output && result < 0)
+		return;
+	index = op != ANT_XATTR_LIST ? 2 : 1;
+	capacity = args[index + 1];
+	size = output ? min_t(u64, min_t(u64, capacity,
+		op != ANT_XATTR_LIST ? XATTR_SIZE_MAX : XATTR_LIST_MAX), result) : capacity;
+	scnprintf(key, sizeof(key), "arg%u.xattr_data", index);
+	ant_capture_field(ctx, index, key, "", 1, args[index], NULL, size, capacity,
+			  !output && capacity > XATTR_SIZE_MAX ?
+			  ANT_INVALID_EXTENT : ANT_COMPLETE);
+}
+
+static void capture_sigmask(struct ant_task *ctx, u8 arg, u64 address, u64 size)
+{
+	if (!address || ant_capture_lost(ctx))
+		return;
+	ant_capture_field(ctx, arg, "signal.mask", LAYOUT("sigset_t"), 3,
+			  address, NULL, sizeof(sigset_t), size,
+			  size == sizeof(sigset_t) ? ANT_COMPLETE : ANT_INVALID_EXTENT);
+}
+
+static void capture_poll(struct ant_task *ctx, u64 nr, const u64 args[6],
+			 bool output, long result)
+{
+	u64 count = (u32)args[1], size = count * sizeof(struct pollfd);
+
+	if (ant_capture_lost(ctx))
+		return;
+	if (!output || result >= 0 || result == -EINTR ||
+	    result == -ERESTARTNOHAND || result == -ERESTART_RESTARTBLOCK)
+		ant_capture_field(ctx, 0, "arg0.pollfd", LAYOUT("pollfd[]"), 3,
+				  args[0], NULL, size, size,
+				  count > rlimit(RLIMIT_NOFILE) ?
+				  ANT_INVALID_EXTENT : ANT_COMPLETE);
+	if (nr != __NR_ppoll || ant_capture_lost(ctx))
+		return;
+	if (!output) {
+		ant_capture_field(ctx, 2, "arg2.timeout", LAYOUT("timespec"), 3,
+				  args[2], NULL, sizeof(struct __kernel_timespec),
+				  sizeof(struct __kernel_timespec), ANT_COMPLETE);
+		capture_sigmask(ctx, 3, args[3], args[4]);
+	} else if (result >= 0 || result == -EINTR || result == -ERESTARTNOHAND) {
+		ant_capture_field(ctx, 2, "arg2.timeout.observed", LAYOUT("timespec"), 3,
+				  args[2], NULL, sizeof(struct __kernel_timespec),
+				  sizeof(struct __kernel_timespec), ANT_COMPLETE);
+	}
+}
+
+static void capture_epoll(struct ant_task *ctx, u64 nr, const u64 args[6],
+			  bool output, long result)
+{
+	u64 size;
+	s32 capacity = args[2];
+
+	if (ant_capture_lost(ctx))
+		return;
+	if (nr == __NR_epoll_ctl) {
+		if (!output && args[1] != EPOLL_CTL_DEL)
+			ant_capture_field(ctx, 3, "arg3.epoll_event", LAYOUT("epoll_event"), 3,
+					  args[3], NULL, sizeof(struct epoll_event),
+					  sizeof(struct epoll_event),
+					  args[1] == EPOLL_CTL_ADD || args[1] == EPOLL_CTL_MOD ?
+					  ANT_COMPLETE : ANT_NO_DECODER);
+		return;
+	}
+	if (!output) {
+		if (nr == __NR_epoll_pwait2)
+			ant_capture_field(ctx, 3, "arg3.timeout", LAYOUT("timespec"), 3,
+					  args[3], NULL, sizeof(struct __kernel_timespec),
+					  sizeof(struct __kernel_timespec), ANT_COMPLETE);
+#ifdef __NR_epoll_wait
+		if (nr != __NR_epoll_wait)
+#endif
+			capture_sigmask(ctx, 4, args[4], args[5]);
+	} else if (result >= 0) {
+		size = capacity > 0 ? min_t(u64, result, capacity) * sizeof(struct epoll_event) : 0;
+		ant_capture_field(ctx, 1, "arg1.epoll_events", LAYOUT("epoll_event[]"), 3,
+				  args[1], NULL, size,
+				  capacity > 0 ? (u64)capacity * sizeof(struct epoll_event) : 0,
+				  capacity <= 0 || capacity > INT_MAX / sizeof(struct epoll_event) ?
+				  ANT_INVALID_EXTENT : ANT_COMPLETE);
+	}
+}
+
+static void capture_signals(struct ant_task *ctx, u64 nr, const u64 args[6],
+			    bool output, long result)
+{
+	u8 arg;
+
+	switch (nr) {
+	case __NR_rt_sigaction:
+		arg = output ? 2 : 1;
+		if ((!output || result == 0) && args[arg])
+			ant_capture_field(ctx, arg, output ? "arg2.sigaction" : "arg1.sigaction",
+					  LAYOUT("sigaction"), 3, args[arg], NULL,
+					  sizeof(struct sigaction), sizeof(struct sigaction),
+					  args[3] == sizeof(sigset_t) ?
+					  ANT_COMPLETE : ANT_INVALID_EXTENT);
+		break;
+	case __NR_rt_sigprocmask:
+		if (!output || result == 0)
+			capture_sigmask(ctx, output ? 2 : 1, args[output ? 2 : 1], args[3]);
+		break;
+	case __NR_rt_sigpending:
+		if (output && result == 0)
+			ant_capture_field(ctx, 0, "arg0.pending", LAYOUT("sigset_t"), 3,
+					  args[0], NULL, args[1], args[1],
+					  args[1] <= sizeof(sigset_t) ?
+					  ANT_COMPLETE : ANT_INVALID_EXTENT);
+		break;
+	case __NR_rt_sigtimedwait:
+		if (!output) {
+			capture_sigmask(ctx, 0, args[0], args[3]);
+			capture_optional(ctx, 2, args[2], "arg2.timeout", LAYOUT("timespec"),
+					 sizeof(struct __kernel_timespec));
+		} else if (result > 0) {
+			capture_optional(ctx, 1, args[1], "arg1.siginfo", LAYOUT("siginfo_t"),
+					 sizeof(siginfo_t));
+		}
+		break;
+	case __NR_rt_sigqueueinfo: case __NR_rt_tgsigqueueinfo: case __NR_pidfd_send_signal:
+		arg = nr == __NR_rt_tgsigqueueinfo ? 3 : 2;
+		if (!output)
+			capture_optional(ctx, arg, args[arg], "signal.siginfo",
+					 LAYOUT("siginfo_t"), sizeof(siginfo_t));
+		break;
+	case __NR_rt_sigsuspend: case __NR_signalfd4:
+#ifdef __NR_signalfd
+	case __NR_signalfd:
+#endif
+		if (!output)
+			capture_sigmask(ctx, nr == __NR_rt_sigsuspend ? 0 : 1,
+					args[nr == __NR_rt_sigsuspend ? 0 : 1],
+					args[nr == __NR_rt_sigsuspend ? 1 : 2]);
+		break;
+	case __NR_sigaltstack:
+		if (!output || result == 0)
+			capture_optional(ctx, output ? 1 : 0, args[output ? 1 : 0],
+					 output ? "arg1.stack" : "arg0.stack",
+					 LAYOUT("stack_t"), sizeof(stack_t));
+		break;
+	default:
+		break;
+	}
+	/* Function, restorer and alternate-stack addresses in native structures
+	 * are roles, not permission to copy executable code or stack contents.
+	 */
+	BUILD_BUG_ON(sizeof(struct sigaction) != 32);
+	BUILD_BUG_ON(sizeof(siginfo_t) != 128);
+	BUILD_BUG_ON(sizeof(stack_t) != 24);
+}
+
+struct ant_select_state {
+	u64 bitmap_size;
+};
+
+struct ant_sigset_pack {
+	sigset_t __user *mask;
+	size_t size;
+};
+
+static void capture_select(struct ant_task *ctx, u64 nr, const u64 args[6],
+			   bool output, long result)
+{
+	struct ant_select_state *state;
+	struct ant_sigset_pack pack;
+	enum ant_status status = ANT_COMPLETE;
+	u64 size;
+	s32 count = args[0];
+	u32 max_fds;
+	u8 arg;
+	char key[48];
+
+	if (!output) {
+		state = kzalloc(sizeof(*state), GFP_NOWAIT);
+		if (!state) {
+			status = ANT_RESOURCE_EXHAUSTED;
+		} else if (count < 0) {
+			status = ANT_INVALID_EXTENT;
+		} else {
+			rcu_read_lock();
+			max_fds = files_fdtable(current->files)->max_fds;
+			rcu_read_unlock();
+			size = min_t(u32, count, max_fds);
+			state->bitmap_size = DIV_ROUND_UP(size, BITS_PER_LONG) *
+				sizeof(unsigned long);
+		}
+		if (status == ANT_COMPLETE)
+			ant_capture_set_state(ctx, state, release_allocation);
+		else
+			kfree(state);
+	} else {
+		state = ant_capture_state(ctx);
+		if (!state)
+			status = ANT_CONTEXT_MISSING;
+	}
+	if (!output || result >= 0) {
+		size = status == ANT_COMPLETE ? state->bitmap_size : U64_MAX;
+		for (arg = 1; arg <= 3 && !ant_capture_lost(ctx); arg++) {
+			if (!args[arg])
+				continue;
+			scnprintf(key, sizeof(key), "arg%u.fdset", arg);
+			ant_capture_field(ctx, arg, key, LAYOUT("unsigned_long[]"), 3,
+					  args[arg], NULL, size, size, status);
+		}
+	}
+	if (!ant_capture_lost(ctx))
+		capture_optional(ctx, 4, args[4], output ? "arg4.timeout.observed" :
+				 "arg4.timeout",
+#ifdef __NR_select
+				 nr == __NR_select ? LAYOUT("timeval") :
+#endif
+				 LAYOUT("timespec"), sizeof(struct __kernel_timespec));
+	if (nr == __NR_pselect6 && !output && args[5] && !ant_capture_lost(ctx)) {
+		status = copy_from_user_nofault(&pack, (void __user *)(unsigned long)args[5],
+						sizeof(pack)) ?
+			ANT_COPY_FAULT : ANT_COMPLETE;
+		ant_capture_field(ctx, 5, "arg5.sigset_pack", LAYOUT("sigset_argpack"), 3,
+				  args[5], &pack, sizeof(pack), sizeof(pack), status);
+		if (status == ANT_COMPLETE && !ant_capture_lost(ctx))
+			capture_sigmask(ctx, 5, (unsigned long)pack.mask, pack.size);
+	}
+}
+
+static bool capture_versioned(struct ant_task *ctx, u8 arg, u64 address,
+			      u64 size, u64 minimum, u64 known_size,
+			      const char *key, const char *layout)
+{
+	enum ant_status status = size < minimum || size > PAGE_SIZE ?
+		ANT_INVALID_EXTENT : ANT_COMPLETE;
+	char extension_key[64];
+
+	ant_capture_field(ctx, arg, key, layout, 3, address, NULL,
+			  min(size, known_size), size, status);
+	if (status == ANT_COMPLETE && size > known_size && !ant_capture_lost(ctx)) {
+		scnprintf(extension_key, sizeof(extension_key), "%s.extension", key);
+		ant_capture_field(ctx, arg, extension_key, "", 1, address + known_size,
+				  NULL, size - known_size, size - known_size,
+				  address > U64_MAX - known_size ?
+				  ANT_INVALID_EXTENT : ANT_COMPLETE);
+	}
+	return status == ANT_COMPLETE;
+}
+
+static void capture_schedattr(struct ant_task *ctx, u64 nr, const u64 args[6],
+			      bool output, long result)
+{
+	u32 size;
+	enum ant_status status;
+
+	if (nr == __NR_sched_getattr) {
+		if (output && result == 0)
+			ant_capture_field(ctx, 1, "arg1.sched_attr", LAYOUT("sched_attr"), 3,
+					  args[1], NULL, min_t(u64, (u32)args[2],
+					  sizeof(struct sched_attr)), (u32)args[2], ANT_COMPLETE);
+		return;
+	}
+	if (output) {
+		if (result == -E2BIG)
+			capture_optional(ctx, 1, args[1], "arg1.sched_attr.required_size",
+					 LAYOUT("u32"), sizeof(u32));
+		return;
+	}
+	status = copy_from_user_nofault(&size, (void __user *)(unsigned long)args[1],
+					sizeof(size)) ?
+		ANT_COPY_FAULT : ANT_COMPLETE;
+	if (status != ANT_COMPLETE) {
+		ant_capture_field(ctx, 1, "arg1.sched_attr.size", LAYOUT("u32"), 3,
+				  args[1], NULL, sizeof(size), sizeof(size), status);
+		return;
+	}
+	capture_versioned(ctx, 1, args[1], size ? size : SCHED_ATTR_SIZE_VER0,
+			  SCHED_ATTR_SIZE_VER0, sizeof(struct sched_attr),
+			  "arg1.sched_attr", LAYOUT("sched_attr"));
+}
+
+static void capture_clone3(struct ant_task *ctx, const u64 args[6],
+			   bool output, long result)
+{
+	struct clone_args *state;
+	enum ant_status status;
+	u64 size;
+
+	if (!output) {
+		if (!capture_versioned(ctx, 0, args[0], args[1], CLONE_ARGS_SIZE_VER0,
+				       sizeof(*state), "arg0.clone_args", LAYOUT("clone_args")) ||
+		    ant_capture_lost(ctx))
+			return;
+		state = kzalloc(sizeof(*state), GFP_NOWAIT);
+		if (!state)
+			status = ANT_RESOURCE_EXHAUSTED;
+		else if (copy_from_user_nofault(state, (void __user *)(unsigned long)args[0],
+						min_t(u64, args[1], sizeof(*state))))
+			status = ANT_COPY_FAULT;
+		else
+			status = ANT_COMPLETE;
+		if (status != ANT_COMPLETE) {
+			ant_capture_field(ctx, 0, "arg0.clone_args.context", "", 1,
+					  args[0], NULL, sizeof(*state), args[1], status);
+			kfree(state);
+			return;
+		}
+		ant_capture_set_state(ctx, state, release_allocation);
+		if (state->set_tid || state->set_tid_size) {
+			size = state->set_tid_size <= MAX_PID_NS_LEVEL ?
+				state->set_tid_size * sizeof(pid_t) : U64_MAX;
+			status = state->set_tid_size && state->set_tid_size <= MAX_PID_NS_LEVEL ?
+				ANT_COMPLETE : ANT_INVALID_EXTENT;
+			ant_capture_field(ctx, 0, "arg0.clone_args.set_tid", LAYOUT("pid_t[]"), 3,
+					  state->set_tid, NULL, size, size, status);
+		}
+		return;
+	}
+	if (result <= 0)
+		return;
+	state = ant_capture_state(ctx);
+	if (!state) {
+		ant_capture_field(ctx, 0, "arg0.clone_args.output", "", 1,
+				  args[0], NULL, U64_MAX, U64_MAX, ANT_CONTEXT_MISSING);
+		return;
+	}
+	if (state->flags & CLONE_PIDFD)
+		capture_optional(ctx, 0, state->pidfd, "arg0.clone_args.pidfd",
+				 LAYOUT("int"), sizeof(int));
+	if (state->flags & CLONE_PARENT_SETTID)
+		capture_optional(ctx, 0, state->parent_tid, "arg0.clone_args.parent_tid",
+				 LAYOUT("pid_t"), sizeof(pid_t));
+	/* The child writes its own TID before returning to user space, and the
+	 * kernel clears it when the child exits; neither is visible here.
+	 */
+	if ((state->flags & CLONE_CHILD_SETTID) && !ant_capture_lost(ctx))
+		ant_capture_field(ctx, 0, "arg0.clone_args.child_tid", LAYOUT("pid_t"), 3,
+				  state->child_tid, NULL, sizeof(pid_t), sizeof(pid_t),
+				  ANT_ASYNC_UNOBSERVED);
+	if ((state->flags & CLONE_CHILD_CLEARTID) && !ant_capture_lost(ctx))
+		ant_capture_field(ctx, 0, "arg0.clone_args.clear_child_tid", LAYOUT("pid_t"), 3,
+				  state->child_tid, NULL, sizeof(pid_t), sizeof(pid_t),
+				  ANT_ASYNC_UNOBSERVED);
+}
+
+static void capture_process_vm(struct ant_task *ctx, const u64 args[6],
+			       bool output, long result, bool input)
+{
+	struct ant_vector_state *remote;
+	u32 index;
+	char key[64];
+
+	capture_vector(ctx, args, output, result, input);
+	if (output || ant_capture_lost(ctx))
+		return;
+	remote = save_vector(ctx, 3, args[3], args[4], "arg3.remote_iov");
+	if (!remote)
+		return;
+	for (index = 0; index < remote->iov_count && !ant_capture_lost(ctx); index++) {
+		scnprintf(key, sizeof(key), "arg3.remote_iov[%u].data", index);
+		/* The other process's memory is never read, by design. */
+		ant_capture_field(ctx, 3, key, "", 1,
+				  (unsigned long)remote->iov[index].iov_base, NULL,
+				  remote->iov[index].iov_len, remote->iov[index].iov_len,
+				  ANT_ADDRESS_ONLY);
+	}
+	kfree(remote);
+}
