+static void capture_fcntl(struct ant_task *ctx, const u64 args[6],
+			  bool output, long result)
+{
+	u64 size;
+	const char *layout;
+	bool input = false, returns_data = false;
+
+	switch ((u32)args[1]) {
+	case F_GETLK: case F_OFD_GETLK:
+		input = true;
+		returns_data = true;
+		fallthrough;
+	case F_SETLK: case F_SETLKW: case F_OFD_SETLK: case F_OFD_SETLKW:
+		input = true;
+		size = sizeof(struct flock);
+		layout = LAYOUT("flock");
+		break;
+	case F_SETOWN_EX:
+		input = true;
+		fallthrough;
+	case F_GETOWN_EX:
+		returns_data = !input;
+		size = sizeof(struct f_owner_ex);
+		layout = LAYOUT("f_owner_ex");
+		break;
+	case F_GETOWNER_UIDS:
+		returns_data = true;
+		size = 2 * sizeof(u32);
+		layout = LAYOUT("uid_t[2]");
+		break;
+	case F_SET_RW_HINT:
+		input = true;
+		fallthrough;
+	case F_GET_RW_HINT:
+		returns_data = !input;
+		size = sizeof(u64);
+		layout = LAYOUT("u64");
+		break;
+	case F_DUPFD: case F_DUPFD_CLOEXEC: case F_CREATED_QUERY: case F_DUPFD_QUERY:
+	case F_GETFD: case F_SETFD: case F_GETFL: case F_SETFL:
+	case F_GETOWN: case F_SETOWN: case F_GETSIG: case F_SETSIG:
+	case F_GETLEASE: case F_SETLEASE: case F_NOTIFY:
+	case F_SETPIPE_SZ: case F_GETPIPE_SZ: case F_ADD_SEALS: case F_GET_SEALS:
+		return;
+	default:
+		if (!output)
+			capture_gap(ctx, "fcntl.unknown_selector", ANT_NO_DECODER);
+		return;
+	}
+	if ((!output && input) || (output && returns_data && result == 0))
+		ant_capture_field(ctx, 2, "arg2.fcntl", layout, 3,
+				  args[2], NULL, size, size, ANT_COMPLETE);
+}
+
+static void capture_remaining_small(struct ant_task *ctx, u64 nr, const u64 args[6],
+				    bool output, long result)
+{
+	u64 size;
+	u8 arg;
+	const char *layout;
+	enum ant_status status;
+
+	if (nr == __NR_syslog) {
+		if ((u32)args[0] >= SYSLOG_ACTION_READ &&
+		    (u32)args[0] <= SYSLOG_ACTION_READ_CLEAR) {
+			if (output && result >= 0) {
+				status = (s32)args[2] >= 0 ? ANT_COMPLETE : ANT_INVALID_EXTENT;
+				ant_capture_field(ctx, 1, "arg1.log", "", 1, args[1], NULL,
+						  min_t(u64, (u32)args[2], result), (u32)args[2],
+						  status);
+			}
+		} else if ((u32)args[0] > SYSLOG_ACTION_SIZE_BUFFER && !output) {
+			ant_capture_field(ctx, 1, "syslog.unknown_selector", "", 1,
+					  args[1], NULL, U64_MAX, U64_MAX, ANT_NO_DECODER);
+		}
+		return;
+	}
+	if (nr == __NR_perf_event_open) {
+		if (!output)
+			capture_sized_input(ctx, 0, args[0], sizeof(u32), PERF_ATTR_SIZE_VER0,
+					    sizeof(struct perf_event_attr), "arg0.perf_event_attr",
+					    LAYOUT("perf_event_attr"), true);
+		else if (result == -E2BIG)
+			capture_optional(ctx, 0, args[0] + sizeof(u32), "arg0.required_size",
+					 LAYOUT("u32"), sizeof(u32));
+		return;
+	}
+	for (arg = output ? 4 : 2; arg <= (output ? 4 : 3) && !ant_capture_lost(ctx); arg++) {
+		if (!args[arg])
+			continue;
+		size = args[1] <= U64_MAX / (arg == 2 ? sizeof(u64) : sizeof(int)) ?
+			args[1] * (arg == 2 ? sizeof(u64) : sizeof(int)) : U64_MAX;
+		layout = arg == 2 ? LAYOUT("address[]") : LAYOUT("int[]");
+		if (!output || result >= 0)
+			ant_capture_field(ctx, arg, "move_pages.array", layout, 3,
+					  args[arg], NULL, size, size,
+					  size == U64_MAX ? ANT_INVALID_EXTENT : ANT_COMPLETE);
+	}
+}
