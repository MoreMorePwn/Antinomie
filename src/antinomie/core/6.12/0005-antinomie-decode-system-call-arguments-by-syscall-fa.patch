+		return ANT_CAPTURE_OWNED | mask;
+	case __NR_preadv: case __NR_pwritev: case __NR_preadv2: case __NR_pwritev2:
+		capture_vector(ctx, args, output, result,
+			       nr == __NR_pwritev || nr == __NR_pwritev2);
+		return ANT_CAPTURE_OWNED | BIT(1);
+	case __NR_sendmsg: case __NR_recvmsg:
+		capture_message(ctx, args, output, result, nr == __NR_sendmsg);
+		return ANT_CAPTURE_OWNED | BIT(1);
+	case __NR_getsockname: case __NR_getpeername: case __NR_accept4:
+		capture_address(ctx, args, output, result);
+		return ANT_CAPTURE_OWNED | BIT(1) | BIT(2);
+	case __NR_setsockopt:
+		if (!output)
+			capture_setsockopt(ctx, args);
+		return ANT_CAPTURE_OWNED | BIT(3);
+	case __NR_getsockopt:
+		capture_getsockopt(ctx, args, output, result);
+		return ANT_CAPTURE_OWNED | BIT(3) | BIT(4);
+	case __NR_socketpair:
+		if (output && result == 0 && !ant_capture_lost(ctx))
+			ant_capture_field(ctx, 3, "arg3.socketpair", LAYOUT("int[2]"), 3,
+					  args[3], NULL, 2 * sizeof(int), 2 * sizeof(int),
+					  ANT_COMPLETE);
+		return ANT_CAPTURE_OWNED | BIT(3);
+	case __NR_setxattr: case __NR_lsetxattr: case __NR_fsetxattr:
+	case __NR_getxattr: case __NR_lgetxattr: case __NR_fgetxattr:
+	case __NR_listxattr: case __NR_llistxattr: case __NR_flistxattr:
+	case __NR_removexattr: case __NR_lremovexattr: case __NR_fremovexattr: {
+		enum ant_xattr_op op = xattr_op(nr);
+
+		capture_xattr(ctx, op, xattr_by_path(nr), args, output, result);
+		mask = xattr_by_path(nr) ? BIT(0) : 0;
+		mask |= op == ANT_XATTR_SET || op == ANT_XATTR_GET ? BIT(1) | BIT(2) : BIT(1);
+		return ANT_CAPTURE_OWNED | mask;
+	}
+	default:
+		mask = ant_arch_capture(ctx, nr, args, output, result);
+		if (mask)
+			return mask;
+		break;
+	}
+	for (index = 0; index < ARRAY_SIZE(field_rules); index++) {
+		const struct ant_field_rule *rule = &field_rules[index];
+
+		if (rule->nr != nr)
+			continue;
+		mask |= BIT(rule->arg_index);
+		if (!ant_capture_lost(ctx))
+			capture_rule(ctx, rule, args, output, result);
+	}
+	return mask ? ANT_CAPTURE_OWNED | mask : 0;
+}
