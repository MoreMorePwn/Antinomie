+#ifdef __NR_sysfs
+static void capture_sysfs(struct ant_task *ctx, const u64 args[6], bool output, long result)
+{
+	switch (args[0]) {
+	case 1:
+		if (!output)
+			ant_capture_string(ctx, 1, "arg1.fsname", args[1], PATH_MAX);
+		return;
+	case 2:
+		/* The kernel writes the name and its NUL; read back exactly that string. */
+		if (output && result == 0)
+			ant_capture_string(ctx, 2, "arg2.fsname", args[2], PATH_MAX);
+		return;
+	case 3:
+		return;
+	default:
+		if (!output)
+			capture_gap(ctx, "sysfs.unknown_selector", ANT_NO_DECODER);
+	}
