+/* Slice 2C: mount, quota control, kexec_load and rseq. Roles follow the pinned
+ * fs/namespace.c, fs/quota/quota.c, kernel/kexec.c and kernel/rseq.c.
+ */
+
+/* copy_mount_options() reads up to one page and stops at the first unreadable
+ * byte. Pages are readable as a whole, so probing each page's first byte gives
+ * the same prefix. A non-resident page may also read as unreadable here.
+ */
+static void capture_mount_data(struct ant_task *ctx, u64 address)
+{
+	u64 first = PAGE_SIZE - offset_in_page(address), prefix;
+	char byte;
+
+	if (!address)
+		return;
+	if (copy_from_user_nofault(&byte, (void __user *)(unsigned long)address, 1))
+		prefix = 0;
+	else if (first >= PAGE_SIZE ||
+		 !copy_from_user_nofault(&byte, (void __user *)(unsigned long)(address + first), 1))
+		prefix = PAGE_SIZE;
+	else
+		prefix = first;
+	if (prefix)
+		ant_capture_field(ctx, 4, "arg4.data", LAYOUT("mount_options"), 1, address, NULL,
+				  prefix, PAGE_SIZE, ANT_COMPLETE);
+	if (prefix < PAGE_SIZE && !ant_capture_lost(ctx))
+		ant_capture_field(ctx, 4, "arg4.data.tail", "", 1, address + prefix, NULL,
+				  PAGE_SIZE - prefix, PAGE_SIZE - prefix, ANT_COPY_FAULT);
+}
+
+static void capture_mount(struct ant_task *ctx, const u64 args[6], bool output)
+{
+	if (output)
+		return;
+	if (args[0])
+		ant_capture_string(ctx, 0, "arg0.dev_name", args[0], PATH_MAX);
+	if (!ant_capture_lost(ctx))
+		ant_capture_string(ctx, 1, "arg1.dir_name", args[1], PATH_MAX);
+	if (args[2] && !ant_capture_lost(ctx))
+		ant_capture_string(ctx, 2, "arg2.type", args[2], PATH_MAX);
+	if (!ant_capture_lost(ctx))
+		capture_mount_data(ctx, args[4]);
+}
+
+/* quotactl(cmd, special, id, addr) and quotactl_fd(fd, cmd, id, addr) share
+ * the subcommand roles of addr (argument 3 in both).
+ */
+static void capture_quota_addr(struct ant_task *ctx, u32 cmd, u64 address, bool output,
+			       long result, bool fd_variant)
+{
+	switch (cmd >> SUBCMDSHIFT) {
+	case Q_QUOTAON:
+		/* quotactl_fd rejects Q_QUOTAON; it has no path argument. */
+		if (!output && !fd_variant)
+			ant_capture_string(ctx, 3, "arg3.quota_file", address, PATH_MAX);
+		return;
+	case Q_GETFMT:
+		capture_paired(ctx, output, result, true, "arg3.format", LAYOUT("u32"), address,
+			       sizeof(u32));
+		return;
+	case Q_GETINFO: case Q_SETINFO:
+		capture_paired(ctx, output, result, cmd >> SUBCMDSHIFT == Q_GETINFO, "arg3.info",
+			       LAYOUT("if_dqinfo"), address, sizeof(struct if_dqinfo));
+		return;
+	case Q_GETQUOTA: case Q_SETQUOTA:
+		capture_paired(ctx, output, result, cmd >> SUBCMDSHIFT == Q_GETQUOTA, "arg3.dqblk",
+			       LAYOUT("if_dqblk"), address, sizeof(struct if_dqblk));
+		return;
+	case Q_GETNEXTQUOTA:
+		capture_paired(ctx, output, result, true, "arg3.dqblk", LAYOUT("if_nextdqblk"),
+			       address, sizeof(struct if_nextdqblk));
+		return;
+	case Q_XQUOTAON: case Q_XQUOTAOFF: case Q_XQUOTARM:
+		capture_paired(ctx, output, result, false, "arg3.flags", LAYOUT("u32"), address,
+			       sizeof(u32));
+		return;
+	case Q_XGETQSTAT:
+		capture_paired(ctx, output, result, true, "arg3.stat", LAYOUT("fs_quota_stat"),
+			       address, sizeof(struct fs_quota_stat));
+		return;
+	case Q_XGETQSTATV:
+		/* The kernel reads only qs_version before writing the whole result. */
+		if (!output)
+			capture_fixed(ctx, 3, "arg3.qs_version", LAYOUT("u8"), address, 1);
+		else
+			capture_paired(ctx, output, result, true, "arg3.stat",
+				       LAYOUT("fs_quota_statv"), address,
+				       sizeof(struct fs_quota_statv));
+		return;
+	case Q_XSETQLIM: case Q_XGETQUOTA: case Q_XGETNEXTQUOTA:
+		capture_paired(ctx, output, result, cmd >> SUBCMDSHIFT != Q_XSETQLIM, "arg3.dquot",
+			       LAYOUT("fs_disk_quota"), address, sizeof(struct fs_disk_quota));
+		return;
+	case Q_QUOTAOFF: case Q_SYNC: case Q_XQUOTASYNC:
+		return;
+	default:
+		if (!output)
+			capture_gap(ctx, "quotactl.unknown_selector", ANT_NO_DECODER);
+	}
+}
+
+/* The user layout of struct kexec_segment; uapi/linux/kexec.h hides it from
+ * kernel code, and the kernel's own copy adds a kbuf union.
+ */
+struct ant_kexec_segment {
+	u64 buf;
+	u64 bufsz;
+	u64 mem;
+	u64 memsz;
+};
+
+static_assert(sizeof(struct ant_kexec_segment) == 4 * sizeof(unsigned long));
+
+static void capture_kexec_load(struct ant_task *ctx, const u64 args[6], bool output)
+{
+	struct ant_kexec_segment segments[KEXEC_SEGMENT_MAX];
+	enum ant_status status;
+	u64 count = args[1], size;
+	unsigned int index;
+	char key[48];
+
+	if (output)
+		return;
+	size = count <= U64_MAX / sizeof(segments[0]) ? count * sizeof(segments[0]) : U64_MAX;
+	if (count > KEXEC_SEGMENT_MAX) {
+		ant_capture_field(ctx, 2, "arg2.segments", LAYOUT("kexec_segment[]"), 3, args[2],
+				  NULL, size, size, ANT_INVALID_EXTENT);
+		return;
+	}
+	status = count && copy_from_user_nofault(segments, (void __user *)(unsigned long)args[2],
+						 size) ? ANT_COPY_FAULT : ANT_COMPLETE;
+	ant_capture_field(ctx, 2, "arg2.segments", LAYOUT("kexec_segment[]"), 3, args[2],
+			  segments, size, size, status);
+	if (status != ANT_COMPLETE)
+		return;
+	for (index = 0; index < count && !ant_capture_lost(ctx); index++) {
+		if (!segments[index].bufsz)
+			continue;
+		scnprintf(key, sizeof(key), "arg2.segments[%u].buf", index);
+		/* Bounded like write(); larger images are flagged, not truncated silently. */
+		ant_capture_field(ctx, 2, key, "", 1, segments[index].buf, NULL,
+				  min_t(u64, segments[index].bufsz, MAX_RW_COUNT),
+				  segments[index].bufsz,
+				  segments[index].bufsz > MAX_RW_COUNT ? ANT_INVALID_EXTENT :
+				  ANT_COMPLETE);
+	}
+}
+
+static void capture_rseq(struct ant_task *ctx, const u64 args[6], bool output, long result)
+{
+	u64 size = min_t(u64, (u32)args[1], sizeof(struct rseq));
+
+	if (!output) {
+		ant_capture_field(ctx, 0, "arg0.rseq", LAYOUT("rseq"), 3, args[0], NULL, size,
+				  (u32)args[1], ANT_COMPLETE);
+	} else if (result == 0 && ((u32)args[2] & RSEQ_FLAG_UNREGISTER)) {
+		capture_fixed(ctx, 0, "arg0.rseq", LAYOUT("rseq"), args[0], size);
+	} else if (result == 0) {
+		/* The kernel writes the CPU, node and mm ids on later returns to user. */
+		ant_capture_field(ctx, 0, "arg0.rseq.updates", LAYOUT("rseq"), 3, args[0], NULL,
+				  sizeof(struct rseq), sizeof(struct rseq), ANT_ASYNC_UNOBSERVED);
+	}
+}
+
+/* Slice 2H: bpf(cmd, attr, size). Nested fields come from the snapshot of the
+ * attribute block taken here, never from a second read of user memory, except
+ * for lengths the kernel writes back, which are re-read at exit.
+ */
+#define ANT_BPF_MAX_INSNS 1000000	/* BPF_COMPLEXITY_LIMIT_INSNS */
+#define ANT_BPF_MAX_BTF (16 * 1024 * 1024)	/* BTF_MAX_SIZE, kernel/bpf/btf.c */
+#define ANT_BPF_REC_MIN 8		/* MIN_BPF_FUNCINFO_SIZE */
+#define ANT_BPF_REC_MAX 252		/* MAX_FUNCINFO_REC_SIZE */
+#define ANT_BPF_MULTI_MAX BIT(20)	/* MAX_KPROBE_MULTI_CNT / MAX_UPROBE_MULTI_CNT */
+
+struct ant_bpf_state {
+	union bpf_attr attr;
+	u32 size;
+	u32 key_size;
+	u32 value_size;
+	u32 batch_size;
+	bool map_known;
+	bool map_info;
+};
+
+/* Key, value and batch-token sizes as kernel/bpf/syscall.c computes them. */
+static void bpf_map_sizes(struct ant_bpf_state *state, u32 fd)
+{
+#ifdef CONFIG_BPF_SYSCALL
+	struct bpf_map *map = bpf_map_get(fd);
+
+	if (IS_ERR(map))
+		return;
+	state->map_known = true;
+	state->key_size = map->key_size;
+	switch (map->map_type) {
+	case BPF_MAP_TYPE_PERCPU_HASH: case BPF_MAP_TYPE_LRU_PERCPU_HASH:
+	case BPF_MAP_TYPE_PERCPU_ARRAY: case BPF_MAP_TYPE_PERCPU_CGROUP_STORAGE:
+		state->value_size = round_up(map->value_size, 8) * num_possible_cpus();
+		break;
+	case BPF_MAP_TYPE_PERF_EVENT_ARRAY: case BPF_MAP_TYPE_CGROUP_ARRAY:
+	case BPF_MAP_TYPE_ARRAY_OF_MAPS: case BPF_MAP_TYPE_PROG_ARRAY:
+	case BPF_MAP_TYPE_HASH_OF_MAPS:
+		state->value_size = sizeof(u32);
+		break;
+	default:
+		state->value_size = map->value_size;
+	}
+	switch (map->map_type) {
+	case BPF_MAP_TYPE_HASH: case BPF_MAP_TYPE_PERCPU_HASH:
+	case BPF_MAP_TYPE_LRU_HASH: case BPF_MAP_TYPE_LRU_PERCPU_HASH:
+		state->batch_size = sizeof(u32);
+		break;
+	default:
+		state->batch_size = map->key_size;
+	}
+	bpf_map_put(map);
+#endif
+}
+
+static void bpf_buffer(struct ant_task *ctx, const char *key, const char *layout, u64 address,
+		       u64 count, u64 element, u64 ceiling)
+{
+	u64 size = element && count <= U64_MAX / element ? count * element : U64_MAX;
+
+	if (!address || ant_capture_lost(ctx))
+		return;
+	ant_capture_field(ctx, 1, key, layout, 1, address, NULL, min(size, ceiling), size,
+			  size > ceiling ? ANT_INVALID_EXTENT : ANT_COMPLETE);
+}
+
+static void bpf_map_buffer(struct ant_task *ctx, struct ant_bpf_state *state, const char *key,
+			   u64 address, u64 count, u32 element)
+{
+	if (!address || ant_capture_lost(ctx))
+		return;
+	if (!state->map_known)
+		ant_capture_field(ctx, 1, key, "", 1, address, NULL, U64_MAX, U64_MAX,
+				  ANT_CONTEXT_MISSING);
+	else
+		bpf_buffer(ctx, key, "", address, count, element, MAX_RW_COUNT);
+}
+
+/* A length the kernel rewrote in the attribute block, if the caller's block
+ * covers it; recorded before the output it bounds.
+ */
+static bool bpf_rewritten(struct ant_task *ctx, struct ant_bpf_state *state, u64 attr,
+			  size_t offset, const char *key, u32 *value)
+{
+	enum ant_status status;
+
+	if (offset + sizeof(u32) > state->size || ant_capture_lost(ctx))
+		return false;
+	status = copy_from_user_nofault(value, (void __user *)(unsigned long)(attr + offset),
+					sizeof(*value)) ? ANT_COPY_FAULT : ANT_COMPLETE;
+	ant_capture_field(ctx, 1, key, LAYOUT("u32"), 3, attr + offset, value, sizeof(*value),
+			  sizeof(*value), status);
+	return status == ANT_COMPLETE;
+}
+
+static void bpf_log(struct ant_task *ctx, const char *key, u64 address, u32 size)
+{
+	/* The verifier writes its log on failure too; read back the string it wrote. */
+	if (address && size && !ant_capture_lost(ctx))
+		ant_capture_string(ctx, 1, key, address, size);
+}
+
+static void capture_bpf_link_create(struct ant_task *ctx, const union bpf_attr *a)
+{
+	u64 names, index, address;
+	char key[64];
+	u32 cnt;
+
+	switch (a->link_create.attach_type) {
+	case BPF_TRACE_KPROBE_MULTI: case BPF_TRACE_KPROBE_SESSION:
+		cnt = a->link_create.kprobe_multi.cnt;
+		names = a->link_create.kprobe_multi.syms;
+		bpf_buffer(ctx, "arg1.attr.syms", LAYOUT("char_ptr[]"), names, cnt, sizeof(u64),
+			   ANT_BPF_MULTI_MAX * sizeof(u64));
+		for (index = 0; names && cnt <= ANT_BPF_MULTI_MAX && index < cnt &&
+		     !ant_capture_lost(ctx); index++) {
+			if (copy_from_user_nofault(&address, (void __user *)(unsigned long)
+						   (names + index * sizeof(u64)), sizeof(address)))
+				break;
+			scnprintf(key, sizeof(key), "arg1.attr.syms[%llu]", index);
+			ant_capture_string(ctx, 1, key, address, KSYM_NAME_LEN);
+		}
+		bpf_buffer(ctx, "arg1.attr.addrs", LAYOUT("u64[]"),
+			   a->link_create.kprobe_multi.addrs, cnt, sizeof(u64),
+			   ANT_BPF_MULTI_MAX * sizeof(u64));
+		bpf_buffer(ctx, "arg1.attr.cookies", LAYOUT("u64[]"),
+			   a->link_create.kprobe_multi.cookies, cnt, sizeof(u64),
+			   ANT_BPF_MULTI_MAX * sizeof(u64));
+		return;
+	case BPF_TRACE_UPROBE_MULTI:
+		cnt = a->link_create.uprobe_multi.cnt;
+		if (a->link_create.uprobe_multi.path && !ant_capture_lost(ctx))
+			ant_capture_string(ctx, 1, "arg1.attr.path",
+					   a->link_create.uprobe_multi.path, PATH_MAX);
+		bpf_buffer(ctx, "arg1.attr.offsets", LAYOUT("u64[]"),
+			   a->link_create.uprobe_multi.offsets, cnt, sizeof(u64),
+			   ANT_BPF_MULTI_MAX * sizeof(u64));
+		bpf_buffer(ctx, "arg1.attr.ref_ctr_offsets", LAYOUT("u64[]"),
+			   a->link_create.uprobe_multi.ref_ctr_offsets, cnt, sizeof(u64),
+			   ANT_BPF_MULTI_MAX * sizeof(u64));
+		bpf_buffer(ctx, "arg1.attr.cookies", LAYOUT("u64[]"),
+			   a->link_create.uprobe_multi.cookies, cnt, sizeof(u64),
+			   ANT_BPF_MULTI_MAX * sizeof(u64));
+		return;
+	case BPF_TRACE_ITER:
+		bpf_buffer(ctx, "arg1.attr.iter_info", LAYOUT("bpf_iter_link_info"),
+			   a->link_create.iter_info, a->link_create.iter_info_len, 1, PAGE_SIZE);
+		return;
+	default:
+		return;
+	}
+}
+
+static void capture_bpf_entry(struct ant_task *ctx, struct ant_bpf_state *state, u32 cmd)
+{
+	const union bpf_attr *a = &state->attr;
+
+	switch (cmd) {
+	case BPF_MAP_LOOKUP_ELEM: case BPF_MAP_LOOKUP_AND_DELETE_ELEM:
+	case BPF_MAP_DELETE_ELEM: case BPF_MAP_UPDATE_ELEM: case BPF_MAP_GET_NEXT_KEY:
+		bpf_map_sizes(state, a->map_fd);
+		bpf_map_buffer(ctx, state, "arg1.attr.key", a->key, 1, state->key_size);
+		if (cmd == BPF_MAP_UPDATE_ELEM)
+			bpf_map_buffer(ctx, state, "arg1.attr.value", a->value, 1,
+				       state->value_size);
+		return;
+	case BPF_MAP_LOOKUP_BATCH: case BPF_MAP_LOOKUP_AND_DELETE_BATCH:
+	case BPF_MAP_UPDATE_BATCH: case BPF_MAP_DELETE_BATCH:
+		bpf_map_sizes(state, a->batch.map_fd);
+		bpf_map_buffer(ctx, state, "arg1.attr.in_batch", a->batch.in_batch, 1,
+			       state->batch_size);
+		if (cmd == BPF_MAP_UPDATE_BATCH || cmd == BPF_MAP_DELETE_BATCH)
+			bpf_map_buffer(ctx, state, "arg1.attr.keys", a->batch.keys, a->batch.count,
+				       state->key_size);
+		if (cmd == BPF_MAP_UPDATE_BATCH)
+			bpf_map_buffer(ctx, state, "arg1.attr.values", a->batch.values,
+				       a->batch.count, state->value_size);
+		return;
+	case BPF_PROG_LOAD:
+		bpf_buffer(ctx, "arg1.attr.insns", LAYOUT("bpf_insn[]"), a->insns, a->insn_cnt,
+			   sizeof(struct bpf_insn), ANT_BPF_MAX_INSNS * sizeof(struct bpf_insn));
+		if (a->license && !ant_capture_lost(ctx))
+			ant_capture_string(ctx, 1, "arg1.attr.license", a->license, 128);
+		if (a->func_info_rec_size >= ANT_BPF_REC_MIN &&
+		    a->func_info_rec_size <= ANT_BPF_REC_MAX)
+			bpf_buffer(ctx, "arg1.attr.func_info", LAYOUT("bpf_func_info[]"),
+				   a->func_info, a->func_info_cnt, a->func_info_rec_size,
+				   MAX_RW_COUNT);
+		if (a->line_info_rec_size >= ANT_BPF_REC_MIN &&
+		    a->line_info_rec_size <= ANT_BPF_REC_MAX)
+			bpf_buffer(ctx, "arg1.attr.line_info", LAYOUT("bpf_line_info[]"),
+				   a->line_info, a->line_info_cnt, a->line_info_rec_size,
+				   MAX_RW_COUNT);
+		bpf_buffer(ctx, "arg1.attr.core_relos", LAYOUT("bpf_core_relo[]"), a->core_relos,
+			   a->core_relo_cnt, a->core_relo_rec_size, MAX_RW_COUNT);
+		/* Linux 6.12 has no fd_array count, so its extent is unknown. */
+		if (a->fd_array)
+			capture_gap(ctx, "bpf.fd_array_unbounded", ANT_NO_DECODER);
+		return;
+	case BPF_BTF_LOAD:
+		bpf_buffer(ctx, "arg1.attr.btf", "", a->btf, a->btf_size, 1, ANT_BPF_MAX_BTF);
+		return;
+	case BPF_OBJ_PIN: case BPF_OBJ_GET:
+		if (!ant_capture_lost(ctx))
+			ant_capture_string(ctx, 1, "arg1.attr.pathname", a->pathname, PATH_MAX);
+		return;
+	case BPF_PROG_TEST_RUN:
+		bpf_buffer(ctx, "arg1.attr.data_in", "", a->test.data_in, a->test.data_size_in, 1,
+			   MAX_RW_COUNT);
+		bpf_buffer(ctx, "arg1.attr.ctx_in", "", a->test.ctx_in, a->test.ctx_size_in, 1,
+			   MAX_RW_COUNT);
+		return;
+	case BPF_OBJ_GET_INFO_BY_FD:
+		bpf_map_sizes(state, a->info.bpf_fd);
+		state->map_info = state->map_known;
+		/* Pointers inside the info structures are not followed. */
+		capture_gap(ctx, "bpf.info_nested", ANT_NO_DECODER);
+		return;
+	case BPF_RAW_TRACEPOINT_OPEN:
+		if (a->raw_tracepoint.name && !ant_capture_lost(ctx))
+			ant_capture_string(ctx, 1, "arg1.attr.name", a->raw_tracepoint.name, 128);
+		return;
+	case BPF_LINK_CREATE:
+		capture_bpf_link_create(ctx, a);
+		return;
+	default:
+		return;
+	}
+}
+
+static void capture_bpf_exit(struct ant_task *ctx, struct ant_bpf_state *state, u32 cmd,
+			     u64 attr, long result)
+{
+	const union bpf_attr *a = &state->attr;
+	u32 count;
+
+	switch (cmd) {
+	case BPF_MAP_LOOKUP_ELEM: case BPF_MAP_LOOKUP_AND_DELETE_ELEM:
+		if (result == 0)
+			bpf_map_buffer(ctx, state, "arg1.attr.value", a->value, 1,
+				       state->value_size);
+		return;
+	case BPF_MAP_GET_NEXT_KEY:
+		if (result == 0)
+			bpf_map_buffer(ctx, state, "arg1.attr.next_key", a->next_key, 1,
+				       state->key_size);
+		return;
+	case BPF_MAP_LOOKUP_BATCH: case BPF_MAP_LOOKUP_AND_DELETE_BATCH:
+		/* -ENOENT reports the end of the map after copying what was found. */
+		if ((result != 0 && result != -ENOENT) ||
+		    !bpf_rewritten(ctx, state, attr, offsetof(union bpf_attr, batch.count),
+				   "arg1.attr.count", &count))
+			return;
+		count = min(count, a->batch.count);
+		bpf_map_buffer(ctx, state, "arg1.attr.out_batch", a->batch.out_batch, 1,
+			       state->batch_size);
+		bpf_map_buffer(ctx, state, "arg1.attr.keys", a->batch.keys, count, state->key_size);
+		bpf_map_buffer(ctx, state, "arg1.attr.values", a->batch.values, count,
+			       state->value_size);
+		return;
+	case BPF_PROG_LOAD:
+		bpf_log(ctx, "arg1.attr.log_buf", a->log_buf, a->log_size);
+		return;
+	case BPF_BTF_LOAD:
+		bpf_log(ctx, "arg1.attr.btf_log_buf", a->btf_log_buf, a->btf_log_size);
+		return;
+	case BPF_PROG_TEST_RUN:
+		if (result)
+			return;
+		if (a->test.data_out &&
+		    bpf_rewritten(ctx, state, attr, offsetof(union bpf_attr, test.data_size_out),
+				  "arg1.attr.data_size_out", &count))
+			bpf_buffer(ctx, "arg1.attr.data_out", "", a->test.data_out,
+				   min(count, a->test.data_size_out), 1, MAX_RW_COUNT);
+		if (a->test.ctx_out &&
+		    bpf_rewritten(ctx, state, attr, offsetof(union bpf_attr, test.ctx_size_out),
+				  "arg1.attr.ctx_size_out", &count))
+			bpf_buffer(ctx, "arg1.attr.ctx_out", "", a->test.ctx_out,
+				   min(count, a->test.ctx_size_out), 1, MAX_RW_COUNT);
+		return;
+	case BPF_OBJ_GET_INFO_BY_FD:
+		if (result ||
+		    !bpf_rewritten(ctx, state, attr, offsetof(union bpf_attr, info.info_len),
+				   "arg1.attr.info_len", &count))
+			return;
+		bpf_buffer(ctx, "arg1.attr.info",
+			   state->map_info ? LAYOUT("bpf_map_info") : LAYOUT("bpf_info"),
+			   a->info.info, min(count, a->info.info_len), 1, PAGE_SIZE);
+		return;
+	case BPF_PROG_QUERY:
+		if (result ||
+		    !bpf_rewritten(ctx, state, attr, offsetof(union bpf_attr, query.prog_cnt),
+				   "arg1.attr.prog_cnt", &count))
+			return;
+		count = min(count, a->query.prog_cnt);
+		bpf_buffer(ctx, "arg1.attr.prog_ids", LAYOUT("u32[]"), a->query.prog_ids, count,
+			   sizeof(u32), MAX_RW_COUNT);
+		bpf_buffer(ctx, "arg1.attr.prog_attach_flags", LAYOUT("u32[]"),
+			   a->query.prog_attach_flags, count, sizeof(u32), MAX_RW_COUNT);
+		bpf_buffer(ctx, "arg1.attr.link_ids", LAYOUT("u32[]"), a->query.link_ids, count,
+			   sizeof(u32), MAX_RW_COUNT);
+		bpf_buffer(ctx, "arg1.attr.link_attach_flags", LAYOUT("u32[]"),
+			   a->query.link_attach_flags, count, sizeof(u32), MAX_RW_COUNT);
+		return;
+	case BPF_TASK_FD_QUERY:
+		if (!result && a->task_fd_query.buf &&
+		    bpf_rewritten(ctx, state, attr, offsetof(union bpf_attr, task_fd_query.buf_len),
+				  "arg1.attr.buf_len", &count) && !ant_capture_lost(ctx))
+			ant_capture_string(ctx, 1, "arg1.attr.buf", a->task_fd_query.buf,
+					   min(count + 1, a->task_fd_query.buf_len));
+		return;
+	default:
+		return;
+	}
+}
+
+static bool bpf_known_command(u32 cmd)
+{
+	switch (cmd) {
+	case BPF_MAP_CREATE: case BPF_MAP_LOOKUP_ELEM: case BPF_MAP_UPDATE_ELEM:
+	case BPF_MAP_DELETE_ELEM: case BPF_MAP_GET_NEXT_KEY: case BPF_PROG_LOAD:
+	case BPF_OBJ_PIN: case BPF_OBJ_GET: case BPF_PROG_ATTACH: case BPF_PROG_DETACH:
+	case BPF_PROG_TEST_RUN: case BPF_PROG_GET_NEXT_ID: case BPF_MAP_GET_NEXT_ID:
+	case BPF_PROG_GET_FD_BY_ID: case BPF_MAP_GET_FD_BY_ID: case BPF_OBJ_GET_INFO_BY_FD:
+	case BPF_PROG_QUERY: case BPF_RAW_TRACEPOINT_OPEN: case BPF_BTF_LOAD:
+	case BPF_BTF_GET_FD_BY_ID: case BPF_TASK_FD_QUERY: case BPF_MAP_LOOKUP_AND_DELETE_ELEM:
+	case BPF_MAP_FREEZE: case BPF_BTF_GET_NEXT_ID: case BPF_MAP_LOOKUP_BATCH:
+	case BPF_MAP_LOOKUP_AND_DELETE_BATCH: case BPF_MAP_UPDATE_BATCH:
+	case BPF_MAP_DELETE_BATCH: case BPF_LINK_CREATE: case BPF_LINK_UPDATE:
+	case BPF_LINK_GET_FD_BY_ID: case BPF_LINK_GET_NEXT_ID: case BPF_ENABLE_STATS:
+	case BPF_ITER_CREATE: case BPF_LINK_DETACH: case BPF_PROG_BIND_MAP:
+	case BPF_TOKEN_CREATE:
+		return true;
+	default:
+		return false;
+	}
+}
+
+static void capture_bpf(struct ant_task *ctx, const u64 args[6], bool output, long result)
+{
+	struct ant_bpf_state *state;
+	enum ant_status status;
+	u32 cmd = args[0], size = args[2];
+	u64 copied;
+
+	if (output) {
+		state = ant_capture_state(ctx);
+		if (state && !ant_capture_lost(ctx))
+			capture_bpf_exit(ctx, state, cmd, args[1], result);
+		return;
+	}
+	if (size > PAGE_SIZE) {
+		ant_capture_field(ctx, 1, "arg1.attr", LAYOUT("bpf_attr"), 3, args[1], NULL,
+				  size, size, ANT_INVALID_EXTENT);
+		return;
+	}
+	state = kzalloc(sizeof(*state), GFP_NOWAIT);
+	copied = min_t(u64, size, sizeof(state->attr));
+	status = !state ? ANT_RESOURCE_EXHAUSTED :
+		copy_from_user_nofault(&state->attr, (void __user *)(unsigned long)args[1],
+				       copied) ? ANT_COPY_FAULT : ANT_COMPLETE;
+	ant_capture_field(ctx, 1, "arg1.attr", bpf_known_command(cmd) ? LAYOUT("bpf_attr") : "",
+			  3, args[1], state ? &state->attr : NULL, copied, size, status);
+	if (size > sizeof(state->attr) && !ant_capture_lost(ctx))
+		ant_capture_field(ctx, 1, "arg1.attr.extension", "", 1,
+				  args[1] + sizeof(state->attr), NULL,
+				  size - sizeof(state->attr), size - sizeof(state->attr),
+				  ANT_COMPLETE);
+	if (!bpf_known_command(cmd))
+		capture_gap(ctx, "bpf.unknown_selector", ANT_NO_DECODER);
+	if (status != ANT_COMPLETE || !bpf_known_command(cmd)) {
+		kfree(state);
+		return;
+	}
+	state->size = size;
+	ant_capture_set_state(ctx, state, release_allocation);
+	if (!ant_capture_lost(ctx))
+		capture_bpf_entry(ctx, state, cmd);
+}
+
+/* Socket options. The table below was reviewed against the pinned
+ * net/core/sock.c, net/ipv4/ip_sockglue.c, net/ipv6/ipv6_sockglue.c and
+ * net/ipv4/tcp.c handlers. A (level, optname) pair absent from it is still
+ * captured as raw bytes bounded by optlen, with an explicit no-decoder gap.
+ */
+#define ANT_SOCKOPT_CEILING (128 * 1024)	/* pinned default optmem_max */
+#define ANT_IPT_SO_BASE 64	/* IPT_SO_SET_REPLACE / IPT_SO_GET_INFO */
+#define ANT_IPT_SO_LAST 67	/* IPT_SO_GET_REVISION_TARGET */
+
+enum ant_sockopt_set {
+	ANT_SET_UNKNOWN, ANT_SET_INT, ANT_SET_INT_OR_BYTE, ANT_SET_FIXED,
+	ANT_SET_BY_LENGTH, ANT_SET_BYTES, ANT_SET_FPROG, ANT_SET_LABELED,
+	ANT_SET_NESTED,
+};
+
+enum ant_sockopt_get {
+	ANT_GET_UNKNOWN, ANT_GET_INT, ANT_GET_INT_OR_BYTE, ANT_GET_FIXED,
+	ANT_GET_LABELED, ANT_GET_FILTER_COUNT, ANT_GET_INPUT_NESTED,
+};
+
+struct ant_sockopt_rule {
+	s32 level;
+	s32 name;
+	u8 set;
+	u8 get;
+	u32 size;
+	u32 alt_size;
+	const char *layout;
+	const char *alt_layout;
+};
+
+#define SO_INT(l, n) { l, n, ANT_SET_INT, ANT_GET_INT, sizeof(int), 0, LAYOUT("int"), NULL }
+#define SO_INT_GET(l, n) { l, n, ANT_SET_UNKNOWN, ANT_GET_INT, sizeof(int), 0, LAYOUT("int"), NULL }
+#define SO_BYTE(l, n) { l, n, ANT_SET_INT_OR_BYTE, ANT_GET_INT_OR_BYTE, sizeof(int), 1, \
+			LAYOUT("int"), LAYOUT("u8") }
+#define SO_FIXED(l, n, t, name) { l, n, ANT_SET_FIXED, ANT_GET_FIXED, sizeof(t), 0, \
+				  LAYOUT(name), NULL }
+#define SO_FIXED_GET(l, n, t, name) { l, n, ANT_SET_UNKNOWN, ANT_GET_FIXED, sizeof(t), 0, \
+				      LAYOUT(name), NULL }
+#define SO_BY_LENGTH(l, n, t, name, alt, alt_name) { l, n, ANT_SET_BY_LENGTH, ANT_GET_FIXED, \
+	sizeof(t), sizeof(alt), LAYOUT(name), LAYOUT(alt_name) }
+#define SO_BYTES(l, n, ceiling) { l, n, ANT_SET_BYTES, ANT_GET_LABELED, ceiling, 0, \
+				  LAYOUT("char[]"), NULL }
+#define SO_LABELED(l, n, ceiling, name) { l, n, ANT_SET_LABELED, ANT_GET_LABELED, ceiling, 0, \
+					  LAYOUT(name), NULL }
+#define SO_LABELED_GET(l, n, name) { l, n, ANT_SET_UNKNOWN, ANT_GET_LABELED, 0, 0, \
+				     LAYOUT(name), NULL }
+#define SO_NESTED(l, n, name) { l, n, ANT_SET_NESTED, ANT_GET_LABELED, 0, 0, LAYOUT(name), NULL }
+#define SO_NESTED_IO(l, n, name) { l, n, ANT_SET_NESTED, ANT_GET_INPUT_NESTED, 0, 0, \
+				   LAYOUT(name), NULL }
+
+static const struct ant_sockopt_rule sockopt_rules[] = {
+	SO_INT(SOL_SOCKET, SO_DEBUG), SO_INT(SOL_SOCKET, SO_REUSEADDR),
+	SO_INT(SOL_SOCKET, SO_TYPE), SO_INT(SOL_SOCKET, SO_ERROR),
+	SO_INT(SOL_SOCKET, SO_DONTROUTE), SO_INT(SOL_SOCKET, SO_BROADCAST),
+	SO_INT(SOL_SOCKET, SO_SNDBUF), SO_INT(SOL_SOCKET, SO_RCVBUF),
+	SO_INT(SOL_SOCKET, SO_SNDBUFFORCE), SO_INT(SOL_SOCKET, SO_RCVBUFFORCE),
+	SO_INT(SOL_SOCKET, SO_KEEPALIVE), SO_INT(SOL_SOCKET, SO_OOBINLINE),
+	SO_INT(SOL_SOCKET, SO_NO_CHECK), SO_INT(SOL_SOCKET, SO_PRIORITY),
+	SO_INT(SOL_SOCKET, SO_PASSCRED), SO_INT(SOL_SOCKET, SO_PASSPIDFD),
+	SO_INT(SOL_SOCKET, SO_RCVLOWAT), SO_INT(SOL_SOCKET, SO_BSDCOMPAT),
+	SO_INT(SOL_SOCKET, SO_REUSEPORT), SO_INT(SOL_SOCKET, SO_PASSSEC),
