+static void capture_seccomp(struct ant_task *ctx, const u64 args[6],
+			    bool output, long result)
+{
+	switch ((u32)args[0]) {
+	case SECCOMP_SET_MODE_STRICT:
+		break;
+	case SECCOMP_SET_MODE_FILTER:
+		if (!output)
+			capture_fprog(ctx, 2, args[2], sizeof(struct sock_fprog), "arg2.program");
+		break;
+	case SECCOMP_GET_ACTION_AVAIL:
+		if (!output)
+			capture_optional(ctx, 2, args[2], "arg2.action", LAYOUT("u32"),
+					 sizeof(u32));
+		break;
+	case SECCOMP_GET_NOTIF_SIZES:
+		if (output && result == 0)
+			capture_optional(ctx, 2, args[2], "arg2.sizes",
+					 LAYOUT("seccomp_notif_sizes"),
+					 sizeof(struct seccomp_notif_sizes));
+		break;
+	default:
+		if (!output)
+			ant_capture_field(ctx, 2, "seccomp.unknown_selector", "", 1,
+					  args[2], NULL, U64_MAX, U64_MAX, ANT_NO_DECODER);
+		break;
+	}
+}
