+
+static bool phase_matches(u8 phase, bool output, long result)
+{
+	if (!output)
+		return phase == ANT_INPUT || phase == ANT_BOTH_NONNEGATIVE;
+	switch (phase) {
+	case ANT_OUTPUT_ZERO:
+		return result == 0;
+	case ANT_OUTPUT_POSITIVE:
+		return result > 0;
+	case ANT_OUTPUT_NONNEGATIVE: case ANT_BOTH_NONNEGATIVE:
+		return result >= 0;
+	case ANT_OUTPUT_INTERRUPTED:
+		return result == -EINTR;
+	default:
+		return false;
+	}
+}
+
+static void capture_rule(struct ant_task *ctx, const struct ant_field_rule *rule,
+			 const u64 args[6], bool output, long result)
+{
+	u64 size = rule->object_size, declared = size;
+	enum ant_status status = ANT_COMPLETE;
+	char key[64];
+
+	if (!phase_matches(rule->phase, output, result))
+		return;
+	if (rule->nr == __NR_clock_nanosleep && rule->arg_index == 3 && (args[1] & TIMER_ABSTIME))
+		return;
+	scnprintf(key, sizeof(key), "arg%u.%s", rule->arg_index,
+		  rule->length == ANT_PATH ? "path" : "data");
+	if (rule->length == ANT_PATH) {
+		ant_capture_string(ctx, rule->arg_index, key,
+				   args[rule->arg_index], size);
+		return;
+	}
+	if (rule->length != ANT_FIXED) {
+		declared = args[rule->length_arg];
+		if (rule->object_size == U32_MAX)
+			declared = (u32)declared;
+		else if (rule->object_size == INT_MAX ||
+			 rule->length == ANT_GROUP_INPUT || rule->length == ANT_GROUP_OUTPUT)
+			declared = (s32)declared < 0 ? U64_MAX : (u32)declared;
+		size = min(declared, rule->object_size);
+		if (rule->length == ANT_BUFFER_OUTPUT || rule->length == ANT_GROUP_OUTPUT)
+			size = declared ? min_t(u64, size, result) : 0;
+		if (declared > rule->object_size && rule->object_size != MAX_RW_COUNT)
+			status = ANT_INVALID_EXTENT;
+		if (rule->length == ANT_GROUP_INPUT || rule->length == ANT_GROUP_OUTPUT) {
+			size *= sizeof(u32);
+			declared = declared > NGROUPS_MAX ? U64_MAX : declared * sizeof(u32);
+		}
+	}
+	ant_capture_field(ctx, rule->arg_index, key, rule->layout,
+			  rule->length == ANT_FIXED ? 3 : 1,
+			  args[rule->arg_index], NULL, size, declared, status);
+}
+
+struct ant_vector_state {
+	u32 iov_count;
+	struct iovec iov[];
+};
+
+struct ant_message_state {
+	struct user_msghdr entry;
+	struct ant_vector_state *vector;
+};
+
+struct ant_address_state {
+	int capacity;
+};
+
+struct ant_mmsg_state {
+	u32 capacity;
+	u32 saved_count;
+	struct ant_message_state *messages[];
+};
+
+static void release_allocation(void *owned)
+{
+	kfree(owned);
+}
+
+static void capture_optional(struct ant_task *ctx, u8 arg, u64 address,
+			     const char *key, const char *layout, u64 size)
+{
+	if (address && !ant_capture_lost(ctx))
+		ant_capture_field(ctx, arg, key, layout, 3, address, NULL,
+				  size, size, ANT_COMPLETE);
+}
+
+static struct ant_vector_state *save_vector(struct ant_task *ctx, u8 arg,
+					    u64 address, u64 count, const char *key)
+{
+	struct ant_vector_state *state = NULL;
+	enum ant_status status = ANT_COMPLETE;
+	u64 size = count <= UIO_MAXIOV ? count * sizeof(struct iovec) : U64_MAX;
+	u32 index;
+
+	if (count > UIO_MAXIOV) {
+		status = ANT_INVALID_EXTENT;
+	} else {
+		state = kzalloc(struct_size(state, iov, count), GFP_NOWAIT);
+		if (!state) {
+			status = ANT_RESOURCE_EXHAUSTED;
+		} else if (count && copy_from_user_nofault(state->iov,
+				(void __user *)(unsigned long)address, size)) {
+			status = address ? ANT_COPY_FAULT : ANT_NULL_POINTER;
+		} else {
+			state->iov_count = count;
+			for (index = 0; index < count; index++)
+				if (state->iov[index].iov_len > SSIZE_MAX) {
+					status = ANT_INVALID_EXTENT;
+					break;
+				}
+		}
+	}
+	ant_capture_field(ctx, arg, key, LAYOUT("iovec[]"), 3, address,
+			  state ? state->iov : NULL, size, size, status);
+	if (status != ANT_COMPLETE) {
+		kfree(state);
+		return NULL;
+	}
+	return state;
+}
+
+static void vector_data(struct ant_task *ctx, struct ant_vector_state *state,
+			u8 arg, const char *prefix, u64 remaining)
+{
+	u32 index;
+	char key[96];
+
+	for (index = 0; index < state->iov_count && !ant_capture_lost(ctx); index++) {
+		u64 size = min_t(u64, state->iov[index].iov_len, remaining);
+
+		scnprintf(key, sizeof(key), "%s[%u].data", prefix, index);
+		ant_capture_field(ctx, arg, key, "", 1,
+				  (unsigned long)state->iov[index].iov_base, NULL,
+				  size, state->iov[index].iov_len, ANT_COMPLETE);
+		remaining -= size;
+	}
+}
+
+static void capture_vector(struct ant_task *ctx, const u64 args[6],
+			   bool output, long result, bool input)
+{
+	struct ant_vector_state *state;
+
+	if (ant_capture_lost(ctx))
+		return;
+	if (!output) {
+		state = save_vector(ctx, 1, args[1], args[2], "arg1.iov");
+		ant_capture_set_state(ctx, state, release_allocation);
+		if (state && input)
+			vector_data(ctx, state, 1, "arg1.iov", MAX_RW_COUNT);
+	} else if (!input && result >= 0) {
+		state = ant_capture_state(ctx);
+		if (!state)
+			ant_capture_field(ctx, 1, "arg1.iov.output", "", 1,
+					  args[1], NULL, U64_MAX, U64_MAX,
+					  ANT_CONTEXT_MISSING);
+		else
+			vector_data(ctx, state, 1, "arg1.iov", min_t(u64, result, MAX_RW_COUNT));
+	}
+}
+
+static void release_message(void *owned)
+{
+	struct ant_message_state *state = owned;
+
+	kfree(state->vector);
+	kfree(state);
+}
+
+static void release_mmsg(void *owned)
+{
+	struct ant_mmsg_state *state = owned;
+	u32 index;
+
+	for (index = 0; index < state->saved_count; index++)
+		if (state->messages[index])
+			release_message(state->messages[index]);
+	kfree(state);
+}
+
+static void capture_mmsg_payload(struct ant_task *ctx, struct ant_message_state *state,
+				 const char *prefix, const struct user_msghdr *observed,
+				 u64 transferred, bool output)
+{
+	char key[64];
+	u64 size;
+
+	scnprintf(key, sizeof(key), "%s.iov", prefix);
+	if (state->vector)
+		vector_data(ctx, state->vector, 1, key, output ?
+			    min_t(u64, transferred, MAX_RW_COUNT) : MAX_RW_COUNT);
+	else if (output)
+		ant_capture_field(ctx, 1, key, "", 1,
+				  (unsigned long)state->entry.msg_iov, NULL,
+				  U64_MAX, U64_MAX, ANT_CONTEXT_MISSING);
+	if (ant_capture_lost(ctx))
+		return;
+	if (state->entry.msg_name) {
+		size = state->entry.msg_namelen < 0 || (output && observed->msg_namelen < 0) ?
+			U64_MAX : min_t(u64, sizeof(struct sockaddr_storage),
+			output ? min(state->entry.msg_namelen, observed->msg_namelen) :
+			state->entry.msg_namelen);
+		scnprintf(key, sizeof(key), "%s.name", prefix);
+		ant_capture_field(ctx, 1, key, LAYOUT("sockaddr"), 3,
+				  (unsigned long)state->entry.msg_name, NULL, size,
+				  state->entry.msg_namelen,
+				  size == U64_MAX ? ANT_INVALID_EXTENT : ANT_COMPLETE);
+	}
+	if (state->entry.msg_control && !ant_capture_lost(ctx)) {
+		size = output ? min(state->entry.msg_controllen, observed->msg_controllen) :
+			state->entry.msg_controllen;
+		scnprintf(key, sizeof(key), "%s.control", prefix);
+		ant_capture_field(ctx, 1, key, LAYOUT("cmsghdr[]"), 3,
+				  (unsigned long)state->entry.msg_control, NULL, size,
+				  state->entry.msg_controllen,
+				  !output && size > INT_MAX ? ANT_INVALID_EXTENT : ANT_COMPLETE);
+	}
+}
+
+static void capture_mmsg(struct ant_task *ctx, const u64 args[6],
+			 bool output, long result, bool input)
+{
+	struct ant_mmsg_state *state;
+	struct ant_message_state *message;
+	struct mmsghdr observed;
+	enum ant_status status;
+	u32 capacity = input ? min_t(u32, args[2], UIO_MAXIOV) : (u32)args[2];
+	u32 index, count;
+	u64 address, header_size, size = (u64)capacity * sizeof(struct mmsghdr);
+	char prefix[48], key[64];
+
+	BUILD_BUG_ON(sizeof(struct mmsghdr) != 64);
+	if (!output) {
+		state = kzalloc(struct_size(state, messages, capacity), GFP_NOWAIT);
+		if (!state) {
+			ant_capture_field(ctx, 1, "arg1.mmsg.context", LAYOUT("mmsghdr[]"), 3,
+					  args[1], NULL, size, size, ANT_RESOURCE_EXHAUSTED);
+			return;
+		}
+		state->capacity = capacity;
+		ant_capture_set_state(ctx, state, release_mmsg);
+		count = capacity;
+	} else {
+		if (result <= 0)
+			return;
+		state = ant_capture_state(ctx);
+		if (!state) {
+			ant_capture_field(ctx, 1, "arg1.mmsg.output", LAYOUT("mmsghdr[]"), 3,
+					  args[1], NULL, min_t(u64, result, capacity) *
+					  sizeof(struct mmsghdr), size, ANT_CONTEXT_MISSING);
+			return;
+		}
+		count = min_t(u64, result, state->capacity);
+	}
+	for (index = 0; index < count && !ant_capture_lost(ctx); index++) {
+		scnprintf(prefix, sizeof(prefix), "arg1.mmsg.%u", index);
+		scnprintf(key, sizeof(key), "%s.header", prefix);
+		address = args[1] + (u64)index * sizeof(struct mmsghdr);
+		if (args[1] > U64_MAX - (u64)index * sizeof(struct mmsghdr)) {
+			ant_capture_field(ctx, 1, key, LAYOUT("mmsghdr"), 3,
+					  args[1], NULL, sizeof(observed), sizeof(observed),
+					  ANT_INVALID_EXTENT);
+			break;
+		}
+		header_size = output ? sizeof(observed) : sizeof(observed.msg_hdr);
+		status = copy_from_user_nofault(&observed,
+						(void __user *)(unsigned long)address,
+						header_size) ?
+			ANT_COPY_FAULT : ANT_COMPLETE;
+		ant_capture_field(ctx, 1, key, output ? LAYOUT("mmsghdr") : LAYOUT("msghdr"),
+				  3, address, &observed, header_size, header_size, status);
+		if (status != ANT_COMPLETE || ant_capture_lost(ctx))
+			break;
+		if (!output) {
+			message = kzalloc(sizeof(*message), GFP_NOWAIT);
+			if (!message) {
+				ant_capture_field(ctx, 1, key, "", 1, address, NULL,
+						  sizeof(*message), sizeof(*message),
+						  ANT_RESOURCE_EXHAUSTED);
+				break;
+			}
+			message->entry = observed.msg_hdr;
+			state->messages[index] = message;
+			state->saved_count = index + 1;
+			scnprintf(key, sizeof(key), "%s.iov", prefix);
+			message->vector = save_vector(ctx, 1, (unsigned long)message->entry.msg_iov,
+						      message->entry.msg_iovlen, key);
+			if (input && !ant_capture_lost(ctx))
+				capture_mmsg_payload(ctx, message, prefix, NULL, 0, false);
+		} else if (!input) {
+			message = index < state->saved_count ? state->messages[index] : NULL;
+			if (message)
+				capture_mmsg_payload(ctx, message, prefix, &observed.msg_hdr,
+						     observed.msg_len, true);
+			else
+				ant_capture_field(ctx, 1, key, "", 1, address, NULL,
+						  sizeof(observed), sizeof(observed),
+						  ANT_CONTEXT_MISSING);
+		}
+	}
+	if (!input)
+		capture_optional(ctx, 4, args[4], output ? "arg4.timeout.observed" :
+				 "arg4.timeout", LAYOUT("timespec"),
+				 sizeof(struct __kernel_timespec));
+}
