+struct ant_regset_state {
+	struct iovec iov;
+};
+
+/* Largest native regset in bytes, for SETREGSET input. */
+static u64 regset_ceiling(void)
+{
+	const struct user_regset_view *view = task_user_regset_view(current);
+	u64 ceiling = 0;
+	unsigned int index;
+
+	for (index = 0; index < view->n; index++)
+		ceiling = max_t(u64, ceiling,
+				(u64)view->regsets[index].n * view->regsets[index].size);
+	return ceiling;
+}
+
+static void capture_regset(struct ant_task *ctx, const u64 args[6], bool output, long result,
+			   bool set)
+{
+	struct ant_regset_state *state;
+	enum ant_status status;
+	u64 length, ceiling;
+
+	if (!output) {
+		state = kzalloc(sizeof(*state), GFP_NOWAIT);
+		if (!state) {
+			ant_capture_field(ctx, 3, "arg3.iovec", LAYOUT("iovec"), 3, args[3], NULL,
+					  sizeof(struct iovec), sizeof(struct iovec),
+					  ANT_RESOURCE_EXHAUSTED);
+			return;
+		}
+		status = copy_from_user_nofault(&state->iov, (void __user *)(unsigned long)args[3],
+						sizeof(state->iov)) ? ANT_COPY_FAULT : ANT_COMPLETE;
+		ant_capture_field(ctx, 3, "arg3.iovec", LAYOUT("iovec"), 3, args[3], &state->iov,
+				  sizeof(state->iov), sizeof(state->iov), status);
+		if (status != ANT_COMPLETE) {
+			kfree(state);
+			return;
+		}
+		ant_capture_set_state(ctx, state, release_allocation);
+		if (set && !ant_capture_lost(ctx)) {
+			ceiling = regset_ceiling();
+			ant_capture_field(ctx, 3, "arg3.iovec.data", "", 1,
+					  (unsigned long)state->iov.iov_base, NULL,
+					  min_t(u64, state->iov.iov_len, ceiling),
+					  state->iov.iov_len,
+					  state->iov.iov_len > ceiling ? ANT_INVALID_EXTENT :
+					  ANT_COMPLETE);
+		}
+		return;
+	}
+	if (result || ant_capture_lost(ctx))
+		return;
+	state = ant_capture_state(ctx);
+	status = copy_from_user_nofault(&length, (void __user *)(unsigned long)
+					(args[3] + offsetof(struct iovec, iov_len)),
+					sizeof(length)) ? ANT_COPY_FAULT : ANT_COMPLETE;
+	ant_capture_field(ctx, 3, "arg3.iov_len", LAYOUT("u64"), 3,
+			  args[3] + offsetof(struct iovec, iov_len), &length, sizeof(length),
+			  sizeof(length), status);
+	if (set || ant_capture_lost(ctx))
+		return;
+	if (!state || status != ANT_COMPLETE) {
+		ant_capture_field(ctx, 3, "arg3.iovec.data", "", 1, 0, NULL, U64_MAX, U64_MAX,
+				  ANT_CONTEXT_MISSING);
+		return;
+	}
+	ant_capture_field(ctx, 3, "arg3.iovec.data", "", 1, (unsigned long)state->iov.iov_base,
+			  NULL, min_t(u64, length, state->iov.iov_len), length,
+			  length > state->iov.iov_len ? ANT_INVALID_EXTENT : ANT_COMPLETE);
+}
+
+static void capture_ptrace(struct ant_task *ctx, const u64 args[6], bool output, long result)
+{
+	struct ptrace_peeksiginfo_args peek;
+	u8 data = 3;
+
+	if (ant_arch_capture_ptrace(ctx, args, output, result))
+		return;
+	switch (args[0]) {
+	case PTRACE_PEEKTEXT: case PTRACE_PEEKDATA:
+		/* Tracee addresses are in another address space; never dereference them. */
+		if (!output)
+			ant_capture_field(ctx, 2, "arg2.tracee_address", LAYOUT("unsigned_long"), 3,
+					  args[2], NULL, sizeof(unsigned long),
+					  sizeof(unsigned long), ANT_ADDRESS_ONLY);
+		fallthrough;
+	case PTRACE_PEEKUSR:
+		if (output && result == 0)
+			capture_fixed(ctx, data, "arg3.word", LAYOUT("unsigned_long"), args[data],
+				      sizeof(unsigned long));
+		return;
+	case PTRACE_POKETEXT: case PTRACE_POKEDATA:
+		if (!output)
+			ant_capture_field(ctx, 2, "arg2.tracee_address", LAYOUT("unsigned_long"), 3,
+					  args[2], NULL, sizeof(unsigned long),
+					  sizeof(unsigned long), ANT_ADDRESS_ONLY);
+		return;
+	case PTRACE_GETREGSET: case PTRACE_SETREGSET:
+		capture_regset(ctx, args, output, result, args[0] == PTRACE_SETREGSET);
+		return;
+	case PTRACE_GETSIGINFO: case PTRACE_SETSIGINFO:
+		capture_paired(ctx, output, result, args[0] == PTRACE_GETSIGINFO, "arg3.siginfo",
+			       LAYOUT("siginfo_t"), args[data], sizeof(siginfo_t));
+		return;
+	case PTRACE_PEEKSIGINFO:
+		if (!output) {
+			capture_fixed(ctx, 2, "arg2.args", LAYOUT("ptrace_peeksiginfo_args"),
+				      args[2],
+				      sizeof(peek));
+		} else if (result > 0 && result <= INT_MAX) {
+			capture_fixed(ctx, data, "arg3.siginfo", LAYOUT("siginfo_t[]"), args[data],
+				      (u64)result * sizeof(siginfo_t));
+		}
+		return;
+	case PTRACE_GETSIGMASK: case PTRACE_SETSIGMASK:
+		if (args[2] == sizeof(sigset_t))
+			capture_paired(ctx, output, result, args[0] == PTRACE_GETSIGMASK,
+				       "arg3.sigmask", LAYOUT("sigset_t"), args[data],
+				       sizeof(sigset_t));
+		return;
+	case PTRACE_GETEVENTMSG:
+		if (output && result == 0)
+			capture_fixed(ctx, data, "arg3.message", LAYOUT("unsigned_long"),
+				      args[data],
+				      sizeof(unsigned long));
+		return;
+	case PTRACE_GET_SYSCALL_INFO:
+		if (output)
+			capture_truncated(ctx, data, "arg3.info", LAYOUT("ptrace_syscall_info"),
+					  args[data], args[2], result);
+		return;
+	case PTRACE_GET_RSEQ_CONFIGURATION:
+		if (output)
+			capture_truncated(ctx, data, "arg3.config",
+					  LAYOUT("ptrace_rseq_configuration"),
+					  args[data], args[2], result);
+		return;
+	case PTRACE_SECCOMP_GET_FILTER:
+		if (output && result > 0 && result <= BPF_MAXINSNS && args[data])
+			capture_fixed(ctx, data, "arg3.filter", LAYOUT("sock_filter[]"), args[data],
+				      (u64)result * sizeof(struct sock_filter));
+		return;
+	case PTRACE_SECCOMP_GET_METADATA:
+		if (!output && args[2] >= sizeof(u64))
+			capture_fixed(ctx, data, "arg3.filter_off", LAYOUT("u64"), args[data],
+				      sizeof(u64));
+		else if (output && result >= 0)
+			ant_capture_field(ctx, data, "arg3.metadata", LAYOUT("seccomp_metadata"), 3,
+					  args[data], NULL,
+					  min_t(u64, args[2], sizeof(struct seccomp_metadata)),
+					  args[2], ANT_COMPLETE);
+		return;
+	case PTRACE_SET_SYSCALL_USER_DISPATCH_CONFIG:
+	case PTRACE_GET_SYSCALL_USER_DISPATCH_CONFIG:
+		if (args[2] == sizeof(struct ptrace_sud_config))
+			capture_paired(ctx, output, result,
+				       args[0] == PTRACE_GET_SYSCALL_USER_DISPATCH_CONFIG,
+				       "arg3.config", LAYOUT("ptrace_sud_config"), args[data],
+				       sizeof(struct ptrace_sud_config));
+		return;
+	case PTRACE_TRACEME: case PTRACE_ATTACH: case PTRACE_SEIZE: case PTRACE_INTERRUPT:
+	case PTRACE_LISTEN: case PTRACE_CONT: case PTRACE_SYSCALL: case PTRACE_SINGLESTEP:
+	case PTRACE_KILL: case PTRACE_DETACH: case PTRACE_SETOPTIONS: case PTRACE_POKEUSR:
+		return;
+	default:
+		if (!output)
+			capture_gap(ctx, "ptrace.unknown_selector", ANT_NO_DECODER);
+	}
+}
+
+struct ant_pkey_state {
+	struct keyctl_pkey_params params;
+};
+
+static void capture_keyctl_pkey(struct ant_task *ctx, const u64 args[6], bool output,
+				long result)
+{
+	struct ant_pkey_state *state;
+	enum ant_status status;
+
+	if (!output) {
+		state = kzalloc(sizeof(*state), GFP_NOWAIT);
+		status = !state ? ANT_RESOURCE_EXHAUSTED :
+			copy_from_user_nofault(&state->params,
+					       (void __user *)(unsigned long)args[1],
+					       sizeof(state->params)) ?
+			ANT_COPY_FAULT : ANT_COMPLETE;
+		ant_capture_field(ctx, 1, "arg1.params", LAYOUT("keyctl_pkey_params"), 3, args[1],
+				  state ? &state->params : NULL, sizeof(state->params),
+				  sizeof(state->params), status);
+		if (!ant_capture_lost(ctx))
+			ant_capture_string(ctx, 2, "arg2.info", args[2], PAGE_SIZE);
+		if (status != ANT_COMPLETE) {
+			kfree(state);
+			return;
+		}
+		ant_capture_set_state(ctx, state, release_allocation);
+		if (!ant_capture_lost(ctx))
+			capture_bounded(ctx, 3, "arg3.input", args[3], state->params.in_len,
+					ANT_KEY_PAYLOAD_MAX);
+		if ((u32)args[0] == KEYCTL_PKEY_VERIFY && !ant_capture_lost(ctx))
+			capture_bounded(ctx, 4, "arg4.signature", args[4], state->params.in2_len,
+					ANT_KEY_PAYLOAD_MAX);
+		return;
+	}
+	if ((u32)args[0] == KEYCTL_PKEY_VERIFY || result < 0 || ant_capture_lost(ctx))
+		return;
+	state = ant_capture_state(ctx);
+	if (!state)
+		ant_capture_field(ctx, 4, "arg4.output", "", 1, args[4], NULL, U64_MAX, U64_MAX,
+				  ANT_CONTEXT_MISSING);
+	else
+		capture_truncated(ctx, 4, "arg4.output", "", args[4], state->params.out_len,
+				  result);
+}
+
+static void capture_keyctl_dh(struct ant_task *ctx, const u64 args[6], bool output, long result)
+{
+	struct keyctl_kdf_params kdf;
+	enum ant_status status;
+
+	if (output) {
+		capture_truncated(ctx, 2, "arg2.buffer", "", args[2], args[3], result);
+		return;
+	}
+	capture_fixed(ctx, 1, "arg1.params", LAYOUT("keyctl_dh_params"), args[1],
+		      sizeof(struct keyctl_dh_params));
+	if (!args[4] || ant_capture_lost(ctx))
+		return;
+	status = copy_from_user_nofault(&kdf, (void __user *)(unsigned long)args[4],
+					sizeof(kdf)) ? ANT_COPY_FAULT : ANT_COMPLETE;
+	ant_capture_field(ctx, 4, "arg4.kdf", LAYOUT("keyctl_kdf_params"), 3, args[4], &kdf,
+			  sizeof(kdf), sizeof(kdf), status);
+	if (status != ANT_COMPLETE || ant_capture_lost(ctx))
+		return;
+	if (kdf.hashname)
+		ant_capture_string(ctx, 4, "arg4.kdf.hashname", (unsigned long)kdf.hashname,
+				   ANT_KDF_HASH_MAX);
+	if (!ant_capture_lost(ctx))
+		capture_bounded(ctx, 4, "arg4.kdf.otherinfo", (unsigned long)kdf.otherinfo,
+				kdf.otherinfolen, ANT_KDF_OTHERINFO_MAX);
+}
+
+static void capture_keyctl(struct ant_task *ctx, const u64 args[6], bool output, long result)
+{
+	struct ant_vector_state *vector;
+
+	switch ((u32)args[0]) {
+	case KEYCTL_JOIN_SESSION_KEYRING:
+		if (!output && args[1])
+			ant_capture_string(ctx, 1, "arg1.name", args[1], ANT_KEY_DESC_MAX);
+		return;
+	case KEYCTL_UPDATE:
+		if (!output)
+			capture_bounded(ctx, 2, "arg2.payload", args[2], args[3],
+					ANT_KEY_UPDATE_MAX);
+		return;
+	case KEYCTL_INSTANTIATE:
+		if (!output)
+			capture_bounded(ctx, 2, "arg2.payload", args[2], args[3],
+					ANT_KEY_PAYLOAD_MAX);
+		return;
+	case KEYCTL_INSTANTIATE_IOV:
+		if (output)
+			return;
+		vector = save_vector(ctx, 2, args[2], args[3], "arg2.iov");
+		if (vector)
+			vector_data(ctx, vector, 2, "arg2.iov", ANT_KEY_PAYLOAD_MAX);
+		kfree(vector);
+		return;
+	case KEYCTL_DESCRIBE: case KEYCTL_READ: case KEYCTL_GET_SECURITY:
+		if (output)
+			capture_truncated(ctx, 2, "arg2.buffer", "", args[2], args[3], result);
+		return;
+	case KEYCTL_SEARCH:
+		if (output)
+			return;
+		ant_capture_string(ctx, 2, "arg2.type", args[2], ANT_KEY_TYPE_MAX);
+		if (!ant_capture_lost(ctx))
+			ant_capture_string(ctx, 3, "arg3.description", args[3], ANT_KEY_DESC_MAX);
+		return;
+	case KEYCTL_RESTRICT_KEYRING:
+		if (output)
+			return;
+		if (args[2])
+			ant_capture_string(ctx, 2, "arg2.type", args[2], ANT_KEY_TYPE_MAX);
+		if (args[3] && !ant_capture_lost(ctx))
+			ant_capture_string(ctx, 3, "arg3.restriction", args[3], PAGE_SIZE);
+		return;
+	case KEYCTL_DH_COMPUTE:
+		capture_keyctl_dh(ctx, args, output, result);
+		return;
+	case KEYCTL_PKEY_QUERY:
+		if (!output)
+			ant_capture_string(ctx, 3, "arg3.info", args[3], PAGE_SIZE);
+		else if (result == 0)
+			capture_fixed(ctx, 4, "arg4.query", LAYOUT("keyctl_pkey_query"), args[4],
+				      sizeof(struct keyctl_pkey_query));
+		return;
+	case KEYCTL_PKEY_ENCRYPT: case KEYCTL_PKEY_DECRYPT: case KEYCTL_PKEY_SIGN:
+	case KEYCTL_PKEY_VERIFY:
+		capture_keyctl_pkey(ctx, args, output, result);
+		return;
+	case KEYCTL_CAPABILITIES:
+		if (output)
+			capture_truncated(ctx, 1, "arg1.buffer", "", args[1], args[2], result);
+		return;
+	case KEYCTL_GET_KEYRING_ID: case KEYCTL_REVOKE: case KEYCTL_CHOWN: case KEYCTL_SETPERM:
+	case KEYCTL_CLEAR: case KEYCTL_LINK: case KEYCTL_UNLINK: case KEYCTL_NEGATE:
+	case KEYCTL_SET_REQKEY_KEYRING: case KEYCTL_SET_TIMEOUT: case KEYCTL_ASSUME_AUTHORITY:
+	case KEYCTL_SESSION_TO_PARENT: case KEYCTL_REJECT: case KEYCTL_INVALIDATE:
+	case KEYCTL_GET_PERSISTENT: case KEYCTL_MOVE: case KEYCTL_WATCH_KEY:
+		return;
+	default:
+		if (!output)
+			capture_gap(ctx, "keyctl.unknown_selector", ANT_NO_DECODER);
+	}
+}
