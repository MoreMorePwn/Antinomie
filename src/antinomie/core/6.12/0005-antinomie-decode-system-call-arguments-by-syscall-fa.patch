+/* Selector families (slice 2B). Pointer roles follow the pinned kernel/sys.c,
+ * kernel/ptrace.c, arch/x86/kernel/ptrace.c, security/keys and fs/filesystems.c.
+ */
+#define ANT_ANON_VMA_NAME_MAX 80	/* ANON_VMA_NAME_MAX_LEN, kernel/sys.c */
+#define ANT_KEY_TYPE_MAX 32		/* char type[32], security/keys/keyctl.c */
+#define ANT_KEY_DESC_MAX 4096		/* KEY_MAX_DESC_SIZE, security/keys/keyctl.c */
+#define ANT_KEY_UPDATE_MAX PAGE_SIZE	/* keyctl_update_key() payload limit */
+#define ANT_KEY_PAYLOAD_MAX (1024 * 1024 - 1)	/* keyctl_instantiate_key() */
+#define ANT_KDF_HASH_MAX 128		/* CRYPTO_MAX_ALG_NAME */
+#define ANT_KDF_OTHERINFO_MAX 64	/* KEYCTL_KDF_MAX_OI_LEN, security/keys/internal.h */
+
+/* The kernel returns the full length but copies only what fits the caller's buffer. */
+static void capture_truncated(struct ant_task *ctx, u8 arg, const char *key,
+			      const char *layout, u64 address, u64 capacity, long result)
+{
+	if (address && result >= 0)
+		ant_capture_field(ctx, arg, key, layout, 1, address, NULL,
+				  min_t(u64, capacity, result), result, ANT_COMPLETE);
+}
+
+static void capture_bounded(struct ant_task *ctx, u8 arg, const char *key, u64 address,
+			    u64 length, u64 ceiling)
+{
+	if (address || length)
+		ant_capture_field(ctx, arg, key, "", 1, address, NULL,
+				  min(length, ceiling), length,
+				  length > ceiling ? ANT_INVALID_EXTENT : ANT_COMPLETE);
+}
