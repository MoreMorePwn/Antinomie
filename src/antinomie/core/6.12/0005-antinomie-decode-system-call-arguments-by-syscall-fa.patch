+
+#include "capture_api.h"
+#include "native_capture.h"
+
+enum ant_phase_rule {
+	ANT_INPUT, ANT_OUTPUT_ZERO, ANT_OUTPUT_POSITIVE, ANT_OUTPUT_NONNEGATIVE,
+	ANT_OUTPUT_INTERRUPTED, ANT_BOTH_NONNEGATIVE,
+};
+
+enum ant_length_rule {
+	ANT_FIXED, ANT_PATH, ANT_BUFFER_INPUT, ANT_BUFFER_OUTPUT,
+	ANT_GROUP_INPUT, ANT_GROUP_OUTPUT,
+};
+
+struct ant_field_rule {
+	u16 nr;
+	u8 arg_index;
+	u8 phase;
+	u8 length;
+	u8 length_arg;
+	u64 object_size;
+	const char *layout;
+};
+
+#define LAYOUT(name) ANT_LAYOUT(name)
+#define PATH_FIELD(n, a) { n, a, ANT_INPUT, ANT_PATH, 0, PATH_MAX, "" }
+#define STRING_FIELD(n, a, max) { n, a, ANT_INPUT, ANT_PATH, 0, max, "" }
+#define FIXED_FIELD(n, a, p, t, l) { n, a, p, ANT_FIXED, 0, sizeof(t), LAYOUT(l) }
+#define INPUT_FIELD(n, a, t, l) FIXED_FIELD(n, a, ANT_INPUT, t, l)
+#define OUTPUT_FIELD(n, a, t, l) FIXED_FIELD(n, a, ANT_OUTPUT_ZERO, t, l)
+#define BUFFER_FIELD(n, a, p, k, len, ceiling) { n, a, p, k, len, ceiling, "" }
+
+/* Extents are native Linux layouts or syscall-defined lengths. Output-only
+ * buffers never follow a pointer from an exit-time descriptor. Legacy calls
+ * the asm-generic architectures lack (open, stat, time ...) are guarded with
+ * #ifdef __NR_<name>, here and wherever this file names one.
+ */
+static const struct ant_field_rule field_rules[] = {
+#ifdef __NR_lstat
+	PATH_FIELD(__NR_lstat, 0), OUTPUT_FIELD(__NR_lstat, 1, struct stat, "stat"),
+#endif
+#ifdef __NR_access
+	PATH_FIELD(__NR_access, 0),
+#endif
+#ifdef __NR_pipe
+	OUTPUT_FIELD(__NR_pipe, 0, int[2], "int[2]"),
+#endif
+	INPUT_FIELD(__NR_nanosleep, 0, struct __kernel_timespec, "timespec"),
+	FIXED_FIELD(__NR_nanosleep, 1, ANT_OUTPUT_INTERRUPTED, struct __kernel_timespec,
