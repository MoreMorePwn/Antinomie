+static void capture_ipc_control(struct ant_task *ctx, u64 nr, const u64 args[6],
+				bool output, long result)
+{
+	u32 command = args[nr == __NR_semctl ? 2 : 1];
+	u8 arg = nr == __NR_semctl ? 3 : 2;
+	u64 size = U64_MAX;
+	const char *layout = "";
+	bool input = command == IPC_SET, ignored = false;
+	enum ant_status status = ANT_COMPLETE;
+
+	if (nr == __NR_shmctl) {
+		switch (command) {
+		case IPC_SET: case IPC_STAT: case SHM_STAT: case SHM_STAT_ANY:
+			size = sizeof(struct shmid64_ds);
+			layout = LAYOUT("shmid64_ds");
+			break;
+		case IPC_INFO:
+			size = sizeof(struct shminfo64);
+			layout = LAYOUT("shminfo64");
+			break;
+		case SHM_INFO:
+			size = sizeof(struct shm_info);
+			layout = LAYOUT("shm_info");
+			break;
+		case IPC_RMID: case SHM_LOCK: case SHM_UNLOCK:
+			ignored = true;
+			break;
+		}
+	} else if (nr == __NR_msgctl) {
+		switch (command) {
+		case IPC_SET: case IPC_STAT: case MSG_STAT: case MSG_STAT_ANY:
+			size = sizeof(struct msqid64_ds);
+			layout = LAYOUT("msqid64_ds");
+			break;
+		case IPC_INFO: case MSG_INFO:
+			size = sizeof(struct msginfo);
+			layout = LAYOUT("msginfo");
+			break;
+		case IPC_RMID:
+			ignored = true;
+			break;
+		}
+	} else {
+		switch (command) {
+		case IPC_SET: case IPC_STAT: case SEM_STAT: case SEM_STAT_ANY:
+			size = sizeof(struct semid64_ds);
+			layout = LAYOUT("semid64_ds");
+			break;
+		case IPC_INFO: case SEM_INFO:
+			size = sizeof(struct seminfo);
+			layout = LAYOUT("seminfo");
+			break;
+		case GETALL: case SETALL:
+			/* ipc/sem.c hands over the kernel's own array copy (sem_nsems
+			 * entries) through ant_monitor_operand(); nothing to read here.
+			 */
+			ignored = true;
+			break;
+		case IPC_RMID: case GETVAL: case GETPID: case GETNCNT: case GETZCNT: case SETVAL:
+			ignored = true;
+			break;
+		}
+	}
+	if (ignored || ant_capture_lost(ctx))
+		return;
+	if (size == U64_MAX && status == ANT_COMPLETE) {
+		if (!output)
+			ant_capture_field(ctx, arg, "ipc.unknown_selector", "", 1,
+					  args[arg], NULL, U64_MAX, U64_MAX, ANT_NO_DECODER);
+		return;
+	}
+	if ((input && !output) || (!input && output && result >= 0))
+		ant_capture_field(ctx, arg, "ipc.control", layout, 3,
+				  args[arg], NULL, size, size, status);
+}
+
+static void capture_ipc_data(struct ant_task *ctx, u64 nr, const u64 args[6],
+			     bool output, long result)
+{
+	u64 count, size;
+	enum ant_status status;
+
+	if (nr == __NR_shmat || nr == __NR_shmdt) {
+		if (!output)
+			ant_capture_field(ctx, nr == __NR_shmat ? 1 : 0, "shm.mapping_address",
+					  "", 1, args[nr == __NR_shmat ? 1 : 0], NULL, 0, 0,
+					  ANT_ADDRESS_ONLY);
+		return;
+	}
+	if (nr == __NR_semop || nr == __NR_semtimedop) {
+		if (output)
+			return;
+		count = (u32)args[2];
+		status = count && count <= READ_ONCE(current->nsproxy->ipc_ns->sem_ctls[2]) ?
+			ANT_COMPLETE : ANT_INVALID_EXTENT;
+		size = count * sizeof(struct sembuf);
+		ant_capture_field(ctx, 1, "arg1.semops", LAYOUT("sembuf[]"), 3,
+				  args[1], NULL, size, size, status);
+		if (nr == __NR_semtimedop)
+			capture_optional(ctx, 3, args[3], "arg3.timeout", LAYOUT("timespec"),
+					 sizeof(struct __kernel_timespec));
+		return;
+	}
+	if ((nr == __NR_msgsnd && output) || (nr == __NR_msgrcv && (!output || result < 0)))
+		return;
+	count = nr == __NR_msgsnd ? args[2] : min_t(u64, args[2], result);
+	status = (s64)args[2] < 0 ||
+		(nr == __NR_msgsnd && args[2] > READ_ONCE(current->nsproxy->ipc_ns->msg_ctlmax)) ?
+		ANT_INVALID_EXTENT : ANT_COMPLETE;
+	size = count <= U64_MAX - sizeof(long) ? count + sizeof(long) : U64_MAX;
+	ant_capture_field(ctx, 1, "arg1.message", LAYOUT("msgbuf"), 3,
+			  args[1], NULL, size,
+			  args[2] <= U64_MAX - sizeof(long) ? args[2] + sizeof(long) : U64_MAX,
+			  status);
+}
+
+static void capture_mqueue(struct ant_task *ctx, u64 nr, const u64 args[6],
+			   bool output, long result)
+{
+	struct sigevent event;
+	enum ant_status status;
+	u64 size;
+
+	if (nr == __NR_mq_notify) {
+		if (output || !args[1])
+			return;
+		status = copy_from_user_nofault(&event, (void __user *)(unsigned long)args[1],
+						sizeof(event)) ?
+			ANT_COPY_FAULT : ANT_COMPLETE;
+		ant_capture_field(ctx, 1, "arg1.notification", LAYOUT("sigevent"), 3,
+				  args[1], &event, sizeof(event), sizeof(event), status);
+		if (status == ANT_COMPLETE && event.sigev_notify == SIGEV_THREAD)
+			capture_optional(ctx, 1, (unsigned long)event.sigev_value.sival_ptr,
+					 "arg1.notification.cookie", "", NOTIFY_COOKIE_LEN);
+		return;
+	}
+	if (!output)
+		capture_optional(ctx, 4, args[4], "arg4.timeout", LAYOUT("timespec"),
+				 sizeof(struct __kernel_timespec));
+	if ((nr == __NR_mq_timedsend && !output) ||
+	    (nr == __NR_mq_timedreceive && output && result >= 0)) {
+		size = nr == __NR_mq_timedsend ? args[2] : min_t(u64, args[2], result);
+		if (!ant_capture_lost(ctx))
+			ant_capture_field(ctx, 1, "arg1.message", "", 1, args[1], NULL,
+					  size, args[2], ANT_COMPLETE);
+		if (nr == __NR_mq_timedreceive)
+			capture_optional(ctx, 3, args[3], "arg3.priority", LAYOUT("u32"),
+					 sizeof(u32));
+	}
+}
+
+static void capture_memory_masks(struct ant_task *ctx, u64 nr, const u64 args[6],
+				 bool output, long result)
+{
+	u64 size, bits;
+	u8 arg, end;
+	enum ant_status status;
+	char key[48];
+
+	if (nr == __NR_sched_setaffinity || nr == __NR_sched_getaffinity) {
+		if ((nr == __NR_sched_setaffinity && !output) ||
+		    (nr == __NR_sched_getaffinity && output && result >= 0)) {
+			size = min_t(u64, (u32)args[1], cpumask_size());
+			if (output)
+				size = min_t(u64, size, result);
+			ant_capture_field(ctx, 2, "arg2.cpu_mask", LAYOUT("unsigned_long[]"), 3,
+					  args[2], NULL, size, (u32)args[1], ANT_COMPLETE);
+		}
+		return;
+	}
+	if (nr == __NR_get_mempolicy) {
+		if (!output || result != 0)
+			return;
+		capture_optional(ctx, 0, args[0], "arg0.policy", LAYOUT("int"), sizeof(int));
+		arg = 1;
+		end = 1;
+		bits = args[2] - 1;
+	} else {
+		if (output)
+			return;
+		arg = nr == __NR_mbind ? 3 : nr == __NR_set_mempolicy ? 1 : 2;
+		end = nr == __NR_migrate_pages ? 3 : arg;
+		bits = args[nr == __NR_mbind ? 4 : nr == __NR_set_mempolicy ? 2 : 1] - 1;
+	}
+	status = bits <= PAGE_SIZE * BITS_PER_BYTE ? ANT_COMPLETE : ANT_INVALID_EXTENT;
+	size = status == ANT_COMPLETE ? DIV_ROUND_UP(bits, BITS_PER_LONG) *
+		sizeof(unsigned long) : U64_MAX;
+	for (; arg <= end && !ant_capture_lost(ctx); arg++) {
+		if (!args[arg] || !bits)
+			continue;
+		scnprintf(key, sizeof(key), "arg%u.node_mask", arg);
+		ant_capture_field(ctx, arg, key, LAYOUT("unsigned_long[]"), 3,
+				  args[arg], NULL, size, size, status);
+	}
+}
+
+static void capture_waiter_values(struct ant_task *ctx, u64 address, u32 count)
+{
+	struct futex_waitv waiter;
+	u32 index;
+	enum ant_status status;
+	u64 item_address;
+	void __user *user_address;
+	char key[64];
+
+	for (index = 0; index < count && !ant_capture_lost(ctx); index++) {
+		item_address = address + (u64)index * sizeof(waiter);
+		user_address = (void __user *)(unsigned long)item_address;
+		if (address > U64_MAX - (u64)index * sizeof(waiter) ||
+		    copy_from_user_nofault(&waiter, user_address, sizeof(waiter))) {
+			ant_capture_field(ctx, 0, "arg0.waiter.context", "", 1, address, NULL,
+					  sizeof(waiter), sizeof(waiter), ANT_CONTEXT_MISSING);
+			break;
+		}
+		status = waiter.flags & ~(FUTEX2_SIZE_MASK | FUTEX2_NUMA | FUTEX2_PRIVATE) ?
+			ANT_NO_DECODER : waiter.__reserved ||
+			(waiter.flags & FUTEX2_SIZE_MASK) != FUTEX2_SIZE_U32 ?
+			ANT_INVALID_EXTENT : ANT_COMPLETE;
+		scnprintf(key, sizeof(key), "arg0.waiters.%u.futex.observed", index);
+		ant_capture_field(ctx, 0, key, LAYOUT("u32"), 3,
+				  waiter.uaddr, NULL, sizeof(u32), sizeof(u32), status);
+	}
+}
+
+static void capture_futex(struct ant_task *ctx, u64 nr, const u64 args[6],
+			  bool output, long result)
+{
+	u32 command = (u32)args[1] & FUTEX_CMD_MASK;
+	u64 count, size;
+	bool timeout = false, second = false, modifies = false;
+	enum ant_status status;
+
+	if (nr == __NR_futex_waitv || nr == __NR_futex_requeue) {
+		if (output)
+			return;
+		count = nr == __NR_futex_requeue ? 2 : (u32)args[1];
+		size = count * sizeof(struct futex_waitv);
+		status = count && count <= FUTEX_WAITV_MAX ? ANT_COMPLETE : ANT_INVALID_EXTENT;
+		ant_capture_field(ctx, 0, "arg0.waiters", LAYOUT("futex_waitv[]"), 3,
+				  args[0], NULL, size, size, status);
+		if (status == ANT_COMPLETE)
+			capture_waiter_values(ctx, args[0], count);
+		if (nr == __NR_futex_waitv)
+			capture_optional(ctx, 3, args[3], "arg3.timeout", LAYOUT("timespec"),
+					 sizeof(struct __kernel_timespec));
+		return;
+	}
+	if (nr == __NR_futex_wake || nr == __NR_futex_wait) {
+		if (!output) {
+			status = (args[3] & FUTEX2_SIZE_MASK) == FUTEX2_SIZE_U32 ?
+				ANT_COMPLETE : ANT_INVALID_EXTENT;
+			ant_capture_field(ctx, 0, "arg0.futex.observed", LAYOUT("u32"), 3,
+					  args[0], NULL, sizeof(u32), sizeof(u32), status);
+			if (nr == __NR_futex_wait)
+				capture_optional(ctx, 4, args[4], "arg4.timeout",
+						 LAYOUT("timespec"),
+						 sizeof(struct __kernel_timespec));
+		}
+		return;
+	}
+	switch (command) {
+	case FUTEX_WAIT: case FUTEX_WAIT_BITSET:
+		timeout = true;
+		break;
+	case FUTEX_WAKE: case FUTEX_WAKE_BITSET:
+		break;
+	case FUTEX_REQUEUE: case FUTEX_CMP_REQUEUE:
+		second = true;
+		break;
+	case FUTEX_WAKE_OP: case FUTEX_CMP_REQUEUE_PI:
+		second = true;
+		modifies = true;
+		break;
+	case FUTEX_WAIT_REQUEUE_PI:
+		timeout = true;
+		second = true;
+		modifies = true;
+		break;
+	case FUTEX_LOCK_PI: case FUTEX_LOCK_PI2:
+		timeout = true;
+		modifies = true;
+		break;
+	case FUTEX_UNLOCK_PI: case FUTEX_TRYLOCK_PI:
+		modifies = true;
+		break;
+	default:
+		if (!output)
+			ant_capture_field(ctx, 0, "futex.unknown_selector", "", 1, args[0], NULL,
+					  U64_MAX, U64_MAX, ANT_NO_DECODER);
+		return;
+	}
+	if (!output || (modifies && result >= 0)) {
+		capture_optional(ctx, 0, args[0], "arg0.futex.observed", LAYOUT("u32"),
+				 sizeof(u32));
+		if (second)
+			capture_optional(ctx, 4, args[4], "arg4.futex.observed", LAYOUT("u32"),
+					 sizeof(u32));
+	}
+	if (!output && timeout)
+		capture_optional(ctx, 3, args[3], "arg3.timeout", LAYOUT("timespec"),
+				 sizeof(struct __kernel_timespec));
+}
+
+/* A classic BPF program header and the instruction array it points to. The
+ * array lives in the caller's memory and its length is bounded by BPF_MAXINSNS.
+ */
+static void capture_fprog(struct ant_task *ctx, u8 arg, u64 address, u64 declared,
+			  const char *key)
+{
+	struct sock_fprog program;
+	enum ant_status status;
+	char filter_key[64];
+	u64 size;
+
+	if (declared != sizeof(program)) {
+		ant_capture_field(ctx, arg, key, LAYOUT("sock_fprog"), 3, address, NULL,
+				  min_t(u64, declared, sizeof(program)), declared,
+				  ANT_INVALID_EXTENT);
+		return;
+	}
+	status = copy_from_user_nofault(&program, (void __user *)(unsigned long)address,
+					sizeof(program)) ? ANT_COPY_FAULT : ANT_COMPLETE;
+	ant_capture_field(ctx, arg, key, LAYOUT("sock_fprog"), 3,
+			  address, &program, sizeof(program), sizeof(program), status);
+	if (status != ANT_COMPLETE || ant_capture_lost(ctx))
+		return;
+	size = (u64)program.len * sizeof(struct sock_filter);
+	scnprintf(filter_key, sizeof(filter_key), "%s.filter", key);
+	ant_capture_field(ctx, arg, filter_key, LAYOUT("sock_filter[]"), 3,
+			  (unsigned long)program.filter, NULL, size, size,
+			  program.len && program.len <= BPF_MAXINSNS ?
+			  ANT_COMPLETE : ANT_INVALID_EXTENT);
+}
