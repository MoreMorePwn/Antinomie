+static void capture_fsconfig(struct ant_task *ctx, const u64 args[6], bool output)
+{
+	u32 command = args[1];
+	u64 size;
+
+	if (output)
+		return;
+	switch (command) {
+	case FSCONFIG_CMD_CREATE: case FSCONFIG_CMD_CREATE_EXCL: case FSCONFIG_CMD_RECONFIGURE:
+		return;
+	case FSCONFIG_SET_FLAG: case FSCONFIG_SET_FD:
+		ant_capture_string(ctx, 2, "arg2.key", args[2], 256);
+		return;
+	case FSCONFIG_SET_STRING: case FSCONFIG_SET_BINARY:
+	case FSCONFIG_SET_PATH: case FSCONFIG_SET_PATH_EMPTY:
+		ant_capture_string(ctx, 2, "arg2.key", args[2], 256);
+		if (ant_capture_lost(ctx))
+			return;
+		if (command == FSCONFIG_SET_BINARY) {
+			size = (u32)args[4];
+			ant_capture_field(ctx, 3, "arg3.value", "", 1, args[3], NULL, size, size,
+					  (s32)size > 0 && size <= 1024 * 1024 ?
+					  ANT_COMPLETE : ANT_INVALID_EXTENT);
+		} else {
+			ant_capture_string(ctx, 3, "arg3.value", args[3],
+					   command == FSCONFIG_SET_STRING ? 256 : PATH_MAX);
+		}
+		return;
+	default:
+		ant_capture_field(ctx, 3, "fsconfig.unknown_selector", "", 1,
+				  args[3], NULL, U64_MAX, U64_MAX, ANT_NO_DECODER);
+	}
+}
