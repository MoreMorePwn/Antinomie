@@ -66,7 +69,9 @@ static void publish_records(struct work_struct *work);
 static DECLARE_WORK(publish_work, publish_records);
 static struct ant_aio_reap reaps[ANT_AIO_REAP_COUNT];
 static atomic_t reap_used = ATOMIC_INIT(0);
