 }
 
-static bool reap_take(struct ant_aio_reap *out, struct mm_struct *mm, u64 request_id,
-		      u64 ctx_id, u64 obj, u64 data)
+/* Removes the entry for request_id; the caller releases its event. */
+static bool reap_take(struct ant_aio_reap *out, u64 request_id)
 {
+	unsigned long flags;
 	bool found = false;
 	int i;
 
-	spin_lock(&reap_lock);
