 			entry = &reaps[i];
@@ -578,43 +592,39 @@ u64 ant_monitor_aio_defer(struct ant_async **slot, u64 ctx_id, u64 obj, u64 data
 		spin_unlock_irqrestore(&request_lock, irqflags);
 		event_hold(&entry->event);
 		entry->mm = current->mm;
