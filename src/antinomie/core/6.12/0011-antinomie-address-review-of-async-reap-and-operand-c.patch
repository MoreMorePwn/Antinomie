diff --git a/io_uring/rsrc.c b/io_uring/rsrc.c
index 8989906ac..873d6394b 100644
--- a/io_uring/rsrc.c
+++ b/io_uring/rsrc.c
@@ -554,8 +554,13 @@ int io_files_update_prep(struct io_kiocb *req, const struct io_uring_sqe *sqe)
 	if (!up->nr_args)
 		return -EINVAL;
 	up->arg = READ_ONCE(sqe->addr);
-	ant_uring_memory(req, "async.operand.fds", "linux-6.12.94/x86_64/int[]", 3, up->arg,
-			 NULL, (u64)up->nr_args * sizeof(__s32), false, true);
+	/* Bounded by the table limit the update is checked against later. */
