 include/linux/antinomie_monitor.h |  29 +++--
 io_uring/io_uring.h               |   8 ++
 io_uring/rsrc.c                   |   9 +-
 io_uring/uring_cmd.c              |  38 ++++--
 ipc/sem.c                         |   6 +-
 kernel/antinomie/async.c          | 190 ++++++++++++++++++++++--------
 kernel/antinomie/recorder.c       |  12 +-
 8 files changed, 229 insertions(+), 81 deletions(-)

diff --git a/fs/aio.c b/fs/aio.c
index 488871fb6..1838acc1a 100644
--- a/fs/aio.c
+++ b/fs/aio.c
@@ -623,6 +623,7 @@ static void free_ioctx(struct work_struct *work)
 					  free_rwork);
 	pr_debug("freeing %p\n", ctx);
 
+	ant_monitor_aio_ctx_free(ctx);
 	aio_free_ring(ctx);
 	free_percpu(ctx->cpu);
 	percpu_ref_exit(&ctx->reqs);
@@ -1136,8 +1137,9 @@ static void aio_complete(struct aio_kiocb *iocb)
 	struct io_event	*ev_page, *event;
 	unsigned tail, pos, head, avail;
 	unsigned long	flags;
-
 #ifdef CONFIG_ANTINOMIE
+	u64 ant_request = ant_monitor_async_id(&iocb->ant_async);
+
 	ant_monitor_async_complete(&iocb->ant_async, iocb->ki_res.res, 0, true);
 #endif
 	/*
@@ -1157,6 +1159,11 @@ static void aio_complete(struct aio_kiocb *iocb)
 	event = ev_page + pos % AIO_EVENTS_PER_PAGE;
 
 	*event = iocb->ki_res;
+#ifdef CONFIG_ANTINOMIE
+	/* Before the tail moves, so a reader cannot consume an unstamped slot. */
+	ant_monitor_aio_completed(ant_request, ctx, pos - AIO_EVENTS_OFFSET,
+				  iocb->ki_res.res);
+#endif
 
 	flush_dcache_folio(ctx->ring_folios[pos / AIO_EVENTS_PER_PAGE]);
 
@@ -1289,6 +1296,7 @@ static long aio_read_events_ring(struct kioctx *ctx,
 			ret = -EFAULT;
 			goto out;
 		}
+		ant_monitor_aio_consumed(ctx, head, avail);
 
 		ret += avail;
 		head += avail;
@@ -1624,13 +1632,15 @@ static int aio_read(struct kiocb *req, const struct iocb *iocb,
 		 * buffer cannot be read; io_getevents() reads it instead.
 		 */
 		deferred = vectored ? 0 :
-			ant_monitor_aio_defer(&tracked->ant_async, tracked->ki_ctx->user_id,
-					      tracked->ki_res.obj, tracked->ki_res.data,
+			ant_monitor_aio_defer(&tracked->ant_async, tracked->ki_ctx,
 					      iocb->aio_buf, iocb->aio_nbytes);
 		observed = iter;
 		result = file->f_op->read_iter(req, &iter);
 		if (result != -EIOCBQUEUED)
 			ant_monitor_aio_undefer(&tracked->ant_async, deferred);
+		/* A failed read wrote no output, so there is no payload to miss. */
+		if (result < 0 && result != -EIOCBQUEUED)
+			ant_monitor_async_scalar(&tracked->ant_async);
 		if (result >= 0)
 			ant_monitor_async_iter(&tracked->ant_async, &observed, result, 0, true);
 		aio_rw_done(req, result);
@@ -2285,8 +2295,6 @@ static long do_io_getevents(aio_context_t ctx_id,
 			ret = read_events(ioctx, min_nr, nr, events, until);
 		percpu_ref_put(&ioctx->users);
 	}
-	if (ret > 0)
-		ant_monitor_aio_reaped(ctx_id, events, ret);
 
 	return ret;
 }
