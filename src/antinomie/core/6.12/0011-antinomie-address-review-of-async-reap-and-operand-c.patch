@@ -625,7 +635,7 @@ void ant_monitor_aio_undefer(struct ant_async **slot, u64 request_id)
 	struct ant_aio_reap entry;
 	unsigned long irqflags;
 
-	if (!request_id || !reap_take(&entry, current->mm, request_id, 0, 0, 0))
+	if (!request_id || !reap_take(&entry, request_id))
