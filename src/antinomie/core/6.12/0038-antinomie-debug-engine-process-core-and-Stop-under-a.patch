From 041cce8767c680c42d78a86e2c13e4bf7633db1e Mon Sep 17 00:00:00 2001
From: MikiMiku <jonathanirvinjo@gmail.com>
Date: Tue, 20 Oct 2026 13:32:29 +0700
Subject: [PATCH] antinomie: debug engine: process core and Stop under a debug
 stop, signals before fatal exits

A thread the debugger holds stopped runs task work queued for it from inside its
park, so a manual process core taken while the group is stopped completes with
the group still stopped (the core's eligibility check accepts a thread in a debug
park, and queueing the core's work wakes the sleeper). The debugger's resume does
not release a thread that is still inside the core's rendezvous.

STOP_RUN tells a session that debugs the run first: no new stop starts, the
worker stops the group if it runs (so the engine's bytes leave memory), releases
every thread and delivers a signal a thread stopped on. The SIGTERM then takes
effect at once; the SIGKILL escalation stays the backstop and ends a parked
thread through its killable sleep.

A signal whose default action ends the whole group used to do so at generation
time, before any delivery path: the debugger never saw SIGTERM, SIGUSR1 without
a handler and the like. For tasks of a debugged group such a signal is now queued
like any other, as it is for a traced task, so it stops the group first.
---
 include/linux/antinomie_monitor.h |   9 +++
 kernel/antinomie/control.c        |   2 +
 kernel/antinomie/debug.c          | 119 ++++++++++++++++++++++++++++--
 kernel/antinomie/debug.h          |   5 ++
 kernel/antinomie/manual_core.c    |   6 +-
 kernel/signal.c                   |   3 +-
 6 files changed, 135 insertions(+), 9 deletions(-)

diff --git a/include/linux/antinomie_monitor.h b/include/linux/antinomie_monitor.h
index 68a472056..d873b5cce 100644
--- a/include/linux/antinomie_monitor.h
+++ b/include/linux/antinomie_monitor.h
@@ -32,6 +32,7 @@ static inline void ant_monitor_shadow_read(struct mm_struct *mm, unsigned long a
 	if (static_branch_unlikely(&ant_dbg_shadow_key))
 		ant_dbg_shadow_read(mm, addr, buf, len);
 }
+bool ant_dbg_wants_signals(struct task_struct *task);
 int ant_dbg_signal(int signr, struct kernel_siginfo *info, enum pid_type type);
 void ant_dbg_signal_delivered(void);
 /* A signal about to be delivered to a debugged thread stops the group first.
@@ -44,6 +45,13 @@ static inline int ant_monitor_signal(int signr, struct kernel_siginfo *info,
 		return ant_dbg_signal(signr, info, type);
 	return signr;
 }
+/* A signal that would end the whole group at once (its default action) is queued
+ * instead, so the debugger sees it before it takes effect, as with a tracer.
+ */
+static inline bool ant_monitor_debugged(struct task_struct *task)
+{
+	return static_branch_unlikely(&ant_dbg_shadow_key) && ant_dbg_wants_signals(task);
+}
 static inline void ant_monitor_signal_delivered(void)
 {
 	if (static_branch_unlikely(&ant_dbg_shadow_key))
@@ -116,6 +124,7 @@ static inline int ant_monitor_signal(int signr, struct kernel_siginfo *info,
 {
 	return signr;
 }
+static inline bool ant_monitor_debugged(struct task_struct *task) { return false; }
 static inline void ant_monitor_signal_delivered(void) {}
 static inline void ant_monitor_enter(struct pt_regs *regs, long nr) {}
 static inline void ant_monitor_exit(struct pt_regs *regs) {}
diff --git a/kernel/antinomie/control.c b/kernel/antinomie/control.c
index 08eef605e..4a1796252 100644
--- a/kernel/antinomie/control.c
+++ b/kernel/antinomie/control.c
@@ -557,6 +557,8 @@ static int stop_run(const u8 *args, size_t args_len)
 	 * escape this pass, so success only reports an issued signal request;
 	 * the escalation to SIGKILL (run.c) covers a task that ignores SIGTERM.
 	 */
+	/* A debugger of this run steps aside first, so the signal is not stopped on. */
+	ant_debug_run_stop(root_cookie);
 	error = ant_run_signal(root_cookie, SIGTERM, &issued);
 	if (issued) {
 		ant_monitor_run_stopped(root_cookie);
diff --git a/kernel/antinomie/debug.c b/kernel/antinomie/debug.c
index c2ab82460..7c0312881 100644
--- a/kernel/antinomie/debug.c
+++ b/kernel/antinomie/debug.c
@@ -51,6 +51,7 @@
 #define W_CONT 2U
 #define W_DETACH 4U
 #define W_SYNC 8U
+#define W_RUNSTOP 16U
 #define SPARE_RECORDS 32U
 #define HIST_ENTRIES 64U
 
@@ -118,7 +119,7 @@ struct ant_dbg {
 	u64 ev_pc, ev_addr;
 	int last_error;
 	u32 wait_status;
-	bool teardown, kill, interrupt, step_request, detaching, run_stopping, start_pending;
+	bool teardown, kill, interrupt, step_request, detaching, run_stopping, run_stop_req, start_pending;
 	u32 step_tid, cont_sig, cont_sig_tid;
 	struct ant_dbg_bp bps[MAX_BREAKPOINTS];
 	unsigned int bp_count;
@@ -758,7 +759,7 @@ bool ant_dbg_trap_breakpoint(struct pt_regs *regs, unsigned long addr)
 		return false;
 	rcu_read_lock();
 	s = rcu_dereference(active_dbg);
-	if (s && !READ_ONCE(s->teardown)) {
+	if (s && !READ_ONCE(s->teardown) && !READ_ONCE(s->run_stop_req)) {
 		t = find_thread(s, current);
 		kind = bp_kind_at(s, addr);
 		if (!t && kind)
@@ -813,7 +814,7 @@ static void hw_triggered(struct perf_event *bp, struct perf_sample_data *data,
 	struct ant_dbg_thread *t;
 	u32 type = bp->attr.bp_type;
 
-	if (!user_mode(regs) || READ_ONCE(s->teardown) || READ_ONCE(s->run_stopping))
+	if (!user_mode(regs) || READ_ONCE(s->teardown) || READ_ONCE(s->run_stop_req))
 		return;
 	rcu_read_lock();
 	t = find_thread(s, current);
@@ -972,7 +973,10 @@ static void park_current(struct ant_dbg *s, struct ant_dbg_thread *t, u32 pendin
 {
 	unsigned long flags;
 
-	if (READ_ONCE(s->teardown))
+	if (READ_ONCE(s->teardown) || READ_ONCE(s->run_stopping))
+		return;
+	/* Already parked: this is a callback that ran inside the park itself. */
+	if (READ_ONCE(t->state) == T_PARKED)
 		return;
 	if (current->flags & PF_EXITING) {
 		WRITE_ONCE(t->state, T_DEAD);
@@ -1020,8 +1024,18 @@ static void park_current(struct ant_dbg *s, struct ant_dbg_thread *t, u32 pendin
 		spin_unlock_irqrestore(&s->lock, flags);
 	}
 	wake_up_all(&s->wait);
-	/* Killable: SIGKILL (and a detach with kill) always gets the thread out. */
-	wait_event_killable(s->wait, READ_ONCE(t->go) || READ_ONCE(s->teardown));
+	/* Killable: SIGKILL (and a detach with kill) always gets the thread out. A
+	 * process core taken while the debugger holds the stop queues its own work
+	 * for the thread; the thread runs it here, in the park, and stays stopped.
+	 */
+	for (;;) {
+		int killed = wait_event_killable(s->wait, READ_ONCE(t->go) ||
+						 READ_ONCE(s->teardown) || task_work_pending(current));
+
+		if (killed || READ_ONCE(t->go) || READ_ONCE(s->teardown))
+			break;
+		task_work_run();
+	}
 	spin_lock_irqsave(&s->lock, flags);
 	t->state = T_RUNNING;
 	s->park_seq++;
@@ -1049,7 +1063,8 @@ static struct ant_dbg *hook_session(void)
 
 	rcu_read_lock();
 	s = rcu_dereference(active_dbg);
-	if (s && (READ_ONCE(s->teardown) || !is_member(s) || !refcount_inc_not_zero(&s->refs)))
+	if (s && (READ_ONCE(s->teardown) || READ_ONCE(s->run_stop_req) || !is_member(s) ||
+		  !refcount_inc_not_zero(&s->refs)))
 		s = NULL;
 	rcu_read_unlock();
 	return s;
@@ -1528,6 +1543,92 @@ static void do_detach(struct ant_dbg *s)
 	unpublish(s);	/* teardown also releases every parked thread */
 }
 
+/* STOP_RUN reached a run this session debugs. The program is being ended: stop
+ * it if it runs (so the engine's bytes are out of memory), then let every thread
+ * go and stop interfering. A signal a thread stopped on is delivered.
+ */
+static void do_runstop(struct ant_dbg *s)
+{
+	u32 state = READ_ONCE(s->state);
+
+	if (state == ANTC_DEBUG_EXITED || state == ANTC_DEBUG_EXEC)
+		return;
+	if (state == ANTC_DEBUG_RUNNING || state == ANTC_DEBUG_STOPPING)
+		do_stop(s);
+	remove_breakpoints(s);
+	tmp_remove(s);
+	WRITE_ONCE(s->run_stopping, true);
+	spin_lock_irq(&s->lock);
+	s->ev_kind = ANTC_DEBUG_EVENT_NONE;
+	s->interrupt = false;
+	spin_unlock_irq(&s->lock);
+	set_state(s, ANTC_DEBUG_RUNNING);
+	release_threads(s);
+}
+
+/* Called by STOP_RUN after it signalled the run. */
+void ant_debug_run_stop(u64 root_cookie)
+{
+	struct ant_dbg *s;
+
+	mutex_lock(&dbg_lock);
+	s = rcu_dereference_protected(active_dbg, lockdep_is_held(&dbg_lock));
+	if (s && READ_ONCE(s->leader->ant_root_cookie) == root_cookie) {
+		/* From now on no new stop starts; the worker ends the ones in place. */
+		WRITE_ONCE(s->run_stop_req, true);
+		spin_lock_irq(&s->lock);
+		s->want |= W_RUNSTOP;
+		spin_unlock_irq(&s->lock);
+		queue_work_ref(s);
+	}
+	mutex_unlock(&dbg_lock);
+}
+
+/* Whether signals to this task are the debugger's to see first. */
+bool ant_dbg_wants_signals(struct task_struct *task)
+{
+	struct ant_dbg *s;
+	bool wanted;
+
+	rcu_read_lock();
+	s = rcu_dereference(active_dbg);
+	wanted = s && !READ_ONCE(s->teardown) && !READ_ONCE(s->run_stop_req) &&
+		same_thread_group(task, s->leader);
+	rcu_read_unlock();
+	return wanted;
+}
+
+/* The thread sleeps in a debug stop: stable enough for a process core. */
+bool ant_debug_task_parked(struct task_struct *task)
+{
+	struct ant_dbg *s;
+	struct ant_dbg_thread *t;
+	bool parked = false;
+
+	rcu_read_lock();
+	s = rcu_dereference(active_dbg);
+	if (s) {
+		t = find_thread(s, task);
+		parked = t && READ_ONCE(t->state) == T_PARKED;
+	}
+	rcu_read_unlock();
+	return parked;
+}
+
+/* Work was queued for a thread that may be asleep in a debug stop: wake it so it
+ * runs the work (TWA_SIGNAL does not wake an uninterruptible sleep).
+ */
+void ant_debug_kick(struct task_struct *task)
+{
+	struct ant_dbg *s;
+
+	rcu_read_lock();
+	s = rcu_dereference(active_dbg);
+	if (s && find_thread(s, task))
+		wake_up_all(&s->wait);
+	rcu_read_unlock();
+}
+
 static void dbg_work_fn(struct work_struct *work)
 {
 	struct ant_dbg *s = container_of(work, struct ant_dbg, work);
@@ -1544,6 +1645,10 @@ static void dbg_work_fn(struct work_struct *work)
 			do_detach(s);
 			continue;
 		}
+		if (want & W_RUNSTOP) {
+			do_runstop(s);
+			continue;
+		}
 		if (want & W_SYNC)
 			sync_threads(s, false);
 		if (want & W_STOP)
diff --git a/kernel/antinomie/debug.h b/kernel/antinomie/debug.h
index 585f1431f..6545564ff 100644
--- a/kernel/antinomie/debug.h
+++ b/kernel/antinomie/debug.h
@@ -88,5 +88,10 @@ bool ant_debug_active(void);
  */
 int ant_debug_launch_check(void);
 int ant_debug_launch(void);
+/* STOP_RUN signalled a run: a session debugging it lets it go and steps aside. */
+void ant_debug_run_stop(u64 root_cookie);
+/* Whether the task sleeps in a debug stop; and wake it to run queued work. */
+bool ant_debug_task_parked(struct task_struct *task);
+void ant_debug_kick(struct task_struct *task);
 
 #endif
diff --git a/kernel/antinomie/manual_core.c b/kernel/antinomie/manual_core.c
index 8335b5377..286771cdc 100644
--- a/kernel/antinomie/manual_core.c
+++ b/kernel/antinomie/manual_core.c
@@ -23,6 +23,7 @@
 #include <linux/workqueue.h>
 #include "control_wire.h"
 #include "process_core.h"
+#include "debug.h"
 
 #ifdef CONFIG_COREDUMP
 #define LIVE_THREADS 256U
@@ -145,7 +146,8 @@ static bool eligible(struct task_struct *task)
 	return !(READ_ONCE(task->flags) & (PF_KTHREAD | PF_USER_WORKER | PF_EXITING)) &&
 		!READ_ONCE(task->ptrace) && !task_is_stopped_or_traced(task) &&
 		!(READ_ONCE(task->jobctl) & JOBCTL_STOP_PENDING) && !freezing(task) &&
-		!(READ_ONCE(task->__state) & TASK_UNINTERRUPTIBLE);
+		(!(READ_ONCE(task->__state) & TASK_UNINTERRUPTIBLE) ||
+		 ant_debug_task_parked(task));
 }
 
 static int resolve_group(struct ant_manual *session)
@@ -512,6 +514,8 @@ static void manual_work(struct work_struct *work)
 			manual_error(session, error);
 			break;
 		}
+		/* A thread the debugger holds stopped runs the work from its park. */
+		ant_debug_kick(participant->task);
 		queued++;
 	}
 	while (!READ_ONCE(session->released)) {
diff --git a/kernel/signal.c b/kernel/signal.c
index bf2209095..cc8aee82b 100644
--- a/kernel/signal.c
+++ b/kernel/signal.c
@@ -1045,7 +1045,8 @@ static void complete_signal(int sig, struct task_struct *p, enum pid_type type)
 		 * its immediate Linux semantics and may yield no process core.
 		 */
 		if (!sig_kernel_coredump(sig) &&
-		    (sig == SIGKILL || !ant_monitor_core_armed(p))) {
+		    (sig == SIGKILL ||
+		     (!ant_monitor_core_armed(p) && !ant_monitor_debugged(p)))) {
 			/*
 			 * Start a group exit and wake everybody up.
 			 * This way we don't have other threads
