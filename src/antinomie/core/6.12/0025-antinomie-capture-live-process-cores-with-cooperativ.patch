From 84b7d4cb605a2bee231461718320dbdbcad4d3ce Mon Sep 17 00:00:00 2001
From: MikiMiku <jonathanirvinjo@gmail.com>
Date: Mon, 12 Oct 2026 09:55:49 +0700
Subject: [PATCH] antinomie: capture live process cores with cooperative pause
 and resume

---
 fs/binfmt_elf.c                 | 163 ++++++--
 fs/coredump.c                   |  83 ++++
 include/linux/coredump.h        |  26 ++
 kernel/antinomie/Makefile       |   1 +
 kernel/antinomie/control.c      |   7 +-
 kernel/antinomie/control_wire.h |  34 +-
 kernel/antinomie/guest.c        |   6 +
 kernel/antinomie/manual_core.c  | 663 ++++++++++++++++++++++++++++++++
 kernel/antinomie/process_core.c | 197 +++++++++-
 kernel/antinomie/process_core.h |  21 +
 10 files changed, 1143 insertions(+), 58 deletions(-)
 create mode 100644 kernel/antinomie/manual_core.c

diff --git a/fs/binfmt_elf.c b/fs/binfmt_elf.c
index 47335a0f4..900562050 100644
--- a/fs/binfmt_elf.c
+++ b/fs/binfmt_elf.c
@@ -1568,8 +1568,26 @@ static void fill_prstatus(struct elf_prstatus_common *prstatus,
 	prstatus->pr_cstime = ns_to_kernel_old_timeval(p->signal->cstime);
 }
 
+static bool live_core(struct coredump_params *cprm)
+{
+#ifdef CONFIG_ANTINOMIE
+	return cprm->antinomie_live != NULL;
+#else
+	return false;
+#endif
+}
+
+static void *core_note_alloc(struct coredump_params *cprm, size_t size)
+{
+#ifdef CONFIG_ANTINOMIE
+	if (live_core(cprm))
+		return size ? ant_coredump_live_alloc(cprm, size) : NULL;
+#endif
+	return kzalloc(size, GFP_KERNEL);
+}
+
 static int fill_psinfo(struct elf_prpsinfo *psinfo, struct task_struct *p,
-		       struct mm_struct *mm)
+		       struct mm_struct *mm, struct coredump_params *cprm)
 {
 	const struct cred *cred;
 	unsigned int i, len;
@@ -1581,8 +1599,17 @@ static int fill_psinfo(struct elf_prpsinfo *psinfo, struct task_struct *p,
 	len = mm->arg_end - mm->arg_start;
 	if (len >= ELF_PRARGSZ)
 		len = ELF_PRARGSZ-1;
-	if (copy_from_user(&psinfo->pr_psargs,
-		           (const char __user *)mm->arg_start, len))
+#ifdef CONFIG_ANTINOMIE
+	if (live_core(cprm)) {
+		if (copy_from_user_nofault(psinfo->pr_psargs,
+					 (const void __user *)mm->arg_start, len)) {
+			memset(psinfo->pr_psargs, 0, sizeof(psinfo->pr_psargs));
+			cprm->antinomie_live->incomplete = true;
+		}
+	}
+#endif
+	if (!live_core(cprm) && copy_from_user(&psinfo->pr_psargs,
+					     (const char __user *)mm->arg_start, len))
 		return -EFAULT;
 	for(i = 0; i < len; i++)
 		if (psinfo->pr_psargs[i] == 0)
@@ -1648,9 +1675,17 @@ static int fill_files_note(struct memelfnote *note, struct coredump_params *cprm
 	user_long_t *start_end_ofs;
 	char *name_base, *name_curpos;
 	int i;
+	unsigned int vma_count = cprm->vma_count;
+	struct core_vma_metadata *vmas = cprm->vma_meta;
 
+#ifdef CONFIG_ANTINOMIE
+	if (live_core(cprm)) {
+		vma_count = cprm->antinomie_live->file_vma_count;
+		vmas = cprm->antinomie_live->file_vmas;
+	}
+#endif
 	/* *Estimated* file count and total data size needed */
-	count = cprm->vma_count;
+	count = vma_count;
 	if (count > UINT_MAX / 64)
 		return -EINVAL;
 	size = count * 64;
@@ -1668,7 +1703,8 @@ static int fill_files_note(struct memelfnote *note, struct coredump_params *cprm
 	 * "size" can be 0 here legitimately.
 	 * Let it ENOMEM and omit NT_FILE section which will be empty anyway.
 	 */
-	data = kvmalloc(size, GFP_KERNEL);
+	data = live_core(cprm) ? core_note_alloc(cprm, size) :
+		kvmalloc(size, GFP_KERNEL);
 	if (ZERO_OR_NULL_PTR(data))
 		return -ENOMEM;
 
@@ -1676,8 +1712,8 @@ static int fill_files_note(struct memelfnote *note, struct coredump_params *cprm
 	name_base = name_curpos = ((char *)data) + names_ofs;
 	remaining = size - names_ofs;
 	count = 0;
-	for (i = 0; i < cprm->vma_count; i++) {
-		struct core_vma_metadata *m = &cprm->vma_meta[i];
+	for (i = 0; i < vma_count; i++) {
+		struct core_vma_metadata *m = &vmas[i];
 		struct file *file;
 		const char *filename;
 
@@ -1687,7 +1723,8 @@ static int fill_files_note(struct memelfnote *note, struct coredump_params *cprm
 		filename = file_path(file, name_curpos, remaining);
 		if (IS_ERR(filename)) {
 			if (PTR_ERR(filename) == -ENAMETOOLONG) {
-				kvfree(data);
+				if (!live_core(cprm))
+					kvfree(data);
 				size = size * 5 / 4;
 				goto alloc;
 			}
@@ -1714,7 +1751,7 @@ static int fill_files_note(struct memelfnote *note, struct coredump_params *cprm
 	 * Count usually is less than mm->map_count,
 	 * we need to move filenames down.
 	 */
-	n = cprm->vma_count - count;
+	n = vma_count - count;
 	if (n != 0) {
 		unsigned shift_bytes = n * 3 * sizeof(data[0]);
 		memmove(name_base - shift_bytes, name_base,
@@ -1770,7 +1807,8 @@ static void do_thread_regset_writeback(struct task_struct *task,
 
 static int fill_thread_core_info(struct elf_thread_core_info *t,
 				 const struct user_regset_view *view,
-				 long signr, struct elf_note_info *info)
+				 long signr, struct elf_note_info *info,
+				 struct coredump_params *cprm)
 {
 	unsigned int note_iter, view_iter;
 
@@ -1781,8 +1819,22 @@ static int fill_thread_core_info(struct elf_thread_core_info *t,
 	 * We assume that regset 0 is NT_PRSTATUS.
 	 */
 	fill_prstatus(&t->prstatus.common, t->task, signr);
-	regset_get(t->task, &view->regsets[0],
-		   sizeof(t->prstatus.pr_reg), &t->prstatus.pr_reg);
+#ifdef CONFIG_ANTINOMIE
+	if (live_core(cprm)) {
+		int ret = regset_get(t->task, &view->regsets[0],
+				     sizeof(t->prstatus.pr_reg), &t->prstatus.pr_reg);
+
+		if (ret != sizeof(t->prstatus.pr_reg)) {
+			cprm->antinomie_live->incomplete = true;
+			return 0;
+		}
+	} else {
+#endif
+		regset_get(t->task, &view->regsets[0],
+			   sizeof(t->prstatus.pr_reg), &t->prstatus.pr_reg);
+#ifdef CONFIG_ANTINOMIE
+	}
+#endif
 
 	fill_note(&t->notes[0], "CORE", NT_PRSTATUS,
 		  PRSTATUS_SIZE, &t->prstatus);
@@ -1808,7 +1860,20 @@ static int fill_thread_core_info(struct elf_thread_core_info *t,
 		if (regset->active && regset->active(t->task, regset) <= 0)
 			continue;
 
-		ret = regset_get_alloc(t->task, regset, ~0U, &data);
+#ifdef CONFIG_ANTINOMIE
+		if (live_core(cprm)) {
+			size_t size = (size_t)regset->n * regset->size;
+
+			data = core_note_alloc(cprm, size);
+			ret = data ? regset_get(t->task, regset, size, data) : -ENOMEM;
+			if (ret < 0 || ret != size)
+				cprm->antinomie_live->incomplete = true;
+		} else {
+#endif
+			ret = regset_get_alloc(t->task, regset, ~0U, &data);
+#ifdef CONFIG_ANTINOMIE
+		}
+#endif
 		if (ret < 0)
 			continue;
 
@@ -1830,7 +1895,8 @@ static int fill_thread_core_info(struct elf_thread_core_info *t,
 #else
 static int fill_thread_core_info(struct elf_thread_core_info *t,
 				 const struct user_regset_view *view,
-				 long signr, struct elf_note_info *info)
+				 long signr, struct elf_note_info *info,
+				 struct coredump_params *cprm)
 {
 	struct task_struct *p = t->task;
 	elf_fpregset_t *fpu;
@@ -1866,7 +1932,7 @@ static int fill_note_info(struct elfhdr *elf, int phdrs,
 	struct elf_prpsinfo *psinfo;
 	struct core_thread *ct;
 
-	psinfo = kmalloc(sizeof(*psinfo), GFP_KERNEL);
+	psinfo = core_note_alloc(cprm, sizeof(*psinfo));
 	if (!psinfo)
 		return 0;
 	fill_note(&info->psinfo, "CORE", NT_PRPSINFO, sizeof(*psinfo), psinfo);
@@ -1906,36 +1972,54 @@ static int fill_note_info(struct elfhdr *elf, int phdrs,
 	/*
 	 * Allocate a structure for each thread.
 	 */
-	info->thread = kzalloc(offsetof(struct elf_thread_core_info,
-				     notes[info->thread_notes]),
-			    GFP_KERNEL);
+	info->thread = core_note_alloc(cprm, offsetof(struct elf_thread_core_info,
+						 notes[info->thread_notes]));
 	if (unlikely(!info->thread))
 		return 0;
 
 	info->thread->task = dump_task;
-	for (ct = dump_task->signal->core_state->dumper.next; ct; ct = ct->next) {
-		t = kzalloc(offsetof(struct elf_thread_core_info,
-				     notes[info->thread_notes]),
-			    GFP_KERNEL);
-		if (unlikely(!t))
-			return 0;
+#ifdef CONFIG_ANTINOMIE
+	if (live_core(cprm)) {
+		unsigned int i;
 
-		t->task = ct->task;
-		t->next = info->thread->next;
-		info->thread->next = t;
+		for (i = 0; i < cprm->antinomie_live->task_count; i++) {
+			struct task_struct *task = cprm->antinomie_live->tasks[i];
+
+			if (task == dump_task)
+				continue;
+			t = core_note_alloc(cprm, offsetof(struct elf_thread_core_info,
+							 notes[info->thread_notes]));
+			if (!t)
+				return 0;
+			t->task = task;
+			t->next = info->thread->next;
+			info->thread->next = t;
+		}
 	}
+#endif
+	if (!live_core(cprm))
+		for (ct = dump_task->signal->core_state->dumper.next; ct; ct = ct->next) {
+			t = core_note_alloc(cprm, offsetof(struct elf_thread_core_info,
+							 notes[info->thread_notes]));
+			if (unlikely(!t))
+				return 0;
+
+			t->task = ct->task;
+			t->next = info->thread->next;
+			info->thread->next = t;
+		}
 
 	/*
 	 * Now fill in each thread's information.
 	 */
 	for (t = info->thread; t != NULL; t = t->next)
-		if (!fill_thread_core_info(t, view, cprm->siginfo->si_signo, info))
+		if (!fill_thread_core_info(t, view, cprm->siginfo->si_signo, info, cprm))
 			return 0;
 
 	/*
 	 * Fill in the two process-wide notes.
 	 */
-	fill_psinfo(psinfo, dump_task->group_leader, dump_task->mm);
+	fill_psinfo(psinfo, dump_task->group_leader, dump_task->mm, cprm);
 	info->size += notesize(&info->psinfo);
 
 	fill_siginfo_note(&info->signote, &info->csigdata, cprm->siginfo);
@@ -1946,6 +2030,10 @@ static int fill_note_info(struct elfhdr *elf, int phdrs,
 
 	if (fill_files_note(&info->files, cprm) == 0)
 		info->size += notesize(&info->files);
+#ifdef CONFIG_ANTINOMIE
+	else if (live_core(cprm))
+		cprm->antinomie_live->incomplete = true;
+#endif
 
 	return 1;
 }
@@ -1988,9 +2076,12 @@ static int write_note_info(struct elf_note_info *info,
 	return 1;
 }
 
-static void free_note_info(struct elf_note_info *info)
+static void free_note_info(struct elf_note_info *info, struct coredump_params *cprm)
 {
 	struct elf_thread_core_info *threads = info->thread;
+
+	if (live_core(cprm))
+		return;
 	while (threads) {
 		unsigned int i;
 		struct elf_thread_core_info *t = threads;
@@ -2072,7 +2163,7 @@ static int elf_core_dump(struct coredump_params *cprm)
 		/* For cell spufs and x86 xstate */
 		sz += elf_coredump_extra_notes_size();
 
-		phdr4note = kmalloc(sizeof(*phdr4note), GFP_KERNEL);
+		phdr4note = core_note_alloc(cprm, sizeof(*phdr4note));
 		if (!phdr4note)
 			goto end_coredump;
 
@@ -2087,7 +2178,7 @@ static int elf_core_dump(struct coredump_params *cprm)
 	e_shoff = offset;
 
 	if (e_phnum == PN_XNUM) {
-		shdr4extnum = kmalloc(sizeof(*shdr4extnum), GFP_KERNEL);
+		shdr4extnum = core_note_alloc(cprm, sizeof(*shdr4extnum));
 		if (!shdr4extnum)
 			goto end_coredump;
 		fill_extnum_info(&elf, shdr4extnum, e_shoff, segs);
@@ -2156,9 +2247,11 @@ static int elf_core_dump(struct coredump_params *cprm)
 	}
 
 end_coredump:
-	free_note_info(&info);
-	kfree(shdr4extnum);
-	kfree(phdr4note);
+	free_note_info(&info, cprm);
+	if (!live_core(cprm)) {
+		kfree(shdr4extnum);
+		kfree(phdr4note);
+	}
 	return has_dumped;
 }
 
diff --git a/fs/coredump.c b/fs/coredump.c
index aecc24956..c9788b6fb 100644
--- a/fs/coredump.c
+++ b/fs/coredump.c
@@ -576,6 +576,57 @@ static int umh_coredump_setup(struct subprocess_info *info, struct cred *new)
 }
 
 #ifdef CONFIG_ANTINOMIE
+/* Nonfatal acquisition owns its own thread list, page refs and metadata.
+ * This path never calls coredump_wait/finish or installs signal->core_state.
+ */
+void *ant_coredump_live_alloc(struct coredump_params *cprm, size_t size)
+{
+	struct ant_coredump_live *live = cprm->antinomie_live;
+	size_t offset = ALIGN(live->arena_used, __alignof__(unsigned long));
+	void *data;
+
+	if (live->aborted(live->context) || offset > live->arena_size ||
+	    size > live->arena_size - offset) {
+		live->incomplete = true;
+		return NULL;
+	}
+	data = live->arena + offset;
+	live->arena_used = offset + size;
+	memset(data, 0, size);
+	return data;
+}
+
+int ant_coredump_live_to_file(struct file *file, unsigned long limit,
+			     struct core_vma_metadata *vmas, unsigned int vma_count,
+			     struct ant_coredump_live *live)
+{
+	kernel_siginfo_t info = { .si_code = SI_KERNEL };
+	struct coredump_params cprm = {
+		.siginfo = &info, .file = file, .limit = limit,
+		.mm_flags = READ_ONCE(current->mm->flags),
+		.cpu = raw_smp_processor_id(), .vma_meta = vmas,
+		.vma_count = vma_count, .antinomie_live = live,
+		.antinomie_deadline = live->deadline,
+	};
+	unsigned int i;
+	int error;
+
+	if (!current->mm->binfmt || !current->mm->binfmt->core_dump ||
+	    test_thread_flag(TIF_ADDR32))
+		return -EOPNOTSUPP;
+	for (i = 0; i < vma_count; i++)
+		cprm.vma_data_size += vmas[i].dump_size;
+	error = current->mm->binfmt->core_dump(&cprm) ? 0 : -EIO;
+	if (cprm.to_skip) {
+		cprm.to_skip--;
+		if (!dump_emit(&cprm, "", 1) && !error)
+			error = -EIO;
+	}
+	if (live->aborted(live->context) || dump_interrupted())
+		return -EINTR;
+	return error ?: (live->incomplete ? -ENODATA : 0);
+}
+
 /* Opt-in host acquisition shares the native ELF writer/rendezvous, but never
  * synthesizes a core bit in the parent-visible wait status. No guest path or
  * helper is used. The caller owns the bounded anonymous sink for this call.
@@ -1045,6 +1096,29 @@ int dump_user_range(struct coredump_params *cprm, unsigned long start,
 	unsigned long addr;
 	struct page *dump_page;
 
+#ifdef CONFIG_ANTINOMIE
+	if (cprm->antinomie_live) {
+		struct ant_coredump_live *live = cprm->antinomie_live;
+		unsigned long size;
+
+		if (live->page_cursor > live->page_count || len % PAGE_SIZE ||
+		    len / PAGE_SIZE > live->page_count - live->page_cursor)
+			return 0;
+		for (size = 0; size < len; size += PAGE_SIZE) {
+			void *data;
+			bool failed;
+
+			if (live->aborted(live->context))
+				return 0;
+			data = kmap_local_page(live->pages[live->page_cursor++]);
+			failed = copy_mc_to_kernel(live->scratch, data, PAGE_SIZE);
+			kunmap_local(data);
+			if (failed || !dump_emit(cprm, live->scratch, PAGE_SIZE))
+				return 0;
+		}
+		return 1;
+	}
+#endif
 	dump_page = dump_page_alloc();
 	if (!dump_page)
 		return 0;
@@ -1286,6 +1360,15 @@ static unsigned long vma_dump_size(struct vm_area_struct *vma,
 	return vma->vm_end - vma->vm_start;
 }
 
+#ifdef CONFIG_ANTINOMIE
+unsigned long ant_coredump_vma_size(struct vm_area_struct *vma, unsigned long flags)
+{
+	unsigned long size = vma_dump_size(vma, flags);
+
+	return size;
+}
+#endif
+
 /*
  * Helper function for iterating across a vma list.  It ensures that the caller
  * will visit `gate_vma' prior to terminating the search.
diff --git a/include/linux/coredump.h b/include/linux/coredump.h
index 568831d08..593d6371f 100644
--- a/include/linux/coredump.h
+++ b/include/linux/coredump.h
@@ -16,6 +16,26 @@ struct core_vma_metadata {
 	struct file   *file;
 };
 
+#ifdef CONFIG_ANTINOMIE
+/* Owned by the manual acquisition session; no signal->core_state is installed.
+ * Metadata and regsets share a preallocated bounded arena while tasks park.
+ */
+struct ant_coredump_live {
+	struct task_struct **tasks;
+	unsigned int task_count;
+	struct core_vma_metadata *file_vmas;
+	unsigned int file_vma_count;
+	struct page **pages;
+	unsigned int page_count, page_cursor;
+	void *arena, *scratch;
+	size_t arena_size, arena_used;
+	unsigned long deadline;
+	bool incomplete;
+	bool (*aborted)(void *context);
+	void *context;
+};
+#endif
+
 struct coredump_params {
 	const kernel_siginfo_t *siginfo;
 	struct file *file;
@@ -31,6 +51,7 @@ struct coredump_params {
 	struct pid *pid;
 #ifdef CONFIG_ANTINOMIE
 	unsigned long antinomie_deadline;
+	struct ant_coredump_live *antinomie_live;
 #endif
 };
 
@@ -48,6 +69,11 @@ int dump_user_range(struct coredump_params *cprm, unsigned long start,
 		    unsigned long len);
 extern void do_coredump(const kernel_siginfo_t *siginfo);
 #ifdef CONFIG_ANTINOMIE
+void *ant_coredump_live_alloc(struct coredump_params *cprm, size_t size);
+int ant_coredump_live_to_file(struct file *file, unsigned long limit,
+			     struct core_vma_metadata *vmas, unsigned int vma_count,
+			     struct ant_coredump_live *live);
+unsigned long ant_coredump_vma_size(struct vm_area_struct *vma, unsigned long flags);
 int ant_coredump_to_file(struct file *file, unsigned long limit, int wait_status,
 			 const kernel_siginfo_t *siginfo, unsigned long deadline);
 #endif
diff --git a/kernel/antinomie/Makefile b/kernel/antinomie/Makefile
index 1085feb98..717f52238 100644
--- a/kernel/antinomie/Makefile
+++ b/kernel/antinomie/Makefile
@@ -3,3 +3,4 @@ obj-y += async_capture.o
 obj-y += specimen.o
