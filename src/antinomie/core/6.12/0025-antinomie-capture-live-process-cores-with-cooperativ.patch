+			ant_core_reply(core, reply);
+			*reply_len = 24;
+		} else {
+			memcpy(status_args, args, 8);
+			put_unaligned_le64(ant_core_id(core), status_args + 8);
+			error = ant_core_command(ANTC_CORE_STATUS, status_args, sizeof(status_args),
+						 reply, capacity, reply_len);
+		}
+		ant_core_put(core);
+		return error;
+	}
+	if (!admission || error != -ESRCH)
+		return error;
+	mutex_lock(&manual_lock);
+	if (!manual_worker || active_manual) {
+		error = manual_worker ? -EBUSY : -EAGAIN;
+		goto unlock;
+	}
+	session = kzalloc(sizeof(*session), GFP_KERNEL | __GFP_NORETRY | __GFP_NOWARN);
+	if (!session) {
+		error = -ENOMEM;
+		goto unlock;
+	}
+	core = ant_core_live_create(&identity);
+	if (IS_ERR(core)) {
+		error = PTR_ERR(core);
+		kfree(session);
+		goto unlock;
+	}
+	session->core = core;
+	session->identity = identity;
+	session->live.deadline = ant_core_live_deadline(core);
+	session->live.aborted = live_aborted;
+	session->live.context = session;
+	refcount_set(&session->refs, 1);
+	spin_lock_init(&session->lock);
+	init_waitqueue_head(&session->wait);
+	INIT_WORK(&session->work, manual_work);
+	active_manual = session;
+	ant_core_reply(core, reply);
+	*reply_len = 24;
+	queue_work(manual_worker, &session->work);
+	error = 0;
+unlock:
+	mutex_unlock(&manual_lock);
+	return error;
+}
+
+static int __init ant_manual_init(void)
+{
+	manual_worker = alloc_workqueue("antinomie-core", WQ_UNBOUND, 1);
+	return manual_worker ? 0 : -ENOMEM;
+}
+late_initcall(ant_manual_init);
+#else
+int ant_manual_command(u32 opcode, const u8 *args, size_t args_len,
+		       void *reply, size_t capacity, size_t *reply_len)
+{
+	return -EOPNOTSUPP;
+}
+void ant_manual_wake(struct ant_core *core) {}
+bool ant_manual_fence(void) { return true; }
+#endif
