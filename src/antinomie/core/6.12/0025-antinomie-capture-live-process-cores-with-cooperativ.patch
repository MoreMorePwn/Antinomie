new file mode 100644
index 000000000..822e2e391
--- /dev/null
+++ b/kernel/antinomie/manual_core.c
@@ -0,0 +1,663 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Cooperative nonfatal process acquisition. No signal/core teardown ownership. */
+#include <linux/antinomie_monitor.h>
+#include <linux/binfmts.h>
+#include <linux/coredump.h>
+#include <linux/elf.h>
+#include <linux/file.h>
+#include <linux/freezer.h>
+#include <linux/highmem.h>
+#include <linux/jiffies.h>
+#include <linux/mm.h>
+#include <linux/mutex.h>
+#include <linux/refcount.h>
+#include <linux/sched/mm.h>
+#include <linux/sched/signal.h>
+#include <linux/sched/task.h>
+#include <linux/sched/coredump.h>
+#include <linux/slab.h>
+#include <linux/task_work.h>
+#include <linux/unaligned.h>
+#include <linux/vmalloc.h>
+#include <linux/wait.h>
+#include <linux/workqueue.h>
+#include "control_wire.h"
+#include "process_core.h"
+
+#ifdef CONFIG_COREDUMP
+#define LIVE_THREADS 256U
+#define LIVE_EXTENTS 4096U
+#define LIVE_PROBES 65536U
+#define LIVE_PAGES (64U * 1024 * 1024 / PAGE_SIZE)
+#define LIVE_AUX_SIZE (8U * 1024 * 1024)
+
+struct ant_manual;
+struct live_participant {
+	struct callback_head work;
+	struct ant_manual *session;
+	struct task_struct *task;
+	bool owner;
+};
+
+struct ant_manual {
+	struct work_struct work;
+	refcount_t refs;
+	spinlock_t lock;
+	wait_queue_head_t wait;
+	struct ant_core_identity identity;
+	struct ant_core *core;
+	struct mm_struct *mm;
+	struct file *file;
+	struct live_participant *participants;
+	struct core_vma_metadata *original, *extents;
+	struct ant_coredump_live live;
+	unsigned int task_count, original_count, extent_count, parked;
+	bool abort, released, owner_active, done;
+	int error;
+};
+
+/* One admitted session includes callbacks which have been detached but have
+ * not run yet. Their references pin the bounded arena, task refs and core.
+ * Lock order is manual_lock -> core_lock; callbacks never take manual_lock.
+ */
+static DEFINE_MUTEX(manual_lock);
+static struct ant_manual *active_manual;
+static struct workqueue_struct *manual_worker;
+
+static void manual_put(struct ant_manual *session)
+{
+	unsigned int i;
+
+	if (!refcount_dec_and_test(&session->refs))
+		return;
+	/* Keep admission closed until the old arena is actually freed. Clearing
+	 * the slot before vfree could briefly double the auxiliary budget.
+	 * done is already published, so fence readers do not touch the core.
+	 */
+	for (i = 0; i < session->task_count; i++)
+		put_task_struct(session->participants[i].task);
+	for (i = 0; i < session->original_count; i++)
+		if (session->original[i].file)
+			fput(session->original[i].file);
+	if (session->mm)
+		mmput(session->mm);
+	if (session->file)
+		fput(session->file);
+	vfree(session->live.arena);
+	ant_core_put(session->core);
+	mutex_lock(&manual_lock);
+	WARN_ON_ONCE(active_manual != session);
+	active_manual = NULL;
+	kfree(session);
+	mutex_unlock(&manual_lock);
+}
+
+static void manual_error(struct ant_manual *session, int error)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&session->lock, flags);
+	if (!session->error)
+		session->error = error;
+	session->abort = true;
+	/* An active writer still owns the frozen registers and pages. It must
+	 * stop touching them before peers leave their park.
+	 */
+	if (!session->owner_active)
+		session->released = true;
+	spin_unlock_irqrestore(&session->lock, flags);
+	wake_up_all(&session->wait);
+}
+
+static int abort_reason(struct ant_manual *session)
+{
+	unsigned int i;
+
+	if (ant_core_live_canceled(session->core))
+		return -ECANCELED;
+	if (time_after_eq(jiffies, session->live.deadline))
+		return -ETIMEDOUT;
+	if (READ_ONCE(session->abort))
+		return READ_ONCE(session->error) ?: -EINTR;
+	for (i = 0; i < session->task_count; i++)
+		if (signal_pending(session->participants[i].task))
+			return -EINTR;
+	return 0;
+}
+
+static bool live_aborted(void *context)
+{
+	return abort_reason(context) != 0;
+}
+
+static void *manual_alloc(struct ant_manual *session, size_t size)
+{
+	struct coredump_params cprm = { .antinomie_live = &session->live };
+
+	return ant_coredump_live_alloc(&cprm, size);
+}
+
+static bool eligible(struct task_struct *task)
+{
+	return !(READ_ONCE(task->flags) & (PF_KTHREAD | PF_USER_WORKER | PF_EXITING)) &&
+		!READ_ONCE(task->ptrace) && !task_is_stopped_or_traced(task) &&
+		!(READ_ONCE(task->jobctl) & JOBCTL_STOP_PENDING) && !freezing(task) &&
+		!(READ_ONCE(task->__state) & TASK_UNINTERRUPTIBLE);
+}
+
+static int resolve_group(struct ant_manual *session)
+{
+	struct task_struct *leader, *task;
+	int error = -ESRCH;
+
+	read_lock(&tasklist_lock);
+	for_each_process(leader) {
+		if (task_tgid_nr(leader) != session->identity.tgid)
+			continue;
+		if (READ_ONCE(leader->ant_cookie) != session->identity.cookie ||
+		    leader->start_boottime != session->identity.start_ns)
+			break;
+		error = -EOPNOTSUPP;
+		if (!eligible(leader) || !READ_ONCE(leader->mm) ||
+		    get_nr_threads(leader) > LIVE_THREADS)
+			break;
+		get_task_struct(leader);
+		session->participants[0].task = leader;
+		session->participants[0].owner = true;
+		session->task_count = 1;
+		for_each_thread(leader, task) {
+			if (task == leader)
+				continue;
+			if (session->task_count == LIVE_THREADS || !eligible(task))
+				goto unlock;
+			get_task_struct(task);
+			session->participants[session->task_count++].task = task;
+		}
+		error = 0;
+		break;
+	}
+unlock:
+	read_unlock(&tasklist_lock);
+	if (error)
+		return error;
+	session->mm = get_task_mm(session->participants[0].task);
+	return session->mm ? 0 : -ESRCH;
+}
+
+/* This predicate runs under scheduler locks. Never wait_task_inactive(): that
+ * API may spin forever and has no acquisition deadline.
+ */
+static int parked_inactive(struct task_struct *task, void *unused)
+{
+	return !task_curr(task) && !READ_ONCE(task->on_rq) &&
+		(READ_ONCE(task->__state) & TASK_UNINTERRUPTIBLE);
+}
+
+static int frozen_identity(struct ant_manual *session)
+{
+	struct task_struct *task, *process;
+	unsigned int i, count = 0;
+	int error = 0;
+
+	if (current->mm != session->mm || current->ant_cookie != session->identity.cookie ||
+	    current->start_boottime != session->identity.start_ns ||
+	    task_tgid_nr(current) != session->identity.tgid ||
+	    !current->mm->binfmt || !current->mm->binfmt->core_dump ||
+	    test_thread_flag(TIF_ADDR32) ||
+	    test_bit(MMF_MULTIPROCESS, &current->mm->flags) ||
+	    READ_ONCE(current->signal->core_state) ||
+	    READ_ONCE(current->signal->flags) & SIGNAL_GROUP_EXIT ||
+	    READ_ONCE(current->signal->group_exec_task))
+		return -EOPNOTSUPP;
+	read_lock(&tasklist_lock);
+	for_each_process_thread(process, task) {
+		if (READ_ONCE(task->mm) == session->mm && !same_thread_group(task, current)) {
+			error = -EOPNOTSUPP;
+			break;
+		}
+		if (!same_thread_group(task, current))
+			continue;
+		count++;
+		for (i = 0; i < session->task_count; i++)
+			if (session->participants[i].task == task)
+				break;
+		if (i == session->task_count || READ_ONCE(task->flags) & PF_EXITING) {
+			error = -EAGAIN;
+			break;
+		}
+	}
+	read_unlock(&tasklist_lock);
+	return error ?: (count == session->task_count ? 0 : -EAGAIN);
+}
+
+static int snapshot_vmas(struct ant_manual *session)
+{
+	struct mm_struct *mm = session->mm;
+	struct vm_area_struct *vma, *gate;
+	unsigned long flags = READ_ONCE(mm->flags);
+	int error = 0;
+
+	VMA_ITERATOR(iterator, mm, 0);
+
+	if (!down_write_trylock(&mm->mmap_lock))
+		return -EAGAIN;
+	gate = get_gate_vma(mm);
+	if (mm->map_count + !!gate > LIVE_EXTENTS) {
+		error = -E2BIG;
+		goto unlock;
+	}
+	vma = vma_next(&iterator);
+	while (vma) {
+		struct core_vma_metadata *meta = &session->original[session->original_count++];
+
+		meta->start = vma->vm_start;
+		meta->end = vma->vm_end;
+		meta->flags = vma->vm_flags;
+		meta->dump_size = ant_coredump_vma_size(vma, flags);
+		meta->pgoff = vma->vm_pgoff;
+		meta->file = vma->vm_file;
+		if (meta->file)
+			get_file(meta->file);
+		if (vma == gate)
+			break;
+		vma = vma_next(&iterator);
+		if (!vma)
+			vma = gate;
+	}
+unlock:
+	up_write(&mm->mmap_lock);
+	return error;
+}
+
+static int append_extent(struct ant_manual *session, struct core_vma_metadata *source,
+			 unsigned long start, unsigned long end, bool resident)
+{
+	struct core_vma_metadata *meta;
+	unsigned long offset = source->pgoff + ((start - source->start) >> PAGE_SHIFT);
+
+	if (start == end)
+		return 0;
+	if (session->extent_count) {
+		meta = &session->extents[session->extent_count - 1];
+		if (meta->end == start && meta->file == source->file &&
+		    meta->flags == source->flags &&
+		    meta->pgoff + ((start - meta->start) >> PAGE_SHIFT) == offset &&
+		    (!!meta->dump_size == resident)) {
+			meta->end = end;
+			if (resident)
+				meta->dump_size += end - start;
+			return 0;
+		}
+	}
+	if (session->extent_count == LIVE_EXTENTS)
+		return -E2BIG;
+	meta = &session->extents[session->extent_count++];
+	*meta = *source;
+	meta->start = start;
+	meta->end = end;
+	meta->pgoff = offset;
+	meta->dump_size = resident ? end - start : 0;
+	return 0;
+}
+
+static int pin_resident_ranges(struct ant_manual *session)
+{
+	unsigned int i, probes = 0;
+	int error;
+
+	for (i = 0; i < session->original_count; i++) {
+		struct core_vma_metadata *meta = &session->original[i];
+		unsigned long addr = meta->start, selected;
+
+		/* Linux's deferred ELF-header filter must not fault in a page. */
+		if (meta->dump_size == 1) {
+			char magic[SELFMAG];
+
+			if (copy_from_user_nofault(magic, (const void __user *)addr, SELFMAG)) {
+				meta->dump_size = 0;
+				session->live.incomplete = true;
+			} else {
+				meta->dump_size = memcmp(magic, ELFMAG, SELFMAG) ? 0 : PAGE_SIZE;
+			}
+		}
+		selected = addr + meta->dump_size;
+		while (addr < selected) {
+			struct page *page = NULL;
+			bool resident;
+
+			error = abort_reason(session);
+			if (error)
+				return error;
+			/* Reserve one unavailable tail for this and each remaining VMA.
+			 * The native writer will not confuse omitted pages with zero data.
+			 */
+			if (probes == LIVE_PROBES ||
+			    session->live.page_count == session->identity.max_size / PAGE_SIZE ||
+			    session->extent_count +
+			    session->original_count - i + 1 >= LIVE_EXTENTS) {
+				session->live.incomplete = true;
+				error = append_extent(session, meta, addr, selected, false);
+				if (error)
+					return error;
+				addr = selected;
+				break;
+			}
+			probes++;
+			resident = get_user_pages_fast_only(addr, 1, FOLL_FORCE, &page) == 1;
+			error = append_extent(session, meta, addr, addr + PAGE_SIZE, resident);
+			if (error) {
+				if (resident)
+					put_page(page);
+				return error;
+			}
+			if (resident)
+				session->live.pages[session->live.page_count++] = page;
+			else
+				session->live.incomplete = true;
+			addr += PAGE_SIZE;
+		}
+		error = append_extent(session, meta, addr, meta->end, false);
+		if (error)
+			return error;
+	}
+	return 0;
+}
+
+static int capture_frozen(struct ant_manual *session)
+{
+	unsigned int i;
+	int error;
+
+	if (!mutex_trylock(&current->signal->cred_guard_mutex))
+		return -EAGAIN;
+	if (!down_read_trylock(&current->signal->exec_update_lock)) {
+		mutex_unlock(&current->signal->cred_guard_mutex);
+		return -EAGAIN;
+	}
+	if (current->mm != session->mm || !eligible(current)) {
+		error = -EAGAIN;
+		goto unlock;
+	}
+	for (;;) {
+		error = abort_reason(session);
+		if (error)
+			goto unlock;
+		if (READ_ONCE(session->parked) + 1 == session->task_count) {
+			for (i = 1; i < session->task_count; i++)
+				if (!task_call_func(session->participants[i].task,
+						    parked_inactive, NULL))
+					break;
+			if (i == session->task_count)
+				break;
+		}
+		wait_event_timeout(session->wait, READ_ONCE(session->abort), 1);
+	}
+	error = frozen_identity(session);
+	if (!error)
+		error = snapshot_vmas(session);
+	if (!error)
+		error = pin_resident_ranges(session);
+	session->live.file_vmas = session->original;
+	session->live.file_vma_count = session->original_count;
+	if (!error)
+		error = ant_coredump_live_to_file(session->file, session->identity.max_size,
+						 session->extents, session->extent_count,
+						 &session->live);
+unlock:
+	up_read(&current->signal->exec_update_lock);
+	mutex_unlock(&current->signal->cred_guard_mutex);
+	return error;
+}
+
+static void participant_work(struct callback_head *work)
+{
+	struct live_participant *participant = container_of(work, struct live_participant, work);
+	struct ant_manual *session = participant->session;
+	unsigned long flags;
+	int error;
+
+	error = abort_reason(session);
+	if (!error && (!eligible(current) || current->mm != session->mm))
+		error = -EAGAIN;
+	if (error)
+		manual_error(session, error);
+	spin_lock_irqsave(&session->lock, flags);
+	if (session->abort || session->released) {
+		spin_unlock_irqrestore(&session->lock, flags);
+		goto put;
+	}
+	if (participant->owner)
+		session->owner_active = true;
+	else
+		session->parked++;
+	spin_unlock_irqrestore(&session->lock, flags);
+	wake_up_all(&session->wait);
+	if (participant->owner) {
+		ant_core_live_begin(session->core);
+		error = capture_frozen(session);
+		spin_lock_irqsave(&session->lock, flags);
+		if (!session->error)
+			session->error = error;
+		session->owner_active = false;
+		session->released = true;
+		spin_unlock_irqrestore(&session->lock, flags);
+		wake_up_all(&session->wait);
+	} else {
+		/* Signals are observed by the owner/watchdog. A peer cannot leave
+		 * before the writer stops reading its frozen register state.
+		 */
+		wait_event(session->wait, READ_ONCE(session->released));
+		spin_lock_irqsave(&session->lock, flags);
+		session->parked--;
+		spin_unlock_irqrestore(&session->lock, flags);
+		wake_up_all(&session->wait);
+	}
+put:
+	manual_put(session);
+}
+
+static void manual_work(struct work_struct *work)
+{
+	struct ant_manual *session = container_of(work, struct ant_manual, work);
+	unsigned int i, queued = 0;
+	int error;
+
+	/* The single admission owns exactly the bounded 8MiB auxiliary budget,
+	 * including the session itself. Output has its separate 128MiB pool.
+	 */
+	session->live.arena_size = LIVE_AUX_SIZE - sizeof(*session);
+	session->live.arena = __vmalloc(session->live.arena_size,
+		GFP_KERNEL | __GFP_ZERO | __GFP_NORETRY | __GFP_NOWARN);
+	if (!session->live.arena) {
+		error = -ENOMEM;
+		goto finish;
+	}
+	session->participants = manual_alloc(session,
+		LIVE_THREADS * sizeof(*session->participants));
+	session->live.tasks = manual_alloc(session, LIVE_THREADS * sizeof(*session->live.tasks));
+	session->original = manual_alloc(session, LIVE_EXTENTS * sizeof(*session->original));
+	session->extents = manual_alloc(session, LIVE_EXTENTS * sizeof(*session->extents));
+	session->live.pages = manual_alloc(session, LIVE_PAGES * sizeof(*session->live.pages));
+	session->live.scratch = manual_alloc(session, PAGE_SIZE);
+	if (!session->participants || !session->live.tasks || !session->original ||
+	    !session->extents || !session->live.pages || !session->live.scratch) {
+		error = abort_reason(session) ?: -ENOMEM;
+		goto finish;
+	}
+	error = resolve_group(session);
+	if (error)
+		goto finish;
+	error = ant_core_live_prepare(session->core, &session->file);
+	if (error)
+		goto finish;
+	session->live.task_count = session->task_count;
+	for (i = 0; i < session->task_count; i++) {
+		session->live.tasks[i] = session->participants[i].task;
+		session->participants[i].session = session;
+		init_task_work(&session->participants[i].work, participant_work);
+	}
+	/* Queue the owner last; late callbacks never park after release. */
+	for (i = 1; i <= session->task_count; i++) {
+		struct live_participant *participant =
+			&session->participants[i % session->task_count];
+
+		refcount_inc(&session->refs);
+		error = task_work_add(participant->task, &participant->work,
+				      TWA_SIGNAL | TWAF_NO_ALLOC);
+		if (error) {
+			manual_put(session);
+			manual_error(session, error);
+			break;
+		}
+		queued++;
+	}
+	while (!READ_ONCE(session->released)) {
+		error = abort_reason(session);
+		if (error)
+			manual_error(session, error);
+		wait_event_timeout(session->wait, READ_ONCE(session->released), 1);
+	}
+	for (i = 1; i <= queued; i++) {
+		struct live_participant *participant =
+			&session->participants[i % session->task_count];
+
+		if (task_work_cancel(participant->task, &participant->work))
+			manual_put(session);
+	}
+	/* A detached callback pins its own session. The release gate prevents
+	 * it from becoming a new writer/park even if it starts after publication.
+	 */
+	wait_event(session->wait, !READ_ONCE(session->parked) && !READ_ONCE(session->owner_active));
+	error = READ_ONCE(session->error);
+finish:
+	if (error)
+		manual_error(session, error);
