+					  args[0], NULL, nr == 218 ? sizeof(u32) :
+					  sizeof(struct robust_list_head),
+					  nr == 218 ? sizeof(u32) : args[1],
+					  nr == 273 && args[1] != sizeof(struct robust_list_head) ?
+					  ANT_INVALID_EXTENT : ANT_ASYNC_UNOBSERVED);
+		return ANT_CAPTURE_OWNED | BIT(0);
+	case 242: case 243: case 244:
+		capture_mqueue(ctx, nr, args, output, result);
+		return ANT_CAPTURE_OWNED | BIT(1) | (nr == 244 ? 0 : BIT(4)) |
+			(nr == 243 ? BIT(3) : 0);
+	case 299: case 307:
+		capture_mmsg(ctx, args, output, result, nr == 307);
+		return ANT_CAPTURE_OWNED | BIT(1) | (nr == 299 ? BIT(4) : 0);
+	case 310: case 311:
+		capture_process_vm(ctx, args, output, result, nr == 311);
+		return ANT_CAPTURE_OWNED | BIT(1) | BIT(3);
+	case 31: case 66: case 71:
+		capture_ipc_control(ctx, nr, args, output, result);
+		return ANT_CAPTURE_OWNED | (nr == 66 ? BIT(3) : BIT(2));
+	case 30: case 65: case 67: case 69: case 70: case 220:
+		capture_ipc_data(ctx, nr, args, output, result);
+		mask = nr == 67 ? BIT(0) : BIT(1);
+		return ANT_CAPTURE_OWNED | mask | (nr == 220 ? BIT(3) : 0);
+	case 13: case 14: case 127: case 128: case 129: case 130: case 131:
+	case 282: case 289: case 297: case 424:
+		capture_signals(ctx, nr, args, output, result);
+		mask = nr == 13 || nr == 14 ? BIT(1) | BIT(2) : nr == 128 ? 7 :
+			nr == 131 ? 3 : nr == 129 || nr == 424 ? BIT(2) :
+			nr == 297 ? BIT(3) : nr == 282 || nr == 289 ? BIT(1) : BIT(0);
+		return ANT_CAPTURE_OWNED | mask;
+	case 23: case 270:
+		capture_select(ctx, nr, args, output, result);
+		return ANT_CAPTURE_OWNED | BIT(1) | BIT(2) | BIT(3) | BIT(4) |
+			(nr == 270 ? BIT(5) : 0);
+	case 314: case 315:
+		capture_schedattr(ctx, nr, args, output, result);
+		return ANT_CAPTURE_OWNED | BIT(1);
+	case 435:
+		capture_clone3(ctx, args, output, result);
+		return ANT_CAPTURE_OWNED | BIT(0);
+	case 437:
+		if (!output) {
+			ant_capture_string(ctx, 1, "arg1.path", args[1], PATH_MAX);
+			if (!ant_capture_lost(ctx))
+				capture_versioned(ctx, 2, args[2], args[3], sizeof(struct open_how),
+						  sizeof(struct open_how), "arg2.open_how",
+						  LAYOUT("open_how"));
+		}
+		return ANT_CAPTURE_OWNED | BIT(1) | BIT(2);
+	case 309:
+		if (output && result == 0) {
+			capture_optional(ctx, 0, args[0], "arg0.cpu", LAYOUT("u32"), sizeof(u32));
+			capture_optional(ctx, 1, args[1], "arg1.node", LAYOUT("u32"), sizeof(u32));
+		}
+		if (!output && args[2] && !ant_capture_lost(ctx))
+			ant_capture_field(ctx, 2, "arg2.ignored_cache", "", 1,
+					  args[2], NULL, 0, 0, ANT_NOT_WRITTEN);
+		return ANT_CAPTURE_OWNED | BIT(0) | BIT(1) | BIT(2);
+	case 7: case 271:
+		capture_poll(ctx, nr, args, output, result);
+		return ANT_CAPTURE_OWNED | BIT(0) | (nr == 271 ? BIT(2) | BIT(3) : 0);
+	case 232: case 233: case 281: case 441:
+		capture_epoll(ctx, nr, args, output, result);
+		mask = nr == 233 ? BIT(3) : BIT(1);
+		if (nr == 281 || nr == 441)
+			mask |= BIT(4);
+		if (nr == 441)
+			mask |= BIT(3);
+		return ANT_CAPTURE_OWNED | mask;
+	case 295: case 296: case 327: case 328:
+		capture_vector(ctx, args, output, result, nr == 296 || nr == 328);
+		return ANT_CAPTURE_OWNED | BIT(1);
+	case 46: case 47:
+		capture_message(ctx, args, output, result, nr == 46);
+		return ANT_CAPTURE_OWNED | BIT(1);
+	case 51: case 52: case 288:
+		capture_address(ctx, args, output, result);
+		return ANT_CAPTURE_OWNED | BIT(1) | BIT(2);
+	case 53:
+		if (output && result == 0 && !ant_capture_lost(ctx))
+			ant_capture_field(ctx, 3, "arg3.socketpair", LAYOUT("int[2]"), 3,
+					  args[3], NULL, 2 * sizeof(int), 2 * sizeof(int),
+					  ANT_COMPLETE);
+		return ANT_CAPTURE_OWNED | BIT(3);
+	case 188 ... 199:
+		capture_xattr(ctx, nr, args, output, result);
+		mask = nr == 190 || nr == 193 || nr == 196 || nr == 199 ? 0 : BIT(0);
+		mask |= nr < 194 ? BIT(1) | BIT(2) : BIT(1);
+		return ANT_CAPTURE_OWNED | mask;
+	default:
+		break;
+	}
+	for (index = 0; index < ARRAY_SIZE(field_rules); index++) {
+		const struct ant_field_rule *rule = &field_rules[index];
+
+		if (rule->nr != nr)
+			continue;
+		mask |= BIT(rule->arg_index);
+		if (!ant_capture_lost(ctx))
+			capture_rule(ctx, rule, args, output, result);
+	}
+	return mask ? ANT_CAPTURE_OWNED | mask : 0;
+}
