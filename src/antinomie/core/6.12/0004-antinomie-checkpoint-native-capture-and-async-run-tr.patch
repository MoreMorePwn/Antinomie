+	ANT_NOT_WRITTEN,
+};
+
+/* A native family returns this bit when it owns the whole syscall capture,
+ * plus bits 0..5 for recognized pointer arguments across both phases.
+ */
+#define ANT_CAPTURE_OWNED BIT(7)
+
+void ant_capture_field(struct ant_task *ctx, u8 arg_index, const char *key,
+		       const char *layout, u16 encoding, u64 address,
+		       const void *snapshot, u64 object_size, u64 declared_size,
+		       enum ant_status status);
