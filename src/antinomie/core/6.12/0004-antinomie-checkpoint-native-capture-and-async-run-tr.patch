+static void capture_handle(struct ant_task *ctx, u64 nr, const u64 args[6],
+			   bool output, long result)
+{
+	struct file_handle header;
+	u32 *capacity;
+	u8 arg = nr == 303 ? 2 : 1;
+	enum ant_status status;
+	u64 size;
+
+	if (!output && nr == 303) {
+		ant_capture_string(ctx, 1, "arg1.path", args[1], PATH_MAX);
+		if (ant_capture_lost(ctx))
+			return;
+	}
+	if (output && (nr != 303 || (result != 0 && result != -EOVERFLOW)))
+		return;
+	status = copy_from_user_nofault(&header, (void __user *)(unsigned long)args[arg],
+					sizeof(header)) ?
+		ANT_COPY_FAULT : ANT_COMPLETE;
+	ant_capture_field(ctx, arg, "handle.header", LAYOUT("file_handle"), 3,
+			  args[arg], &header, sizeof(header), sizeof(header), status);
+	if (status != ANT_COMPLETE || ant_capture_lost(ctx))
+		return;
+	if (!output && nr == 303) {
+		capacity = kmalloc(sizeof(*capacity), GFP_NOWAIT);
+		if (!capacity) {
+			ant_capture_field(ctx, arg, "handle.context", "", 1, args[arg], NULL,
+					  sizeof(header), sizeof(header), ANT_RESOURCE_EXHAUSTED);
+		} else {
+			*capacity = header.handle_bytes;
+			ant_capture_set_state(ctx, capacity, release_allocation);
+		}
+		return;
+	}
+	if (output) {
+		capture_optional(ctx, 3, args[3], "arg3.mount_id",
+				 args[4] & AT_HANDLE_MNT_ID_UNIQUE ? LAYOUT("u64") : LAYOUT("int"),
+				 args[4] & AT_HANDLE_MNT_ID_UNIQUE ? sizeof(u64) : sizeof(int));
+		if (result == -EOVERFLOW)
+			return;
+		capacity = ant_capture_state(ctx);
+		status = !capacity ? ANT_CONTEXT_MISSING : header.handle_bytes > *capacity ||
+			*capacity > MAX_HANDLE_SZ ? ANT_INVALID_EXTENT : ANT_COMPLETE;
+	} else {
+		status = !header.handle_bytes || header.handle_bytes > MAX_HANDLE_SZ ?
+			ANT_INVALID_EXTENT : ANT_COMPLETE;
+	}
+	size = header.handle_bytes;
+	if (args[arg] > U64_MAX - sizeof(header))
+		status = ANT_INVALID_EXTENT;
+	if (!ant_capture_lost(ctx))
+		ant_capture_field(ctx, arg, "handle.bytes", "", 1,
+				  args[arg] + sizeof(header), NULL, size, size, status);
+}
