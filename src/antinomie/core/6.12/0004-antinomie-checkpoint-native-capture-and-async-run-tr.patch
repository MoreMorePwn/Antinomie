+static void capture_ipc_control(struct ant_task *ctx, u64 nr, const u64 args[6],
+				bool output, long result)
+{
+	u32 command = args[nr == 66 ? 2 : 1];
+	u8 arg = nr == 66 ? 3 : 2;
+	u64 size = U64_MAX;
+	const char *layout = "";
+	bool input = command == IPC_SET, ignored = false;
+	enum ant_status status = ANT_COMPLETE;
+
+	if (nr == 31) {
+		switch (command) {
+		case IPC_SET: case IPC_STAT: case SHM_STAT: case SHM_STAT_ANY:
+			size = sizeof(struct shmid64_ds);
+			layout = LAYOUT("shmid64_ds");
+			break;
+		case IPC_INFO:
+			size = sizeof(struct shminfo64);
+			layout = LAYOUT("shminfo64");
+			break;
+		case SHM_INFO:
+			size = sizeof(struct shm_info);
+			layout = LAYOUT("shm_info");
+			break;
+		case IPC_RMID: case SHM_LOCK: case SHM_UNLOCK:
+			ignored = true;
+			break;
+		}
+	} else if (nr == 71) {
+		switch (command) {
+		case IPC_SET: case IPC_STAT: case MSG_STAT: case MSG_STAT_ANY:
+			size = sizeof(struct msqid64_ds);
+			layout = LAYOUT("msqid64_ds");
+			break;
+		case IPC_INFO: case MSG_INFO:
+			size = sizeof(struct msginfo);
+			layout = LAYOUT("msginfo");
+			break;
+		case IPC_RMID:
+			ignored = true;
+			break;
+		}
+	} else {
+		switch (command) {
+		case IPC_SET: case IPC_STAT: case SEM_STAT: case SEM_STAT_ANY:
+			size = sizeof(struct semid64_ds);
+			layout = LAYOUT("semid64_ds");
+			break;
+		case IPC_INFO: case SEM_INFO:
+			size = sizeof(struct seminfo);
+			layout = LAYOUT("seminfo");
+			break;
+		case GETALL: case SETALL:
+			input = command == SETALL;
+			status = ANT_UNKNOWN_EXTENT;
+			layout = LAYOUT("unsigned_short[]");
+			break;
+		case IPC_RMID: case GETVAL: case GETPID: case GETNCNT: case GETZCNT: case SETVAL:
+			ignored = true;
+			break;
+		}
+	}
+	if (ignored || ant_capture_lost(ctx))
+		return;
+	if (size == U64_MAX && status == ANT_COMPLETE) {
+		if (!output)
+			ant_capture_field(ctx, arg, "ipc.unknown_selector", "", 1,
+					  args[arg], NULL, U64_MAX, U64_MAX, ANT_NO_DECODER);
+		return;
+	}
+	if ((input && !output) || (!input && output && result >= 0))
+		ant_capture_field(ctx, arg, "ipc.control", layout, 3,
+				  args[arg], NULL, size, size, status);
+}
