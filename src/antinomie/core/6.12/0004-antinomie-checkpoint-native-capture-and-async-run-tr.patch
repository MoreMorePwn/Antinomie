+
+/* Boot-lifetime objects never move or disappear. Task and async ownership can
+ * safely retain their address; this lock serializes every status transition.
+ */
+static struct ant_run runs[ANT_RUN_COUNT];
+static unsigned int run_count;
+static DEFINE_SPINLOCK(run_lock);
+
+static struct ant_run *find_run(u64 cookie)
+{
+	unsigned int i;
+
+	for (i = 0; i < run_count; i++)
+		if (runs[i].root_cookie == cookie)
+			return &runs[i];
+	return NULL;
+}
+
+int ant_run_launch(struct task_struct *task, u64 cookie)
+{
+	struct ant_run *run;
+	unsigned long irqflags;
+
+	spin_lock_irqsave(&run_lock, irqflags);
+	if (run_count == ANT_RUN_COUNT) {
+		spin_unlock_irqrestore(&run_lock, irqflags);
+		return -ENOSPC;
+	}
+	run = &runs[run_count++];
+	run->root_cookie = cookie;
+	run->generation = 1;
+	run->live_count = 1;
+	run->task_count = 1;
+	task->ant_run = run;
+	task->ant_root_process = true;
+	spin_unlock_irqrestore(&run_lock, irqflags);
+	return 0;
+}
+
+void ant_run_fork(struct task_struct *parent, struct task_struct *child)
+{
+	struct ant_run *run = parent->ant_run;
+	unsigned long irqflags;
+
+	if (!run)
+		return;
+	spin_lock_irqsave(&run_lock, irqflags);
+	child->ant_run = run;
+	child->ant_root_process = parent->ant_root_process &&
+		same_thread_group(parent, child);
+	run->live_count++;
+	run->task_count++;
+	run->generation++;
+	spin_unlock_irqrestore(&run_lock, irqflags);
+}
+
+bool ant_run_exit(struct task_struct *task, bool group_dead)
+{
+	struct ant_run *run = task->ant_run;
+	unsigned long irqflags;
+
+	if (!run)
+		return false;
+	spin_lock_irqsave(&run_lock, irqflags);
+	/* Detachment also makes a repeated exit observation harmless. */
+	task->ant_run = NULL;
+	/* Root status follows the launched process, including nonleader exec.
+	 * Match wait_task_zombie(): an internal de_thread leader death and a
+	 * leader-only pthread_exit are not root-process completion.
+	 */
+	if (task->ant_root_process && group_dead) {
+		run->root_status = task->signal->flags & SIGNAL_GROUP_EXIT ?
+			task->signal->group_exit_code : task->group_leader->exit_code;
+		run->flags |= ANTC_RUN_ROOT_EXITED;
+	}
+	if (!--run->live_count)
+		run->flags |= ANTC_RUN_TREE_EXITED;
+	run->generation++;
+	spin_unlock_irqrestore(&run_lock, irqflags);
+	return true;
+}
+
+int ant_monitor_run_status(u64 root_cookie, void *out)
+{
+	struct ant_run *run;
+	unsigned long irqflags;
+	u8 *p = out;
+	u32 flags;
+
+	spin_lock_irqsave(&run_lock, irqflags);
+	run = find_run(root_cookie);
+	if (!run) {
+		spin_unlock_irqrestore(&run_lock, irqflags);
+		return -ESRCH;
+	}
+	flags = run->flags;
+	if (!run->async_count && !(flags & ANTC_RUN_OBSERVATION_INCOMPLETE))
+		flags |= ANTC_RUN_ASYNC_COMPLETE;
+	put_unaligned_le64(run->root_cookie, p);
+	put_unaligned_le64(run->generation, p + 8);
+	put_unaligned_le64(run->live_count, p + 16);
+	put_unaligned_le64(run->async_count, p + 24);
+	put_unaligned_le32(flags, p + 32);
+	put_unaligned_le32(run->root_status, p + 36);
+	put_unaligned_le64(run->async_losses, p + 40);
+	put_unaligned_le64(run->task_count, p + 48);
+	put_unaligned_le64(0, p + 56);
+	spin_unlock_irqrestore(&run_lock, irqflags);
+	return 0;
+}
+
+void ant_monitor_run_stopped(u64 root_cookie)
+{
+	struct ant_run *run;
+	unsigned long irqflags;
+
+	spin_lock_irqsave(&run_lock, irqflags);
+	run = find_run(root_cookie);
+	if (run && !(run->flags & ANTC_RUN_STOP_REQUESTED)) {
+		run->flags |= ANTC_RUN_STOP_REQUESTED;
+		run->generation++;
+	}
+	spin_unlock_irqrestore(&run_lock, irqflags);
+}
+
+static void async_update(u64 root_cookie, int change, bool loss)
+{
+	struct ant_run *run;
+	unsigned long irqflags;
+
+	spin_lock_irqsave(&run_lock, irqflags);
+	run = find_run(root_cookie);
+	if (run) {
+		if (change > 0)
+			run->async_count++;
+		else if (change < 0 && run->async_count)
+			run->async_count--;
+		else if (change < 0)
+			run->flags |= ANTC_RUN_OBSERVATION_INCOMPLETE;
+		if (!change) {
+			if (loss)
+				run->async_losses++;
+			else
+				run->flags |= ANTC_RUN_OBSERVATION_INCOMPLETE;
+		}
+		run->generation++;
+	}
+	spin_unlock_irqrestore(&run_lock, irqflags);
+}
+
+void ant_run_async_start(u64 root_cookie)
+{
+	async_update(root_cookie, 1, false);
+}
+
+void ant_run_async_finish(u64 root_cookie)
+{
+	async_update(root_cookie, -1, false);
+}
+
+void ant_run_async_loss(u64 root_cookie)
+{
+	async_update(root_cookie, 0, true);
+}
+
+void ant_run_async_incomplete(u64 root_cookie)
+{
+	async_update(root_cookie, 0, false);
+}
