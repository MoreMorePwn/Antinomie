+static void capture_lsm(struct ant_task *ctx, u64 nr, const u64 args[6],
+			bool output, long result)
+{
+	u8 size_arg = nr == 461 ? 1 : 2;
+	u8 data_arg = nr == 461 ? 0 : 1;
+	u32 observed, *capacity;
+	enum ant_status status;
+	u64 size;
+
+	if (nr == 460) {
+		if (!output) {
+			status = (u32)args[2] >= sizeof(struct lsm_ctx) &&
+				(u32)args[2] <= PAGE_SIZE ?
+				ANT_COMPLETE : ANT_INVALID_EXTENT;
+			ant_capture_field(ctx, 1, "arg1.context", LAYOUT("lsm_ctx"), 3,
+					  args[1], NULL, (u32)args[2], (u32)args[2], status);
+		}
+		return;
+	}
+	if (output && result < 0 && result != -E2BIG)
+		return;
+	status = copy_from_user_nofault(&observed, (void __user *)(unsigned long)args[size_arg],
+					sizeof(observed)) ?
+		ANT_COPY_FAULT : ANT_COMPLETE;
+	ant_capture_field(ctx, size_arg, output ? "lsm.returned_size" : "lsm.capacity",
+			  LAYOUT("u32"), 3, args[size_arg], &observed,
+			  sizeof(observed), sizeof(observed), status);
+	if (status != ANT_COMPLETE || ant_capture_lost(ctx))
+		return;
+	if (!output) {
+		capacity = kmalloc(sizeof(*capacity), GFP_NOWAIT);
+		if (!capacity) {
+			ant_capture_field(ctx, size_arg, "lsm.context", "", 1,
+					  args[size_arg], NULL, sizeof(observed), sizeof(observed),
+					  ANT_RESOURCE_EXHAUSTED);
+		} else {
+			*capacity = observed;
+			ant_capture_set_state(ctx, capacity, release_allocation);
+		}
+		if (nr == 459 && args[3] == LSM_FLAG_SINGLE)
+			capture_optional(ctx, 1, args[1], "arg1.lsm_selector", LAYOUT("lsm_ctx"),
+					 sizeof(struct lsm_ctx));
+		return;
+	}
+	if (result == -E2BIG || !args[data_arg])
+		return;
+	capacity = ant_capture_state(ctx);
+	status = !capacity ? ANT_CONTEXT_MISSING : observed > *capacity ?
+		ANT_INVALID_EXTENT : ANT_COMPLETE;
+	size = status == ANT_COMPLETE ? observed : U64_MAX;
+	ant_capture_field(ctx, data_arg, "lsm.output", nr == 461 ? LAYOUT("u64[]") :
+			  LAYOUT("lsm_ctx[]"), 3, args[data_arg], NULL, size,
+			  capacity ? *capacity : U64_MAX, status);
+}
