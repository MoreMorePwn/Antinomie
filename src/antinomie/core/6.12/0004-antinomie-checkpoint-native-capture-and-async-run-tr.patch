+				ANT_COMPLETE : ANT_INVALID_EXTENT;
+			ant_capture_field(ctx, 0, "arg0.clone_args.set_tid", LAYOUT("pid_t[]"), 3,
+					  state->set_tid, NULL, size, size, status);
+		}
+		if ((state->flags & (CLONE_CHILD_SETTID | CLONE_CHILD_CLEARTID)) &&
+		    !ant_capture_lost(ctx))
+			ant_capture_field(ctx, 0, "arg0.clone_args.child_tid", LAYOUT("pid_t"), 3,
+					  state->child_tid, NULL, sizeof(pid_t), sizeof(pid_t),
+					  ANT_CONTEXT_MISSING);
+		return;
+	}
+	if (result <= 0)
+		return;
+	state = ant_capture_state(ctx);
+	if (!state) {
+		ant_capture_field(ctx, 0, "arg0.clone_args.output", "", 1,
+				  args[0], NULL, U64_MAX, U64_MAX, ANT_CONTEXT_MISSING);
+		return;
+	}
+	if (state->flags & CLONE_PIDFD)
+		capture_optional(ctx, 0, state->pidfd, "arg0.clone_args.pidfd",
+				 LAYOUT("int"), sizeof(int));
+	if (state->flags & CLONE_PARENT_SETTID)
+		capture_optional(ctx, 0, state->parent_tid, "arg0.clone_args.parent_tid",
+				 LAYOUT("pid_t"), sizeof(pid_t));
