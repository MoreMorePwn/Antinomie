diff --git a/io_uring/io_uring.c b/io_uring/io_uring.c
index 03c6ab505..cd1297586 100644
--- a/io_uring/io_uring.c
+++ b/io_uring/io_uring.c
@@ -231,6 +231,7 @@ static inline void req_fail_link_node(struct io_kiocb *req, int res)
 
 static inline void io_req_add_to_cache(struct io_kiocb *req, struct io_ring_ctx *ctx)
 {
+	ant_uring_abandon(req);
 	wq_stack_add_head(&req->comp_list, &ctx->submit_state.free_list);
 }
 
@@ -874,6 +875,7 @@ bool io_req_post_cqe(struct io_kiocb *req, s32 res, u32 cflags)
 	}
 
 	ctx->submit_state.cq_flush = true;
+	ant_uring_complete(req, res, cflags, false);
 	return posted;
 }
 
@@ -898,6 +900,7 @@ static void io_req_complete_post(struct io_kiocb *req, unsigned issue_flags)
 		return;
 	}
 
+	ant_uring_complete(req, req->cqe.res, req->cqe.flags, true);
 	io_cq_lock(ctx);
 	if (!(req->flags & REQ_F_CQE_SKIP)) {
 		if (!io_fill_cqe_req(ctx, req))
@@ -932,6 +935,9 @@ void io_req_defer_failed(struct io_kiocb *req, s32 res)
  */
 static void io_preinit_req(struct io_kiocb *req, struct io_ring_ctx *ctx)
 {
+#ifdef CONFIG_ANTINOMIE
+	req->ant_async = NULL;
+#endif
 	req->ctx = ctx;
 	req->link = NULL;
 	req->async_data = NULL;
@@ -2148,6 +2154,35 @@ static __cold int io_submit_fail_init(const struct io_uring_sqe *sqe,
 	return 0;
 }
 
+#ifdef CONFIG_ANTINOMIE
+static u32 ant_uring_payload_flags(u8 opcode)
+{
+	switch (opcode) {
+	case IORING_OP_NOP:
+	case IORING_OP_FSYNC:
+	case IORING_OP_POLL_ADD:
+	case IORING_OP_POLL_REMOVE:
+	case IORING_OP_ASYNC_CANCEL:
+	case IORING_OP_SYNC_FILE_RANGE:
+	case IORING_OP_CLOSE:
+	case IORING_OP_FALLOCATE:
+	case IORING_OP_FADVISE:
+	case IORING_OP_SPLICE:
+	case IORING_OP_REMOVE_BUFFERS:
+	case IORING_OP_TEE:
+	case IORING_OP_SHUTDOWN:
+	case IORING_OP_MSG_RING:
+	case IORING_OP_SOCKET:
+	case IORING_OP_FIXED_FD_INSTALL:
+	case IORING_OP_FTRUNCATE:
+	case IORING_OP_LISTEN:
+		return ANT_ASYNC_PRODUCER_UNKNOWN;
+	default:
+		return ANT_ASYNC_PAYLOAD_GAP | ANT_ASYNC_PRODUCER_UNKNOWN;
+	}
+}
+#endif
+
 static inline int io_submit_sqe(struct io_ring_ctx *ctx, struct io_kiocb *req,
 			 const struct io_uring_sqe *sqe)
 	__must_hold(&ctx->uring_lock)
@@ -2155,7 +2190,20 @@ static inline int io_submit_sqe(struct io_ring_ctx *ctx, struct io_kiocb *req,
 	struct io_submit_link *link = &ctx->submit_state.link;
 	int ret;
 
+#ifdef CONFIG_ANTINOMIE
+	/* The entering task is the submission observer. An mmap SQE does not
+	 * establish which process wrote it; SQPOLL has no user task origin.
+	 */
+	req->ant_async = ant_monitor_async_begin(ANT_ASYNC_IO_URING,
+						 READ_ONCE(sqe->opcode), READ_ONCE(sqe->user_data),
+						 ant_uring_payload_flags(READ_ONCE(sqe->opcode)),
+						 sqe, ctx->flags & IORING_SETUP_SQE128 ?
+						 128 : sizeof(*sqe));
+#endif
 	ret = io_init_req(ctx, req, sqe);
+#ifdef CONFIG_ANTINOMIE
+	ant_monitor_async_accepted(&req->ant_async, ret);
+#endif
 	if (unlikely(ret))
 		return io_submit_fail_init(sqe, req, ret);
 
@@ -3318,6 +3366,7 @@ SYSCALL_DEFINE6(io_uring_enter, unsigned int, fd, u32, to_submit,
 	 */
 	ret = 0;
 	if (ctx->flags & IORING_SETUP_SQPOLL) {
+		ant_monitor_async_unavailable();
 		if (unlikely(ctx->sq_data->thread == NULL)) {
 			ret = -EOWNERDEAD;
 			goto out;
@@ -3698,6 +3747,8 @@ static __cold int io_uring_create(unsigned entries, struct io_uring_params *p,
 		goto err_fput;
 
 	trace_io_uring_create(ret, ctx, p->sq_entries, p->cq_entries, p->flags);
+	if (ctx->flags & IORING_SETUP_SQPOLL)
+		ant_monitor_async_unavailable();
 	return ret;
 err:
 	io_ring_ctx_wait_and_kill(ctx);
diff --git a/io_uring/io_uring.h b/io_uring/io_uring.h
index f1d3b4928..ce4c41aa5 100644
--- a/io_uring/io_uring.h
+++ b/io_uring/io_uring.h
@@ -2,6 +2,7 @@
 #define IOU_CORE_H
 
 #include <linux/errno.h>
+#include <linux/antinomie_monitor.h>
 #include <linux/lockdep.h>
 #include <linux/resume_user_mode.h>
 #include <linux/kasan.h>
@@ -35,6 +36,48 @@ enum {
 	IOU_STOP_MULTISHOT	= -ECANCELED,
 };
 
+static inline void ant_uring_complete(struct io_kiocb *req, s32 result,
+				      u32 flags, bool final)
+{
+#ifdef CONFIG_ANTINOMIE
+	ant_monitor_async_complete(&req->ant_async, result, flags, final);
+#endif
+}
+
+static inline void ant_uring_abandon(struct io_kiocb *req)
+{
+#ifdef CONFIG_ANTINOMIE
+	ant_monitor_async_abandon(&req->ant_async);
+#endif
+}
+
+static inline void ant_uring_iter(struct io_kiocb *req, const struct iov_iter *iter,
+				  size_t size, u64 offset, bool output)
+{
+#ifdef CONFIG_ANTINOMIE
+	ant_monitor_async_iter(&req->ant_async, iter, size, offset, output);
+#endif
+}
+
+static inline void ant_uring_link_completion(struct io_kiocb *req,
+					     struct io_kiocb *notif, s32 result)
+{
+#ifdef CONFIG_ANTINOMIE
+	ant_monitor_async_link_completion(&req->ant_async, &notif->ant_async,
+					  result, IORING_CQE_F_MORE);
+#endif
+}
+
+static inline void ant_uring_memory(struct io_kiocb *req, const char *key,
+				    const char *layout, u16 encoding, u64 address,
+				    const void *snapshot, u64 size, bool output, bool complete)
+{
+#ifdef CONFIG_ANTINOMIE
+	ant_monitor_async_memory(&req->ant_async, key, layout, encoding, address,
+				 snapshot, size, output, complete);
+#endif
+}
+
 struct io_wait_queue {
 	struct wait_queue_entry wq;
 	struct io_ring_ctx *ctx;
@@ -364,6 +407,7 @@ static inline void io_req_complete_defer(struct io_kiocb *req)
 
 	lockdep_assert_held(&req->ctx->uring_lock);
 
+	ant_uring_complete(req, req->cqe.res, req->cqe.flags, true);
 	wq_list_add_tail(&req->comp_list, &state->compl_reqs);
