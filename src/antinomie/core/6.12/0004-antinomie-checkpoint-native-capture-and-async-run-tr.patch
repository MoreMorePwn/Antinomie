+static void capture_sized_input(struct ant_task *ctx, u8 arg, u64 address, u8 offset,
+				u64 minimum, u64 known_size, const char *key,
+				const char *layout, bool zero_is_original)
+{
+	u32 size;
+	enum ant_status status;
+	void __user *user_address = (void __user *)(unsigned long)(address + offset);
+
+	status = address > U64_MAX - offset ? ANT_INVALID_EXTENT :
+		copy_from_user_nofault(&size, user_address, sizeof(size)) ?
+		ANT_COPY_FAULT : ANT_COMPLETE;
+	if (status != ANT_COMPLETE) {
+		ant_capture_field(ctx, arg, key, LAYOUT("u32"), 3, address + offset,
+				  NULL, sizeof(size), sizeof(size), status);
+		return;
+	}
+	capture_versioned(ctx, arg, address, !size && zero_is_original ? minimum : size,
+			  minimum, known_size, key, layout);
+}
