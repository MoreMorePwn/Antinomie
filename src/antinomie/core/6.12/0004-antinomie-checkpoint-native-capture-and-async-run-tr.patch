diff --git a/kernel/antinomie/async.c b/kernel/antinomie/async.c
new file mode 100644
index 000000000..bc4afff12
--- /dev/null
+++ b/kernel/antinomie/async.c
@@ -0,0 +1,427 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/antinomie_monitor.h>
+#include <linux/antinomie.h>
+#include <linux/atomic.h>
+#include <linux/cred.h>
+#include <linux/errno.h>
+#include <linux/ktime.h>
+#include <linux/overflow.h>
+#include <linux/refcount.h>
+#include <linux/sched/task.h>
+#include <linux/sched/signal.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/workqueue.h>
+#include <uapi/linux/io_uring.h>
+
+#include "async.h"
+#include "run.h"
+
+#define ANT_ASYNC_REQUEST_COUNT 256
+#define ANT_ASYNC_RECORD_COUNT 1024
+
+struct ant_async {
+	struct ant_async_event event;
+	struct ant_task *capture;
+	refcount_t refs;
+	atomic_t capture_busy;
+	u64 output_end;
+	bool payload_failed;
+};
+
+struct ant_async_record {
+	struct ant_async_event event;
+	size_t packet_len;
+	u8 packet[136 + 4096];
+};
+
+static atomic_t request_count = ATOMIC_INIT(0);
+static atomic64_t request_ids = ATOMIC64_INIT(0);
+static struct ant_async_record records[ANT_ASYNC_RECORD_COUNT];
+static unsigned int record_head, record_tail, record_count;
+static DEFINE_SPINLOCK(record_lock);
+/* Slot publication/detachment and request metadata share this lock. Taking a
+ * reference while the slot is protected closes the final-completion race.
+ * Never acquire request_lock while holding record_lock.
+ */
+static DEFINE_SPINLOCK(request_lock);
+static void publish_records(struct work_struct *work);
+static DECLARE_WORK(publish_work, publish_records);
+
+static void stage_record(struct ant_async *request, u32 stage, s64 result,
+			 u64 flags, bool final)
+{
+	struct ant_async_event *event;
+	struct ant_async_event observed;
+	unsigned long irqflags;
+
+	spin_lock_irqsave(&request_lock, irqflags);
+	observed = request->event;
+	spin_unlock_irqrestore(&request_lock, irqflags);
+	/* The subsystem owns request until this hook returns. A queued record
+	 * takes a separate task reference and never retains the request pointer.
+	 */
+	spin_lock_irqsave(&record_lock, irqflags);
+	if (record_count == ANT_ASYNC_RECORD_COUNT) {
+		spin_unlock_irqrestore(&record_lock, irqflags);
+		ant_run_async_loss(request->event.root_cookie);
+		return;
+	}
+	records[record_tail].packet_len = 0;
+	event = &records[record_tail].event;
+	*event = observed;
+	event->stage = stage;
+	event->result = result;
+	event->flags |= flags;
+	event->final = final;
+	event->timestamp_ns = ktime_get_ns();
+	event->cpu = raw_smp_processor_id();
+	if (stage != 1)
+		event->descriptor_len = 0;
+	get_task_struct(event->origin);
+	record_tail = (record_tail + 1) % ANT_ASYNC_RECORD_COUNT;
+	record_count++;
+	spin_unlock_irqrestore(&record_lock, irqflags);
+	schedule_work(&publish_work);
+}
+
+static void publish_records(struct work_struct *work)
+{
+	static struct ant_async_record record;
+	unsigned long irqflags;
+	int error;
+
+	for (;;) {
+		spin_lock_irqsave(&record_lock, irqflags);
+		if (!record_count) {
+			spin_unlock_irqrestore(&record_lock, irqflags);
+			return;
+		}
+		record = records[record_head];
+		record_head = (record_head + 1) % ANT_ASYNC_RECORD_COUNT;
+		record_count--;
+		spin_unlock_irqrestore(&record_lock, irqflags);
+		if (record.packet_len) {
+			error = ant_send(record.packet, record.packet_len);
+			if (error)
+				ant_monitor_async_send_failed();
+		} else {
+			error = ant_monitor_async_publish(&record.event);
+		}
+		if (error)
+			ant_run_async_loss(record.event.root_cookie);
+		put_task_struct(record.event.origin);
+		cond_resched();
+	}
+}
+
+int ant_async_stage_packet(const struct ant_async_event *event,
+			   const void *packet, size_t packet_len)
+{
+	struct ant_async_record *record;
+	unsigned long irqflags;
+
+	if (packet_len > sizeof(record->packet))
+		return -EMSGSIZE;
+	spin_lock_irqsave(&record_lock, irqflags);
+	if (record_count == ANT_ASYNC_RECORD_COUNT) {
+		spin_unlock_irqrestore(&record_lock, irqflags);
+		ant_run_async_loss(event->root_cookie);
+		return -ENOSPC;
+	}
+	record = &records[record_tail];
+	record->event = *event;
+	record->packet_len = packet_len;
+	memcpy(record->packet, packet, packet_len);
+	get_task_struct(event->origin);
+	record_tail = (record_tail + 1) % ANT_ASYNC_RECORD_COUNT;
+	record_count++;
+	spin_unlock_irqrestore(&record_lock, irqflags);
+	schedule_work(&publish_work);
+	return 0;
+}
+
+struct ant_async *ant_monitor_async_begin(u8 system, u32 opcode, u64 user_data,
+					  u32 flags, const void *descriptor, size_t descriptor_len)
+{
+	const struct cred *cred = current_cred();
+	struct ant_async *request;
+	struct ant_async_event *event;
+
+	if (!current->ant_cookie)
+		return NULL;
+	if (descriptor_len > sizeof(event->descriptor)) {
+		ant_run_async_incomplete(current->ant_root_cookie);
+		return NULL;
+	}
+	if (!atomic_add_unless(&request_count, 1, ANT_ASYNC_REQUEST_COUNT)) {
+		ant_run_async_loss(current->ant_root_cookie);
+		ant_run_async_incomplete(current->ant_root_cookie);
+		return NULL;
+	}
+	request = kzalloc(sizeof(*request), GFP_NOWAIT);
+	if (!request) {
+		atomic_dec(&request_count);
+		ant_run_async_loss(current->ant_root_cookie);
+		ant_run_async_incomplete(current->ant_root_cookie);
+		return NULL;
+	}
+	event = &request->event;
+	refcount_set(&request->refs, 1);
+	atomic_set(&request->capture_busy, 0);
+	request->capture = ant_monitor_async_capture_alloc();
+	event->origin = current;
+	get_task_struct(current);
+	event->request_id = atomic64_inc_return(&request_ids);
+	event->parent_call_id = ant_monitor_parent_call_id();
+	event->entry_ns = ktime_get_ns();
+	event->cpu = raw_smp_processor_id();
+	event->root_cookie = current->ant_root_cookie;
+	event->task_cookie = current->ant_cookie;
+	event->start_boot_ns = current->start_boottime;
+	event->pid = task_tgid_nr(current);
+	event->tid = task_pid_nr(current);
+	event->opcode = opcode;
+	event->user_data = user_data;
+	event->flags = flags;
+	event->system = system;
+	event->uid = from_kuid(&init_user_ns, cred->uid);
+	event->gid = from_kgid(&init_user_ns, cred->gid);
+	event->euid = from_kuid(&init_user_ns, cred->euid);
+	event->egid = from_kgid(&init_user_ns, cred->egid);
+	event->descriptor_len = descriptor_len;
+	memcpy(event->descriptor, descriptor, descriptor_len);
+	ant_run_async_start(event->root_cookie);
+	if (flags & ~ANT_ASYNC_PAYLOAD_GAP)
+		ant_run_async_incomplete(event->root_cookie);
+	stage_record(request, 1, 0, 0, false);
+	return request;
+}
+
+static struct ant_async *get_request(struct ant_async **slot, bool final)
+{
+	struct ant_async *request;
+	unsigned long irqflags;
+
+	spin_lock_irqsave(&request_lock, irqflags);
+	request = *slot;
+	if (request) {
+		if (final)
+			*slot = NULL;
+		else
+			refcount_inc(&request->refs);
+	}
+	spin_unlock_irqrestore(&request_lock, irqflags);
+	return request;
+}
+
+static void put_request(struct ant_async *request)
+{
+	if (!refcount_dec_and_test(&request->refs))
+		return;
+	put_task_struct(request->event.origin);
+	ant_monitor_async_capture_free(request->capture);
+	kfree(request);
+	atomic_dec(&request_count);
+}
+
+static void finish_request(struct ant_async *request)
+{
+	unsigned long irqflags;
+	bool payload_missing;
+
+	spin_lock_irqsave(&request_lock, irqflags);
+	payload_missing = (request->event.flags & ANT_ASYNC_PAYLOAD_GAP) &&
+		!request->payload_failed;
+	spin_unlock_irqrestore(&request_lock, irqflags);
+	if (payload_missing)
+		ant_run_async_loss(request->event.root_cookie);
+	ant_run_async_finish(request->event.root_cookie);
+	put_request(request);
+}
+
+bool ant_async_iter_covers_payload(const struct ant_async_event *event)
+{
+	const struct io_uring_sqe *sqe = (const void *)event->descriptor;
+
+	if (event->system == ANT_ASYNC_AIO)
+		return true;
+	switch (event->opcode) {
+	case IORING_OP_READV: case IORING_OP_WRITEV:
+	case IORING_OP_READ_FIXED: case IORING_OP_WRITE_FIXED:
+	case IORING_OP_READ: case IORING_OP_WRITE:
+	case IORING_OP_RECV:
+		return true;
+	case IORING_OP_SEND: case IORING_OP_SEND_ZC:
+		return !sqe->addr2;
+	default:
+		/* An iterator does not include msg_name, msg_control or other
+		 * opcode-specific nested operands. Keep their gap explicit.
+		 */
+		return false;
+	}
+}
+
+static bool rw_output(const struct ant_async_event *event)
+{
+	if (event->system == ANT_ASYNC_AIO)
+		return true;
+	return event->opcode == IORING_OP_READ || event->opcode == IORING_OP_READV ||
+		event->opcode == IORING_OP_READ_FIXED;
+}
+
+void ant_monitor_async_iter(struct ant_async **slot,
+			    const struct iov_iter *iter, size_t size,
+			    u64 result_offset, bool output)
+{
+	struct ant_async *request = get_request(slot, false);
+	struct ant_async_event event;
+	unsigned long irqflags;
+	u64 output_end = 0;
+	bool acquired, failed, gap = false;
+
+	if (!request)
+		return;
+	spin_lock_irqsave(&request_lock, irqflags);
+	event = request->event;
+	if (output && rw_output(&event)) {
+		/* A successful tail cannot establish observation of a missing prefix. */
+		gap = result_offset > request->output_end ||
+			check_add_overflow(result_offset, (u64)size, &output_end);
+		if (gap) {
+			request->event.flags |= ANT_ASYNC_PAYLOAD_GAP;
+			request->payload_failed = true;
+			event.flags |= ANT_ASYNC_PAYLOAD_GAP;
+		}
+	}
+	spin_unlock_irqrestore(&request_lock, irqflags);
+	acquired = !atomic_cmpxchg(&request->capture_busy, 0, 1);
+	if (!acquired) {
+		failed = true;
+	} else {
+		failed = !request->capture || ant_monitor_async_capture(request->capture,
+				&event, iter, size, result_offset, output);
+	}
+	spin_lock_irqsave(&request_lock, irqflags);
+	if (!failed && output && rw_output(&event) && !gap)
+		request->output_end = max(request->output_end, output_end);
+	if (failed) {
+		request->event.flags |= ANT_ASYNC_PAYLOAD_GAP;
+		request->payload_failed = true;
+	} else if (!request->payload_failed && ant_async_iter_covers_payload(&event)) {
+		request->event.flags &= ~ANT_ASYNC_PAYLOAD_GAP;
+	}
+	spin_unlock_irqrestore(&request_lock, irqflags);
+	if (acquired)
+		atomic_set_release(&request->capture_busy, 0);
+	if (failed || gap)
+		ant_run_async_loss(request->event.root_cookie);
+	put_request(request);
+}
+
+void ant_monitor_async_memory(struct ant_async **slot, const char *key,
+			      const char *layout, u16 encoding, u64 address,
+			      const void *snapshot, u64 size, bool output, bool complete)
+{
+	struct ant_async *request = get_request(slot, false);
+	struct ant_async_event event;
+	unsigned long irqflags;
+	bool failed;
+
+	if (!request)
+		return;
+	spin_lock_irqsave(&request_lock, irqflags);
+	event = request->event;
+	spin_unlock_irqrestore(&request_lock, irqflags);
+	if (atomic_cmpxchg(&request->capture_busy, 0, 1)) {
+		failed = true;
+	} else {
+		failed = !request->capture || ant_monitor_async_capture_memory(request->capture,
+				&event, key, layout, encoding, address, snapshot, size, output);
+		atomic_set_release(&request->capture_busy, 0);
+	}
+	spin_lock_irqsave(&request_lock, irqflags);
+	if (failed) {
+		request->event.flags |= ANT_ASYNC_PAYLOAD_GAP;
+		request->payload_failed = true;
+	} else if (complete && !request->payload_failed) {
+		request->event.flags &= ~ANT_ASYNC_PAYLOAD_GAP;
+	}
+	spin_unlock_irqrestore(&request_lock, irqflags);
+	if (failed)
+		ant_run_async_loss(request->event.root_cookie);
+	put_request(request);
+}
+
+void ant_monitor_async_accepted(struct ant_async **slot, int result)
+{
+	struct ant_async *request = get_request(slot, result < 0);
+
+	if (!request)
+		return;
+	if (result < 0) {
+		stage_record(request, 3, result, 0, true);
+		finish_request(request);
+	} else {
+		stage_record(request, 2, result, 0, false);
+		put_request(request);
+	}
+}
+
+void ant_monitor_async_complete(struct ant_async **slot, s64 result,
+				u32 flags, bool final)
+{
+	struct ant_async *request = get_request(slot, final);
+
+	if (!request)
+		return;
+	stage_record(request, result == -ECANCELED ? 5 : 4, result,
+		     (u64)flags << 32, final);
+	if (final)
+		finish_request(request);
+	else
+		put_request(request);
+}
+
+void ant_monitor_async_abandon(struct ant_async **slot)
+{
+	struct ant_async *request = get_request(slot, true);
+
+	if (!request)
+		return;
+	ant_run_async_incomplete(request->event.root_cookie);
+	stage_record(request, 6, -ENODATA, ANT_ASYNC_ABANDONED, true);
+	finish_request(request);
+}
+
+void ant_monitor_async_link_completion(struct ant_async **source,
+				       struct ant_async **target, s64 result, u32 flags)
+{
+	struct ant_async *request = get_request(source, false);
+	unsigned long irqflags;
+	bool transferred = false;
+
+	if (!request)
+		return;
+	stage_record(request, result == -ECANCELED ? 5 : 4, result,
+		     (u64)flags << 32, false);
+	/* Both subsystem objects remain owned by the caller. Transfer the slot
+	 * reference, not the origin identity or an additional pending request.
+	 */
+	spin_lock_irqsave(&request_lock, irqflags);
+	if (*source == request && !*target) {
+		*target = request;
+		*source = NULL;
+		transferred = true;
+	}
+	spin_unlock_irqrestore(&request_lock, irqflags);
+	if (!transferred)
+		ant_run_async_incomplete(request->event.root_cookie);
+	put_request(request);
+}
+
+void ant_monitor_async_unavailable(void)
+{
+	if (current->ant_cookie)
+		ant_run_async_incomplete(current->ant_root_cookie);
+}
