+u8 ant_native_capture(struct ant_task *ctx, u64 nr, const u64 args[6],
+		      bool output, long result)
+{
+	u8 mask = 0;
+	unsigned int index;
+
+	switch (nr) {
+	case 101: case 139: case 157: case 250:
+		/* Scalar prototypes do not describe selector-dependent pointer roles. */
+		if (!output)
+			capture_gap(ctx, "schema.selector_decoder", ANT_NO_DECODER);
+		return 0;
+	case 15: case 335:
+		if (!output)
+			capture_gap(ctx, "schema.arch_context", ANT_CONTEXT_MISSING);
+		return 0;
+	case 72:
+		capture_fcntl(ctx, args, output, result);
+		return ANT_CAPTURE_OWNED | BIT(2);
+	case 158:
+		capture_arch_prctl(ctx, args, output, result);
+		return ANT_CAPTURE_OWNED | BIT(1);
+	case 103: case 154: case 279: case 298:
+		capture_remaining_small(ctx, nr, args, output, result);
+		return ANT_CAPTURE_OWNED | (nr == 298 ? BIT(0) : nr == 279 ?
+			BIT(2) | BIT(3) | BIT(4) : BIT(1));
+	case 457: case 458:
+		capture_mount_queries(ctx, nr, args, output, result);
+		return ANT_CAPTURE_OWNED | BIT(0) | BIT(1);
+	case 459: case 460: case 461:
+		capture_lsm(ctx, nr, args, output, result);
+		return ANT_CAPTURE_OWNED | (nr == 461 ? BIT(0) | BIT(1) :
+			BIT(1) | (nr == 459 ? BIT(2) : 0));
+	case 125: case 126:
+		capture_capabilities(ctx, nr, args, output, result);
+		return ANT_CAPTURE_OWNED | BIT(0) | BIT(1);
+	case 169:
+		capture_reboot(ctx, args, output);
+		return ANT_CAPTURE_OWNED | BIT(3);
+	case 278:
+		capture_vector(ctx, args, output, result, true);
+		return ANT_CAPTURE_OWNED | BIT(1);
+	case 303: case 304:
+		capture_handle(ctx, nr, args, output, result);
+		return ANT_CAPTURE_OWNED | BIT(1) | (nr == 303 ? BIT(2) | BIT(3) : 0);
+	case 317:
+		capture_seccomp(ctx, args, output, result);
+		return ANT_CAPTURE_OWNED | BIT(2);
+	case 431:
+		capture_fsconfig(ctx, args, output);
+		return ANT_CAPTURE_OWNED | BIT(2) | BIT(3);
+	case 440:
+		if (!output) {
+			struct ant_vector_state *vector;
+
+			vector = save_vector(ctx, 1, args[1], args[2], "arg1.remote_ranges");
+			kfree(vector);
+		}
+		return ANT_CAPTURE_OWNED | BIT(1);
+	case 442:
+		if (!output) {
+			ant_capture_string(ctx, 1, "arg1.path", args[1], PATH_MAX);
+			if (!ant_capture_lost(ctx))
+				capture_versioned(ctx, 3, args[3], args[4], MOUNT_ATTR_SIZE_VER0,
+						  sizeof(struct mount_attr), "arg3.mount_attr",
+						  LAYOUT("mount_attr"));
+		}
+		return ANT_CAPTURE_OWNED | BIT(1) | BIT(3);
+	case 444:
+		if (!output && !args[2])
+			capture_versioned(ctx, 0, args[0], args[1], sizeof(u64),
+					  sizeof(struct landlock_ruleset_attr), "arg0.ruleset",
+					  LAYOUT("landlock_ruleset_attr"));
+		return ANT_CAPTURE_OWNED | BIT(0);
+	case 445:
+		capture_landlock_rule(ctx, args, output);
+		return ANT_CAPTURE_OWNED | BIT(2);
+	case 27:
+		if (output && result == 0) {
+			u64 pages = (args[1] >> PAGE_SHIFT) + !!(args[1] & ~PAGE_MASK);
+
+			ant_capture_field(ctx, 2, "arg2.residency", "", 1,
+					  args[2], NULL, pages, pages, ANT_COMPLETE);
+		}
+		return ANT_CAPTURE_OWNED | BIT(2);
+	case 170: case 171:
+		if (!output)
+			ant_capture_field(ctx, 0, "arg0.name", "", 1, args[0], NULL,
+					  (u32)args[1], (u32)args[1],
+					  (s32)args[1] >= 0 && (u32)args[1] <= __NEW_UTS_LEN ?
+					  ANT_COMPLETE : ANT_INVALID_EXTENT);
+		return ANT_CAPTURE_OWNED | BIT(0);
+	case 202: case 449: case 454: case 455: case 456:
+		capture_futex(ctx, nr, args, output, result);
+		mask = nr == 202 ? BIT(0) | BIT(3) | BIT(4) :
+			nr == 449 ? BIT(0) | BIT(3) : nr == 455 ? BIT(0) | BIT(4) : BIT(0);
+		return ANT_CAPTURE_OWNED | mask;
+	case 203: case 204: case 237: case 238: case 239: case 256:
+		capture_memory_masks(ctx, nr, args, output, result);
+		mask = nr == 203 || nr == 204 ? BIT(2) : nr == 237 ? BIT(3) :
+			nr == 238 ? BIT(1) : nr == 239 ? BIT(0) | BIT(1) : BIT(2) | BIT(3);
+		return ANT_CAPTURE_OWNED | mask;
+	case 218: case 273:
