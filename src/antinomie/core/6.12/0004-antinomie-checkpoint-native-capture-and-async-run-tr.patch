+static void capture_gap(struct ant_task *ctx, const char *key, enum ant_status status)
+{
+	if (!ant_capture_lost(ctx))
+		ant_capture_field(ctx, 255, key, "", 1, 0, NULL,
+				  U64_MAX, U64_MAX, status);
+}
