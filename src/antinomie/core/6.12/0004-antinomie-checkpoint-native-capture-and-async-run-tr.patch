+static void capture_rule(struct ant_task *ctx, const struct ant_field_rule *rule,
+			 const u64 args[6], bool output, long result)
+{
+	u64 size = rule->object_size, declared = size;
+	enum ant_status status = ANT_COMPLETE;
+	char key[64];
+
+	if (!phase_matches(rule->phase, output, result))
+		return;
+	if (rule->nr == 230 && rule->arg_index == 3 && (args[1] & TIMER_ABSTIME))
+		return;
+	scnprintf(key, sizeof(key), "arg%u.%s", rule->arg_index,
+		  rule->length == ANT_PATH ? "path" : "data");
+	if (rule->length == ANT_PATH) {
+		ant_capture_string(ctx, rule->arg_index, key,
+				   args[rule->arg_index], size);
+		return;
+	}
+	if (rule->length != ANT_FIXED) {
+		declared = args[rule->length_arg];
+		if (rule->object_size == U32_MAX)
+			declared = (u32)declared;
+		else if (rule->object_size == INT_MAX ||
+			 rule->length == ANT_GROUP_INPUT || rule->length == ANT_GROUP_OUTPUT)
+			declared = (s32)declared < 0 ? U64_MAX : (u32)declared;
+		size = min(declared, rule->object_size);
+		if (rule->length == ANT_BUFFER_OUTPUT || rule->length == ANT_GROUP_OUTPUT)
+			size = declared ? min_t(u64, size, result) : 0;
+		if (declared > rule->object_size && rule->object_size != MAX_RW_COUNT)
+			status = ANT_INVALID_EXTENT;
+		if (rule->length == ANT_GROUP_INPUT || rule->length == ANT_GROUP_OUTPUT) {
+			size *= sizeof(u32);
+			declared = declared > NGROUPS_MAX ? U64_MAX : declared * sizeof(u32);
+		}
+	}
+	ant_capture_field(ctx, rule->arg_index, key, rule->layout,
+			  rule->length == ANT_FIXED ? 3 : 1,
+			  args[rule->arg_index], NULL, size, declared, status);
+}
