+static bool phase_matches(u8 phase, bool output, long result)
+{
+	if (!output)
+		return phase == ANT_INPUT || phase == ANT_BOTH_NONNEGATIVE;
+	switch (phase) {
+	case ANT_OUTPUT_ZERO:
+		return result == 0;
+	case ANT_OUTPUT_POSITIVE:
+		return result > 0;
+	case ANT_OUTPUT_NONNEGATIVE: case ANT_BOTH_NONNEGATIVE:
+		return result >= 0;
+	case ANT_OUTPUT_INTERRUPTED:
+		return result == -EINTR;
+	default:
+		return false;
+	}
+}
