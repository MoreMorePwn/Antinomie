+static void capture_capabilities(struct ant_task *ctx, u64 nr, const u64 args[6],
+				 bool output, long result)
+{
+	u32 version, *word_count;
+	u64 size;
+	enum ant_status status;
+
+	if (!output) {
+		status = copy_from_user_nofault(&version, (void __user *)(unsigned long)args[0],
+						sizeof(version)) ?
+			ANT_COPY_FAULT : ANT_COMPLETE;
+		ant_capture_field(ctx, 0, "arg0.version", LAYOUT("u32"), 3,
+				  args[0], &version, sizeof(version), sizeof(version), status);
+		if (status != ANT_COMPLETE || ant_capture_lost(ctx))
+			return;
+		word_count = kzalloc(sizeof(*word_count), GFP_NOWAIT);
+		if (!word_count) {
+			ant_capture_field(ctx, 0, "arg0.context", "", 1, args[0], NULL,
+					  sizeof(version), sizeof(version), ANT_RESOURCE_EXHAUSTED);
+			return;
+		}
+		switch (version) {
+		case _LINUX_CAPABILITY_VERSION_1:
+			*word_count = 1;
+			break;
+		case _LINUX_CAPABILITY_VERSION_2: case _LINUX_CAPABILITY_VERSION_3:
+			*word_count = 2;
+			break;
+		}
+		ant_capture_set_state(ctx, word_count, release_allocation);
+		if (!*word_count || (nr == 125 && !args[1]))
+			return;
+		capture_optional(ctx, 0, args[0] + sizeof(u32), "arg0.pid", LAYOUT("pid_t"),
+				 sizeof(pid_t));
+	} else {
+		word_count = ant_capture_state(ctx);
+		if (!word_count) {
+			if (nr == 125 && result == 0 && args[1])
+				ant_capture_field(ctx, 1, "arg1.capabilities", "", 1, args[1], NULL,
+						  U64_MAX, U64_MAX, ANT_CONTEXT_MISSING);
+			return;
+		}
+		if (!*word_count && (result == -EINVAL || (nr == 125 && result == 0))) {
+			capture_optional(ctx, 0, args[0], "arg0.required_version", LAYOUT("u32"),
+					 sizeof(u32));
+			return;
+		}
+	}
+	if ((nr == 126 && !output) || (nr == 125 && output && result == 0 && args[1])) {
+		size = *word_count * sizeof(struct __user_cap_data_struct);
+		if (!ant_capture_lost(ctx))
+			ant_capture_field(ctx, 1, "arg1.capabilities", LAYOUT("cap_data[]"), 3,
+					  args[1], NULL, size, size, ANT_COMPLETE);
+	}
