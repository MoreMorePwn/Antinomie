+/* Contract revision 21: who sent the signal that ended a thread group.
+ *
+ * A signal that starts the group exit when it is sent (SIGKILL, or a fatal
+ * signal nothing catches: complete_signal()) is never dequeued with its
+ * siginfo, and SIGKILL is never queued with one at all, so the sender is
+ * taken at the send, where the sending call's task is current. A fatal
+ * signal that is dequeued instead (a core-dumping one, one a ptraced or
+ * debugged task gets) is taken at its delivery, from the siginfo the task
+ * dequeued. Both run with the group's siglock held, which also orders them
+ * with the read at exit. The first record of a group stays.
+ */
+static bool sent_by_call(const struct kernel_siginfo *info)
+{
+	if (!in_task() || (current->flags & PF_KTHREAD))
+		return false;
+	if (info == SEND_SIG_NOINFO)
+		return true;
+	/* signal.c's is_si_special(): the special values are the two lowest. */
+	return info > SEND_SIG_PRIV &&
+		(info->si_code == SI_USER || info->si_code == SI_TKILL ||
+		 info->si_code == SI_QUEUE);
+}
+
+static void fatal_note(struct ant_fatal_signal *fatal, int sig,
+		       const struct kernel_siginfo *info, struct task_struct *t, u8 origin)
+{
+	enum siginfo_layout layout;
+
+	memset(fatal, 0, sizeof(*fatal));
+	fatal->signo = sig;
+	fatal->origin = origin;
+	if (info == SEND_SIG_PRIV) {
+		fatal->code = SI_KERNEL;
+		return;
+	}
+	if (info == SEND_SIG_NOINFO) {
+		/* As __send_signal_locked() fills it for the target. */
+		fatal->code = SI_USER;
+		fatal->pid = task_tgid_nr_ns(current, task_active_pid_ns(t));
+		rcu_read_lock();
+		fatal->uid = from_kuid_munged(task_cred_xxx(t, user_ns), current_uid());
+		rcu_read_unlock();
+	} else {
+		fatal->code = info->si_code;
+		layout = siginfo_layout(sig, info->si_code);
+		if (layout == SIL_KILL || layout == SIL_CHLD || layout == SIL_RT) {
+			fatal->pid = info->si_pid;
+			fatal->uid = info->si_uid;
+		}
+	}
+	if (origin == ANT_FATAL_SENT && sent_by_call(info)) {
+		fatal->sender_pid = task_tgid_nr(current);
+		fatal->sender_uid = from_kuid(&init_user_ns, current_uid());
+		/* Unlocked, as printk's users read it: get_task_comm() would take
+		 * the task lock inside the siglock.
+		 */
+		strscpy(fatal->sender_comm, current->comm, sizeof(fatal->sender_comm));
+	}
+}
+
+void ant_monitor_signal_sent(int sig, struct kernel_siginfo *info,
+			     struct task_struct *t)
+{
+	struct signal_struct *signal = t->signal;
+	struct ant_fatal_signal *fatal = &ant_state(t->group_leader)->fatal;
+
+	if (!(signal->flags & SIGNAL_GROUP_EXIT) || signal->group_exit_code != sig ||
+	    fatal->signo == sig)
+		return;
+	fatal_note(fatal, sig, info, t, ANT_FATAL_SENT);
+}
+
+void ant_monitor_fatal_signal(int sig, const struct kernel_siginfo *info)
+{
+	struct ant_fatal_signal *fatal = &ant_state(current->group_leader)->fatal;
+
+	if (!fatal->signo)
+		fatal_note(fatal, sig, info, current, ANT_FATAL_DELIVERED);
+}
+
+/* The OOM killer has sent its SIGKILL to the victim's group (SI_KERNEL, at
+ * the send) and logged the kill; the record keeps that line. The victim's
+ * task lock is held, which nests the siglock (do_send_sig_info() just took it).
+ */
+void ant_monitor_oom_kill(struct task_struct *victim, struct mm_struct *mm,
+			  const char *message)
+{
+	struct ant_fatal_signal *fatal;
+	unsigned long flags;
+
+	if (!lock_task_sighand(victim, &flags))
+		return;
+	fatal = &ant_state(victim->group_leader)->fatal;
+	if (fatal->signo == SIGKILL && fatal->code == SI_KERNEL && !fatal->oom) {
+		fatal->oom = true;
+		scnprintf(fatal->log, sizeof(fatal->log),
+			  "%s: Killed process %d (%s) total-vm:%lukB, anon-rss:%lukB, file-rss:%lukB, shmem-rss:%lukB, UID:%u pgtables:%lukB oom_score_adj:%hd",
+			  message, task_pid_nr(victim), victim->comm,
+			  mm->total_vm << (PAGE_SHIFT - 10),
+			  get_mm_counter(mm, MM_ANONPAGES) << (PAGE_SHIFT - 10),
+			  get_mm_counter(mm, MM_FILEPAGES) << (PAGE_SHIFT - 10),
+			  get_mm_counter(mm, MM_SHMEMPAGES) << (PAGE_SHIFT - 10),
+			  from_kuid(&init_user_ns, task_uid(victim)),
+			  mm_pgtables_bytes(mm) >> 10, victim->signal->oom_score_adj);
+	}
+	unlock_task_sighand(victim, &flags);
+}
+
+/* The task-exit record: the wait status, and for a task the signal ended, who
+ * sent that signal when its group's record has it.
+ */
+static void lifecycle_task_exit(struct ant_task *ctx)
+{
+	static const char *const keys[] = {
+		"lifecycle.signal.signo", "lifecycle.signal.code",
+		"lifecycle.signal.pid", "lifecycle.signal.uid",
+		"lifecycle.signal.origin", "lifecycle.signal.sender_pid",
+		"lifecycle.signal.sender_uid", "lifecycle.signal.oom",
+	};
+	struct ant_fatal_signal fatal;
+	u64 values[ARRAY_SIZE(keys)];
+	unsigned long flags;
+	u8 scalar[8];
+	int i, count;
+
+	if (!ctx || ctx->busy)
+		return;
+	fatal.signo = 0;
+	if ((current->exit_code & 0x7f) && lock_task_sighand(current, &flags)) {
+		fatal = ant_state(current->group_leader)->fatal;
+		unlock_task_sighand(current, &flags);
+	}
+	if (!fatal.signo || fatal.signo != (current->exit_code & 0x7f)) {
+		lifecycle(ctx, "lifecycle.task_exit", current->exit_code);
+		return;
+	}
+	if (!lifecycle_admit(ctx))
+		return;
+	values[0] = fatal.signo;
+	values[1] = (s64)fatal.code;
+	values[2] = (s64)fatal.pid;
+	values[3] = fatal.uid;
+	values[4] = fatal.origin;
+	values[5] = (s64)fatal.sender_pid;
+	values[6] = fatal.sender_uid;
+	values[7] = fatal.oom;
+	/* Sender fields only when the sending call's task is known; the OOM
+	 * mark only for the OOM killer's kill.
+	 */
+	count = fatal.sender_pid ? 7 : 5;
+	ctx->busy = true;
+	event_begin(ctx, 3, 0);
+	put_unaligned_le64(current->exit_code, scalar);
+	field(ctx, 255, "lifecycle.task_exit", "", 4, 0, scalar, sizeof(scalar),
+	      sizeof(scalar), ANT_COMPLETE);
+	for (i = 0; i < count; i++) {
+		put_unaligned_le64(values[i], scalar);
+		field(ctx, 255, keys[i], "", 4, 0, scalar, sizeof(scalar), sizeof(scalar),
+		      ANT_COMPLETE);
+	}
+	if (fatal.sender_pid)
+		field(ctx, 255, "lifecycle.signal.sender_comm", "", 2, 0, fatal.sender_comm,
+		      strnlen(fatal.sender_comm, sizeof(fatal.sender_comm)),
+		      sizeof(fatal.sender_comm), ANT_COMPLETE);
+	if (fatal.oom) {
+		put_unaligned_le64(1, scalar);
+		field(ctx, 255, keys[7], "", 4, 0, scalar, sizeof(scalar), sizeof(scalar),
+		      ANT_COMPLETE);
+		field(ctx, 255, "lifecycle.kernel_log", "", 2, 0, fatal.log,
+		      strnlen(fatal.log, sizeof(fatal.log)), sizeof(fatal.log),
+		      ANT_COMPLETE);
+	}
+	event_end(ctx);
+	ctx->busy = false;
+}
+
 void ant_monitor_task_exit(bool group_dead)
 {
 	/* Pages the address space held dirty when exit_mm() dropped it. */
 	filemap_note(ant_state(current)->monitor);
 	ant_run_exit(current, group_dead);
-	lifecycle(ant_state(current)->monitor, "lifecycle.task_exit", current->exit_code);
+	lifecycle_task_exit(ant_state(current)->monitor);
 	if (ant_state(current)->counted) {
 		ant_state(current)->counted = false;
 		atomic64_dec(&tasks_live);
diff --git a/kernel/antinomie/state.h b/kernel/antinomie/state.h
index 375b0d87b..0f7a6bf11 100644
--- a/kernel/antinomie/state.h
+++ b/kernel/antinomie/state.h
@@ -10,6 +10,31 @@ struct ant_task;
 struct ant_run;
 struct ant_coredump_live;
 
+/* The kernel's log line for an OOM kill, as __oom_kill_process() prints it. */
+#define ANT_KILL_LOG_SIZE 192
+
+/* The signal that ended a thread group and who sent it (contract revision
+ * 21). It is kept in the group leader's state, written and read under the
+ * group's siglock: by the send that starts the group exit (SIGKILL, an
+ * uncaught fatal signal), else by the delivery of a fatal signal, and marked
+ * by the OOM killer with the line it logs. signo 0: nothing recorded.
+ */
+struct ant_fatal_signal {
+	s32 code;		/* si_code, as the task would read it */
+	s32 pid;		/* si_pid and si_uid, where si_code's layout has them */
+	u32 uid;
+	s32 sender_pid;		/* the task whose call sent it (global TGID), or 0 */
+	u32 sender_uid;
+	u8 signo;
+	u8 origin;		/* ANT_FATAL_SENT or ANT_FATAL_DELIVERED */
+	bool oom;		/* the OOM killer's SIGKILL; log holds its line */
+	char sender_comm[TASK_COMM_LEN];
+	char log[ANT_KILL_LOG_SIZE];
+};
+
+#define ANT_FATAL_SENT 1
+#define ANT_FATAL_DELIVERED 2
+
 /* What the recorder keeps per task. It lives in the task's security blob
  * (task->security), at an offset reserved after every LSM's own part when the
  * LSMs are set up (ant_task_state_reserve()), never in struct task_struct, so
@@ -32,6 +57,7 @@ struct ant_task_state {
 	/* The process core this task is writing (ant_coredump_attach()). */
 	struct ant_coredump_live *coredump_live;
 	unsigned long coredump_deadline;
+	struct ant_fatal_signal fatal;
 	atomic64_t event_seq;
 	atomic64_t packet_seq;
 	bool root_process;
diff --git a/kernel/signal.c b/kernel/signal.c
index cc8aee82b..84b8fce6d 100644
--- a/kernel/signal.c
+++ b/kernel/signal.c
@@ -1190,6 +1190,7 @@ static int __send_signal_locked(int sig, struct kernel_siginfo *info,
 	}
 
 	complete_signal(sig, t, type);
+	ant_monitor_signal_sent(sig, info, t);
 ret:
 	trace_signal_generate(sig, info, t, type != PIDTYPE_PID, result);
 	return ret;
@@ -2894,6 +2895,7 @@ bool get_signal(struct ksignal *ksig)
 			continue;
 		}
 
+		ant_monitor_fatal_signal(signr, &ksig->info);
 	fatal:
 		spin_unlock_irq(&sighand->siglock);
 		if (unlikely(cgroup_task_frozen(current)))
