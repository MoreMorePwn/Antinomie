diff --git a/kernel/antinomie/Kconfig b/kernel/antinomie/Kconfig
new file mode 100644
index 0000000..3ff7199
--- /dev/null
+++ b/kernel/antinomie/Kconfig
@@ -0,0 +1,20 @@
+config ANTINOMIE
+	bool "Antinomie host control and syscall recorder"
+	depends on X86_64 && UNIX98_PTYS
+	help
+	  Host control, PTY sessions and observational syscall telemetry over
+	  the Antinomie V7 memory transport. Only host-launched tasks and their
+	  descendants are traced. Host access includes guest execution authority.
+	  An architecture with a port provides <asm/antinomie.h>, the generated
+	  <asm/antinomie_syscalls.h> and hooks in its own arch/ tree; x86-64 is
+	  the only one.
+
+config ANTINOMIE_SOURCE_ID
+	string "Antinomie patch-series identity"
+	depends on ANTINOMIE
+	default ""
+	help
+	  "<revision>:<series sha256>", set by the Antinomie kernel build
+	  script after it verifies that the tree is the pinned baseline plus
+	  the committed patch series. Reported to the host by the INFO
+	  command. Leave empty for development builds.
