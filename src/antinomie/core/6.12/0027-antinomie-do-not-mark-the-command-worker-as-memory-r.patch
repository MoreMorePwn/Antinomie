From 8ce5b59909b830acf3196432a204e746e90c1da7 Mon Sep 17 00:00:00 2001
From: MikiMiku <jonathanirvinjo@gmail.com>
Date: Tue, 13 Oct 2026 06:46:19 +0700
Subject: [PATCH] antinomie: do not mark the command worker as memory reclaim

Terminal READ flushes the ordinary TTY workqueue. A reclaim worker is not allowed to wait for that work, so the control queue keeps ordered command handling without WQ_MEM_RECLAIM.

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 kernel/antinomie/guest.c | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/kernel/antinomie/guest.c b/kernel/antinomie/guest.c
index 85f9cfcee..de445d3fd 100644
--- a/kernel/antinomie/guest.c
+++ b/kernel/antinomie/guest.c
@@ -437,7 +437,15 @@ static int __init ant_guest_init(void)
 		directory[index].cpu_id = cpu;
 		per_cpu(producers, cpu).index = index++;
 	}
-	worker = alloc_ordered_workqueue("antinomie-control", WQ_MEM_RECLAIM);
+	/*
+	 * This worker only polls host commands. It is not a reclaim path,
+	 * and a terminal READ reaches n_tty_read, which flushes the ordinary
+	 * TTY queue events_unbound. WQ_MEM_RECLAIM makes that flush trip
+	 * check_flush_dependency. Flags stay 0 so the worker may complete
+	 * the read. The queue stays ordered, so commands, EOF and shutdown
+	 * keep one sequence.
+	 */
+	worker = alloc_ordered_workqueue("antinomie-control", 0);
 	if (!worker) goto free_rings;
 	control->geometry.version = ANT_ABI;
 	control->geometry.session = get_random_u64() ?: 1;
-- 
