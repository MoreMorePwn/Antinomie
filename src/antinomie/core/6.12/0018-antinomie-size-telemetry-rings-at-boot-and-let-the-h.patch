From bdc2e677b190e1d9618e76b4f81e4ba7ece6395b Mon Sep 17 00:00:00 2001
From: MikiMiku <jonathanirvinjo@gmail.com>
Date: Fri, 9 Oct 2026 20:45:20 +0700
Subject: [PATCH] antinomie: size telemetry rings at boot and let the host ask
 senders to wait

antinomie_ring_kib= selects each CPU's telemetry ring, a power of two from
256 KiB to 4 MiB (default 1 MiB); when memory is short the guest falls back
to smaller rings. With send_wait_us set in the control region, a send to a
full ring waits for room instead of dropping, while the host is live and
for at most that long (up to 10 s): a sender that may sleep sleeps, one in
atomic context spins. Queues report the waits. Transport ABI 8; contract
revision 13.
---
 include/linux/antinomie.h       |  8 ++-
 kernel/antinomie/abi.h          | 22 ++++++--
 kernel/antinomie/async.c        |  2 +-
 kernel/antinomie/control_wire.h |  3 +-
 kernel/antinomie/guest.c        | 99 ++++++++++++++++++++++++++++++---
 5 files changed, 117 insertions(+), 17 deletions(-)

diff --git a/include/linux/antinomie.h b/include/linux/antinomie.h
index 18ef86315..7b33226ce 100644
--- a/include/linux/antinomie.h
+++ b/include/linux/antinomie.h
@@ -5,9 +5,15 @@
 
 /* Task context only. data is valid kernel memory; copied before return.
  * Zero means local acceptance, not delivery. No allocation or sleep on send.
- * A zero-length message is valid. Maximum payload length is ring capacity minus framing.
+ * A full ring returns -ENOSPC at once, unless the host set a send wait: then
+ * the sender spins, preemption off, until room appears, the wait ends or the
+ * host stops being live. A zero-length message is valid. Maximum payload
+ * length is the smallest ring capacity minus framing (ANT_MAX_MESSAGE_LEN).
  */
 int ant_send(const void *data, size_t payload_len);
+/* Bytes in each CPU's telemetry ring (antinomie_ring_kib=, or smaller when
+ * the requested size could not be allocated at boot). */
+u32 ant_ring_size(void);
 /* Bytes free in the telemetry ring of the CPU the caller runs on, as of the
  * consumer's last published tail; U32_MAX when sends would fail regardless.
  * Advisory: a caller that can sleep uses it to pace bulk publication.
diff --git a/kernel/antinomie/abi.h b/kernel/antinomie/abi.h
index dbbfd8039..81779595a 100644
--- a/kernel/antinomie/abi.h
+++ b/kernel/antinomie/abi.h
@@ -11,15 +11,21 @@
 
 /* Wire profile: x86-64, little endian. Memory translation is supplied by host. */
 #define ANT_MAGIC 0x354e5441U
-#define ANT_ABI 7U
+#define ANT_ABI 8U
 #define ANT_MAX_CPUS 256U
 #define ANT_CONTROL_SIZE 1048576U
 #define ANT_REQUEST_OFFSET 4096U
 #define ANT_RESPONSE_OFFSET (ANT_REQUEST_OFFSET + ANT_COMMAND_RING_SIZE)
 #define ANT_DIRECTORY_OFFSET (ANT_RESPONSE_OFFSET + ANT_COMMAND_RING_SIZE)
 #define ANT_COMMAND_RING_SIZE 262144U
-#define ANT_TELEMETRY_RING_SIZE 262144U
-#define ANT_MAX_MESSAGE_LEN (ANT_TELEMETRY_RING_SIZE - 32U)
+/* Per-CPU telemetry rings are a power of two in this range; the boot option
+ * antinomie_ring_kib= selects the size (the default when absent). */
+#define ANT_TELEMETRY_RING_MIN 262144U
+#define ANT_TELEMETRY_RING_DEFAULT 1048576U
+#define ANT_TELEMETRY_RING_MAX 4194304U
+#define ANT_MAX_MESSAGE_LEN (ANT_TELEMETRY_RING_MIN - 32U)
+/* Longest a full ring may hold a sender when the host asks senders to wait. */
+#define ANT_SEND_WAIT_MAX_US 10000000U
 #define ANT_MAX_COMMAND_LEN 16352U
 #define ANT_MAX_RESULT_LEN 16352U
 #define ANT_POLL_MS 10U
@@ -48,7 +54,10 @@ struct ant_queue {
 	__u8 descriptor_pad[48];
 	__u64 head, attempted, dropped;
 	__u32 fault;
-	__u8 producer_pad[36];
+	__u32 producer_reserved;
+	/* Sends that found the ring full and waited, and the total wait. */
+	__u64 waits, wait_ns;
+	__u8 producer_pad[16];
 	__u64 tail;
 	__u8 consumer_pad[56];
 } __attribute__((aligned(64)));
@@ -68,7 +77,10 @@ struct ant_control {
 	__u8 guest_pad[28];
 	__u64 host_heartbeat;
 	__u32 host_timeout_ms;
-	__u8 host_pad[316];
+	/* Zero: a send to a full ring drops. Otherwise a sender spins up to this
+	 * long (at most ANT_SEND_WAIT_MAX_US) while the host is live. */
+	__u32 send_wait_us;
+	__u8 host_pad[312];
 	struct ant_queue requests, responses;
 } __attribute__((aligned(64)));
 
diff --git a/kernel/antinomie/async.c b/kernel/antinomie/async.c
index 1b12199f9..cd71b91bf 100644
--- a/kernel/antinomie/async.c
+++ b/kernel/antinomie/async.c
@@ -144,7 +144,7 @@ static void await_room(void)
 {
 	unsigned long deadline = jiffies + msecs_to_jiffies(ANT_ASYNC_PACE_MS);
 
-	while (ant_send_room() < ANT_TELEMETRY_RING_SIZE / 2 &&
+	while (ant_send_room() < ant_ring_size() / 2 &&
 	       time_before(jiffies, deadline))
 		usleep_range(100, 200);
 }
diff --git a/kernel/antinomie/control_wire.h b/kernel/antinomie/control_wire.h
index 1dc9b5a89..c2afb0e78 100644
--- a/kernel/antinomie/control_wire.h
+++ b/kernel/antinomie/control_wire.h
@@ -11,7 +11,8 @@
  */
 #define ANTC_VERSION 1
 /* Contract revision of the guest's observable behaviour (native-schema-slices). */
-#define ANTC_REVISION 12
+/* Revision 13: transport ABI 8 (antinomie_ring_kib= ring size, host send wait). */
+#define ANTC_REVISION 13
 #define ANTC_HEADER_SIZE 8
 #define ANTC_UPLOAD_BEGIN 0x1001
 #define ANTC_UPLOAD_CHUNK 0x1002
diff --git a/kernel/antinomie/guest.c b/kernel/antinomie/guest.c
index 8e09fcd6c..de7a00220 100644
--- a/kernel/antinomie/guest.c
+++ b/kernel/antinomie/guest.c
@@ -1,12 +1,16 @@
 // SPDX-License-Identifier: GPL-2.0-only
 #include <linux/antinomie.h>
 #include <linux/cpu.h>
+#include <linux/delay.h>
 #include <linux/export.h>
 #include <linux/init.h>
 #include <linux/io.h>
 #include <linux/jiffies.h>
+#include <linux/log2.h>
 #include <linux/mm.h>
+#include <linux/sched/clock.h>
 #include <linux/random.h>
+#include <linux/rcupdate.h>
 #include <linux/rwsem.h>
 #include <linux/slab.h>
 #include <linux/workqueue.h>
@@ -17,7 +21,7 @@ struct ant_cpu {
 	void *data;
 };
 struct ant_producer {
-	u64 head, cached_tail, attempted, dropped;
+	u64 head, cached_tail, attempted, dropped, waits, wait_ns;
 	u32 index;
 	bool fault;
 };
@@ -27,6 +31,7 @@ static struct ant_control *control;
 static struct ant_queue *directory;
 static struct ant_region *region;
 static u32 queue_count;
+static u32 ring_size = ANT_TELEMETRY_RING_DEFAULT;
 static bool ready, broken;
 static struct workqueue_struct *worker;
 static void control_tick(struct work_struct *work);
@@ -46,11 +51,34 @@ static u64 last_heartbeat;
 static unsigned long host_seen;
 static bool host_attached;
 
+/* antinomie_ring_kib=<KiB>: per-CPU telemetry ring size, a power of two. */
+static int __init ant_ring_param(char *arg)
+{
+	u32 kib;
+
+	if (kstrtou32(arg, 0, &kib) || !is_power_of_2(kib) ||
+	    kib < ANT_TELEMETRY_RING_MIN / 1024 || kib > ANT_TELEMETRY_RING_MAX / 1024) {
+		pr_warn("antinomie: ignoring antinomie_ring_kib=%s\n", arg);
+		return 0;
+	}
+	ring_size = kib * 1024;
+	return 0;
+}
+early_param("antinomie_ring_kib", ant_ring_param);
+
+u32 ant_ring_size(void)
+{
+	return ring_size;
+}
+EXPORT_SYMBOL_GPL(ant_ring_size);
+
 int ant_send(const void *data, size_t payload_len)
 {
 	struct ant_producer *p;
 	struct ant_queue *q;
 	struct ant_message msg = { .payload_len = payload_len };
+	u64 waited_from = 0, now;
+	u32 wait_us;
 	int error;
 
 	if (!in_task()) return -EWOULDBLOCK;
@@ -65,7 +93,47 @@ int ant_send(const void *data, size_t payload_len)
 		error = -EPROTO;
 		goto drop;
 	}
-	error = ant_space(q, ANT_TELEMETRY_RING_SIZE, p->head, &p->cached_tail, ant_span(payload_len));
+	for (;;) {
+		error = ant_space(q, ring_size, p->head, &p->cached_tail, ant_span(payload_len));
+		if (error != -ENOSPC)
+			break;
+		/* The host may ask senders to wait for room instead of dropping,
+		 * bounded and only while it is live. A sender that may sleep
+		 * sleeps, so the control worker and other tasks keep running;
+		 * one in atomic context spins. */
+		wait_us = min_t(u32, READ_ONCE(control->send_wait_us), ANT_SEND_WAIT_MAX_US);
+		if (!wait_us || !READ_ONCE(control->live))
+			break;
+		now = local_clock();
+		if (!waited_from) {
+			waited_from = now;
+			p->waits++;
+		} else if (now - waited_from >= (u64)wait_us * NSEC_PER_USEC) {
+			break;
+		}
+		if (preempt_count() == 1 && !irqs_disabled() && !rcu_preempt_depth()) {
+			/* Only our own preempt_disable is held: sleep, then take this
+			 * CPU's producer again (the task may have moved). */
+			WRITE_ONCE(q->attempted, p->attempted);
+			WRITE_ONCE(q->waits, p->waits);
+			preempt_enable();
+			usleep_range(50, 100);
+			preempt_disable();
+			p = this_cpu_ptr(&producers);
+			q = &directory[p->index];
+			if (p->fault) {
+				error = -EPROTO;
+				break;
+			}
+			continue;
+		}
+		cpu_relax();
+	}
+	if (waited_from) {
+		p->wait_ns += local_clock() - waited_from;
+		WRITE_ONCE(q->waits, p->waits);
+		WRITE_ONCE(q->wait_ns, p->wait_ns);
+	}
 	if (error) {
 		if (error != -ENOSPC) {
 			p->fault = true;
@@ -73,7 +141,7 @@ int ant_send(const void *data, size_t payload_len)
 		}
 		goto drop;
 	}
-	ant_publish(q, cpus[p->index].data, ANT_TELEMETRY_RING_SIZE, &p->head, &msg, data);
+	ant_publish(q, cpus[p->index].data, ring_size, &p->head, &msg, data);
 	goto out;
 drop:
 	p->dropped++;
@@ -99,8 +167,8 @@ u32 ant_send_room(void)
 	p = this_cpu_ptr(&producers);
 	q = &directory[p->index];
 	tail = ANT_ACQ(&q->tail);
-	if (!p->fault && tail <= p->head && p->head - tail <= ANT_TELEMETRY_RING_SIZE)
-		room = ANT_TELEMETRY_RING_SIZE - (p->head - tail);
+	if (!p->fault && tail <= p->head && p->head - tail <= ring_size)
+		room = ring_size - (p->head - tail);
 	preempt_enable();
 	return room;
 }
@@ -271,12 +339,25 @@ static int __init ant_guest_init(void)
 	directory = region->directory;
 	cpus = kcalloc(queue_count, sizeof(*cpus), GFP_KERNEL);
 	if (!cpus) goto free_control;
+	/* Every ring has the same size; when memory is short, try a smaller one. */
+retry:
+	index = 0;
 	for_each_possible_cpu(cpu) {
-		cpus[index].pages = alloc_pages(GFP_KERNEL | __GFP_ZERO, get_order(ANT_TELEMETRY_RING_SIZE));
-		if (!cpus[index].pages) goto free_rings;
+		cpus[index].pages = alloc_pages(GFP_KERNEL | __GFP_ZERO | __GFP_NOWARN,
+						get_order(ring_size));
+		if (!cpus[index].pages) {
+			while (index) {
+				__free_pages(cpus[--index].pages, get_order(ring_size));
+				cpus[index].pages = NULL;
+			}
+			if (ring_size == ANT_TELEMETRY_RING_MIN)
+				goto free_rings;
+			ring_size /= 2;
+			goto retry;
+		}
 		cpus[index].data = page_address(cpus[index].pages);
 		directory[index].data_gpa = page_to_phys(cpus[index].pages);
-		directory[index].data_size = ANT_TELEMETRY_RING_SIZE;
+		directory[index].data_size = ring_size;
 		directory[index].cpu_id = cpu;
 		per_cpu(producers, cpu).index = index++;
 	}
@@ -307,7 +388,7 @@ static int __init ant_guest_init(void)
 	return 0;
 free_rings:
 	for (index = 0; index < queue_count; index++)
-		if (cpus[index].pages) __free_pages(cpus[index].pages, get_order(ANT_TELEMETRY_RING_SIZE));
+		if (cpus[index].pages) __free_pages(cpus[index].pages, get_order(ring_size));
 	kfree(cpus);
 free_control:
 	__free_pages(pages, get_order(ANT_CONTROL_SIZE));
-- 
2.53.0

