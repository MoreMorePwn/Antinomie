From 6db1ad81c98ea7ddf9fc16806103f137caba2e36 Mon Sep 17 00:00:00 2001
From: MikiMiku <jonathanirvinjo@gmail.com>
Date: Sun, 22 Nov 2026 01:12:29 +0700
Subject: [PATCH] antinomie: read at most 4096 entries of an io_submit array

The capture of io_submit read nr entries of the iocb pointer array at
entry, each with its iocb and buffer fields, about three records per
entry, and the array itself as one field of nr pointers. The kernel
handles at most the context's nr_events entries, and none for a
context that does not exist (it fails with EINVAL at once), neither of
which the recorder can know before the call. io_submit(bad_ctx, 1 <<
20, array) therefore cost millions of records under the never-drop
contract before the call could fail.

The recorder now reads at most ANT_AIO_SUBMIT_MAX (4096) entries: the
array field covers them, and one field arg2.iocbpp[4096] with the
status RESOURCE_EXHAUSTED and no bytes stands for the rest. An nr the
kernel rejects outright (negative, or more pointers than LONG_MAX
bytes) is recorded as before.

Found by the 0.9.0 bug hunt (K1-01). No contract change (revision 22).
---
 kernel/antinomie/async_capture.c | 26 +++++++++++++++++++++-----
 1 file changed, 21 insertions(+), 5 deletions(-)

diff --git a/kernel/antinomie/async_capture.c b/kernel/antinomie/async_capture.c
index 5887132e9..102a95234 100644
--- a/kernel/antinomie/async_capture.c
+++ b/kernel/antinomie/async_capture.c
@@ -21,6 +21,12 @@
 #define ANT_PBUF_COUNT 65535
 #define ANT_SQ_COUNT 32768
 #define ANT_CQ_COUNT (2 * ANT_SQ_COUNT)
+/* io_submit() entries read at entry. The kernel itself handles at most the
+ * context's nr_events of them and none for a context that does not exist,
+ * neither of which the recorder can know before the call; a larger nr is a
+ * prefix and one field for the rest.
+ */
+#define ANT_AIO_SUBMIT_MAX 4096U
 
 struct ant_uring_setup {
 	struct io_uring_params params;
@@ -76,15 +82,25 @@ static void signal_mask(struct ant_task *ctx, u8 arg, u64 address, u64 size)
 
 static void aio_submission(struct ant_task *ctx, const u64 a[6])
 {
-	u64 ptr, index, count = a[1];
+	u64 ptr, index, count = a[1], read;
 	struct iocb iocb;
 	char key[96];
 
-	array_field(ctx, 2, "arg2.iocbpp", ANT_LAYOUT("pointer[]"),
-		    a[2], count, sizeof(ptr), LONG_MAX / sizeof(ptr));
-	if ((s64)count < 0 || count > LONG_MAX / sizeof(ptr))
+	if ((s64)count < 0 || count > LONG_MAX / sizeof(ptr)) {
+		array_field(ctx, 2, "arg2.iocbpp", ANT_LAYOUT("pointer[]"),
+			    a[2], count, sizeof(ptr), LONG_MAX / sizeof(ptr));
 		return;
-	for (index = 0; index < count && !ant_capture_lost(ctx); index++) {
+	}
+	read = min_t(u64, count, ANT_AIO_SUBMIT_MAX);
+	array_field(ctx, 2, "arg2.iocbpp", ANT_LAYOUT("pointer[]"),
+		    a[2], read, sizeof(ptr), ANT_AIO_SUBMIT_MAX);
+	if (read < count && a[2] <= ULONG_MAX - read * sizeof(ptr)) {
+		/* The entries from index ANT_AIO_SUBMIT_MAX on, not read. */
+		scnprintf(key, sizeof(key), "arg2.iocbpp[%llu]", read);
+		bytes_field(ctx, 2, key, ANT_LAYOUT("pointer[]"), a[2] + read * sizeof(ptr),
+			    (count - read) * sizeof(ptr), ANT_RESOURCE_EXHAUSTED);
+	}
+	for (index = 0; index < read && !ant_capture_lost(ctx); index++) {
 		if (a[2] > ULONG_MAX - index * sizeof(ptr))
 			return;
 		scnprintf(key, sizeof(key), "arg2.iocbpp[%llu]", index);
-- 
