diff --git a/kernel/antinomie/abi.h b/kernel/antinomie/abi.h
index cd61acfca..d7a59c9ff 100644
--- a/kernel/antinomie/abi.h
+++ b/kernel/antinomie/abi.h
@@ -9,9 +9,23 @@
 #include "bootstrap_layout.h"
 #endif
 
-/* Wire profile: x86-64, little endian. Memory translation is supplied by host. */
+/* Memory translation is supplied by host. The layout below is the LP64 one
+ * (natural alignment, 64-bit fields at 8-byte offsets) on every guest.
+ * ABI 9: a 64-bit little-endian guest; every field is a native word.
+ * ABI 10: the same layout with every field little endian, for 32-bit and
+ * big-endian guests; the profile says how wide the moving words are.
+ */
 #define ANT_MAGIC 0x354e5441U
 #define ANT_ABI 9U
+#define ANT_ABI_WIRE_LE 10U
+/* ant_boot.profile bits. LP64 is always set. POS32 (ABI 10 only, a 32-bit
+ * guest, which has no 64-bit atomics): a 64-bit queue position, heartbeat,
+ * nonce, sequence or counter travels as its low 32 bits in the first four
+ * bytes of its field, the other four stay zero; positions are free-running
+ * modulo 2^32 and each reader widens one next to a position it knows (rings
+ * are at most ANT_TELEMETRY_RING_MAX, far below 2^31). */
+#define ANT_PROFILE_LP64 1U
+#define ANT_PROFILE_POS32 2U
 #define ANT_MAX_CPUS 256U
 #define ANT_CONTROL_SIZE 1048576U
 #define ANT_REQUEST_OFFSET 4096U
diff --git a/kernel/antinomie/control.c b/kernel/antinomie/control.c
index 4e5236c4f..431536737 100644
--- a/kernel/antinomie/control.c
+++ b/kernel/antinomie/control.c
@@ -4,6 +4,8 @@
 #include <linux/cred.h>
 #include <linux/tty.h>
 #include <linux/devpts_fs.h>
+#include <linux/elf.h>
+#include <linux/hex.h>
 #include <linux/file.h>
 #include <linux/fdtable.h>
 #include <linux/fs.h>
@@ -633,6 +635,34 @@ static int stop_run(const u8 *args, size_t args_len)
 	return error;
 }
 
+/* ARCH_INFO: what the host needs to decode this guest (control_wire.h). */
+static int arch_info(size_t args_len, u8 *reply, size_t capacity, size_t *reply_len)
+{
+	struct ant_dbg_caps caps;
+	const char *table_id;
+	u32 slots;
+
+	if (args_len != 8 || capacity < ANTC_ARCH_INFO_SIZE)
+		return -EINVAL;
+	memset(reply, 0, ANTC_ARCH_INFO_SIZE);
+	slots = ant_monitor_native_table(&table_id);
+	if (hex2bin(reply + 32, table_id, 32))
+		return -EIO;
+	ant_dbg_arch_caps(&caps);
+	put_unaligned_le32(ELF_ARCH, reply);
+	reply[4] = ELF_CLASS;
+	reply[5] = ELF_DATA == ELFDATA2MSB ? ANTC_ARCH_ENDIAN_BIG : ANTC_ARCH_ENDIAN_LITTLE;
+	put_unaligned_le16(PAGE_SHIFT, reply + 6);
+	put_unaligned_le32(ANT_ARCH_ABI_MASK, reply + 8);
+	put_unaligned_le32(ANT_ARCH_NR_BASE, reply + 12);
+	put_unaligned_le32(slots, reply + 16);
+	put_unaligned_le32(ANT_ARCH_USER_VA_BITS, reply + 20);
+	put_unaligned_le32(caps.flags, reply + 24);
+	strscpy_pad((char *)reply + 64, ANT_LAYOUT_SET, 32);
+	*reply_len = ANTC_ARCH_INFO_SIZE;
+	return 0;
+}
+
 static int command(const void *data, size_t args_len, void *reply,
 		   size_t capacity, size_t *reply_len, void *context)
 {
@@ -733,6 +763,8 @@ static int command(const void *data, size_t args_len, void *reply,
 		strscpy_pad((char *)reply + 88, init_utsname()->release, 64);
 		*reply_len = ANTC_INFO_SIZE;
 		return 0;
+	case ANTC_ARCH_INFO:
+		return arch_info(args_len, reply, capacity, reply_len);
 	case ANTC_SHUTDOWN:
 		if (args_len != 8)
 			return -EINVAL;
@@ -765,7 +797,7 @@ static int __init ant_control_init(void)
 		ANTC_DEBUG_REGS_WRITE, ANTC_DEBUG_MEM_READ, ANTC_DEBUG_MEM_WRITE,
 		ANTC_DEBUG_BP_SET, ANTC_DEBUG_BP_CLEAR, ANTC_DEBUG_AUXV, ANTC_DEBUG_CONFIG,
 		ANTC_DEBUG_EVENTS, ANTC_DEBUG_THREAD_CTL, ANTC_DEBUG_SESSIONS,
-		ANTC_DEBUG_BP_LIST, ANTC_TRACER_CAPS };
+		ANTC_DEBUG_BP_LIST, ANTC_TRACER_CAPS, ANTC_ARCH_INFO };
 	int i, error;
 
 	for (i = 0; i < ARRAY_SIZE(opcodes); i++) {
