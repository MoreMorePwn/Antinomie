 #define ANT_SESSION_MAX 64
 
@@ -43,6 +44,7 @@ struct ant_launch {
 	kuid_t uid;
 	kgid_t gid;
 	struct ant_specimen *specimen;
+	struct ant_core *core;
 };
 
 static LIST_HEAD(sessions);
@@ -239,6 +241,7 @@ static int launch_init(struct subprocess_info *info, struct cred *cred)
 	session->task_cookie = current->ant_cookie;
 	session->pgrp = get_task_pid(current, PIDTYPE_PGID);
 	ant_specimen_arm(launch->specimen);
+	ant_core_bind(launch->core, session->task_cookie);
 	return 0;
 }
 
@@ -248,6 +251,7 @@ static int execute(const u8 *args, size_t args_len, void *reply, size_t *reply_l
 	struct ant_session *session;
 	struct subprocess_info *info;
 	struct ant_specimen *specimen = NULL;
+	struct ant_core *core = NULL;
 	u32 argc, envc, flags;
 	size_t offset = 32;
 	int error;
@@ -255,7 +259,7 @@ static int execute(const u8 *args, size_t args_len, void *reply, size_t *reply_l
 	if (args_len < offset)
 		return -EINVAL;
 	flags = get_unaligned_le32(args + 4);
-	if (flags & ~ANTC_EXEC_SPECIMEN)
+	if (flags & ~(ANTC_EXEC_SPECIMEN | ANTC_EXEC_CORE))
 		return -EINVAL;
 	argc = get_unaligned_le32(args + 16);
 	envc = get_unaligned_le32(args + 20);
@@ -291,7 +295,7 @@ static int execute(const u8 *args, size_t args_len, void *reply, size_t *reply_l
 	if (error)
 		goto fail;
 	if (flags & ANTC_EXEC_SPECIMEN) {
-		if (args_len - offset != 8) {
+		if (args_len - offset != (flags & ANTC_EXEC_CORE ? 16 : 8)) {
 			error = -EINVAL;
 			goto fail;
 		}
@@ -300,6 +304,24 @@ static int execute(const u8 *args, size_t args_len, void *reply, size_t *reply_l
 		launch->specimen = specimen;
 		offset += 8;
 	}
+	if (flags & ANTC_EXEC_CORE) {
+		u32 max_size, timeout_ms;
+
+		if (args_len - offset != 8) {
+			error = -EINVAL;
+			goto fail;
+		}
+		max_size = get_unaligned_le32(args + offset);
+		timeout_ms = get_unaligned_le32(args + offset + 4);
+		if (!max_size || max_size > 64U * 1024 * 1024 ||
+		    !timeout_ms || timeout_ms > 5000) {
+			error = -EINVAL;
+			goto fail;
+		}
+		core = ant_core_create(max_size, timeout_ms);
+		launch->core = core;
+		offset += 8;
+	}
 	if (offset != args_len) {
 		error = -EINVAL;
 		goto fail;
@@ -321,6 +343,7 @@ static int execute(const u8 *args, size_t args_len, void *reply, size_t *reply_l
 	/* UMH owns and has freed launch regardless of success. */
 	if (error) {
 		ant_specimen_finish(specimen, false);
+		ant_core_finish_launch(core, false);
 		free_session(session);
 		return error;
 	}
@@ -335,10 +358,16 @@ static int execute(const u8 *args, size_t args_len, void *reply, size_t *reply_l
 		ant_specimen_reply(specimen, reply + 24);
 		*reply_len = 48;
 	}
+	if (flags & ANTC_EXEC_CORE) {
+		ant_core_reply(core, reply + *reply_len);
+		*reply_len += 24;
+	}
+	ant_core_finish_launch(core, true);
 	ant_specimen_finish(specimen, true);
 	return 0;
 fail:
 	ant_specimen_finish(specimen, false);
+	ant_core_finish_launch(core, false);
 	free_session(session);
 	free_launch(launch);
 	return error;
@@ -548,9 +577,13 @@ static int command(const void *data, size_t args_len, void *reply,
 	case ANTC_UPLOAD_CHUNK: case ANTC_UPLOAD_COMMIT: case ANTC_UPLOAD_ABORT:
 		return upload_command(opcode, args, args_len, reply, reply_len);
 	case ANTC_EXEC:
-		if (capacity < (get_unaligned_le32(args + 4) ? 48 : 24))
+		if (capacity < 24 +
+		    (get_unaligned_le32(args + 4) & ANTC_EXEC_SPECIMEN ? 24 : 0) +
+		    (get_unaligned_le32(args + 4) & ANTC_EXEC_CORE ? 24 : 0))
 			return -EMSGSIZE;
 		return execute(args, args_len, reply, reply_len);
+	case ANTC_CORE_STATUS: case ANTC_CORE_READ: case ANTC_CORE_RELEASE:
+		return ant_core_command(opcode, args, args_len, reply, capacity, reply_len);
 	case ANTC_ACQUIRE:
 		if (capacity < 24)
 			return -EMSGSIZE;
@@ -596,6 +629,7 @@ static int command(const void *data, size_t args_len, void *reply,
 	case ANTC_SHUTDOWN:
 		if (args_len != 8)
 			return -EINVAL;
+		ant_core_shutdown();
 		schedule_delayed_work(&power_off_work, msecs_to_jiffies(250));
 		return 0;
 	default:
@@ -615,7 +649,8 @@ static int __init ant_control_init(void)
 		ANTC_SIGNAL, ANTC_STOP_RUN, ANTC_RUN_STATUS, ANTC_STATS,
 		ANTC_SHUTDOWN, ANTC_ACQUIRE, ANTC_SPECIMEN_READ,
 		ANTC_SPECIMEN_RELEASE, ANTC_PROCESS_LIST, ANTC_CAPTURE_ATTACH,
-		ANTC_CAPTURE_ALL, ANTC_CAPTURE_STOP, ANTC_CAPTURE_STATUS };
+		ANTC_CAPTURE_ALL, ANTC_CAPTURE_STOP, ANTC_CAPTURE_STATUS,
+		ANTC_CORE_STATUS, ANTC_CORE_READ, ANTC_CORE_RELEASE };
 	int i, error;
 
 	for (i = 0; i < ARRAY_SIZE(opcodes); i++) {
diff --git a/kernel/antinomie/control_wire.h b/kernel/antinomie/control_wire.h
index 88996d014..3daec0c54 100644
--- a/kernel/antinomie/control_wire.h
+++ b/kernel/antinomie/control_wire.h
@@ -11,8 +11,8 @@
  */
 #define ANTC_VERSION 1
 /* Contract revision of the guest's observable behaviour (native-schema-slices). */
-/* Revision 14: transport ABI 9 (reattachment and snapshot resume mailbox). */
-#define ANTC_REVISION 14
+/* Revision 15: opt-in root-process ELF core acquisition at exit; ABI 9. */
+#define ANTC_REVISION 15
 #define ANTC_HEADER_SIZE 8
 #define ANTC_UPLOAD_BEGIN 0x1001
 #define ANTC_UPLOAD_CHUNK 0x1002
@@ -53,6 +53,21 @@
 #define ANTC_SPECIMEN_READ 0x1041
 #define ANTC_SPECIMEN_RELEASE 0x1042
 #define ANTC_EXEC_SPECIMEN 1
+#define ANTC_EXEC_CORE 2
+#define ANTC_CORE_STATUS 0x1060
+#define ANTC_CORE_READ 0x1061
+#define ANTC_CORE_RELEASE 0x1062
+#define ANTC_CORE_STATUS_SIZE 80
+#define ANTC_CORE_ARMED 1
+#define ANTC_CORE_COPYING 2
+#define ANTC_CORE_READY 3
+#define ANTC_CORE_PARTIAL 4
+#define ANTC_CORE_UNAVAILABLE 5
+#define ANTC_CORE_CANCELED 6
+#define ANTC_CORE_ROOT_ONLY 1
+#define ANTC_CORE_NATIVE_ELF64 2
+#define ANTC_CORE_FILTERED_MEMORY 4
+#define ANTC_CORE_COVERAGE_GAP 8
 #define ANTC_UPLOAD_OVERWRITE 1
 #define ANTC_UPLOAD_EXECUTABLE 2
 
@@ -66,7 +81,8 @@
  * COMMIT verifies total, fsyncs and closes; ABORT closes (partial destination
  * remains, visibly incomplete). No implicit execution.
  *
- * EXEC: header flags=0 or EXEC_SPECIMEN, u32 uid at 8, u32 gid at 12, u32 argc at 16,
+ * EXEC: header flags=EXEC_SPECIMEN|EXEC_CORE (both optional), uid at8,
+ * gid at12, argc at16,
  * u32 envc at 20, u32 path_len at 24, u32 cwd_len at 28; path then cwd
  * at 32, followed by argc then envc entries, each u32 byte_len + bytes.
  * argc >= 1, explicit argv[0], absolute executable and cwd, no interior NUL.
@@ -76,6 +92,29 @@
  * EXEC_SPECIMEN appends u32 max_size, u32 timeout_ms after argv/env.
  * Its reply appends the 24-byte acquisition reply to the normal 24 bytes.
  * Acquisition failure never changes the execution result.
+ * EXEC_CORE appends u32 max_size (1..64MiB), u32 timeout_ms (1..5000),
+ * after the optional specimen trailer. Reply appends u64 core_id, u64
+ * max_size, i32 status, u32 reserved=0 after optional specimen reply.
+ * Arm failure has id/size=0 and negative errno; execution still succeeds.
+ * Only the launched root thread group is eligible, native Linux ELF64.
+ * CORE_STATUS: header flags=0, u64 id at 8, 16 bytes total. Reply80:
+ * u64 id/root_cookie/start_ns/finish_ns/size/expected_size at 0/8/16/24/32/40,
+ * u32 state at48, i32 status at52, i32 original wait_status at56,
+ * u32 signal/flags/tgid/thread_count/reserved=0 at60/64/68/72/76.
+ * Expected size is zero if complete ELF program headers are unavailable.
+ * States: ARMED/COPYING/READY/PARTIAL/UNAVAILABLE/CANCELED. READY has
+ * status0; PARTIAL retains a prefix with negative errno. Flags identify
+ * root-only, native ELF64, Linux coredump_filter and coverage limitations.
+ * CORE_READ has the same request/reply layout and bound as SPECIMEN_READ.
+ * Only READY/PARTIAL data is readable; it is immutable.
+ * CORE_RELEASE: header flags=0, u64 id at8; removes/cancels the handle.
+ * Four handles, 128MiB global reservation; terminal handles expire after
+ * 180s idle. Armed handles require release; no automatic cancellation of
+ * a long running process. Release while copying retains its reservation
+ * until capture unwinds. Unknown ids return -ESRCH; ids/root cookies must
+ * be revalidated across snapshot epochs. No side-effect retry guarantee.
+ * Timeout bounds serialization, not Linux thread rendezvous/page faults.
+ * Linux memory filtering applies, so not every mapped byte is included.
  *
  * ACQUIRE: header flags=0, uid at 8, gid at 12, u32 path_len at 16,
  * reserved=0 at 20, absolute path at 24, then u32 max_size, timeout_ms.
diff --git a/kernel/antinomie/process_core.c b/kernel/antinomie/process_core.c
new file mode 100644
index 000000000..3636505a7
--- /dev/null
+++ b/kernel/antinomie/process_core.c
@@ -0,0 +1,481 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/antinomie_monitor.h>
+#include <linux/anon_inodes.h>
+#include <linux/coredump.h>
+#include <linux/elf.h>
+#include <linux/file.h>
+#include <linux/jiffies.h>
+#include <linux/mutex.h>
+#include <linux/overflow.h>
+#include <linux/refcount.h>
+#include <linux/sched/signal.h>
+#include <linux/slab.h>
+#include <linux/timekeeping.h>
+#include <linux/uio.h>
+#include <linux/unaligned.h>
+#include <linux/vmalloc.h>
+#include <linux/workqueue.h>
+#include "control_wire.h"
+#include "process_core.h"
+#include "run.h"
+
+#define ANT_CORE_MAX (64U * 1024 * 1024)
+#define ANT_CORE_TOTAL (128U * 1024 * 1024)
+#define ANT_CORE_HANDLES 4
+#define ANT_CORE_IDLE (180 * HZ)
+
+struct ant_core {
+	struct list_head node;
+	refcount_t refs;
+	void *data;
+	u64 id, root_cookie, start_ns, finish_ns, expected_size;
+	size_t size, max_size;
+	unsigned long touched, deadline;
+	u32 timeout_ms, state, flags, tgid, thread_count;
+	int status, wait_status, signal, sink_error;
+	bool canceled;
+};
+
+/* Command worker, exiting processes and expiry share this lock. Allocation,
+ * core rendezvous, memory copy and final release never run while it is held.
+ * A retained-list reference and each active caller own independent references.
+ */
+static DEFINE_MUTEX(core_lock);
+static LIST_HEAD(cores);
+static size_t reserved_size;
+static unsigned int handle_count;
+static u64 next_id;
+
+static void core_put(struct ant_core *core)
+{
+	size_t reserved;
+
+	if (IS_ERR_OR_NULL(core) || !refcount_dec_and_test(&core->refs))
+		return;
+	reserved = core->max_size;
+	vfree(core->data);
+	kfree(core);
+	mutex_lock(&core_lock);
+	reserved_size -= reserved;
+	handle_count--;
+	mutex_unlock(&core_lock);
+}
+
+static struct ant_core *find_core(u64 id)
+{
+	struct ant_core *core;
+
+	list_for_each_entry(core, &cores, node)
+		if (core->id == id)
+			return core;
+	return NULL;
+}
+
+static void expire_cores(struct work_struct *work);
+static DECLARE_DELAYED_WORK(core_expiry_work, expire_cores);
+
+static void expire_cores(struct work_struct *work)
+{
+	struct ant_core *core, *next;
+	LIST_HEAD(expired);
+	bool remaining;
+
+	mutex_lock(&core_lock);
+	list_for_each_entry_safe(core, next, &cores, node)
+		if (core->state >= ANTC_CORE_READY &&
+		    time_after_eq(jiffies, core->touched + ANT_CORE_IDLE))
+			list_move_tail(&core->node, &expired);
+	remaining = !list_empty(&cores);
+	mutex_unlock(&core_lock);
+	list_for_each_entry_safe(core, next, &expired, node) {
+		list_del_init(&core->node);
+		core_put(core);
+	}
+	if (remaining)
+		schedule_delayed_work(&core_expiry_work, 30 * HZ);
+}
+
+struct ant_core *ant_core_create(u32 max_size, u32 timeout_ms)
+{
+	struct ant_core *core;
+
+	if (!max_size || max_size > ANT_CORE_MAX ||
+	    !timeout_ms || timeout_ms > 5000)
+		return ERR_PTR(-EINVAL);
+	core = kzalloc(sizeof(*core), GFP_KERNEL);
+	if (!core)
+		return ERR_PTR(-ENOMEM);
+	mutex_lock(&core_lock);
+	if (handle_count >= ANT_CORE_HANDLES ||
+	    max_size > ANT_CORE_TOTAL - reserved_size || next_id == U64_MAX) {
+		mutex_unlock(&core_lock);
+		kfree(core);
+		return ERR_PTR(-ENOSPC);
+	}
+	handle_count++;
+	reserved_size += max_size;
+	core->id = ++next_id;
+	mutex_unlock(&core_lock);
+	core->max_size = max_size;
+	refcount_set(&core->refs, 1);
+	INIT_LIST_HEAD(&core->node);
+	core->data = vzalloc(max_size);
+	if (!core->data) {
+		core_put(core);
+		return ERR_PTR(-ENOMEM);
+	}
+	core->timeout_ms = timeout_ms;
+	core->state = ANTC_CORE_ARMED;
+	core->flags = ANTC_CORE_ROOT_ONLY | ANTC_CORE_FILTERED_MEMORY;
+	core->touched = jiffies;
+	mutex_lock(&core_lock);
+	refcount_inc(&core->refs);
+	list_add_tail(&core->node, &cores);
+	mutex_unlock(&core_lock);
+	schedule_delayed_work(&core_expiry_work, 30 * HZ);
+	return core;
+}
+
+void ant_core_bind(struct ant_core *core, u64 root_cookie)
+{
+	if (IS_ERR_OR_NULL(core))
+		return;
+	mutex_lock(&core_lock);
+	core->root_cookie = root_cookie;
+	core->tgid = task_tgid_nr(current);
+	mutex_unlock(&core_lock);
+	ant_run_core_arm(root_cookie, true);
+}
+
+void ant_core_reply(struct ant_core *core, void *reply)
+{
+	memset(reply, 0, 24);
+	if (IS_ERR_OR_NULL(core)) {
+		put_unaligned_le32(core ? PTR_ERR(core) : -ENOMEM, reply + 16);
+		return;
+	}
+	put_unaligned_le64(core->id, reply);
+	put_unaligned_le64(core->max_size, reply + 8);
+}
+
+void ant_core_finish_launch(struct ant_core *core, bool executed)
+{
+	bool removed = false;
+
+	if (IS_ERR_OR_NULL(core))
+		return;
+	if (!executed) {
+		mutex_lock(&core_lock);
+		WRITE_ONCE(core->canceled, true);
+		if (!list_empty(&core->node)) {
+			list_del_init(&core->node);
+			removed = true;
+		}
+		mutex_unlock(&core_lock);
+	}
+	if (!executed)
+		ant_run_core_arm(core->root_cookie, false);
+	if (removed)
+		core_put(core);
+	core_put(core);
+}
+
+/* This file is private to one exiting process. Only cancellation is shared;
+ * terminal publication under core_lock makes data/size immutable to readers.
+ */
+static int sink_check(struct ant_core *core)
+{
+	int error = READ_ONCE(core->canceled) ? -ECANCELED :
+		time_after_eq(jiffies, core->deadline) ? -ETIMEDOUT : 0;
+
+	if (error)
+		core->sink_error = error;
+	return error;
+}
+
+static ssize_t core_write_iter(struct kiocb *iocb, struct iov_iter *from)
+{
+	struct ant_core *core = iocb->ki_filp->private_data;
+	size_t count = iov_iter_count(from);
+	loff_t pos = iocb->ki_pos;
+	int error = sink_check(core);
+
+	if (error)
+		return error;
+	if (pos < 0 || pos > core->max_size || count > core->max_size - pos) {
+		core->sink_error = -EFBIG;
+		return -EFBIG;
+	}
+	if (copy_from_iter(core->data + pos, count, from) != count) {
+		core->sink_error = -EFAULT;
+		return -EFAULT;
+	}
+	iocb->ki_pos += count;
+	core->size = max_t(size_t, core->size, iocb->ki_pos);
+	return count;
+}
+
+static loff_t core_llseek(struct file *file, loff_t offset, int whence)
+{
+	struct ant_core *core = file->private_data;
+	loff_t pos;
+	int error = sink_check(core);
+
+	if (error)
+		return error;
+	if (whence == SEEK_CUR) {
+		if (check_add_overflow(file->f_pos, offset, &pos))
+			return -EOVERFLOW;
+	} else if (whence == SEEK_SET) {
+		pos = offset;
+	} else {
+		return -EINVAL;
+	}
+	if (pos < 0 || pos > core->max_size) {
+		core->sink_error = -EFBIG;
+		return -EFBIG;
+	}
+	file->f_pos = pos;
+	return pos;
+}
+
+static const struct file_operations core_fops = {
+	.write_iter = core_write_iter,
+	.llseek = core_llseek,
+};
+
+static u64 core_expected_size(struct ant_core *core)
+{
+	struct elf64_hdr *elf = core->data;
+	struct elf64_phdr *ph;
+	u64 size = 0, extent;
+	unsigned int i;
+
+	if (core->size < sizeof(*elf) ||
+	    memcmp(elf->e_ident, ELFMAG, SELFMAG) ||
+	    elf->e_ident[EI_CLASS] != ELFCLASS64 ||
+	    elf->e_ident[EI_DATA] != ELFDATA2LSB ||
+	    elf->e_type != ET_CORE || elf->e_machine != EM_X86_64 ||
+	    elf->e_phentsize != sizeof(*ph) || elf->e_phnum == PN_XNUM ||
+	    elf->e_phoff > core->size ||
+	    elf->e_phnum > (core->size - elf->e_phoff) / sizeof(*ph))
+		return 0;
+	ph = core->data + elf->e_phoff;
+	for (i = 0; i < elf->e_phnum; i++) {
+		if (check_add_overflow(ph[i].p_offset, ph[i].p_filesz, &extent))
+			return 0;
+		size = max(size, extent);
+	}
+	return size;
+}
+
+/* Count complete native PRSTATUS notes actually retained, rather than claim
+ * that the live-thread count sampled before rendezvous was fully recovered.
+ */
+static u32 core_thread_count(struct ant_core *core)
+{
+	struct elf64_hdr *elf = core->data;
+	struct elf64_phdr *ph;
+	u32 count = 0;
+	unsigned int i;
+
+	if (!core->expected_size)
+		return 0;
+	ph = core->data + elf->e_phoff;
+	for (i = 0; i < elf->e_phnum; i++) {
+		u64 offset = ph[i].p_offset, end;
+
+		if (ph[i].p_type != PT_NOTE || offset > core->size ||
+		    check_add_overflow(offset, ph[i].p_filesz, &end))
+			continue;
+		end = min_t(u64, end, core->size);
+		while (offset <= end && sizeof(struct elf_note) <= end - offset) {
+			struct elf_note *note = core->data + offset;
+			u64 name_size = ALIGN((u64)note->n_namesz, 4);
+			u64 data_size = ALIGN((u64)note->n_descsz, 4);
+
+			offset += sizeof(*note);
+			if (name_size > end - offset ||
+			    data_size > end - offset - name_size)
+				break;
+			if (note->n_type == NT_PRSTATUS && note->n_namesz == 5 &&
+			    !memcmp(core->data + offset, "CORE", 5))
+				count++;
+			offset += name_size + data_size;
+		}
+	}
+	return count;
+}
+
+bool ant_monitor_core_exit(int wait_status, const kernel_siginfo_t *siginfo)
+{
+	struct ant_core *core, *selected = NULL;
+	struct file *file;
+	u32 thread_count;
+	int error;
+
+	if (!current->ant_root_process || !current->mm)
+		return false;
+	mutex_lock(&core_lock);
+	list_for_each_entry(core, &cores, node)
+		if (core->root_cookie == current->ant_root_cookie &&
+		    core->state == ANTC_CORE_ARMED && !core->canceled) {
+			selected = core;
+			refcount_inc(&core->refs);
+			core->state = ANTC_CORE_COPYING;
+			core->start_ns = ktime_get_ns();
+			core->wait_status = wait_status;
+			core->signal = siginfo ? siginfo->si_signo : wait_status & 0x7f;
+			core->tgid = task_tgid_nr(current);
+			core->thread_count = get_nr_threads(current);
+			break;
+		}
+	mutex_unlock(&core_lock);
+	if (!selected)
+		return false;
+	core = selected;
+	core->deadline = jiffies + msecs_to_jiffies(core->timeout_ms);
+	file = anon_inode_getfile("antinomie-core", &core_fops, core, O_RDWR);
+	if (IS_ERR(file)) {
+		error = PTR_ERR(file);
+	} else {
+		/* anon_inode_getfile recognizes llseek and write_iter itself. */
+		error = ant_coredump_to_file(file, core->max_size, wait_status, siginfo,
+					     core->deadline);
+		fput(file);
+	}
+	ant_run_core_arm(core->root_cookie, false);
+	core->expected_size = core_expected_size(core);
+	thread_count = core_thread_count(core);
+	if (core->sink_error)
+		error = core->sink_error;
+	else if (time_after_eq(jiffies, core->deadline))
+		error = -ETIMEDOUT;
+	if (!error && (!core->expected_size || core->size < core->expected_size))
+		error = -EFBIG;
+	mutex_lock(&core_lock);
+	if (core->expected_size)
+		core->flags |= ANTC_CORE_NATIVE_ELF64;
+	if (thread_count < core->thread_count)
+		core->flags |= ANTC_CORE_COVERAGE_GAP;
+	core->thread_count = thread_count;
+	core->status = error;
+	core->finish_ns = ktime_get_ns();
+	core->touched = jiffies;
+	core->state = core->canceled ? ANTC_CORE_CANCELED :
+		error ? (core->size ? ANTC_CORE_PARTIAL : ANTC_CORE_UNAVAILABLE) :
+		ANTC_CORE_READY;
+	if (error)
+		core->flags |= ANTC_CORE_COVERAGE_GAP;
+	mutex_unlock(&core_lock);
+	core_put(core);
+	return true;
+}
+
+int ant_core_command(u32 opcode, const u8 *args, size_t args_len,
+		     void *reply, size_t capacity, size_t *reply_len)
+{
+	struct ant_core *core;
+	u64 id, offset;
+	u32 count;
+	int error = 0;
+	bool removed = false;
+
+	if (args_len != (opcode == ANTC_CORE_READ ? 32 : 16) ||
+	    get_unaligned_le32(args + 4))
+		return -EINVAL;
+	id = get_unaligned_le64(args + 8);
+	if (!id)
+		return -EINVAL;
+	mutex_lock(&core_lock);
+	core = find_core(id);
+	if (!core) {
+		error = -ESRCH;
+		goto unlock;
+	}
+	refcount_inc(&core->refs);
+	core->touched = jiffies;
+	if (opcode == ANTC_CORE_RELEASE) {
+		WRITE_ONCE(core->canceled, true);
+		list_del_init(&core->node);
+		removed = true;
+	} else if (opcode == ANTC_CORE_STATUS) {
+		if (capacity < ANTC_CORE_STATUS_SIZE) {
+			error = -EMSGSIZE;
+			goto put;
+		}
+		memset(reply, 0, ANTC_CORE_STATUS_SIZE);
+		put_unaligned_le64(core->id, reply);
+		put_unaligned_le64(core->root_cookie, reply + 8);
+		put_unaligned_le64(core->start_ns, reply + 16);
+		put_unaligned_le64(core->finish_ns, reply + 24);
+		/* Never race a writer by exposing its mutable length/metadata. */
+		if (core->state >= ANTC_CORE_READY) {
+			put_unaligned_le64(core->size, reply + 32);
+			put_unaligned_le64(core->expected_size, reply + 40);
+		}
+		put_unaligned_le32(core->state, reply + 48);
+		put_unaligned_le32(core->status, reply + 52);
+		put_unaligned_le32(core->wait_status, reply + 56);
+		put_unaligned_le32(core->signal, reply + 60);
+		put_unaligned_le32(core->flags, reply + 64);
+		put_unaligned_le32(core->tgid, reply + 68);
+		put_unaligned_le32(core->thread_count, reply + 72);
+		*reply_len = ANTC_CORE_STATUS_SIZE;
+	} else if (opcode == ANTC_CORE_READ) {
+		offset = get_unaligned_le64(args + 16);
+		count = get_unaligned_le32(args + 24);
+		if (get_unaligned_le32(args + 28) || !count || count > 16328 ||
+		    capacity < 24 || count > capacity - 24) {
+			error = -EINVAL;
+			goto put;
+		}
+		if (core->state != ANTC_CORE_READY && core->state != ANTC_CORE_PARTIAL) {
+			error = -EAGAIN;
+			goto put;
+		}
+		if (offset > core->size) {
+			error = -EINVAL;
+			goto put;
+		}
+		count = min_t(u64, count, core->size - offset);
+		put_unaligned_le64(offset, reply);
+		put_unaligned_le64(core->size, reply + 8);
+		put_unaligned_le32(count, reply + 16);
+		put_unaligned_le32(0, reply + 20);
+		/* Retained caller reference pins the immutable terminal buffer. */
+		mutex_unlock(&core_lock);
+		memcpy(reply + 24, core->data + offset, count);
+		*reply_len = 24 + count;
+		core_put(core);
+		return 0;
+	}
+put:
+	mutex_unlock(&core_lock);
+	if (removed) {
+		ant_run_core_arm(core->root_cookie, false);
+		core_put(core);
+	}
+	core_put(core);
+	return error;
+unlock:
+	mutex_unlock(&core_lock);
+	return error;
+}
+
+void ant_core_shutdown(void)
+{
+	struct ant_core *core, *next;
+	LIST_HEAD(canceled);
+
+	mutex_lock(&core_lock);
+	list_for_each_entry(core, &cores, node)
+		WRITE_ONCE(core->canceled, true);
+	list_splice_init(&cores, &canceled);
+	mutex_unlock(&core_lock);
+	list_for_each_entry_safe(core, next, &canceled, node) {
+		ant_run_core_arm(core->root_cookie, false);
+		list_del_init(&core->node);
+		core_put(core);
+	}
+}
