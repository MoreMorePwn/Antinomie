@@ -24,6 +25,8 @@ u64 ant_monitor_cookie(struct task_struct *task);
 u64 ant_monitor_stream_id(void);
 void ant_monitor_exec(void);
 void ant_monitor_specimen_exec(struct file *file);
+bool ant_monitor_core_armed(struct task_struct *task);
+bool ant_monitor_core_exit(int wait_status, const struct kernel_siginfo *siginfo);
 void ant_monitor_task_exit(bool group_dead);
 void ant_monitor_release(struct task_struct *task);
 int ant_monitor_launch(const char *path, char **argv, char **envp);
@@ -74,6 +77,15 @@ static inline void ant_monitor_fork(struct task_struct *child) {}
 static inline void ant_monitor_fork_prepare(struct task_struct *child) {}
 static inline void ant_monitor_exec(void) {}
 static inline void ant_monitor_specimen_exec(struct file *file) {}
+static inline bool ant_monitor_core_armed(struct task_struct *task)
+{
+	return false;
+}
+static inline bool ant_monitor_core_exit(int wait_status,
+					 const struct kernel_siginfo *siginfo)
+{
+	return false;
+}
 static inline void ant_monitor_task_exit(bool group_dead) {}
 static inline void ant_monitor_release(struct task_struct *task) {}
 static inline struct ant_async *ant_monitor_async_begin(u8 system, u32 opcode,
