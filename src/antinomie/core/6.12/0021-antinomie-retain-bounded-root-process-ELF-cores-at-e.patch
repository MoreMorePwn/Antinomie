 include/linux/antinomie_monitor.h |  12 +
 include/linux/coredump.h          |  15 +
 kernel/antinomie/Makefile         |   1 +
 kernel/antinomie/control.c        |  43 ++-
 kernel/antinomie/control_wire.h   |  45 ++-
 kernel/antinomie/process_core.c   | 481 ++++++++++++++++++++++++++++++
 kernel/antinomie/process_core.h   |  14 +
 kernel/antinomie/run.c            |  24 ++
 kernel/antinomie/run.h            |   1 +
 kernel/exit.c                     |   4 +
 kernel/signal.c                   |   9 +-
 12 files changed, 712 insertions(+), 8 deletions(-)
 create mode 100644 kernel/antinomie/process_core.c
