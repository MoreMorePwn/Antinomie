 };
 
 extern unsigned int core_file_note_size_limit;
@@ -44,6 +47,10 @@ extern int dump_align(struct coredump_params *cprm, int align);
 int dump_user_range(struct coredump_params *cprm, unsigned long start,
 		    unsigned long len);
 extern void do_coredump(const kernel_siginfo_t *siginfo);
+#ifdef CONFIG_ANTINOMIE
+int ant_coredump_to_file(struct file *file, unsigned long limit, int wait_status,
+			 const kernel_siginfo_t *siginfo, unsigned long deadline);
+#endif
 
 /*
  * Logging for the coredump code, ratelimited.
@@ -64,6 +71,14 @@ extern void do_coredump(const kernel_siginfo_t *siginfo);
 
 #else
 static inline void do_coredump(const kernel_siginfo_t *siginfo) {}
+#ifdef CONFIG_ANTINOMIE
+static inline int ant_coredump_to_file(struct file *file, unsigned long limit,
+				     int wait_status, const kernel_siginfo_t *siginfo,
+				     unsigned long deadline)
+{
+	return -EOPNOTSUPP;
+}
+#endif
 
 #define coredump_report(...)
 #define coredump_report_failure(...)
