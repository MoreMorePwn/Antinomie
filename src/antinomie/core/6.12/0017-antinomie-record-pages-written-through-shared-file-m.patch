diff --git a/kernel/antinomie/control_wire.h b/kernel/antinomie/control_wire.h
index 56aa302..3a0c794 100644
--- a/kernel/antinomie/control_wire.h
+++ b/kernel/antinomie/control_wire.h
@@ -14,8 +14,9 @@
 /* Revision 15: opt-in root-process ELF core acquisition at exit; ABI 9. */
 /* Revision 17: kernel-native guest resource sample (RESOURCES), and the
  * credential and file-hash lifecycle records described below. */
-/* Revision 18: where reads and writes of seekable files happened, and the
- * operands of in-kernel copies and allocations (file.position, file.copy). */
+/* Revision 18: where reads and writes of seekable files happened, the
+ * operands of in-kernel copies and allocations (file.position, file.copy), and
+ * pages written through shared file mappings (lifecycle.file_mapped). */
 #define ANTC_REVISION 18
 #define ANTC_HEADER_SIZE 8
 #define ANTC_UPLOAD_BEGIN 0x1001
@@ -389,6 +390,57 @@
 #define ANTC_FILECOPY_DATA 4
 #define ANTC_FILECOPY_DATA_CUT 8
 #define ANTC_FILECOPY_DATA_MAX 1048576
+/* lifecycle.file_mapped, layout "antinomie.filemap/1", 96 bytes (revision 18,
+ * additive): pages of a regular file written through a shared mapping, which
+ * no system call carries, with their content when the kernel took note of the
+ * stores. Each record is one range of one file, followed by the field
+ * lifecycle.file_mapped.data (encoding 1, declared extent = the range's
+ * length) when the guest copied bytes of it. The records of one call are one
+ * lifecycle event (phase 3) of that call, published just before its exit;
+ * for an address space dropped when the task exits, just before
+ * lifecycle.task_exit, under the task's last call.
+ * u8 cause at 0: WRITEBACK, the call wrote the pages back to the file (msync,
+ * fsync, fdatasync, sync_file_range, sync, syncfs, an O_DIRECT transfer or
+ * fadvise that flushed them first), and a mapping's page table entry for them
+ * was dirty or writable; UNMAP, the call removed a mapping whose entry was
+ * dirty (munmap, mremap, a MAP_FIXED mapping over it, madvise, a hole punch
+ * of the file, exec, or exit). The bytes are the page at that moment: every
+ * store in between is not seen, only the result. A host applies a call's
+ * records before the call's own change to the file: a copy already holds what
+ * the call wrote to the page before it was copied (an O_SYNC write), and a
+ * change made after the copy (the zeros of a hole punch) is the call's own.
+ * u8 flags at 1 (DATA: the data field follows this record), u8 cut at 2
+ * (why bytes of the range are missing from the data field: BUDGET, the call
+ * had copied ANTC_FILEMAP_DATA_MAX bytes already; MEMORY, the guest could not
+ * get a page for the copy; zero: none missing), zero at 3, u32 page size at 4,
+ * u64 offset at 8 (file offset of the range's first page), u64 length at 16
+ * (bytes of the file in the range: whole pages, the last clipped to the file
+ * size; a page past the end of the file is not recorded), u64 carried at 24
+ * (bytes of the data field, from the offset on; less than length when cut),
+ * the file at 32 (u64 dev, u64 ino, u32 generation, u32 mode, as in
+ * file.copy), u64 file size at 56 (i_size when the first page was copied),
+ * u64 time at 64 (ktime_get_ns() when the first page was copied), u64 write
+ * order at 72 (as for file.position: taken while no write to the file was in
+ * progress, so the range holds every write with a lower number and no part
+ * of one with a higher number; zero when a write was in progress), u16 index
+ * at 80 and u16 count at 82 (this record's place among the call's records),
+ * u32 lost at 84 (pages the guest saw since the previous record and could not
+ * list at all: no memory for the list), u64 unlisted at 88 (pages of this
+ * call past its ANTC_FILEMAP_RANGES records: counted, not listed).
+ * Only tasks the recorder follows are seen, and only pages they saw: a page the
+ * kernel's background writeback wrote while the mapping stayed is clean when
+ * the mapping goes, and is not recorded unless stored to again. Mappings of
+ * kernel-internal files (shared anonymous memory, System V shared memory,
+ * memfd) and of hugetlbfs files are not recorded.
+ */
+#define ANTC_FILEMAP_SIZE 96
+#define ANTC_FILEMAP_WRITEBACK 1
+#define ANTC_FILEMAP_UNMAP 2
+#define ANTC_FILEMAP_DATA 1
+#define ANTC_FILEMAP_CUT_BUDGET 1
+#define ANTC_FILEMAP_CUT_MEMORY 2
+#define ANTC_FILEMAP_DATA_MAX 4194304
+#define ANTC_FILEMAP_RANGES 64
 #define ANTC_UPLOAD_OVERWRITE 1
 #define ANTC_UPLOAD_EXECUTABLE 2
 
diff --git a/kernel/antinomie/filemap.c b/kernel/antinomie/filemap.c
new file mode 100644
index 0000000..0aaf4df
--- /dev/null
+++ b/kernel/antinomie/filemap.c
@@ -0,0 +1,318 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Pages of a regular file written through a shared mapping.
+ *
+ * A store into a writable shared mapping of a file makes no system call: the
+ * page in the page cache changes, its page table entry turns dirty, and the
+ * file system writes the page back some time later. What the host can be
+ * given is each page's state at the moments the kernel itself takes note of
+ * the stores, which are the moments the page table entry's dirty bit is
+ * consumed:
+ *
+ * - writeback (ANTC_FILEMAP_WRITEBACK): a traced call writes the page back
+ *   to the file (msync, fsync, sync, an O_DIRECT transfer that flushes the
+ *   cache first). folio_clear_dirty_for_io() write-protects and cleans the
+ *   mappings' entries, and folio_mkclean() says whether one of them was
+ *   dirty or writable: the page was written through a mapping since its last
+ *   writeback. The folio is locked and no mapping can write it, so the copy
+ *   is what goes to the file.
+ * - unmap (ANTC_FILEMAP_UNMAP): a traced task removes a mapping whose entry
+ *   is dirty (munmap, mremap, a MAP_FIXED mapping over it, madvise, a hole
+ *   punch, exec or exit dropping the address space). The dirty bit moves to
+ *   the page, which the file system writes back later; the copy is the page
+ *   as the mapping left it.
+ *
+ * Every architecture keeps that dirty bit (in hardware, or by a write fault),
+ * and every file system has it, tmpfs included, which has no page_mkwrite and
+ * is never written back; so the same code serves them all. A page_mkwrite
+ * hook would see the first store after each writeback, before it lands, and
+ * nothing on tmpfs. Every store in between is not seen: two stores to one
+ * page before its writeback leave only the second.
+ *
+ * Not seen: a page the kernel's background writeback (the flusher, by
+ * default some 30 s after the store) wrote back while the mapping stayed,
+ * and that the program did not store to again before it removed the mapping:
+ * that writeback runs outside the program's calls and cleans the entry, so
+ * the unmap finds it clean. A page stored to by a process that is not
+ * followed is seen only when a traced call writes it back. Mappings of
+ * kernel-internal files (shared anonymous memory, System V shared memory,
+ * memfd, AIO rings) are not files of the run; mappings of hugetlbfs files
+ * are removed by other code and are not seen.
+ *
+ * Copies are made where the kernel sees the page, without sleeping (under the
+ * page table lock for an unmap, the folio lock for a writeback): each page goes
+ * to a page of its own from a nonblocking allocation, at most
+ * ANTC_FILEMAP_DATA_MAX bytes per call. Past it, or when no page can be had,
+ * the range is still recorded, with the reason its bytes are missing. At most
+ * ANTC_FILEMAP_RANGES ranges are recorded per call; pages past them are
+ * counted.
+ *
+ * Write order: each range takes a number from the counter writes take theirs
+ * from (fileops.c), and every page of the range is copied while holding the
+ * file's inode lock shared, taken with a trylock. A write takes its number and
+ * applies its bytes under that lock held exclusively, so a write with a lower
+ * number is complete in the copy, and a write with a higher number either
+ * came after the copy or is replayed over bytes the copy already holds. When
+ * the trylock fails a write is in progress: the page goes to a range without
+ * a number.
+ */
+#include <linux/antinomie_monitor.h>
+#include <linux/atomic.h>
+#include <linux/bvec.h>
+#include <linux/fs.h>
+#include <linux/highmem.h>
+#include <linux/kdev_t.h>
+#include <linux/ktime.h>
+#include <linux/list.h>
+#include <linux/minmax.h>
+#include <linux/mm.h>
+#include <linux/pagemap.h>
+#include <linux/rwsem.h>
+#include <linux/sched.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/uio.h>
+#include <linux/unaligned.h>
+
+#include "control_wire.h"
+#include "fileops.h"
+#include "filemap.h"
+
+/* One record: a run of contiguous pages of one file, seen for one cause. */
+struct ant_filemap_range {
+	u64 dev, ino, offset, len, carried, size, time_ns, order;
+	u32 generation, mode;
+	u8 cause, cut;
+};
+
+/* What a task saw during one call (or its exit). Owned by the task's
+ * recorder context; filled only by the task itself.
+ */
+struct ant_filemap {
+	struct ant_filemap_range range[ANTC_FILEMAP_RANGES];
+	/* The copies, in range order, chained by page->lru; page_private() is
+	 * the bytes of the page that belong to the file.
+	 */
+	struct list_head pages;
+	u64 carried, unlisted;
+	unsigned int count;
+};
+
+/* Pages seen with no memory for a list to put them in. */
+static atomic_t lost = ATOMIC_INIT(0);
+
+/* A file a run can leave behind: not one of the kernel's internal mounts. */
+static bool followed(const struct inode *inode)
+{
+	return S_ISREG(inode->i_mode) && !(inode->i_sb->s_flags & SB_KERNMOUNT);
+}
+
+/* Whether the page at @pos can join @r: the same file and cause, right after
+ * it (and after a whole page), numbered alike, and with its copied bytes
+ * still a prefix of the range.
+ */
+static bool extends(const struct ant_filemap_range *r, const struct inode *inode,
+		    u64 pos, u8 cause, bool ordered, u8 cut)
+{
+	return r->ino == inode->i_ino && r->dev == new_encode_dev(inode->i_sb->s_dev) &&
+	       r->generation == inode->i_generation && r->cause == cause &&
+	       r->offset + r->len == pos && !(r->len & ~PAGE_MASK) &&
+	       !!r->order == ordered && (r->carried == r->len || cut == r->cut);
+}
+
+static void add_page(struct ant_filemap *map, struct inode *inode, struct page *page,
+		     u64 pos, u64 len, u64 size, u8 cause, bool ordered)
+{
+	struct ant_filemap_range *r = map->count ? &map->range[map->count - 1] : NULL;
+	struct page *copy = NULL;
+	u8 cut = 0;
+
+	if (map->carried + len > ANTC_FILEMAP_DATA_MAX) {
+		cut = ANTC_FILEMAP_CUT_BUDGET;
+	} else {
+		copy = alloc_page(GFP_NOWAIT | __GFP_NOWARN);
+		if (!copy)
+			cut = ANTC_FILEMAP_CUT_MEMORY;
+	}
+	if (!r || !extends(r, inode, pos, cause, ordered, cut)) {
+		if (map->count >= ANTC_FILEMAP_RANGES) {
+			map->unlisted++;
+			if (copy)
+				__free_page(copy);
+			return;
+		}
+		r = &map->range[map->count++];
+		memset(r, 0, sizeof(*r));
+		r->dev = new_encode_dev(inode->i_sb->s_dev);
+		r->ino = inode->i_ino;
+		r->generation = inode->i_generation;
+		r->mode = inode->i_mode;
+		r->offset = pos;
+		r->size = size;
+		r->time_ns = ktime_get_ns();
+		r->order = ordered ? ant_fileops_next_order() : 0;
+		r->cause = cause;
+	}
+	if (cut)
+		r->cut = cut;
+	r->len += len;
+	if (!copy)
+		return;
+	memcpy_from_page(page_address(copy), page, 0, len);
+	set_page_private(copy, len);
+	list_add_tail(&copy->lru, &map->pages);
+	r->carried += len;
+	map->carried += len;
+}
+
+/* Copy @nr pages of @folio from its page @first, seen for @cause. Called under
+ * the page table lock (an unmap) or with the folio locked (a writeback):
+ * nothing here sleeps.
+ */
+static void capture(struct ant_filemap **slot, struct folio *folio, unsigned long first,
+		    unsigned int nr, u8 cause)
+{
+	struct address_space *mapping = folio_mapping(folio);
+	struct ant_filemap *map = *slot;
+	struct inode *inode;
+	unsigned long i;
+	bool ordered;
+	u64 size;
+
+	if (!mapping || folio_test_anon(folio) || !mapping->host)
+		return;
+	inode = mapping->host;
+	if (!followed(inode))
+		return;
+	if (!map) {
+		map = kzalloc(sizeof(*map), GFP_NOWAIT | __GFP_NOWARN);
+		if (!map) {
+			atomic_add(nr, &lost);
+			return;
+		}
+		INIT_LIST_HEAD(&map->pages);
+		*slot = map;
+	}
+	ordered = down_read_trylock(&inode->i_rwsem);
+	size = i_size_read(inode);
+	for (i = first; i < first + nr; i++) {
+		u64 pos = (u64)(folio->index + i) << PAGE_SHIFT;
+
+		/* Past the end of the file a page holds nothing of it. */
+		if (pos >= size)
+			break;
+		add_page(map, inode, folio_page(folio, i), pos,
+			 min_t(u64, PAGE_SIZE, size - pos), size, cause, ordered);
+	}
+	if (ordered)
+		up_read(&inode->i_rwsem);
+}
+
+/* folio_clear_dirty_for_io(), with @folio locked: folio_mkclean() found a
+ * mapping's entry for it dirty or writable, and the folio is about to be
+ * written back. Recorded when a traced call does the writeback.
+ */
+void ant_monitor_mapped_writeback(struct folio *folio)
+{
+	struct ant_filemap **slot;
+
+	if (!current->ant_monitor)
+		return;
+	slot = ant_monitor_filemap(true);
+	if (slot)
+		capture(slot, folio, 0, folio_nr_pages(folio), ANTC_FILEMAP_WRITEBACK);
+}
+
+/* zap_present_folio_ptes(), under the page table lock: @nr entries of @vma
+ * mapping @folio from @page on were dirty and are gone.
+ */
+void ant_monitor_mapped_unmap(struct vm_area_struct *vma, struct folio *folio,
+			      struct page *page, unsigned int nr)
+{
+	struct ant_filemap **slot;
+
+	if (!current->ant_monitor || !(vma->vm_flags & VM_SHARED))
+		return;
+	slot = ant_monitor_filemap(false);
+	if (slot)
+		capture(slot, folio, folio_page_idx(folio, page), nr, ANTC_FILEMAP_UNMAP);
+}
+
+static void pack(const struct ant_filemap *map, const struct ant_filemap_range *r,
+		 unsigned int index, u64 carried, u8 cut, u32 dropped, u8 *rec)
+{
+	memset(rec, 0, ANTC_FILEMAP_SIZE);
+	rec[0] = r->cause;
+	rec[1] = carried ? ANTC_FILEMAP_DATA : 0;
+	rec[2] = carried < r->len ? cut : 0;
+	put_unaligned_le32(PAGE_SIZE, rec + 4);
+	put_unaligned_le64(r->offset, rec + 8);
+	put_unaligned_le64(r->len, rec + 16);
+	put_unaligned_le64(carried, rec + 24);
+	put_unaligned_le64(r->dev, rec + 32);
+	put_unaligned_le64(r->ino, rec + 40);
+	put_unaligned_le32(r->generation, rec + 48);
+	put_unaligned_le32(r->mode, rec + 52);
+	put_unaligned_le64(r->size, rec + 56);
+	put_unaligned_le64(r->time_ns, rec + 64);
+	put_unaligned_le64(r->order, rec + 72);
+	put_unaligned_le16(index, rec + 80);
+	put_unaligned_le16(map->count, rec + 82);
+	put_unaligned_le32(dropped, rec + 84);
+	put_unaligned_le64(map->unlisted, rec + 88);
+}
+
+/* In the task's own context, where it may sleep: the copies of each range are
+ * handed over as one iterator.
+ */
+void ant_filemap_emit(struct ant_filemap *map, ant_filemap_emit_fn emit, void *arg)
+{
+	struct page *page = list_first_entry_or_null(&map->pages, struct page, lru);
+	u32 dropped = map->count ? atomic_xchg(&lost, 0) : 0;
+	u8 rec[ANTC_FILEMAP_SIZE];
+	unsigned int i, j, n;
+
+	for (i = 0; i < map->count; i++) {
+		const struct ant_filemap_range *r = &map->range[i];
+		struct bio_vec *bvec = NULL;
+		struct iov_iter iter;
+		u64 carried = r->carried;
+		u8 cut = r->cut;
+
+		/* Every page of a range is whole but its last. */
+		n = DIV_ROUND_UP(carried, PAGE_SIZE);
+		if (n)
+			bvec = kvmalloc_array(n, sizeof(*bvec), GFP_KERNEL | __GFP_NOWARN);
+		for (j = 0; j < n && page; j++) {
+			if (bvec)
+				bvec_set_page(&bvec[j], page, page_private(page), 0);
+			page = list_is_last(&page->lru, &map->pages) ? NULL :
+				list_next_entry(page, lru);
+		}
+		if (n && !bvec) {
+			carried = 0;
+			cut = ANTC_FILEMAP_CUT_MEMORY;
+		}
+		pack(map, r, i, carried, cut, i ? 0 : dropped, rec);
+		if (carried) {
+			iov_iter_bvec(&iter, ITER_SOURCE, bvec, n, carried);
+			emit(arg, rec, &iter, carried, r->len);
+		} else {
+			emit(arg, rec, NULL, 0, r->len);
+		}
+		kvfree(bvec);
+	}
+}
+
+void ant_filemap_free(struct ant_filemap *map)
+{
+	struct page *page, *next;
+
+	if (!map)
+		return;
+	list_for_each_entry_safe(page, next, &map->pages, lru) {
+		list_del(&page->lru);
+		set_page_private(page, 0);
+		__free_page(page);
+	}
+	kfree(map);
+}
diff --git a/kernel/antinomie/filemap.h b/kernel/antinomie/filemap.h
new file mode 100644
index 0000000..1e0790e
--- /dev/null
+++ b/kernel/antinomie/filemap.h
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _ANTINOMIE_FILEMAP_H
+#define _ANTINOMIE_FILEMAP_H
+
+#include <linux/types.h>
+
+struct ant_filemap;
+struct iov_iter;
+
+#define ANT_FILEMAP_KEY "lifecycle.file_mapped"
+#define ANT_FILEMAP_LAYOUT "antinomie.filemap/1"
+#define ANT_FILEMAP_DATA_KEY "lifecycle.file_mapped.data"
+
+/* The calling task's pending records (recorder.c): NULL when the task is not
