+	int error;
 
 	if (!ctx)
 		return -ENOMEM;
 	ant_monitor_cookie(current);
+	error = ant_run_launch(current, current->ant_cookie);
+	if (error) {
+		kfree(ctx);
+		return error;
+	}
 	WRITE_ONCE(current->ant_root_cookie, current->ant_cookie);
 	current->ant_monitor = ctx;
 	if (!current->ant_counted) {
@@ -1181,10 +1188,21 @@ u64 ant_monitor_stream_id(void)
 void ant_monitor_fork_prepare(struct task_struct *child)
 {
 	WRITE_ONCE(child->ant_observer_cookie, READ_ONCE(current->ant_observer_cookie));
-	if (!current->ant_root_cookie || child->flags & PF_USER_WORKER)
+	if (!current->ant_run)
 		return;
+	/* An io_uring worker is a thread of the creating process, but not a
+	 * task the program started: it is invisible to the observer and carries
+	 * no cookie. The run still counts it, because the process is not gone,
+	 * and its status not final, until the group's last thread has exited,
+	 * and that can be a worker (see ant_run_exit()).
+	 */
+	if (child->flags & PF_USER_WORKER) {
+		ant_run_fork(current, child);
+		return;
+	}
 	ant_monitor_cookie(child);
 	WRITE_ONCE(child->ant_root_cookie, READ_ONCE(current->ant_root_cookie));
+	ant_run_fork(current, child);
 	child->ant_counted = true;
 	atomic64_inc(&tasks_created);
 	atomic64_inc(&tasks_live);
@@ -1224,8 +1242,9 @@ void ant_monitor_exec(void)
 	lifecycle(current->ant_monitor, "lifecycle.exec_commit", task_pid_nr(current));
 }
 
-void ant_monitor_task_exit(void)
+void ant_monitor_task_exit(bool group_dead)
 {
+	ant_run_exit(current, group_dead);
 	lifecycle(current->ant_monitor, "lifecycle.task_exit", current->exit_code);
 	if (current->ant_counted) {
 		current->ant_counted = false;
diff --git a/kernel/antinomie/run.c b/kernel/antinomie/run.c
new file mode 100644
index 0000000..55e595e
--- /dev/null
+++ b/kernel/antinomie/run.c
@@ -0,0 +1,285 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/antinomie_monitor.h>
+#include <linux/errno.h>
+#include <linux/sched.h>
+#include <linux/sched/signal.h>
+#include <linux/sched/task.h>
+#include <linux/spinlock.h>
+#include <linux/unaligned.h>
+#include <linux/workqueue.h>
+
+#include "control_wire.h"
+#include "run.h"
+
+#define ANT_RUN_COUNT 64
+
+/* Stop escalation. STOP_RUN sends SIGTERM to every task of a run; a task that
+ * ignores or blocks it would then run on for ever. The guest therefore sends
+ * SIGKILL to the whole run after a grace period, with no help from the host.
+ * SIGKILL is repeated every ANT_STOP_RECHECK_MS while tasks of the run are still live
+ * (a fork that raced the first pass), at most ANT_STOP_PASSES times.
+ */
+#define ANT_STOP_GRACE_DEFAULT_MS 4000U
+#define ANT_STOP_RECHECK_MS 250U
+#define ANT_STOP_PASSES 20U
+
+struct ant_run {
+	u64 root_cookie;
+	u64 generation;
+	u64 live_count;
+	u64 async_count;
+	u64 async_losses;
+	u64 task_count;
+	u32 flags;
+	s32 root_status;
+	bool stop_armed;
+	u32 stop_passes;
+	unsigned long kill_at;
+};
+
+/* Boot-lifetime objects never move or disappear. Task and async ownership can
+ * safely retain their address; this lock serializes every status transition.
+ */
+static struct ant_run runs[ANT_RUN_COUNT];
+static unsigned int run_count;
+static DEFINE_SPINLOCK(run_lock);
+static void stop_escalate(struct work_struct *work);
+static DECLARE_DELAYED_WORK(stop_work, stop_escalate);
+/* Whether stop_work is queued and when it fires; both under run_lock. */
+static bool stop_scheduled;
+static unsigned long stop_next;
+
+static struct ant_run *find_run(u64 cookie)
+{
+	unsigned int i;
+
+	for (i = 0; i < run_count; i++)
+		if (runs[i].root_cookie == cookie)
+			return &runs[i];
+	return NULL;
+}
+
+int ant_run_launch(struct task_struct *task, u64 cookie)
+{
+	struct ant_run *run;
+	unsigned long irqflags;
+
+	spin_lock_irqsave(&run_lock, irqflags);
+	if (run_count == ANT_RUN_COUNT) {
+		spin_unlock_irqrestore(&run_lock, irqflags);
+		return -ENOSPC;
+	}
+	run = &runs[run_count++];
+	run->root_cookie = cookie;
+	run->generation = 1;
+	run->live_count = 1;
+	run->task_count = 1;
+	task->ant_run = run;
+	task->ant_root_process = true;
+	spin_unlock_irqrestore(&run_lock, irqflags);
+	return 0;
+}
+
+void ant_run_fork(struct task_struct *parent, struct task_struct *child)
+{
+	struct ant_run *run = parent->ant_run;
+	unsigned long irqflags;
+
+	if (!run)
+		return;
+	spin_lock_irqsave(&run_lock, irqflags);
+	child->ant_run = run;
+	child->ant_root_process = parent->ant_root_process &&
+		same_thread_group(parent, child);
+	run->live_count++;
+	run->task_count++;
+	run->generation++;
+	spin_unlock_irqrestore(&run_lock, irqflags);
+}
+
+/* Every thread of a run's process counts, including the io_uring workers
+ * (iou-wrk, iou-sqp) the kernel adds to it: the root's wait status is taken by
+ * the thread that leaves the group last, and with a group exit that can be
+ * a worker well after the leader has gone. A worker
+ * that was not counted left the run with TREE_EXITED and no ROOT_EXITED.
+ */
+bool ant_run_exit(struct task_struct *task, bool group_dead)
+{
+	struct ant_run *run = task->ant_run;
+	unsigned long irqflags;
+
+	if (!run)
+		return false;
+	spin_lock_irqsave(&run_lock, irqflags);
+	/* Detachment also makes a repeated exit observation harmless. */
+	task->ant_run = NULL;
+	/* Root status follows the launched process, including nonleader exec.
+	 * Match wait_task_zombie(): an internal de_thread leader death and a
+	 * leader-only pthread_exit are not root-process completion.
+	 */
+	if (task->ant_root_process && group_dead) {
+		run->root_status = task->signal->flags & SIGNAL_GROUP_EXIT ?
+			task->signal->group_exit_code : task->group_leader->exit_code;
+		run->flags |= ANTC_RUN_ROOT_EXITED;
+	}
+	if (!--run->live_count)
+		run->flags |= ANTC_RUN_TREE_EXITED;
+	run->generation++;
+	spin_unlock_irqrestore(&run_lock, irqflags);
+	return true;
+}
+
+int ant_monitor_run_status(u64 root_cookie, void *out)
+{
+	struct ant_run *run;
+	unsigned long irqflags;
+	u8 *p = out;
+	u32 flags;
+
+	spin_lock_irqsave(&run_lock, irqflags);
+	run = find_run(root_cookie);
+	if (!run) {
+		spin_unlock_irqrestore(&run_lock, irqflags);
+		return -ESRCH;
+	}
+	flags = run->flags;
+	if (!run->async_count && !(flags & ANTC_RUN_OBSERVATION_INCOMPLETE))
+		flags |= ANTC_RUN_ASYNC_COMPLETE;
+	put_unaligned_le64(run->root_cookie, p);
+	put_unaligned_le64(run->generation, p + 8);
+	put_unaligned_le64(run->live_count, p + 16);
+	put_unaligned_le64(run->async_count, p + 24);
+	put_unaligned_le32(flags, p + 32);
+	put_unaligned_le32(run->root_status, p + 36);
+	put_unaligned_le64(run->async_losses, p + 40);
+	put_unaligned_le64(run->task_count, p + 48);
+	put_unaligned_le64(0, p + 56);
+	spin_unlock_irqrestore(&run_lock, irqflags);
+	return 0;
+}
+
+void ant_monitor_run_stopped(u64 root_cookie)
+{
+	struct ant_run *run;
+	unsigned long irqflags;
+
+	spin_lock_irqsave(&run_lock, irqflags);
+	run = find_run(root_cookie);
+	if (run && !(run->flags & ANTC_RUN_STOP_REQUESTED)) {
+		run->flags |= ANTC_RUN_STOP_REQUESTED;
+		run->generation++;
+	}
+	spin_unlock_irqrestore(&run_lock, irqflags);
+}
+
+/* Signal every task that carries this run's launch cookie. RCU protects the
+ * traversal; each signal uses a referenced task, never a PID, so membership
+ * survives PTY reaping and root exit. A fork that races the pass can escape it.
+ * Returns the first error other than -ESRCH, else 0 if a signal was issued, else
+ * -ESRCH.
+ */
+int ant_run_signal(u64 root_cookie, int sig, bool *issued)
+{
+	struct task_struct *process, *task;
+	int error, first_error = 0;
+
+	*issued = false;
+	rcu_read_lock();
+	for_each_process_thread(process, task) {
+		if (!READ_ONCE(task->ant_cookie) ||
+		    READ_ONCE(task->ant_root_cookie) != root_cookie)
+			continue;
+		get_task_struct(task);
+		error = send_sig(sig, task, 1);
+		put_task_struct(task);
+		if (!error)
+			*issued = true;
+		else if (error != -ESRCH && !first_error)
+			first_error = error;
+	}
+	rcu_read_unlock();
+	if (first_error)
+		return first_error;
+	return *issued ? 0 : -ESRCH;
+}
+
+/* Schedule the escalation check for the earliest deadline. Caller holds
+ * run_lock, which orders this against the work's own reschedule.
+ */
+static void stop_schedule_locked(unsigned long at)
+{
+	if (stop_scheduled && !time_before(at, stop_next))
+		return;
+	stop_scheduled = true;
+	stop_next = at;
+	mod_delayed_work(system_unbound_wq, &stop_work, at > jiffies ? at - jiffies : 0);
+}
+
+/* Arm the SIGKILL escalation of a run whose Stop was accepted. A repeated Stop
+ * can only bring the deadline forward. grace_ms 0 selects the default.
+ */
+void ant_run_stop_arm(u64 root_cookie, u32 grace_ms)
+{
+	struct ant_run *run;
+	unsigned long irqflags, at;
+
+	at = jiffies + msecs_to_jiffies(grace_ms ?: ANT_STOP_GRACE_DEFAULT_MS);
+	spin_lock_irqsave(&run_lock, irqflags);
+	run = find_run(root_cookie);
+	if (run && !(run->flags & ANTC_RUN_TREE_EXITED)) {
+		if (!run->stop_armed || time_before(at, run->kill_at))
+			run->kill_at = at;
+		if (!run->stop_armed)
+			run->stop_passes = 0;
+		run->stop_armed = true;
+		stop_schedule_locked(run->kill_at);
+	}
+	spin_unlock_irqrestore(&run_lock, irqflags);
+}
+
+static void stop_escalate(struct work_struct *work)
+{
+	u64 cookies[ANT_RUN_COUNT];
+	unsigned int i, due = 0, n;
+	unsigned long irqflags, now;
+	struct ant_run *run;
+	bool issued;
+
+	spin_lock_irqsave(&run_lock, irqflags);
+	now = jiffies;
+	stop_scheduled = false;
+	for (i = 0; i < run_count; i++) {
+		run = &runs[i];
+		if (!run->stop_armed)
+			continue;
+		if (run->flags & ANTC_RUN_TREE_EXITED) {
+			run->stop_armed = false;
+		} else if (!time_before(now, run->kill_at)) {
+			cookies[due++] = run->root_cookie;
+		}
+	}
+	spin_unlock_irqrestore(&run_lock, irqflags);
+
+	for (n = 0; n < due; n++) {
+		issued = false;
+		ant_run_signal(cookies[n], SIGKILL, &issued);
+		spin_lock_irqsave(&run_lock, irqflags);
+		run = find_run(cookies[n]);
+		if (run && run->stop_armed) {
+			if (issued && !(run->flags & ANTC_RUN_KILL_ESCALATED)) {
+				run->flags |= ANTC_RUN_KILL_ESCALATED;
+				run->generation++;
+			}
+			run->kill_at = jiffies + msecs_to_jiffies(ANT_STOP_RECHECK_MS);
+			if (++run->stop_passes >= ANT_STOP_PASSES)
+				run->stop_armed = false;
+		}
+		spin_unlock_irqrestore(&run_lock, irqflags);
+	}
+
+	spin_lock_irqsave(&run_lock, irqflags);
+	for (i = 0; i < run_count; i++)
+		if (runs[i].stop_armed && !(runs[i].flags & ANTC_RUN_TREE_EXITED))
+			stop_schedule_locked(runs[i].kill_at);
+	spin_unlock_irqrestore(&run_lock, irqflags);
+}
