diff --git a/kernel/antinomie/control.c b/kernel/antinomie/control.c
index a4ce499..b58eaca 100644
--- a/kernel/antinomie/control.c
+++ b/kernel/antinomie/control.c
@@ -23,6 +23,7 @@
 #include <linux/workqueue.h>
 #include "control_wire.h"
 #include "observer.h"
+#include "run.h"
 
 #define ANT_SESSION_MAX 64
 
@@ -454,6 +455,37 @@ static int terminal_command(u32 opcode, const u8 *args, size_t args_len,
 	return tty->ops->resize ? tty->ops->resize(tty, &ws) : tty_do_resize(tty, &ws);
 }
 
+static int stop_run(const u8 *args, size_t args_len)
+{
+	u64 root_cookie;
+	u32 grace_ms = 0;
+	bool issued;
+	int error;
+
+	if (args_len != 16 && args_len != 24)
+		return -EINVAL;
+	root_cookie = get_unaligned_le64(args + 8);
+	if (!root_cookie)
+		return -EINVAL;
+	if (args_len == 24) {
+		grace_ms = get_unaligned_le32(args + 16);
+		if (get_unaligned_le32(args + 20) ||
+		    (grace_ms && (grace_ms < 100 || grace_ms > 30000)))
+			return -EINVAL;
+	}
+
+	/* Membership survives PTY reaping and root exit. Concurrent forks can
+	 * escape this pass, so success only reports an issued signal request;
+	 * the escalation to SIGKILL (run.c) covers a task that ignores SIGTERM.
+	 */
+	error = ant_run_signal(root_cookie, SIGTERM, &issued);
+	if (issued) {
+		ant_monitor_run_stopped(root_cookie);
+		ant_run_stop_arm(root_cookie, grace_ms);
+	}
+	return error;
+}
+
 static int command(const void *data, size_t args_len, void *reply,
 		   size_t capacity, size_t *reply_len, void *context)
 {
@@ -463,7 +495,7 @@ static int command(const void *data, size_t args_len, void *reply,
 	*reply_len = 0;
 	if (args_len < ANTC_HEADER_SIZE || get_unaligned_le16(args) != ANTC_VERSION ||
 	    get_unaligned_le16(args + 2) != ANTC_HEADER_SIZE)
-		return -EPROTO;
+		return opcode == ANTC_RUN_STATUS ? -EINVAL : -EPROTO;
 	if (opcode != ANTC_UPLOAD_BEGIN && get_unaligned_le32(args + 4))
 		return -EINVAL;
 	switch (opcode) {
@@ -479,6 +511,22 @@ static int command(const void *data, size_t args_len, void *reply,
 	case ANTC_TERMINAL_INPUT: case ANTC_TERMINAL_READ:
 	case ANTC_TERMINAL_RESIZE: case ANTC_SIGNAL:
 		return terminal_command(opcode, args, args_len, reply, capacity, reply_len);
+	case ANTC_STOP_RUN:
+		return stop_run(args, args_len);
+	case ANTC_RUN_STATUS: {
+		u64 root_cookie;
+		int error;
+
+		if (args_len != 16 || capacity < 64)
+			return -EINVAL;
+		root_cookie = get_unaligned_le64(args + 8);
+		if (!root_cookie)
+			return -EINVAL;
+		error = ant_monitor_run_status(root_cookie, reply);
+		if (!error)
+			*reply_len = 64;
+		return error;
+	}
 	case ANTC_STATS:
 		if (args_len != 8 || capacity < 80)
 			return -EINVAL;
@@ -513,7 +561,7 @@ static int __init ant_control_init(void)
 	static const u32 opcodes[] = { ANTC_INFO, ANTC_UPLOAD_BEGIN,
 		ANTC_UPLOAD_CHUNK, ANTC_UPLOAD_COMMIT, ANTC_UPLOAD_ABORT, ANTC_EXEC,
 		ANTC_TERMINAL_INPUT, ANTC_TERMINAL_READ, ANTC_TERMINAL_RESIZE,
-		ANTC_SIGNAL, ANTC_STATS,
+		ANTC_SIGNAL, ANTC_STOP_RUN, ANTC_RUN_STATUS, ANTC_STATS,
 		ANTC_SHUTDOWN, ANTC_PROCESS_LIST, ANTC_CAPTURE_ATTACH,
 		ANTC_CAPTURE_ALL, ANTC_CAPTURE_STOP, ANTC_CAPTURE_STATUS };
 	int i, error;
diff --git a/kernel/antinomie/control_wire.h b/kernel/antinomie/control_wire.h
index 87464f8..3c875c0 100644
--- a/kernel/antinomie/control_wire.h
+++ b/kernel/antinomie/control_wire.h
@@ -22,6 +22,15 @@
 #define ANTC_TERMINAL_READ 0x1012
 #define ANTC_TERMINAL_RESIZE 0x1013
 #define ANTC_SIGNAL 0x1014
+#define ANTC_STOP_RUN 0x1015
+#define ANTC_RUN_STATUS 0x1016
+#define ANTC_RUN_STATUS_SIZE 64
+#define ANTC_RUN_ROOT_EXITED 1
+#define ANTC_RUN_TREE_EXITED 2
+#define ANTC_RUN_STOP_REQUESTED 4
+#define ANTC_RUN_ASYNC_COMPLETE 8
+#define ANTC_RUN_OBSERVATION_INCOMPLETE 16
+#define ANTC_RUN_KILL_ESCALATED 32
 #define ANTC_STATS 0x1020
 #define ANTC_INFO 0x1021
 #define ANTC_INFO_SIZE 160
@@ -70,6 +79,20 @@
  * u16 pixel_width at 20, u16 pixel_height at 22. Empty success reply.
  * SIGNAL: header, u64 session_id at 8, u32 signal at 16,
  * u32 reserved=0 at 20. Signals launch process group. Empty success reply.
+ * STOP_RUN: header flags=0, nonzero u64 root_task_cookie at 8 (16 bytes), or
+ * 24 bytes with u32 grace_ms at 16 (0 selects the default, 4000; otherwise
+ * 100..30000) and u32 reserved=0 at 20.
+ * Requests SIGTERM for each traced task with this inherited launch cookie,
+ * including descendants after root exit or PTY/session reaping. Empty reply.
+ * Status 0 means signal requests issued, not proven tree termination; -ESRCH
+ * means no signalable matching task. Concurrent forks may escape this pass.
+ * After the grace period the guest itself sends SIGKILL to every task of the
+ * run still alive and repeats it every 250 ms (20 passes at most) while tasks
+ * remain, and sets RUN_STATUS flag KILL_ESCALATED (32). A later STOP_RUN only
+ * brings the deadline forward.
+ * RUN_STATUS: header flags=0, nonzero u64 root cookie at 8 (16 bytes).
+ * Success: 64-byte reply specified in protocol/run-status.md. Task/tree
+ * completion, root wait status, async observations and saving are distinct.
  *
  * STATS: header only. Reply: ten u64 counters in order: stream_id,
  * tasks_created, tasks_live, calls_entered, events_attempted,
