+
+static u32 creds_reason(const struct ant_task *ctx, const struct cred *old,
+			const struct cred *new)
+{
+	bool ids = !uid_eq(old->uid, new->uid) || !uid_eq(old->euid, new->euid) ||
+		!uid_eq(old->suid, new->suid) || !gid_eq(old->gid, new->gid) ||
+		!gid_eq(old->egid, new->egid) || !gid_eq(old->sgid, new->sgid);
+
+	if (!ctx->active || ctx->abi != 1)
+		return ANTC_CRED_OTHER;
+	switch (ctx->nr) {
+	case 105: case 113: /* setuid, setreuid */
+		return ANTC_CRED_SETUID;
+	case 106: case 114: /* setgid, setregid */
+		return ANTC_CRED_SETGID;
+	case 117: case 119: /* setresuid, setresgid */
+		return ANTC_CRED_SETRES;
+	case 122: case 123: /* setfsuid, setfsgid */
+		return ANTC_CRED_SETFS;
+	case 126: /* capset */
+		return ANTC_CRED_CAPSET;
+	case 157: /* prctl: ambient and bounding sets, securebits, keepcaps */
+		return ANTC_CRED_PRCTL;
+	case 59: case 322: /* execve, execveat */
+		if (ids)
+			return ANTC_CRED_EXEC_SETID;
+		if (!cap_isidentical(old->cap_permitted, new->cap_permitted) ||
+		    !cap_isidentical(old->cap_effective, new->cap_effective))
+			return ANTC_CRED_EXEC_CAPS;
+	}
+	return ANTC_CRED_OTHER;
+}
+
+void ant_monitor_creds(const struct cred *old, const struct cred *new)
+{
+	struct ant_task *ctx = current->ant_monitor;
+
+	if (!ctx || ctx->busy || !ctx->creds_seen)
+		return;
+	if (uid_eq(old->uid, new->uid) && uid_eq(old->euid, new->euid) &&
+	    uid_eq(old->suid, new->suid) && uid_eq(old->fsuid, new->fsuid) &&
+	    gid_eq(old->gid, new->gid) && gid_eq(old->egid, new->egid) &&
+	    gid_eq(old->sgid, new->sgid) && gid_eq(old->fsgid, new->fsgid) &&
+	    cap_isidentical(old->cap_effective, new->cap_effective) &&
+	    cap_isidentical(old->cap_permitted, new->cap_permitted) &&
+	    cap_isidentical(old->cap_inheritable, new->cap_inheritable) &&
+	    cap_isidentical(old->cap_bset, new->cap_bset) &&
+	    cap_isidentical(old->cap_ambient, new->cap_ambient) &&
+	    old->securebits == new->securebits)
+		return;
+	creds_note(ctx, creds_reason(ctx, old, new), new);
+}
+
+void ant_monitor_loginuid(void)
+{
+	struct ant_task *ctx = current->ant_monitor;
+
+	if (ctx)
+		creds_note(ctx, ANTC_CRED_LOGINUID, current_cred());
+}
+
+/* A record of the call in progress, or of an earlier call when a worker
+ * publishes it (ant_monitor_note_publish). Both use a lifecycle event with one
+ * fixed-structure field.
+ */
+bool ant_monitor_note(const char *key, const char *layout, const void *data, size_t len)
+{
+	struct ant_task *ctx = current->ant_monitor;
