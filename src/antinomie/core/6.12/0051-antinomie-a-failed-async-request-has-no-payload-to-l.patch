From d30ac5041e06ed8666ff49fee9364606265492b3 Mon Sep 17 00:00:00 2001
From: MikiMiku <jonathanirvinjo@gmail.com>
Date: Wed, 21 Oct 2026 20:56:47 +0700
Subject: [PATCH] antinomie: a failed async request has no payload to lose;
 decode termios2 and process-group ioctls

An io_uring request that failed before it moved any data (a READ on a bad
descriptor, an unknown opcode rejected at submission) kept the payload-gap
flag it started with. Its final record then said the payload was not
observed, and finishing it counted an async observation loss, so a run
that only submitted a failing request reported lost observations. A request
that ends with an error transferred nothing: there is nothing to observe.
Its final record (rejection, completion or cancellation) now carries no
payload gap and no loss is counted. A capture that had already failed keeps
its gap; it was counted when it failed.

glibc's tcgetattr() and isatty() ask a terminal with TCGETS2, so nearly
every program that writes to a terminal made an ioctl whose argument was
recorded as NO_DECODER. The terminal decoder now also knows TCGETS2 and
TCSETS2/TCSETSW2/TCSETSF2 (struct termios2, 44 bytes) and TIOCGPGRP,
TIOCSPGRP and TIOCGSID (pid_t). Inputs are copied at entry, outputs at exit
after success, as for TCGETS.

The contract revision stays 17: the records are the existing field and
async layouts, and an older host reads them as before.
---
 kernel/antinomie/async.c    | 20 ++++++++++++++++++++
 kernel/antinomie/recorder.c | 15 +++++++++++++++
 2 files changed, 35 insertions(+)

diff --git a/kernel/antinomie/async.c b/kernel/antinomie/async.c
index c3d4d74a1..d9003a242 100644
--- a/kernel/antinomie/async.c
+++ b/kernel/antinomie/async.c
@@ -458,6 +458,23 @@ void ant_monitor_async_memory(struct ant_async **slot, const char *key,
 	put_request(request);
 }
 
+/* A request that ends with an error moved no data: whatever payload it
+ * would have had was never transferred, so there is nothing left to observe.
+ * Its final record carries no payload gap and finishing it counts no loss.
+ * A capture that had already failed keeps its gap (and was counted then).
+ */
+static void failed_without_payload(struct ant_async *request, s64 result)
+{
+	unsigned long irqflags;
+
+	if (result >= 0)
+		return;
+	spin_lock_irqsave(&request_lock, irqflags);
+	if (!request->payload_failed)
+		request->event.flags &= ~ANT_ASYNC_PAYLOAD_GAP;
+	spin_unlock_irqrestore(&request_lock, irqflags);
+}
+
 void ant_monitor_async_accepted(struct ant_async **slot, int result)
 {
 	struct ant_async *request = get_request(slot, result < 0);
@@ -465,6 +482,7 @@ void ant_monitor_async_accepted(struct ant_async **slot, int result)
 	if (!request)
 		return;
 	if (result < 0) {
+		failed_without_payload(request, result);
 		stage_record(request, 3, result, 0, true);
 		finish_request(request);
 	} else {
@@ -480,6 +498,8 @@ void ant_monitor_async_complete(struct ant_async **slot, s64 result,
 
 	if (!request)
 		return;
+	if (final)
+		failed_without_payload(request, result);
 	stage_record(request, result == -ECANCELED ? 5 : 4, result,
 		     (u64)flags << 32, final);
 	if (final)
diff --git a/kernel/antinomie/recorder.c b/kernel/antinomie/recorder.c
index 642f89c0e..ae4ece278 100644
--- a/kernel/antinomie/recorder.c
+++ b/kernel/antinomie/recorder.c
@@ -510,6 +510,14 @@ static void ioctl_field(struct ant_task *ctx, bool output, long result)
 			size = sizeof(struct termios);
 			layout = "linux-6.12.94/x86_64/termios";
 			break;
+		case TCSETS2: case TCSETSW2: case TCSETSF2:
+			input = true;
+			fallthrough;
+		case TCGETS2:
+			/* glibc's tcgetattr() and isatty() ask with TCGETS2. */
+			size = sizeof(struct termios2);
+			layout = "linux-6.12.94/x86_64/termios2";
+			break;
 		case TIOCSWINSZ:
 			input = true;
 			fallthrough;
@@ -517,6 +525,13 @@ static void ioctl_field(struct ant_task *ctx, bool output, long result)
 			size = sizeof(struct winsize);
 			layout = "linux-6.12.94/x86_64/winsize";
 			break;
+		case TIOCSPGRP:
+			input = true;
+			fallthrough;
+		case TIOCGPGRP: case TIOCGSID:
+			size = sizeof(pid_t);
+			layout = "linux-6.12.94/x86_64/pid_t";
+			break;
 		case FIONREAD:
 			size = sizeof(int);
 			layout = "linux-6.12.94/x86_64/int";
-- 
2.53.0

