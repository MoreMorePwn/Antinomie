 		return -EINVAL;
 	switch (opcode) {
 	case ANTC_PROCESS_LIST: case ANTC_CAPTURE_ATTACH: case ANTC_CAPTURE_ALL:
@@ -601,6 +601,8 @@ static int command(const void *data, size_t args_len, void *reply,
 		return ant_manual_command(opcode, args, args_len, reply, capacity, reply_len);
 	case ANTC_CORE_STATUS: case ANTC_CORE_READ: case ANTC_CORE_RELEASE: case ANTC_CORE_CANCEL:
 		return ant_core_command(opcode, args, args_len, reply, capacity, reply_len);
+	case ANTC_CORE_CAPS:
+		return ant_core_caps(args, args_len, reply, capacity, reply_len);
 	case ANTC_DEBUG_CAPS: case ANTC_DEBUG_ATTACH: case ANTC_DEBUG_DETACH:
