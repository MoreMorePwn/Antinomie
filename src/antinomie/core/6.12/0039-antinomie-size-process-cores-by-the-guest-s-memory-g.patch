 		timeout_ms = get_unaligned_le32(args + offset + 4);
-		if (!max_size || max_size > 64U * 1024 * 1024 ||
-		    !timeout_ms || timeout_ms > 5000) {
+		if (!max_size || max_size > ant_core_max_bytes() ||
+		    !timeout_ms || timeout_ms > ant_core_max_timeout_ms()) {
 			error = -EINVAL;
 			goto fail;
 		}
@@ -580,7 +580,7 @@ static int command(const void *data, size_t args_len, void *reply,
 	if (opcode != ANTC_UPLOAD_BEGIN && opcode != ANTC_EXEC &&
 	    opcode != ANTC_DEBUG_ATTACH && opcode != ANTC_DEBUG_DETACH &&
 	    opcode != ANTC_DEBUG_CONT && opcode != ANTC_DEBUG_REGS_READ &&
