@@ -324,24 +420,79 @@ static unsigned int extent_search(const struct ant_core *core, u64 offset)
 	return low;
 }
 
-/* The stored bytes at a file offset and how many follow in the same extent;
- * NULL where the offset is in a hole or past the end.
+/* Where in the buffer the bytes of a file offset are, and how many of the
+ * extent follow it; false in a hole or past the end.
  */
-static void *core_span(const struct ant_core *core, u64 offset, u64 *available)
+static bool core_locate(const struct ant_core *core, u64 offset, u64 *base, u64 *available)
 {
 	unsigned int index;
 	const struct ant_core_extent *extent;
 
-	if (!core->data || !core->extents)
-		return NULL;
+	if (!core->chunks || !core->extents)
+		return false;
 	index = extent_search(core, offset);
 	if (index >= core->extent_count)
-		return NULL;
+		return false;
 	extent = &core->extents[index];
 	if (offset < extent->offset)
-		return NULL;
+		return false;
 	*available = extent->offset + extent->length - offset;
-	return core->data + extent->base + (offset - extent->offset);
+	*base = extent->base + (offset - extent->offset);
+	return true;
+}
+
+/* The stored bytes at a file offset, and how many follow in the same extent
+ * and the same chunk; NULL where the offset is in a hole or past the end.
+ * The ELF header, program headers and notes are read this way: they are
+ * written first and sit inside the first chunk.
+ */
+static void *core_span(const struct ant_core *core, u64 offset, u64 *available)
+{
+	u64 base;
+
+	if (!core_locate(core, offset, &base, available) ||
+	    base >> ANT_CORE_CHUNK_SHIFT >= core->chunk_count)
+		return NULL;
+	*available = min_t(u64, *available, ANT_CORE_CHUNK - (base & ANT_CORE_CHUNK_MASK));
+	return core->chunks[base >> ANT_CORE_CHUNK_SHIFT] + (base & ANT_CORE_CHUNK_MASK);
+}
+
+/* Copy count stored bytes starting at buffer offset base out of the chunks. */
+static void core_copy_out(const struct ant_core *core, u64 base, void *to, u32 count)
+{
+	while (count) {
+		u32 piece = min_t(u64, count, ANT_CORE_CHUNK - (base & ANT_CORE_CHUNK_MASK));
+
+		memcpy(to, core->chunks[base >> ANT_CORE_CHUNK_SHIFT] + (base & ANT_CORE_CHUNK_MASK),
+		       piece);
+		to += piece;
+		base += piece;
+		count -= piece;
+	}
+}
