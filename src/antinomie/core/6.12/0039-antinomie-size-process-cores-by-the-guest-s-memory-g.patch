 	session->live.scratch = manual_alloc(session, PAGE_SIZE);
 	if (!session->participants || !session->live.tasks || !session->original ||
 	    !session->extents || !session->live.pages || !session->live.scratch) {
@@ -598,8 +598,9 @@ int ant_manual_command(u32 opcode, const u8 *args, size_t args_len,
 		identity.max_size = get_unaligned_le32(args + 28);
 		identity.timeout_ms = get_unaligned_le32(args + 32);
 		identity.policy = get_unaligned_le32(args + 36);
-		if (!identity.max_size || identity.max_size > 64U * 1024 * 1024 ||
-		    !identity.timeout_ms || identity.timeout_ms > 5000 || identity.policy != 1)
