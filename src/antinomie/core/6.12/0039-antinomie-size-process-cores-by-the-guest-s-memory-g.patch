+#include <linux/resource.h>
 #include <linux/sched/signal.h>
 #include <linux/slab.h>
 #include <linux/timekeeping.h>
@@ -19,8 +23,20 @@
 #include "process_core.h"
 #include "run.h"
 
-#define ANT_CORE_MAX (64U * 1024 * 1024)
-#define ANT_CORE_TOTAL (128U * 1024 * 1024)
+/* The budget a handle may ask for follows the guest's memory (see
+ * ant_core_max_bytes); the floor is the ceiling every earlier kernel had and is
+ * always accepted. The buffer grows in chunks while it is written, so a budget
+ * costs nothing until a process really is that large; an exit core reserves
+ * its first ANT_CORE_PREALLOC bytes when it is armed, as it always did.
+ */
+#define ANT_CORE_HARD_MAX (1024ULL << 20)
+#define ANT_CORE_FLOOR (64ULL << 20)
+#define ANT_CORE_PREALLOC (64ULL << 20)
+#define ANT_CORE_RESERVE (128ULL << 20)
+#define ANT_CORE_CHUNK_SHIFT 23
+#define ANT_CORE_CHUNK (1U << ANT_CORE_CHUNK_SHIFT)
+#define ANT_CORE_CHUNK_MASK (ANT_CORE_CHUNK - 1)
+#define ANT_CORE_TIMEOUT_MAX 60000U
 #define ANT_CORE_HANDLES 4
 #define ANT_CORE_IDLE (180 * HZ)
 /* A core file is sparse: Linux skips pages that are not resident, and the
@@ -31,7 +47,7 @@
  * as a hole, which keeps the alignment padding of ELF notes in one extent.
  */
 #define ANT_CORE_LOGICAL_MAX ANTC_CORE_LOGICAL_MAX
-#define ANT_CORE_EXTENTS 32768
+#define ANT_CORE_EXTENTS 32768U
 #define ANT_CORE_FILL 64
 #define ANT_CORE_HOLE_MAX (1U << 30)
 
@@ -44,9 +60,11 @@ struct ant_core_extent {
 struct ant_core {
 	struct list_head node;
 	refcount_t refs;
-	void *data;
+	/* The stored bytes, in chunks that are allocated in order as they are written. */
+	void **chunks;
+	u32 chunk_count, chunk_max;
 	struct ant_core_extent *extents;
-	u32 extent_count;
+	u32 extent_count, extent_max;
 	u64 id, root_cookie, start_ns, finish_ns, expected_size;
 	/* size: the file's logical end; stored: bytes in the buffer. */
 	size_t size, stored, max_size;
@@ -67,14 +85,63 @@ static size_t reserved_size;
 static unsigned int handle_count;
 static u64 next_id;
 
+/* The largest budget one handle may have: half of the memory less a base
+ * allowance, because the dumped process is still resident while its copy is
+ * made. A bound, not a promise: running out of memory ends the core as a
+ * labelled partial. Never below the floor, never above the hard cap.
+ */
+u64 ant_core_max_bytes(void)
+{
+	u64 ram = (u64)totalram_pages() << PAGE_SHIFT, half = ram / 2;
+
+	half = half > ANT_CORE_RESERVE ? half - ANT_CORE_RESERVE : 0;
+	return round_down(clamp(half, ANT_CORE_FLOOR, ANT_CORE_HARD_MAX), 1ULL << 20);
+}
+
+/* What the budgets of all open handles may add up to. */
+u64 ant_core_pool_bytes(void)
+{
+	return 2 * ant_core_max_bytes();
+}
+
+u32 ant_core_max_timeout_ms(void)
+{
+	return ANT_CORE_TIMEOUT_MAX;
+}
+
+/* What CORE_CAPS tells the host about the limits above. */
+int ant_core_caps(const u8 *args, size_t args_len, void *reply, size_t capacity,
+		  size_t *reply_len)
+{
+	if (args_len != ANTC_HEADER_SIZE)
+		return -EINVAL;
+	if (capacity < ANTC_CORE_CAPS_SIZE)
+		return -EMSGSIZE;
+	memset(reply, 0, ANTC_CORE_CAPS_SIZE);
+	put_unaligned_le32(1, reply);
+	put_unaligned_le32(ANTC_CORE_CAPS_BUDGET | ANTC_CORE_CAPS_STORED |
+			   ANTC_CORE_CAPS_LONG_TIMEOUT | ANTC_CORE_CAPS_CHUNKED, reply + 4);
+	put_unaligned_le64(ant_core_max_bytes(), reply + 8);
+	put_unaligned_le64(ant_core_pool_bytes(), reply + 16);
+	put_unaligned_le32(ANT_CORE_HANDLES, reply + 24);
+	put_unaligned_le32(ant_core_max_timeout_ms(), reply + 28);
+	put_unaligned_le64((u64)totalram_pages() << PAGE_SHIFT, reply + 32);
+	put_unaligned_le64(ANT_CORE_PREALLOC, reply + 40);
+	*reply_len = ANTC_CORE_CAPS_SIZE;
+	return 0;
+}
+
 void ant_core_put(struct ant_core *core)
 {
 	size_t reserved;
+	u32 i;
 
 	if (IS_ERR_OR_NULL(core) || !refcount_dec_and_test(&core->refs))
 		return;
 	reserved = core->max_size;
-	vfree(core->data);
+	for (i = 0; i < core->chunk_count; i++)
+		vfree(core->chunks[i]);
+	kvfree(core->chunks);
 	vfree(core->extents);
 	kfree(core);
 	mutex_lock(&core_lock);
@@ -117,29 +184,58 @@ static void expire_cores(struct work_struct *work)
 		schedule_delayed_work(&core_expiry_work, 30 * HZ);
 }
 
-/* The data buffer (max_size bytes) and the extent table of one core. */
-static bool core_buffers(struct ant_core *core)
+static void *core_chunk_alloc(void)
 {
-	core->data = __vmalloc(core->max_size, GFP_KERNEL | __GFP_ZERO |
-			       __GFP_NORETRY | __GFP_NOWARN);
-	core->extents = __vmalloc(ANT_CORE_EXTENTS * sizeof(*core->extents),
+	/* Not zeroed: only bytes the sink wrote are ever exposed. */
+	return __vmalloc(ANT_CORE_CHUNK, GFP_KERNEL | __GFP_NORETRY | __GFP_NOWARN);
+}
+
+/* Make the chunks that cover the first end bytes of the buffer exist. */
+static int core_reserve(struct ant_core *core, u64 end)
+{
+	u32 need = DIV_ROUND_UP(end, ANT_CORE_CHUNK);
+
+	if (need > core->chunk_max)
+		return -EFBIG;
+	while (core->chunk_count < need) {
+		void *chunk = core_chunk_alloc();
+
+		if (!chunk)
+			return -ENOMEM;
+		core->chunks[core->chunk_count++] = chunk;
+	}
+	return 0;
+}
+
+/* The chunk table and the extent table of one core, and the first prealloc
+ * bytes of the buffer; the rest of it is allocated as it is written.
+ */
+static bool core_buffers(struct ant_core *core, u64 prealloc)
+{
+	core->chunk_max = DIV_ROUND_UP(core->max_size, ANT_CORE_CHUNK);
+	core->extent_max = max_t(u32, ANT_CORE_EXTENTS,
+				 core->max_size / PAGE_SIZE + 4096);
+	core->chunks = kvcalloc(core->chunk_max, sizeof(*core->chunks),
+				GFP_KERNEL | __GFP_NORETRY | __GFP_NOWARN);
+	core->extents = __vmalloc(array_size(core->extent_max, sizeof(*core->extents)),
 				  GFP_KERNEL | __GFP_ZERO | __GFP_NORETRY | __GFP_NOWARN);
-	return core->data && core->extents;
+	return core->chunks && core->extents &&
+	       !core_reserve(core, min_t(u64, prealloc, core->max_size));
 }
 
 static struct ant_core *core_create(u32 max_size, u32 timeout_ms, bool allocate)
 {
 	struct ant_core *core;
 
-	if (!max_size || max_size > ANT_CORE_MAX ||
-	    !timeout_ms || timeout_ms > 5000)
