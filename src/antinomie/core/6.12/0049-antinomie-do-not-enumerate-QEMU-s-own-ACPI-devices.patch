From 73dbc786c8bb69a6ede7f49c6941ba443791c39b Mon Sep 17 00:00:00 2001
From: MikiMiku <jonathanirvinjo@gmail.com>
Date: Wed, 21 Oct 2026 18:53:58 +0700
Subject: [PATCH] antinomie: do not enumerate QEMU's own ACPI devices

QEMU describes its fw_cfg device in the DSDT as QEMU0002. Enumerated, it is
/sys/bus/acpi/devices/QEMU0002:00 and its I/O ports are reserved as
"QEMU0002:00" in /proc/ioports: both world-readable, both name QEMU, even
when the stealth profile replaced every vendor string QEMU writes into the
firmware tables. In a kernel with the qemu_fw_cfg module (the Debian
configuration builds it), the device's modalias also loads it, and
/sys/firmware/qemu_fw_cfg appears.

The ACPI scan now skips devices whose _HID starts with QEMU (QEMU0001 pvpanic,
QEMU0002 fw_cfg and the like), like the UART it already hides for SPCR. The
guest needs none of them after the firmware: the firmware reads the kernel,
the initrd and the firmware tables through fw_cfg before the kernel runs, and
nothing in the guest kernel talks to it afterwards. The DSDT itself still
holds the device; reading it takes root.
---
 drivers/acpi/scan.c               |  3 ++-
 include/linux/antinomie_stealth.h |  7 +++++++
 kernel/antinomie/stealth.c        | 20 ++++++++++++++++++++
 3 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/drivers/acpi/scan.c b/drivers/acpi/scan.c
index 0774cc692..7cbeba238 100644
--- a/drivers/acpi/scan.c
+++ b/drivers/acpi/scan.c
@@ -12,6 +12,7 @@
 #include <linux/acpi.h>
 #include <linux/acpi_iort.h>
 #include <linux/acpi_viot.h>
+#include <linux/antinomie_stealth.h>
 #include <linux/iommu.h>
 #include <linux/signal.h>
 #include <linux/kthread.h>
@@ -2135,7 +2136,7 @@ static acpi_status acpi_bus_check_add(acpi_handle handle, bool first_pass,
 
 	switch (acpi_type) {
 	case ACPI_TYPE_DEVICE:
-		if (acpi_device_should_be_hidden(handle))
+		if (acpi_device_should_be_hidden(handle) || ant_acpi_device_hidden(handle))
 			return AE_OK;
 
 		if (first_pass) {
diff --git a/include/linux/antinomie_stealth.h b/include/linux/antinomie_stealth.h
index 3601e71fb..6a27fedd4 100644
--- a/include/linux/antinomie_stealth.h
+++ b/include/linux/antinomie_stealth.h
@@ -10,11 +10,18 @@ void ant_cmdline_take(char *cmdline);
 /* Whether a program reading symbols by name (/proc/kallsyms, wchan) must not
  * see this one: the recorder's own. name may be NULL. */
 bool ant_symbol_hidden(unsigned long address, const char *name);
+/* ACPI scan: whether the device (an acpi_handle) is one of QEMU's own, which
+ * the guest does not enumerate. */
+bool ant_acpi_device_hidden(void *handle);
 #else
 static inline void ant_cmdline_take(char *cmdline) { }
 static inline bool ant_symbol_hidden(unsigned long address, const char *name)
 {
 	return false;
 }
+static inline bool ant_acpi_device_hidden(void *handle)
+{
+	return false;
+}
 #endif
 #endif
diff --git a/kernel/antinomie/stealth.c b/kernel/antinomie/stealth.c
index 4eeca6d46..6f72f0971 100644
--- a/kernel/antinomie/stealth.c
+++ b/kernel/antinomie/stealth.c
@@ -11,11 +11,17 @@
  * elsewhere named ant_*) are left out of what programs read by name:
  * /proc/kallsyms and /proc/<pid>/wchan. The kernel itself still has them, so
  * stack traces, kprobes and every internal lookup work as before.
+ *
+ * QEMU's own ACPI devices (HID QEMU0001 pvpanic, QEMU0002 fw_cfg, ...) are not
+ * enumerated: no driver of this kernel uses them, and enumerated they appear
+ * in /sys/bus/acpi/devices and /proc/ioports by their QEMU names.
  */
+#include <linux/acpi.h>
 #include <linux/antinomie_stealth.h>
 #include <linux/ctype.h>
 #include <linux/init.h>
 #include <linux/kernel.h>
+#include <linux/slab.h>
 #include <linux/string.h>
 #include <asm/setup.h>
 #include "sections.h"
@@ -101,3 +107,17 @@ bool ant_symbol_hidden(unsigned long address, const char *name)
 			return true;
 	return name && ant_symbol_name(name);
 }
+
+#ifdef CONFIG_ACPI
+bool ant_acpi_device_hidden(void *handle)
+{
+	struct acpi_device_info *info;
+	bool hidden;
+
+	if (ACPI_FAILURE(acpi_get_object_info(handle, &info)))
+		return false;
+	hidden = (info->valid & ACPI_VALID_HID) && !strncmp(info->hardware_id.string, "QEMU", 4);
+	kfree(info);
+	return hidden;
+}
+#endif
-- 
2.53.0

