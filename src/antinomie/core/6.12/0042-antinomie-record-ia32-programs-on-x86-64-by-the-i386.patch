From dc3ac1fe5fa8a7a5c9d98b5a6c6b56506064fb4a Mon Sep 17 00:00:00 2001
From: MikiMiku <jonathanirvinjo@gmail.com>
Date: Sun, 1 Nov 2026 14:53:43 +0700
Subject: [PATCH] antinomie: record ia32 programs on x86-64 by the i386 table

An x86-64 kernel with CONFIG_IA32_EMULATION runs 32-bit x86 (i386)
programs, the shape of many older Linux samples (XorDDoS, Rex). Their
calls were recorded with their numbers only (ANT_ABI_NONE): no
arguments decoded, nothing captured, and an i386 number read as an
x86-64 one names another call.

They are now recorded as ANT_ABI_COMPAT (3, already in ARCH_INFO's ABI
mask definition) with the i386 table generated from
arch/x86/entry/syscalls/syscall_32.tbl (<asm/antinomie_compat_syscalls.h>,
the guest copy of protocol/i386/native-syscalls.json), as patch 37 does
for AArch32 programs on arm64: each record's arguments are the call's
registers' low halves (a 64-bit argument takes two consecutive
registers), the 32-bit signed ones sign-extended. A call that is an
x86-64 call with the same arguments and objects of one layout (264 of
them) is captured by the native code under the native number while its
records keep the i386 number and ABI; execve and execveat read their
vectors as 32-bit pointers (linux-6.12.94/x86/pointer); every other
call has its path strings captured and its other pointers recorded by
address.

i386 programs reach the socket calls through socketcall(call, args) as
often as directly (glibc for kernels before 4.3, Go): a socketcall is
recorded as the direct call it makes, its arguments read from its
array (accept as accept4 with no flags, send and recv as sendto and
recvfrom with no address, as net/socket.c makes them), with a
socketcall.call field naming the call; an array that cannot be read
leaves the socketcall itself.

The compat ABI's __NR_ names come from the architecture header
(ANT_COMPAT_UNISTD, ANT_COMPAT_NR()): arm64's objects are unchanged.
On x86-64, recorder.o (the compat code, now compiled there) and
control.o (ARCH_INFO's ABI mask gains bit 3) change; the hooks and
every other object are unchanged. Process cores of ia32 programs are
still not written. No contract change.
---
 arch/arm64/include/asm/antinomie.h            |    3 +
 arch/x86/include/asm/antinomie.h              |   20 +-
 .../include/asm/antinomie_compat_syscalls.h   | 5588 +++++++++++++++++
 kernel/antinomie/recorder.c                   |   74 +-
 4 files changed, 5681 insertions(+), 4 deletions(-)
 create mode 100644 arch/x86/include/asm/antinomie_compat_syscalls.h

diff --git a/arch/arm64/include/asm/antinomie.h b/arch/arm64/include/asm/antinomie.h
index 6833fff82..9af6c1071 100644
--- a/arch/arm64/include/asm/antinomie.h
+++ b/arch/arm64/include/asm/antinomie.h
@@ -34,6 +34,9 @@
  */
 #define ANT_ABI_COMPAT 3
 #define ANT_ARCH_ABI_MASK (BIT(ANT_ABI_NATIVE) | BIT(ANT_ABI_COMPAT))
+/* The compat ABI's __NR_ names, for the recorder. */
+#define ANT_COMPAT_UNISTD <asm/unistd_compat_32.h>
+#define ANT_COMPAT_NR(name) __NR_compat32_##name
 #else
 #define ANT_ARCH_ABI_MASK BIT(ANT_ABI_NATIVE)
 #endif
diff --git a/arch/x86/include/asm/antinomie.h b/arch/x86/include/asm/antinomie.h
index 9eb8809a3..f5fd7c6af 100644
--- a/arch/x86/include/asm/antinomie.h
+++ b/arch/x86/include/asm/antinomie.h
@@ -29,18 +29,34 @@
  */
 #define ANT_ABI_X32 2
 
+#ifdef CONFIG_IA32_EMULATION
+/* ia32 programs' calls: i386 numbers, described by
+ * <asm/antinomie_compat_syscalls.h> (protocol/i386/native-syscalls.json).
+ * Their socketcall is recorded as the socket call it makes.
+ */
+#define ANT_ABI_COMPAT 3
+#define ANT_COMPAT_UNISTD <asm/unistd_32_ia32.h>
+#define ANT_COMPAT_NR(name) __NR_ia32_##name
+#define ANT_ARCH_COMPAT_SOCKETCALL 1
+#define ANT_ARCH_COMPAT_MASK BIT(ANT_ABI_COMPAT)
+#else
+#define ANT_ARCH_COMPAT_MASK 0
+#endif
+
 /* ARCH_INFO: the ABIs system call records may carry (bit n: ABI n), and the
  * width of user virtual addresses.
  */
-#define ANT_ARCH_ABI_MASK (BIT(ANT_ABI_NATIVE) | \
+#define ANT_ARCH_ABI_MASK (BIT(ANT_ABI_NATIVE) | ANT_ARCH_COMPAT_MASK | \
 	(IS_ENABLED(CONFIG_X86_X32_ABI) ? BIT(ANT_ABI_X32) : 0))
 #define ANT_ARCH_USER_VA_BITS __VIRTUAL_MASK_SHIFT
 
 /* The ABI of the system call being entered, the abi field of its records. */
 static __always_inline u16 ant_arch_syscall_abi(long nr)
 {
+#ifdef ANT_ABI_COMPAT
 	if (in_ia32_syscall())
-		return ANT_ABI_NONE;
+		return ANT_ABI_COMPAT;
+#endif
 	return nr & __X32_SYSCALL_BIT ? ANT_ABI_X32 : ANT_ABI_NATIVE;
 }
 
