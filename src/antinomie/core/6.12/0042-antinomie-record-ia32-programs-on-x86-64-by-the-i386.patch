+#ifdef ANT_ARCH_COMPAT_SOCKETCALL
+/* socketcall(call, args) makes one socket call with the arguments at args
+ * (32-bit values, their number per call as net/socket.c's nargs). Its records
+ * are that call's own, by the compat table's direct number, as the kernel
+ * makes it: accept is accept4 with no flags, send and recv are sendto and
+ * recvfrom with no address. A call made so carries a socketcall.call field.
+ */
+static const struct { u16 nr; u8 args; } socketcall_calls[SYS_SENDMMSG + 1] = {
+	[SYS_SOCKET] = { ANT_COMPAT_NR(socket), 3 },
+	[SYS_BIND] = { ANT_COMPAT_NR(bind), 3 },
+	[SYS_CONNECT] = { ANT_COMPAT_NR(connect), 3 },
+	[SYS_LISTEN] = { ANT_COMPAT_NR(listen), 2 },
+	[SYS_ACCEPT] = { ANT_COMPAT_NR(accept4), 3 },
+	[SYS_GETSOCKNAME] = { ANT_COMPAT_NR(getsockname), 3 },
+	[SYS_GETPEERNAME] = { ANT_COMPAT_NR(getpeername), 3 },
+	[SYS_SOCKETPAIR] = { ANT_COMPAT_NR(socketpair), 4 },
+	[SYS_SEND] = { ANT_COMPAT_NR(sendto), 4 },
+	[SYS_RECV] = { ANT_COMPAT_NR(recvfrom), 4 },
+	[SYS_SENDTO] = { ANT_COMPAT_NR(sendto), 6 },
+	[SYS_RECVFROM] = { ANT_COMPAT_NR(recvfrom), 6 },
+	[SYS_SHUTDOWN] = { ANT_COMPAT_NR(shutdown), 2 },
+	[SYS_SETSOCKOPT] = { ANT_COMPAT_NR(setsockopt), 5 },
+	[SYS_GETSOCKOPT] = { ANT_COMPAT_NR(getsockopt), 5 },
+	[SYS_SENDMSG] = { ANT_COMPAT_NR(sendmsg), 3 },
+	[SYS_RECVMSG] = { ANT_COMPAT_NR(recvmsg), 3 },
+	[SYS_ACCEPT4] = { ANT_COMPAT_NR(accept4), 4 },
+	[SYS_RECVMMSG] = { ANT_COMPAT_NR(recvmmsg), 5 },
+	[SYS_SENDMMSG] = { ANT_COMPAT_NR(sendmmsg), 4 },
+};
+
+/* A socketcall's call, its arguments read from its array; an unknown call or
+ * an array that cannot be read leaves the socketcall itself. */
+static void compat_socketcall(struct ant_task *ctx)
+{
+	u32 values[6] = { 0 };
+	u64 call = lower_32_bits(ctx->args[0]);
+	int i;
+
+	ctx->socketcall = 0;
+	if (ctx->nr != ANT_COMPAT_NR(socketcall) || call < SYS_SOCKET || call > SYS_SENDMMSG ||
+	    copy_from_user_nofault(values,
+				   (void __user *)(unsigned long)lower_32_bits(ctx->args[1]),
+				   socketcall_calls[call].args * sizeof(u32)))
+		return;
+	ctx->socketcall = call;
+	ctx->nr = socketcall_calls[call].nr;
+	for (i = 0; i < 6; i++)
+		ctx->args[i] = values[i];
+}
+#endif
