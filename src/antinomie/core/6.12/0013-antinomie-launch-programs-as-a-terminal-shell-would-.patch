From 3d44ab8917bf1d5027b859f49deb5d5792c37b4c Mon Sep 17 00:00:00 2001
From: MikiMiku <jonathanirvinjo@gmail.com>
Date: Mon, 26 Oct 2026 09:13:00 +0700
Subject: [PATCH] antinomie: launch programs as a terminal shell would have run
 them

A program started through a user-mode helper does not look like one a
user started: its parent is kthreadd, it leads its own session, and a
session leader's exit hangs up its terminal's foreground group, which
kills a child forked just before (the usual way a program daemonizes).

By default the launched program now keeps the terminal as its
controlling terminal but no longer leads the session, as under a shell,
so its children survive its exit. With the optional EXEC flag
SHELL_JOB it starts as a job of a terminal shell that has since closed:
init adopts it, it leads its own process group, still the terminal's
foreground group, in a session whose id is a PID allocated for it and
held by no process, as a closed shell's would be. Nothing runs in the
guest for it. TRACER_CAPS offers the flag.

No kernel file outside kernel/antinomie is touched.

Contract: SHELL_JOB and its capability bit are additive within revision
17; an older guest does not offer the flag and a newer host never sends
it there.
---
 kernel/antinomie/control.c      | 69 ++++++++++++++++++++++++++++++++-
 kernel/antinomie/control_wire.h |  9 ++++-
 2 files changed, 74 insertions(+), 4 deletions(-)

diff --git a/kernel/antinomie/control.c b/kernel/antinomie/control.c
index c36cf60..c07ebf1 100644
--- a/kernel/antinomie/control.c
+++ b/kernel/antinomie/control.c
@@ -11,8 +11,10 @@
 #include <linux/init.h>
 #include <linux/namei.h>
 #include <linux/pid.h>
+#include <linux/pid_namespace.h>
 #include <linux/reboot.h>
 #include <linux/sched/signal.h>
+#include <linux/sched/task.h>
 #include <linux/sched/user.h>
 #include <linux/slab.h>
 #include <linux/syscalls.h>
@@ -47,6 +49,10 @@ struct ant_launch {
 	kgid_t gid;
 	struct ant_specimen *specimen;
 	struct ant_core *core;
+	/* EXEC_SHELL_JOB: the session the program joins, allocated before it
+	 * so that its id is lower; owned here until launch_as_job() moves it
+	 * into the program's session. */
+	struct pid *job_session;
 	u32 hash_flags;
 	bool debug;
 };
@@ -151,6 +157,9 @@ static void free_vector(char **vector)
 
 static void free_launch(struct ant_launch *launch)
 {
+	/* Never attached to a task: freed like a failed fork's PID. */
+	if (launch->job_session)
+		free_pid(launch->job_session);
 	free_vector(launch->argv);
 	free_vector(launch->envp);
 	kfree(launch->path);
@@ -164,6 +173,42 @@ static void launch_cleanup(struct subprocess_info *info)
 	free_launch(info->data);
 }
 
+/*
+ * A user-mode helper is a child of kthreadd (PID 2), which no program started
+ * from a shell or a service has, and setsid() made it the leader of its own
+ * session. As a job of a terminal shell that has since closed, the program
+ * looks like one a user started: init adopted it, as it adopts every orphan
+ * (and reaps it), and it leads its own process group, still the terminal's
+ * foreground group, in the shell's session, whose leader is gone. The session
+ * id is a PID allocated for it before the program's own, which no process
+ * holds, as a closed shell's would be. Nothing runs in the guest for it.
+ */
+static void launch_as_job(struct ant_launch *launch, struct tty_struct *tty)
+{
+	struct pid *session = launch->job_session, *old;
+	struct task_struct *reaper;
+	unsigned long flags;
+
+	launch->job_session = NULL;
+	write_lock_irq(&tasklist_lock);
+	reaper = task_active_pid_ns(current)->child_reaper;
+	if (rcu_access_pointer(current->real_parent) != reaper) {
+		list_move_tail(&current->sibling, &reaper->children);
+		RCU_INIT_POINTER(current->real_parent, reaper);
+		current->parent = current->real_parent;
+		current->exit_signal = SIGCHLD;
+		current->parent_exec_id = reaper->self_exec_id;
+	}
+	/* The PID passes to the session: it is freed with its last member. */
+	change_pid(current, PIDTYPE_SID, session);
+	write_unlock_irq(&tasklist_lock);
+	spin_lock_irqsave(&tty->ctrl.lock, flags);
+	old = tty->ctrl.session;
+	tty->ctrl.session = get_pid(session);
+	spin_unlock_irqrestore(&tty->ctrl.lock, flags);
+	put_pid(old);
+}
+
 static int launch_init(struct subprocess_info *info, struct cred *cred)
 {
 	struct ant_launch *launch = info->data;
@@ -230,6 +275,16 @@ static int launch_init(struct subprocess_info *info, struct cred *cred)
 		close_fd(fd);
 	if (error)
 		return error;
+	/* The terminal is now the session's controlling terminal. The program
+	 * keeps it, but does not lead the session, as under a terminal's shell:
+	 * a session leader's exit hangs up the foreground process group, which
+	 * would kill a child the program forked before that child could call
+	 * setsid() (a daemonizing program, most malware). */
+	write_lock_irq(&tasklist_lock);
+	current->signal->leader = 0;
+	write_unlock_irq(&tasklist_lock);
+	if (launch->job_session)
+		launch_as_job(launch, tty);
 	error = ant_monitor_launch(launch->path, launch->argv, launch->envp);
 	if (error)
 		return error;
@@ -260,7 +315,7 @@ static int execute(const u8 *args, size_t args_len, void *reply, size_t *reply_l
 		return -EINVAL;
 	flags = get_unaligned_le32(args + 4);
 	if (flags & ~(ANTC_EXEC_SPECIMEN | ANTC_EXEC_CORE | ANTC_EXEC_DEBUG |
-		      ANTC_EXEC_HASH_ROOT | ANTC_EXEC_HASH_WRITES))
+		      ANTC_EXEC_HASH_ROOT | ANTC_EXEC_HASH_WRITES | ANTC_EXEC_SHELL_JOB))
 		return -EINVAL;
 	if (flags & ANTC_EXEC_DEBUG) {
 		error = ant_debug_launch_check();
@@ -334,6 +389,15 @@ static int execute(const u8 *args, size_t args_len, void *reply, size_t *reply_l
 		error = -EINVAL;
 		goto fail;
 	}
+	if (flags & ANTC_EXEC_SHELL_JOB) {
+		struct pid *job_session = alloc_pid(&init_pid_ns, NULL, 0);
+
+		if (IS_ERR(job_session)) {
+			error = PTR_ERR(job_session);
+			goto fail;
+		}
+		launch->job_session = job_session;
+	}
 	session->master = filp_open("/dev/ptmx", O_RDWR | O_NONBLOCK | O_NOCTTY, 0);
 	if (IS_ERR(session->master)) {
 		error = PTR_ERR(session->master);
@@ -614,7 +678,8 @@ static int command(const void *data, size_t args_len, void *reply,
 			return -EINVAL;
 		memset(reply, 0, ANTC_TRACER_CAPS_SIZE);
 		put_unaligned_le32(ANTC_TRACER_ABI, reply);
-		put_unaligned_le32(ANTC_EXEC_HASH_ROOT | ANTC_EXEC_HASH_WRITES, reply + 4);
+		put_unaligned_le32(ANTC_EXEC_HASH_ROOT | ANTC_EXEC_HASH_WRITES |
+				   ANTC_EXEC_SHELL_JOB, reply + 4);
 		put_unaligned_le32(ANTC_HASH_FILE_MAX, reply + 8);
 		put_unaligned_le32(ANTC_HASH_QUEUE, reply + 12);
 		put_unaligned_le64(ANTC_HASH_PENDING_MAX, reply + 16);
diff --git a/kernel/antinomie/control_wire.h b/kernel/antinomie/control_wire.h
index c43d4d4..103ac5d 100644
--- a/kernel/antinomie/control_wire.h
+++ b/kernel/antinomie/control_wire.h
@@ -62,6 +62,7 @@
  * TRACER_CAPS lists them; an older guest rejects unknown flags with -EINVAL. */
 #define ANTC_EXEC_HASH_ROOT 8
 #define ANTC_EXEC_HASH_WRITES 16
+#define ANTC_EXEC_SHELL_JOB 32
 #define ANTC_CORE_STATUS 0x1060
 #define ANTC_CORE_READ 0x1061
 #define ANTC_CORE_RELEASE 0x1062
@@ -366,10 +367,14 @@
  * Stop escalation end it.
  * EXEC_HASH_ROOT hashes the program's own image at its exec; EXEC_HASH_WRITES
  * hashes the regular files the run writes, when the last writer closes them
- * (see lifecycle.file_hash). Neither adds request or reply bytes.
+ * (see lifecycle.file_hash). EXEC_SHELL_JOB starts the program as a job of a
+ * terminal shell that has closed: its parent is init (PID 1), not kthreadd,
+ * and it leads its own process group, the terminal's foreground group, in a
+ * session whose leader no longer exists (the session id is a PID no process
+ * has). None of them adds request or reply bytes.
  * TRACER_CAPS: header only (8 bytes). Reply 32 bytes: u32 abi=1 at 0, u32
  * exec_flags at 4 (the optional EXEC flags this guest accepts: HASH_ROOT,
- * HASH_WRITES), u32 hash file limit at 8 (ANTC_HASH_FILE_MAX), u32 hash queue
+ * HASH_WRITES, SHELL_JOB), u32 hash file limit at 8 (ANTC_HASH_FILE_MAX), u32 hash queue
  * jobs at 12 (ANTC_HASH_QUEUE), u64 hash queued byte limit at 16
  * (ANTC_HASH_PENDING_MAX), zero at 24.
  * Arm failure has id/size=0 and negative errno; execution still succeeds.
-- 
2.53.0

