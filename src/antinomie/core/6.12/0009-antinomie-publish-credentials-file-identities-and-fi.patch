diff --git a/io_uring/fs.c b/io_uring/fs.c
index 924132d..0d3fdbf 100644
--- a/io_uring/fs.c
+++ b/io_uring/fs.c
@@ -47,6 +47,19 @@ struct io_link {
 	int				flags;
 };
 
+/* A rename, link or unlink runs on a worker with no traced call of its own:
+ * the identity the operation publishes when it succeeded (do_renameat2,
+ * do_linkat, do_unlinkat, do_rmdir) goes to the request as its operand, with
+ * the link count the operation left. Two requests on one file, run beside
+ * each other, each say what their own operation did.
+ */
+static inline void ant_uring_target(struct io_kiocb *req, bool on)
+{
+#ifdef CONFIG_ANTINOMIE
+	current->ant_async_target = on ? &req->ant_async : NULL;
+#endif
+}
+
 int io_renameat_prep(struct io_kiocb *req, const struct io_uring_sqe *sqe)
 {
 	struct io_rename *ren = io_kiocb_to_cmd(req, struct io_rename);
@@ -89,8 +102,10 @@ int io_renameat(struct io_kiocb *req, unsigned int issue_flags)
 
 	WARN_ON_ONCE(issue_flags & IO_URING_F_NONBLOCK);
 
+	ant_uring_target(req, true);
 	ret = do_renameat2(ren->old_dfd, ren->oldpath, ren->new_dfd,
 				ren->newpath, ren->flags);
+	ant_uring_target(req, false);
 
 	req->flags &= ~REQ_F_NEED_CLEANUP;
 	io_req_set_res(req, ret, 0);
@@ -140,10 +155,12 @@ int io_unlinkat(struct io_kiocb *req, unsigned int issue_flags)
 
 	WARN_ON_ONCE(issue_flags & IO_URING_F_NONBLOCK);
 
+	ant_uring_target(req, true);
 	if (un->flags & AT_REMOVEDIR)
 		ret = do_rmdir(un->dfd, un->filename);
 	else
 		ret = do_unlinkat(un->dfd, un->filename);
+	ant_uring_target(req, false);
 
 	req->flags &= ~REQ_F_NEED_CLEANUP;
 	io_req_set_res(req, ret, 0);
@@ -292,8 +309,10 @@ int io_linkat(struct io_kiocb *req, unsigned int issue_flags)
 
 	WARN_ON_ONCE(issue_flags & IO_URING_F_NONBLOCK);
 
+	ant_uring_target(req, true);
 	ret = do_linkat(lnk->old_dfd, lnk->oldpath, lnk->new_dfd,
 				lnk->newpath, lnk->flags);
+	ant_uring_target(req, false);
 
 	req->flags &= ~REQ_F_NEED_CLEANUP;
 	io_req_set_res(req, ret, 0);
diff --git a/io_uring/io_uring.c b/io_uring/io_uring.c
index dda8c39..8ff6d76 100644
--- a/io_uring/io_uring.c
+++ b/io_uring/io_uring.c
@@ -1715,6 +1715,36 @@ static bool io_assign_file(struct io_kiocb *req, const struct io_issue_def *def,
 
 #define REQ_ISSUE_SLOW_FLAGS	(REQ_F_CREDS | REQ_F_ARM_LTIMEOUT)
 
+#ifdef CONFIG_ANTINOMIE
+/* The requests that act on a file their descriptor names, whose identity is
+ * recorded so a descriptor in a registered table or one the run never saw
+ * opened can still be tied to a file.
+ */
+static bool ant_uring_file_opcode(u8 opcode)
+{
+	switch (opcode) {
+	case IORING_OP_READV:
+	case IORING_OP_WRITEV:
+	case IORING_OP_READ_FIXED:
+	case IORING_OP_WRITE_FIXED:
+	case IORING_OP_READ:
+	case IORING_OP_WRITE:
+	case IORING_OP_READ_MULTISHOT:
+	case IORING_OP_FSYNC:
+	case IORING_OP_FTRUNCATE:
+	case IORING_OP_FALLOCATE:
+	case IORING_OP_SYNC_FILE_RANGE:
+	case IORING_OP_FADVISE:
+	case IORING_OP_SPLICE:
+	case IORING_OP_FSETXATTR:
+	case IORING_OP_FGETXATTR:
+		return true;
+	default:
+		return false;
+	}
+}
+#endif
+
 static int io_issue_sqe(struct io_kiocb *req, unsigned int issue_flags)
 {
 	const struct io_issue_def *def = &io_issue_defs[req->opcode];
@@ -1724,6 +1754,11 @@ static int io_issue_sqe(struct io_kiocb *req, unsigned int issue_flags)
 
 	if (unlikely(!io_assign_file(req, def, issue_flags)))
 		return -EBADF;
+#ifdef CONFIG_ANTINOMIE
+	if (req->file && ant_uring_file_opcode(req->opcode) &&
+	    S_ISREG(file_inode(req->file)->i_mode))
+		ant_uring_file_id(req, ANT_FILE_ID_ISSUE, file_inode(req->file), 0);
+#endif
 
 	if (unlikely(req->flags & REQ_ISSUE_SLOW_FLAGS)) {
 		if ((req->flags & REQ_F_CREDS) && req->creds != current_cred())
