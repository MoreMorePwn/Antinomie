+
+/* A task that has left its run (ant_run_exit() detached it) still closes its
+ * files afterwards, in exit_task_work(): its root cookie finds the run.
+ */
+bool ant_run_hashes(struct task_struct *task, u32 flag)
+{
+	struct ant_run *run = READ_ONCE(task->ant_run);
+	u64 cookie = READ_ONCE(task->ant_root_cookie);
+	unsigned long irqflags;
+	bool hashes;
+
+	if (run)
+		return READ_ONCE(run->hash_flags) & flag;
+	if (!cookie)
+		return false;
+	spin_lock_irqsave(&run_lock, irqflags);
+	run = find_run(cookie);
+	hashes = run && (run->hash_flags & flag);
+	spin_unlock_irqrestore(&run_lock, irqflags);
+	return hashes;
+}
