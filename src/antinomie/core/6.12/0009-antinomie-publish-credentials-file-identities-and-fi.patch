@@ -0,0 +1,690 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* SHA-256 of an executed image, of a file about to be deleted and, for a run
+ * that asks for it, of a file the run wrote, when its last writer closes it.
+ *
+ * The traced task only takes references and queues a small job; a worker on
+ * the system unbound workqueue reopens the file, hashes it and publishes the
+ * result as a lifecycle record of the call that triggered it. Nothing here
+ * runs a helper process, opens a descriptor in the guest or starts a
+ * workqueue of its own.
+ *
+ * Budget: a file above ANTC_HASH_FILE_MAX is not read, at most
+ * ANTC_HASH_QUEUE jobs wait at once and at most ANTC_HASH_PENDING_MAX bytes
+ * are queued. Every other outcome is recorded with its reason: unsupported
+ * filesystem, not a regular file, queue or budget exhausted, no memory, read
+ * error. A record that cannot be sent at all is counted and reported in the
+ * next record that is. The worker reads through a private open with no
+ * notification and no access-time update, one 64 KiB chunk at a time.
+ *
+ * A written file is hashed when the last open-for-writing reference to it goes
+ * (the inode's writer count drops to zero in __fput()), by whichever task of
+ * the run released it: in task work after close(), at exit, or after the call
+ * that dropped the last reference. That moment is the content the run left,
+ * the way an inotify CLOSE_WRITE reader sees it; a file opened for writing and
+ * not written is hashed all the same. The record carries the file's identity,
+ * because the call it belongs to (the task's last) need not name the file.
+ * Writers that are not tasks of the run (another process, an io_uring worker,
+ * the delayed fput worker) are not followed.
+ *
+ * The digest describes the bytes the worker read, at hashing time, never the
+ * bytes at the call: the file is read some time after the call returned. The
+ * call records the file's state (inode identity, size, modification and change
+ * time, change counter) and the worker compares it with the state after the
+ * read; any difference sets CHANGED. A state that matches is strong evidence,
+ * not proof, on a filesystem without a change counter: a rewrite within one
+ * timestamp tick that restores the size leaves nothing to compare. The change
+ * counter is armed (queried) when the state is taken, so on ext4 and tmpfs a
+ * later write moves it even then.
+ */
+#include <crypto/sha2.h>
+#include <linux/antinomie_monitor.h>
+#include <linux/atomic.h>
+#include <linux/dcache.h>
+#include <linux/err.h>
+#include <linux/fcntl.h>
+#include <linux/file.h>
+#include <linux/fs.h>
+#include <linux/init.h>
+#include <linux/iversion.h>
+#include <linux/ktime.h>
+#include <linux/list.h>
+#include <linux/kdev_t.h>
+#include <linux/magic.h>
+#include <linux/mm.h>
+#include <linux/mount.h>
+#include <linux/path.h>
+#include <linux/sched.h>
+#include <linux/sched/task.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/unaligned.h>
+#include <linux/delay.h>
+#include <linux/workqueue.h>
+#include "async.h"
+#include "run.h"
+#include "control_wire.h"
+#include "hash.h"
+#include "notes.h"
+
+#define ANT_HASH_CHUNK (64U * 1024)
+#define ANT_HASH_CACHE 32
+#define ANT_HASH_CACHE_TTL_NS (30ULL * NSEC_PER_SEC)
+/* Refusals waiting for the worker to publish them (deferred jobs only). */
+#define ANT_HASH_REPORTS 64
+#define ANT_HASH_KEY "lifecycle.file_hash"
+#define ANT_HASH_LAYOUT "antinomie.hash/1"
+#define ANT_HASH_WRITE_LAYOUT "antinomie.hash/2"
+
+/* The identity and state of a file's inode. */
+struct ant_hash_state {
+	u64 dev, ino, size, mtime_ns, ctime_ns, version;
+	u32 generation;
+	bool versioned;
+};
+
+struct ant_hash_job {
+	struct list_head node;
+	struct ant_async_event event;
+	struct path path;
+	struct ant_hash_state seen;
+	u64 nr, size, reserved, queued_ns;
+	s32 error;
+	/* WRITE: the file at its last close. */
+	u32 mode, nlink;
+	u8 kind, status, flags;
+	/* An unlink of this job's file is in progress (see unlink_begin()). */
+	bool unlinking;
+	/* Outside a traced call: even a refusal is published by the worker. */
+	bool deferred;
+};
+
+/* Digests of recently hashed files, so an exec storm of one program reads it
+ * once. An entry matches only the same inode in the same state, including its
+ * change counter, and only for a bounded monotonic time, so a file written
+ * since is never served stale. A filesystem without a change counter is never
+ * cached: its coarse timestamps cannot tell a rewrite within one tick apart,
+ * and the page cache already makes the second read cheap.
+ */
+struct ant_hash_cached {
+	struct ant_hash_state state;
+	u64 stored_ns;
+	bool valid;
+	u8 digest[SHA256_DIGEST_SIZE];
+};
+
+static DEFINE_SPINLOCK(hash_lock);
+static struct ant_hash_cached cache[ANT_HASH_CACHE];
+static unsigned int cache_next;
+static LIST_HEAD(hash_jobs);
+static LIST_HEAD(hash_reports);
+static unsigned int pending_reports;
+/* The job a worker is processing, which is on no list; see unlink_begin(). */
+static struct ant_hash_job *running;
+static unsigned int pending_jobs;
+static u64 pending_bytes;
+static bool scheduled;
+static atomic_t lost = ATOMIC_INIT(0);
+
+static void hash_run(struct work_struct *work);
+static DECLARE_WORK(hash_work, hash_run);
+
+static void job_free(struct ant_hash_job *job)
+{
+	if (job->path.dentry)
+		path_put(&job->path);
+	put_task_struct(job->event.origin);
+	kfree(job);
+}
+
+/* A job for the traced call in progress or, with @last, for the task's last
+ * traced call (or its launch): see ant_monitor_identity_last().
+ */
+static struct ant_hash_job *job_new(u8 kind, bool last)
+{
+	struct ant_hash_job *job;
+	bool known;
+
+	if (!current->ant_monitor)
+		return NULL;
+	job = kzalloc(sizeof(*job), GFP_NOWAIT | __GFP_NOWARN);
+	if (!job) {
+		atomic_inc(&lost);
+		return NULL;
+	}
+	known = last ? ant_monitor_identity_last(&job->event, &job->nr) :
+		ant_monitor_identity(&job->event, &job->nr);
+	if (!known) {
+		kfree(job);
+		return NULL;
+	}
+	get_task_struct(job->event.origin);
+	job->kind = kind;
+	return job;
+}
+
+static void state_of(struct ant_hash_state *state, struct inode *inode)
+{
+	memset(state, 0, sizeof(*state));
+	state->dev = new_encode_dev(inode->i_sb->s_dev);
+	state->ino = inode->i_ino;
+	state->generation = inode->i_generation;
+	state->size = i_size_read(inode);
+	state->mtime_ns = timespec64_to_ns(&(struct timespec64){
+		.tv_sec = inode_get_mtime_sec(inode), .tv_nsec = inode_get_mtime_nsec(inode) });
+	state->ctime_ns = timespec64_to_ns(&(struct timespec64){
+		.tv_sec = inode_get_ctime_sec(inode), .tv_nsec = inode_get_ctime_nsec(inode) });
+	/* Querying arms the counter: from now on every change moves it, even
+	 * one that leaves the coarse timestamps and the size alone.
+	 */
+	state->versioned = IS_I_VERSION(inode);
+	if (state->versioned)
+		state->version = inode_query_iversion(inode);
+}
+
+static bool state_same(const struct ant_hash_state *a, const struct ant_hash_state *b)
+{
+	return a->dev == b->dev && a->ino == b->ino && a->generation == b->generation &&
+	       a->size == b->size && a->mtime_ns == b->mtime_ns && a->ctime_ns == b->ctime_ns &&
+	       a->versioned == b->versioned && a->version == b->version;
+}
+
+static bool same_inode(const struct ant_hash_state *a, const struct ant_hash_state *b)
+{
+	return a->dev == b->dev && a->ino == b->ino && a->generation == b->generation;
+}
+
+static u8 classify(struct inode *inode, struct ant_hash_state *state)
+{
+	u32 magic = inode->i_sb->s_magic;
+
+	state_of(state, inode);
+	if (!S_ISREG(inode->i_mode))
+		return ANTC_HASH_NOT_REGULAR;
+	/* The same filesystems the specimen copy reads, plus the initial ramfs.
+	 * A filesystem that can block on a remote or user-space peer is never
+	 * opened.
+	 */
+	if (magic != EXT4_SUPER_MAGIC && magic != TMPFS_MAGIC && magic != RAMFS_MAGIC)
+		return ANTC_HASH_UNSUPPORTED_FS;
+	if (state->size > ANTC_HASH_FILE_MAX)
+		return ANTC_HASH_TOO_LARGE;
+	return ANTC_HASH_OK;
+}
+
+static bool cache_find(const struct ant_hash_state *key, u8 *digest)
+{
+	u64 now = ktime_get_ns();
+	bool found = false;
+	unsigned int i;
+
+	if (!key->versioned)
+		return false;
+	spin_lock(&hash_lock);
+	for (i = 0; i < ANT_HASH_CACHE && !found; i++) {
+		const struct ant_hash_cached *entry = &cache[i];
+
+		if (entry->valid && now - entry->stored_ns <= ANT_HASH_CACHE_TTL_NS &&
+		    state_same(&entry->state, key)) {
+			memcpy(digest, entry->digest, SHA256_DIGEST_SIZE);
+			found = true;
+		}
+	}
+	spin_unlock(&hash_lock);
+	return found;
+}
+
+static void cache_store(const struct ant_hash_state *key, const u8 *digest)
+{
+	if (!key->versioned)
+		return;
+	spin_lock(&hash_lock);
+	cache[cache_next].state = *key;
+	cache[cache_next].stored_ns = ktime_get_ns();
+	memcpy(cache[cache_next].digest, digest, SHA256_DIGEST_SIZE);
+	cache[cache_next].valid = true;
+	cache_next = (cache_next + 1) % ANT_HASH_CACHE;
+	spin_unlock(&hash_lock);
+}
+
+/* The record of @job: ANTC_HASH_SIZE bytes, ANTC_HASH_WRITE_SIZE for WRITE. */
+static size_t pack(const struct ant_hash_job *job, u8 status, u8 flags, const u8 *digest,
+		   u64 hashed, u32 queue_us, u32 hash_us, u8 *rec)
+{
+	memset(rec, 0, ANTC_HASH_WRITE_SIZE);
+	rec[0] = job->kind;
+	rec[1] = status;
+	rec[2] = digest ? ANTC_HASH_SHA256 : 0;
+	rec[3] = flags;
+	put_unaligned_le32(job->error, rec + 4);
+	put_unaligned_le64(job->size, rec + 8);
+	put_unaligned_le64(hashed, rec + 16);
+	put_unaligned_le64(ANTC_HASH_FILE_MAX, rec + 24);
+	if (digest)
+		memcpy(rec + 32, digest, SHA256_DIGEST_SIZE);
+	put_unaligned_le32(queue_us, rec + 64);
+	put_unaligned_le32(hash_us, rec + 68);
+	put_unaligned_le32(atomic_read(&lost), rec + 72);
+	if (job->kind != ANTC_HASH_WRITE)
+		return ANTC_HASH_SIZE;
+	put_unaligned_le64(job->seen.dev, rec + 80);
+	put_unaligned_le64(job->seen.ino, rec + 88);
+	put_unaligned_le32(job->seen.generation, rec + 96);
+	put_unaligned_le32(job->mode, rec + 100);
+	put_unaligned_le32(job->nlink, rec + 104);
+	return ANTC_HASH_WRITE_SIZE;
+}
+
+static const char *layout_of(const struct ant_hash_job *job)
+{
+	return job->kind == ANTC_HASH_WRITE ? ANT_HASH_WRITE_LAYOUT : ANT_HASH_LAYOUT;
+}
+
+/* An outcome decided in the traced task: nothing is read. */
+static void report_now(struct ant_hash_job *job, u8 status)
+{
+	u8 rec[ANTC_HASH_WRITE_SIZE];
+	size_t len;
+	bool kick;
+
+	/* A record outside a traced call (the launch's exec, a last close in
+	 * task work) cannot be written in the task's own call: a worker
+	 * publishes it under the identity taken, with nothing to read.
+	 */
+	if (!job->deferred) {
+		len = pack(job, status, job->flags, NULL, 0, 0, 0, rec);
+		if (!ant_monitor_note(ANT_HASH_KEY, layout_of(job), rec, len))
+			atomic_inc(&lost);
+		job_free(job);
+		return;
+	}
+	job->status = status;
+	if (job->path.dentry) {
+		path_put(&job->path);
+		job->path.dentry = NULL;
+	}
+	spin_lock(&hash_lock);
+	if (pending_reports >= ANT_HASH_REPORTS) {
+		spin_unlock(&hash_lock);
+		atomic_inc(&lost);
+		job_free(job);
+		return;
+	}
+	pending_reports++;
+	list_add_tail(&job->node, &hash_reports);
+	kick = !scheduled;
+	scheduled = true;
+	spin_unlock(&hash_lock);
+	if (kick)
+		queue_work(system_unbound_wq, &hash_work);
+}
+
+static void submit(struct ant_hash_job *job)
+{
+	u8 status = job->status;
+	bool kick = false;
+
+	if (status == ANTC_HASH_OK) {
+		spin_lock(&hash_lock);
+		if (pending_jobs >= ANTC_HASH_QUEUE) {
+			status = ANTC_HASH_QUEUE_FULL;
+		} else if (pending_bytes + job->size > ANTC_HASH_PENDING_MAX) {
+			status = ANTC_HASH_BUDGET;
+		} else {
+			job->queued_ns = ktime_get_ns();
+			pending_jobs++;
+			job->reserved = job->size;
+			pending_bytes += job->reserved;
+			list_add_tail(&job->node, &hash_jobs);
+			kick = !scheduled;
+			scheduled = true;
+		}
+		spin_unlock(&hash_lock);
+		if (status == ANTC_HASH_OK) {
+			if (kick)
+				queue_work(system_unbound_wq, &hash_work);
+			return;
+		}
+		atomic_inc(&lost);
+	}
+	report_now(job, status);
+}
+
+/* A traced task is about to unlink a file that queued jobs may be waiting to
+ * hash, typically a sample that executes itself and then deletes its image.
+ * The unlink moves the change time and counter, which must not read as a
+ * write: jobs whose state still equals the state just before the unlink are
+ * marked, and unlink_end() moves their expected state to the one the unlink
+ * leaves. A job that already differs from the file keeps its old state and so
+ * still reports CHANGED. A job a worker is processing is not touched.
+ */
+static void unlink_begin(const struct ant_hash_state *before)
+{
+	struct ant_hash_job *other;
+
+	spin_lock(&hash_lock);
+	list_for_each_entry(other, &hash_jobs, node)
+		if (other->status == ANTC_HASH_OK && state_same(&other->seen, before))
+			other->unlinking = true;
+	other = running;
+	if (other && other->status == ANTC_HASH_OK && state_same(&other->seen, before))
+		other->unlinking = true;
+	spin_unlock(&hash_lock);
+}
+
+static void unlink_end(const struct ant_hash_state *after, bool unlinked)
+{
+	struct ant_hash_job *other;
+
+	spin_lock(&hash_lock);
+	list_for_each_entry(other, &hash_jobs, node)
+		if (other->unlinking && same_inode(&other->seen, after)) {
+			if (unlinked)
+				other->seen = *after;
+			other->unlinking = false;
+		}
+	other = running;
+	if (other && other->unlinking && same_inode(&other->seen, after)) {
+		if (unlinked)
+			other->seen = *after;
+		other->unlinking = false;
+	}
+	spin_unlock(&hash_lock);
+}
+
+static void exec_job(struct ant_hash_job *job, struct file *file, bool interpreter)
+{
+	if (!job)
+		return;
+	if (interpreter)
+		job->flags |= ANTC_HASH_INTERPRETER;
+	job->status = classify(file_inode(file), &job->seen);
+	job->size = job->seen.size;
+	if (job->status == ANTC_HASH_OK) {
+		job->path = file->f_path;
+		path_get(&job->path);
+	}
+	submit(job);
+}
+
+void ant_hash_exec(struct file *file, bool interpreter)
+{
+	exec_job(job_new(ANTC_HASH_EXEC, false), file, interpreter);
+}
+
+/* The launched program's own exec, which the kernel makes without a traced
+ * call: hashed only for a run launched with EXEC flag HASH_ROOT, under the
+ * launch's identity (call id 0).
+ */
+void ant_hash_launch_exec(struct file *file, bool interpreter)
+{
+	struct ant_hash_job *job;
+
+	if (!ant_run_hashes(current, ANTC_EXEC_HASH_ROOT))
+		return;
+	job = job_new(ANTC_HASH_EXEC, true);
+	if (job)
+		job->deferred = true;
+	exec_job(job, file, interpreter);
+}
+
+/* Filesystems with no stored content: a write there is a control operation,
+ * not a file the run left behind, and its last close publishes nothing.
+ */
+static bool pseudo_fs(unsigned long magic)
+{
+	switch (magic) {
+	case PROC_SUPER_MAGIC: case SYSFS_MAGIC: case CGROUP_SUPER_MAGIC:
+	case CGROUP2_SUPER_MAGIC: case DEBUGFS_MAGIC: case TRACEFS_MAGIC:
+	case SECURITYFS_MAGIC: case BPF_FS_MAGIC: case PSTOREFS_MAGIC:
+	case EFIVARFS_MAGIC: case SELINUX_MAGIC: case SMACK_MAGIC:
+	case BINFMTFS_MAGIC:
+		return true;
+	}
+	return false;
+}
+
+/* __fput() of a file opened for writing, after its write access was put. When
+ * it was the file's last writer and a task of a run that hashes its writes let
+ * it go (also at exit, after the task left the run), the content the run left
+ * is queued for hashing. Never sleeps or waits: the job takes its own path
+ * reference before __fput() drops the file's.
+ */
+void ant_monitor_close_write(struct file *file)
+{
+	struct inode *inode = file->f_inode;
+	struct ant_hash_job *job;
+
+	/* A file opened for writing holds write access; a pseudo file made for
+	 * writing (memfd) has none, and only one with write methods counts (an
+	 * attached System V shared memory segment has none).
+	 */
+	if (!S_ISREG(inode->i_mode) ||
+	    !(file->f_mode & (FMODE_WRITER | FMODE_CAN_WRITE)) ||
+	    (file->f_mode & FMODE_NONOTIFY) || pseudo_fs(inode->i_sb->s_magic) ||
+	    !ant_run_hashes(current, ANTC_EXEC_HASH_WRITES))
+		return;
+	/* Another writer still has it open (or, below zero, it is being
+	 * executed and cannot have one): its own last close comes later.
+	 */
+	if (atomic_read(&inode->i_writecount) != 0)
+		return;
+	job = job_new(ANTC_HASH_WRITE, true);
+	if (!job)
+		return;
+	job->deferred = true;
+	job->status = classify(inode, &job->seen);
+	job->size = job->seen.size;
+	job->mode = inode->i_mode;
+	job->nlink = inode->i_nlink;
+	if (job->status == ANTC_HASH_OK) {
+		job->path = file->f_path;
+		path_get(&job->path);
+	}
+	submit(job);
+}
+
+/* Called with the parent directory locked, before vfs_unlink(). The pinned
+ * dentry keeps the inode and its data until the worker is done, even after the
+ * name is gone; the caller reports the outcome with ant_monitor_delete_done().
+ */
+struct ant_hash_job *ant_monitor_delete_prepare(const struct path *parent,
+					     struct dentry *dentry)
+{
+	struct ant_hash_job *job = job_new(ANTC_HASH_DELETE, false);
+
+	if (!job)
+		return NULL;
+	job->status = classify(d_inode(dentry), &job->seen);
+	job->size = job->seen.size;
+	if (job->status == ANTC_HASH_OK) {
+		job->path.mnt = parent->mnt;
+		job->path.dentry = dentry;
+		path_get(&job->path);
+		unlink_begin(&job->seen);
+	}
+	return job;
+}
+
+void ant_monitor_delete_done(struct ant_hash_job *job, int error)
+{
+	if (!job)
+		return;
+	/* The unlink itself moved the change time and counter (the link count
+	 * dropped); the state to compare with is the one it left. The pinned
+	 * dentry keeps the inode.
+	 */
+	if (job->status == ANTC_HASH_OK) {
+		struct ant_hash_state after;
+
+		state_of(&after, d_inode(job->path.dentry));
+		unlink_end(&after, !error);
+		if (!error)
+			job->seen = after;
+	}
+	if (error)
+		job_free(job);
+	else
+		submit(job);
+}
+
+/* Whether the file is still in the state the call saw. A job whose file is
+ * being unlinked right now is compared again once the unlink has finished,
+ * because the unlink moves the change time and counter.
+ */
+static bool still_same(struct ant_hash_job *job, struct inode *inode)
+{
+	struct ant_hash_state first, now, second;
+	bool unlinking_first, unlinking_second;
+	unsigned int tries;
+
+	for (tries = 0; tries < 200; tries++) {
+		spin_lock(&hash_lock);
+		first = job->seen;
+		unlinking_first = job->unlinking;
+		spin_unlock(&hash_lock);
+		state_of(&now, inode);
+		if (state_same(&first, &now))
+			return true;
+		spin_lock(&hash_lock);
+		second = job->seen;
+		unlinking_second = job->unlinking;
+		spin_unlock(&hash_lock);
+		if (state_same(&second, &now))
+			return true;
+		if (!unlinking_first && !unlinking_second && state_same(&first, &second))
+			return false;
+		usleep_range(100, 200);
+	}
+	return false;
+}
+
+static void process(struct ant_hash_job *job, struct ant_task *ctx, u8 *buf)
+{
+	struct sha256_state sha;
+	struct ant_hash_state key, after;
+	u8 digest[SHA256_DIGEST_SIZE], rec[ANTC_HASH_WRITE_SIZE], status = ANTC_HASH_OK;
+	u8 flags = job->flags;
+	struct file *file;
+	u64 start = ktime_get_ns(), hashed = 0, limit;
+	loff_t pos = 0;
+	ssize_t count;
+	size_t len;
+
+	if (!buf) {
+		status = ANTC_HASH_NO_MEMORY;
+		goto publish;
+	}
+	file = kernel_file_open(&job->path, O_RDONLY | O_LARGEFILE | O_NOATIME |
+				__FMODE_NONOTIFY, current_cred());
+	if (IS_ERR(file)) {
+		job->error = PTR_ERR(file);
+		status = ANTC_HASH_READ_ERROR;
+		goto publish;
+	}
+	limit = i_size_read(file_inode(file));
+	if (limit > ANTC_HASH_FILE_MAX) {
+		status = ANTC_HASH_TOO_LARGE;
+		job->size = limit;
+		goto close;
+	}
+	state_of(&key, file_inode(file));
+	if (cache_find(&key, digest)) {
+		hashed = limit;
+		flags |= ANTC_HASH_CACHED;
+		goto verify;
+	}
+	sha256_init(&sha);
+	while (pos < limit) {
+		count = kernel_read(file, buf, min_t(u64, ANT_HASH_CHUNK, limit - pos), &pos);
+		if (count <= 0) {
+			job->error = count < 0 ? count : -ENODATA;
+			status = ANTC_HASH_READ_ERROR;
+			break;
+		}
+		sha256_update(&sha, buf, count);
+		hashed += count;
+		cond_resched();
+	}
+	if (status == ANTC_HASH_OK && !(flags & ANTC_HASH_CACHED)) {
+		sha256_final(&sha, digest);
+		state_of(&after, file_inode(file));
+		if (state_same(&key, &after))
+			cache_store(&key, digest);
+	}
+verify:
+	if (status == ANTC_HASH_OK && !still_same(job, file_inode(file)))
+		flags |= ANTC_HASH_CHANGED;
+close:
+	fput(file);
+publish:
+	len = pack(job, status, flags, status == ANTC_HASH_OK ? digest : NULL, hashed,
+		   min_t(u64, (start - job->queued_ns) / NSEC_PER_USEC, U32_MAX),
+		   min_t(u64, (ktime_get_ns() - start) / NSEC_PER_USEC, U32_MAX), rec);
+	if (ant_monitor_note_publish(ctx, &job->event, job->nr, ANT_HASH_KEY,
+				     layout_of(job), rec, len))
+		atomic_inc(&lost);
+}
+
+/* A refusal decided outside a traced call (see report_now()). */
+static void publish_report(struct ant_hash_job *job, struct ant_task *ctx)
+{
+	u8 rec[ANTC_HASH_WRITE_SIZE];
+	size_t len = pack(job, job->status, job->flags, NULL, 0, 0, 0, rec);
+
+	if (ant_monitor_note_publish(ctx, &job->event, job->nr, ANT_HASH_KEY,
+				     layout_of(job), rec, len))
+		atomic_inc(&lost);
+}
+
+static void hash_run(struct work_struct *work)
+{
+	struct ant_task *ctx = NULL;
+	u8 *buf = kvmalloc(ANT_HASH_CHUNK, GFP_KERNEL);
+	struct ant_hash_job *job;
+
+	for (;;) {
+		spin_lock(&hash_lock);
+		job = list_first_entry_or_null(&hash_reports, struct ant_hash_job, node);
+		if (job) {
+			list_del(&job->node);
+			pending_reports--;
+			spin_unlock(&hash_lock);
+			if (!ctx)
+				ctx = ant_monitor_async_capture_alloc();
+			if (ctx)
+				publish_report(job, ctx);
+			else
+				atomic_inc(&lost);
+			job_free(job);
+			continue;
+		}
+		job = list_first_entry_or_null(&hash_jobs, struct ant_hash_job, node);
+		if (!job) {
+			scheduled = false;
+			spin_unlock(&hash_lock);
+			break;
+		}
+		list_del(&job->node);
+		running = job;
+		spin_unlock(&hash_lock);
+		/* Without a context nothing can be published, so reading the
+		 * file would only produce a record that is thrown away: count
+		 * the loss and skip the read. The allocation is retried per job.
+		 */
+		if (!ctx)
+			ctx = ant_monitor_async_capture_alloc();
+		if (ctx)
+			process(job, ctx, buf);
+		else
+			atomic_inc(&lost);
+		spin_lock(&hash_lock);
+		running = NULL;
+		pending_jobs--;
+		pending_bytes -= job->reserved;
+		spin_unlock(&hash_lock);
+		job_free(job);
+	}
+	kvfree(buf);
+	if (ctx)
+		ant_monitor_async_capture_free(ctx);
+}
