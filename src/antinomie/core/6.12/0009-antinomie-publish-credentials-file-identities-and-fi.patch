+++ b/fs/exec.c
@@ -1849,7 +1849,9 @@ static int exec_binprm(struct linux_binprm *bprm)
 
 	audit_bprm(bprm);
 	trace_sched_process_exec(current, old_pid, bprm);
-	ant_monitor_exec();
+	ant_monitor_exec(bprm->file, bprm->interp != bprm->filename);
