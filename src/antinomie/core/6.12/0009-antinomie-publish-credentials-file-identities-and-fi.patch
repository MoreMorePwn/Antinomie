diff --git a/fs/namei.c b/fs/namei.c
index f40e885..af9a9a9 100644
--- a/fs/namei.c
+++ b/fs/namei.c
@@ -16,6 +16,7 @@
  */
 
 #include <linux/init.h>
+#include <linux/antinomie_monitor.h>
 #include <linux/export.h>
 #include <linux/slab.h>
 #include <linux/wordpart.h>
@@ -4370,6 +4371,7 @@ int do_rmdir(int dfd, struct filename *name)
 	struct path path;
 	struct qstr last;
 	int type;
+	struct inode *inode = NULL;
 	unsigned int lookup_flags = 0;
 retry:
 	error = filename_parentat(dfd, name, lookup_flags, &path, &last, &type);
@@ -4404,11 +4406,19 @@ retry:
 	error = security_path_rmdir(&path, dentry);
 	if (error)
 		goto exit4;
+	/* The removed directory leaves the dentry: hold it to say which it was. */
+	inode = dentry->d_inode;
+	ihold(inode);
 	error = vfs_rmdir(mnt_idmap(path.mnt), path.dentry->d_inode, dentry);
+	if (!error)
+		ant_monitor_file_id(ANT_FILE_ID_UNLINK, inode);
 exit4:
 	dput(dentry);
 exit3:
 	inode_unlock(path.dentry->d_inode);
+	if (inode)
+		iput(inode);
+	inode = NULL;
 	mnt_drop_write(path.mnt);
 exit2:
 	path_put(&path);
@@ -4511,6 +4521,7 @@ int do_unlinkat(int dfd, struct filename *name)
 	int type;
 	struct inode *inode = NULL;
 	struct inode *delegated_inode = NULL;
+	struct ant_hash_job *hash_job;
 	unsigned int lookup_flags = 0;
 retry:
 	error = filename_parentat(dfd, name, lookup_flags, &path, &last, &type);
@@ -4538,8 +4549,12 @@ retry_deleg:
 		error = security_path_unlink(&path, dentry);
 		if (error)
 			goto exit3;
+		hash_job = ant_monitor_delete_prepare(&path, dentry);
 		error = vfs_unlink(mnt_idmap(path.mnt), path.dentry->d_inode,
 				   dentry, &delegated_inode);
+		ant_monitor_delete_done(hash_job, error);
+		if (!error)
+			ant_monitor_file_id(ANT_FILE_ID_UNLINK, inode);
 exit3:
 		dput(dentry);
 	}
@@ -4816,6 +4831,8 @@ retry:
 		goto out_dput;
 	error = vfs_link(old_path.dentry, idmap, new_path.dentry->d_inode,
 			 new_dentry, &delegated_inode);
+	if (!error)
+		ant_monitor_file_id(ANT_FILE_ID_LINK, d_inode(old_path.dentry));
 out_dput:
 	done_path_create(&new_path, new_dentry);
 	if (delegated_inode) {
@@ -5176,6 +5193,8 @@ retry_deleg:
 	rd.delegated_inode = &delegated_inode;
 	rd.flags	   = flags;
 	error = vfs_rename(&rd);
+	if (!error)
+		ant_monitor_file_id(ANT_FILE_ID_RENAME, d_inode(old_dentry));
 exit5:
 	dput(new_dentry);
 exit4:
