From b6e975330958ca53440bccc5bcff4f2991591678 Mon Sep 17 00:00:00 2001
From: MikiMiku <jonathanirvinjo@gmail.com>
Date: Mon, 5 Oct 2026 18:54:44 +0700
Subject: [PATCH] antinomie: tag launched run lineage and request tree stop

---
 include/linux/sched.h           |  1 +
 kernel/antinomie/control.c      | 41 ++++++++++++++++++++++++++++++++-
 kernel/antinomie/control_wire.h |  6 +++++
 kernel/antinomie/recorder.c     |  6 ++++-
 kernel/fork.c                   |  1 +
 5 files changed, 53 insertions(+), 2 deletions(-)

diff --git a/include/linux/sched.h b/include/linux/sched.h
index 33d05cc66..3e933b282 100644
--- a/include/linux/sched.h
+++ b/include/linux/sched.h
@@ -802,6 +802,7 @@ struct task_struct {
 
 #ifdef CONFIG_ANTINOMIE
 	u64 ant_cookie;
+	u64 ant_root_cookie;
 	struct ant_task *ant_monitor;
 #endif
 
diff --git a/kernel/antinomie/control.c b/kernel/antinomie/control.c
index 638467267..bf5098de5 100644
--- a/kernel/antinomie/control.c
+++ b/kernel/antinomie/control.c
@@ -452,6 +452,42 @@ static int terminal_command(u32 opcode, const u8 *args, size_t args_len,
 	return tty->ops->resize ? tty->ops->resize(tty, &ws) : tty_do_resize(tty, &ws);
 }
 
+static int stop_run(const u8 *args, size_t args_len)
+{
+	struct task_struct *process, *task;
+	u64 root_cookie;
+	bool issued = false;
+	int error, first_error = 0;
+
+	if (args_len != 16)
+		return -EINVAL;
+	root_cookie = get_unaligned_le64(args + 8);
+	if (!root_cookie)
+		return -EINVAL;
+
+	/* RCU protects traversal; each signal uses a referenced task, never a PID.
+	 * Membership survives PTY reaping and root exit. Concurrent forks can
+	 * escape this pass, so success only reports an issued signal request.
+	 */
+	rcu_read_lock();
+	for_each_process_thread(process, task) {
+		if (!READ_ONCE(task->ant_cookie) ||
+		    READ_ONCE(task->ant_root_cookie) != root_cookie)
+			continue;
+		get_task_struct(task);
+		error = send_sig(SIGTERM, task, 1);
+		put_task_struct(task);
+		if (!error)
+			issued = true;
+		else if (error != -ESRCH && !first_error)
+			first_error = error;
+	}
+	rcu_read_unlock();
+	if (first_error)
+		return first_error;
+	return issued ? 0 : -ESRCH;
+}
+
 static int command(const void *data, size_t args_len, void *reply,
 		   size_t capacity, size_t *reply_len, void *context)
 {
@@ -474,6 +510,8 @@ static int command(const void *data, size_t args_len, void *reply,
 	case ANTC_TERMINAL_INPUT: case ANTC_TERMINAL_READ:
 	case ANTC_TERMINAL_RESIZE: case ANTC_SIGNAL:
 		return terminal_command(opcode, args, args_len, reply, capacity, reply_len);
+	case ANTC_STOP_RUN:
+		return stop_run(args, args_len);
 	case ANTC_STATS:
 		if (args_len != 8 || capacity < 80)
 			return -EINVAL;
@@ -494,7 +532,8 @@ static int __init ant_control_init(void)
 {
 	static const u32 opcodes[] = { ANTC_UPLOAD_BEGIN, ANTC_UPLOAD_CHUNK,
 		ANTC_UPLOAD_COMMIT, ANTC_UPLOAD_ABORT, ANTC_EXEC, ANTC_TERMINAL_INPUT,
-		ANTC_TERMINAL_READ, ANTC_TERMINAL_RESIZE, ANTC_SIGNAL, ANTC_STATS, ANTC_SHUTDOWN };
+		ANTC_TERMINAL_READ, ANTC_TERMINAL_RESIZE, ANTC_SIGNAL, ANTC_STOP_RUN,
+		ANTC_STATS, ANTC_SHUTDOWN };
 	int i, error;
 
 	for (i = 0; i < ARRAY_SIZE(opcodes); i++) {
diff --git a/kernel/antinomie/control_wire.h b/kernel/antinomie/control_wire.h
index 8e19c9b2c..5bee714d6 100644
--- a/kernel/antinomie/control_wire.h
+++ b/kernel/antinomie/control_wire.h
@@ -20,6 +20,7 @@
 #define ANTC_TERMINAL_READ 0x1012
 #define ANTC_TERMINAL_RESIZE 0x1013
 #define ANTC_SIGNAL 0x1014
+#define ANTC_STOP_RUN 0x1015
 #define ANTC_STATS 0x1020
 #define ANTC_SHUTDOWN 0x1030
 #define ANTC_UPLOAD_OVERWRITE 1
@@ -52,6 +53,11 @@
  * u16 pixel_width at 20, u16 pixel_height at 22. Empty success reply.
  * SIGNAL: header, u64 session_id at 8, u32 signal at 16,
  * u32 reserved=0 at 20. Signals launch process group. Empty success reply.
+ * STOP_RUN: header flags=0, nonzero u64 root_task_cookie at 8 (16 bytes).
+ * Requests SIGTERM for each traced task with this inherited launch cookie,
+ * including descendants after root exit or PTY/session reaping. Empty reply.
+ * Status 0 means signal requests issued, not proven tree termination; -ESRCH
+ * means no signalable matching task. Concurrent forks may escape this pass.
  *
  * STATS: header only. Reply: ten u64 counters in order: stream_id,
  * tasks_created, tasks_live, calls_entered, events_attempted,
diff --git a/kernel/antinomie/recorder.c b/kernel/antinomie/recorder.c
index 1dd1f462e..d88dc1bf6 100644
--- a/kernel/antinomie/recorder.c
+++ b/kernel/antinomie/recorder.c
@@ -25,7 +25,7 @@
  * its context across migration; failure to allocate does not lose lineage.
  */
 #define ANT_CHUNK_SIZE 4096
-#define ANT_HEADER_SIZE 128
+#define ANT_HEADER_SIZE 136
 #define ANT_X32_BIT 0x40000000UL
 #define ANT_SCHEMA 1
 #define ANT_INCOMPLETE 1
@@ -80,6 +80,7 @@ static int publish(struct ant_task *ctx, u8 kind, u32 object_id,
 	memset(p, 0, ANT_HEADER_SIZE);
 	memcpy(p, "ANTT", 4);
 	put_unaligned_le16(1, p + 4);
+	put_unaligned_le16(1, p + 6);
 	put_unaligned_le16(ANT_HEADER_SIZE, p + 8);
 	put_unaligned_le16(1, p + 10);
 	put_unaligned_le32(ANT_HEADER_SIZE + body_len, p + 12);
@@ -103,6 +104,7 @@ static int publish(struct ant_task *ctx, u8 kind, u32 object_id,
 	put_unaligned_le64(object_offset, p + 104);
 	put_unaligned_le64(object_size, p + 112);
 	put_unaligned_le32(body_len, p + 120);
+	put_unaligned_le64(current->ant_root_cookie, p + 128);
 	ctx->packet_count++;
 	atomic64_inc(&packets_attempted);
 	error = ant_send(p, ANT_HEADER_SIZE + body_len);
@@ -642,6 +644,7 @@ int ant_monitor_launch(const char *path, char **argv, char **envp)
 	if (!ctx)
 		return -ENOMEM;
 	current->ant_cookie = atomic64_inc_return(&cookies);
+	WRITE_ONCE(current->ant_root_cookie, current->ant_cookie);
 	current->ant_monitor = ctx;
 	atomic64_inc(&tasks_created);
 	atomic64_inc(&tasks_live);
@@ -682,6 +685,7 @@ void ant_monitor_fork(struct task_struct *child)
 	if (!current->ant_cookie)
 		return;
 	child->ant_cookie = atomic64_inc_return(&cookies);
+	WRITE_ONCE(child->ant_root_cookie, current->ant_root_cookie);
 	child->ant_monitor = kzalloc(sizeof(*ctx), GFP_NOWAIT);
 	if (child->ant_monitor) {
 		child->ant_monitor->nr = U64_MAX;
diff --git a/kernel/fork.c b/kernel/fork.c
index 2507c790c..256badaa4 100644
--- a/kernel/fork.c
+++ b/kernel/fork.c
@@ -1140,6 +1140,7 @@ static struct task_struct *dup_task_struct(struct task_struct *orig, int node)
 		goto free_tsk;
 #ifdef CONFIG_ANTINOMIE
 	tsk->ant_cookie = 0;
+	tsk->ant_root_cookie = 0;
 	tsk->ant_monitor = NULL;
 #endif
 
-- 
2.53.0

