@@ -339,8 +376,12 @@ void __init __no_sanitize_address setup_arch(char **cmdline_p)
 	/* Parse the ACPI tables for possible boot-time configuration */
 	acpi_boot_table_init();
 
-	if (acpi_disabled)
+	if (acpi_disabled) {
 		unflatten_device_tree();
+#ifdef CONFIG_ANTINOMIE
+		ant_dt_bootargs();
+#endif
+	}
 
 	bootmem_init();
 
