@@ -331,6 +365,9 @@ void __init __no_sanitize_address setup_arch(char **cmdline_p)
 	}
 
 	arm64_memblock_init();
+#ifdef CONFIG_ANTINOMIE
+	ant_bootstrap_reserve();
+#endif
 
