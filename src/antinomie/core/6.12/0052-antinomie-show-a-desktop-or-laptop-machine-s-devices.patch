diff --git a/kernel/antinomie/facade.c b/kernel/antinomie/facade.c
new file mode 100644
index 000000000..561680744
--- /dev/null
+++ b/kernel/antinomie/facade.c
@@ -0,0 +1,605 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* The guest facade: what a desktop or laptop machine profile says its
+ * devices are, shown where programs read the identity of the devices QEMU
+ * emulates.
+ *
+ * The host passes the profile's values as boot options (antinomie_f*), which
+ * ant_cmdline_take() removes from the command line before the kernel first
+ * prints it; without them nothing here changes anything. The kernel itself
+ * keeps the true identities: drivers bind, quirks apply and the uevents that
+ * load modules carry the emulated devices' own IDs. Only the views programs
+ * read are rewritten:
+ *
+ * - PCI: the vendor, device and subsystem IDs in config space as user space
+ *   reads it (sysfs config, /proc/bus/pci/BB/DD.F), the sysfs vendor,
+ *   device, subsystem_* and modalias attributes, the uevent file's PCI_ID,
+ *   PCI_SUBSYS_ID and MODALIAS, /proc/bus/pci/devices and the boot log's
+ *   device line. A rule maps an emulated vendor:device to the shown
+ *   vendor:device and subsystem (antinomie_fpci); devices with QEMU's Red Hat
+ *   subsystem (1af4) take the board's (antinomie_fsub).
+ * - NVMe: Identify Controller (model, firmware, PCI vendor and subsystem
+ *   vendor, IEEE OUI, a subsystem NQN as the kernel makes one for a drive
+ *   without its own), Identify Namespace and the namespace identification
+ *   descriptors (QEMU's 52:54:00 EUI-64 prefix), and the firmware slot log,
+ *   on the driver's reads and on admin pass-through (nvme-cli, smartctl).
+ * - ACPI: tables read through /sys/firmware/acpi/tables and the boot log's
+ *   table lines: QEMU's creator ID (BXPC) becomes the profile's, OVMF's and
+ *   QEMU's own OEM IDs the machine's (as QEMU writes them for the profile),
+ *   the DSDT's fw_cfg device (FWCF, _HID QEMU0002) a motherboard resource
+ *   device; checksums stay valid.
+ * - Display: QEMU's standard VGA driver (bochs-drm) is named as the profile's
+ *   GPU driver in DRM_IOCTL_VERSION, the fbdev name (/proc/fb), its PCI
+ *   driver and its I/O resources.
+ * - USB: QEMU's HID devices (vendor 0627, maker "QEMU") take the profile's
+ *   mouse IDs and strings before a driver sees them, so the input device is
+ *   named after that mouse.
+ * - EFI: the firmware vendor the boot log names.
+ * - ATA: QEMU's default CD-ROM, on a machine without an optical drive
+ *   (antinomie_fnocd), is not attached.
+ *
+ * What stays: raw config-space access as root (port I/O at 0xcf8) and USB
+ * string requests made to the device through usbfs read QEMU's values.
+ */
+#include <linux/acpi.h>
+#include <linux/antinomie_stealth.h>
+#include <linux/ctype.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/kobject.h>
+#include <linux/nvme.h>
+#include <linux/pci.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+#include <linux/unaligned.h>
+#include <linux/usb.h>
+
+#define PCI_VENDOR_QEMU_VIRTIO 0x1af4
+#define PCI_VENDOR_QEMU 0x1b36
+#define USB_VENDOR_QEMU 0x0627
+#define ANT_PCI_RULES 16
+
+struct ant_pci_rule {
+	u16 vendor, device;
+	struct ant_pci_ids shown;
+};
+
+static struct ant_pci_rule pci_rules[ANT_PCI_RULES] __ro_after_init;
+static unsigned int pci_rule_count __ro_after_init;
+static u16 board_sub_vendor __ro_after_init, board_sub_device __ro_after_init;
+static bool board_sub __ro_after_init;
+
+static struct {
+	bool set;
+	char model[40], firmware[8];
+	u8 oui[3];
+	u16 vid, ssvid;
+} nvme __ro_after_init;
+/* QEMU's firmware revision, read with the first Identify Controller: the
+ * firmware slot log names it too. */
+static char nvme_real_firmware[8];
+
+static struct {
+	bool set;
+	char creator[4], oem_id[6], oem_table_id[8];
+	u32 revision;
+} acpi_facade __ro_after_init;
+
+static char drm_name[24] __ro_after_init;
+
+static struct {
+	bool set;
+	u16 vendor, product, bcd;
+	char manufacturer[64], product_name[64];
+} usb_facade __ro_after_init;
+
+static char efi_vendor[64] __ro_after_init;
+static bool hide_qemu_cdrom __ro_after_init;
+
+/* Copy an option's value into a fixed field, quotes already removed by the
+ * parser; false when it does not fit. */
+static bool __init take_text(char *out, size_t size, const char *value, size_t len)
+{
+	if (len >= size)
+		return false;
+	memcpy(out, value, len);
+	out[len] = '\0';
+	return true;
+}
+
+/* antinomie_fpci=VVVVDDDD=vvvvddddSSSSssss[,...]: the device VVVV:DDDD is
+ * shown as vvvv:dddd with subsystem SSSS:ssss. */
+static int __init facade_pci_param(char *value)
+{
+	char *item;
+
+	while (value && (item = strsep(&value, ",")) && pci_rule_count < ANT_PCI_RULES) {
+		struct ant_pci_rule *rule = &pci_rules[pci_rule_count];
+
+		if (sscanf(item, "%4hx%4hx=%4hx%4hx%4hx%4hx", &rule->vendor, &rule->device,
+			   &rule->shown.vendor, &rule->shown.device,
+			   &rule->shown.subsystem_vendor, &rule->shown.subsystem_device) == 6)
+			pci_rule_count++;
+	}
+	return 0;
+}
+early_param("antinomie_fpci", facade_pci_param);
+
+/* antinomie_fsub=SSSSssss: the board's subsystem, for devices that carry
+ * QEMU's. */
+static int __init facade_sub_param(char *value)
+{
+	board_sub = value && sscanf(value, "%4hx%4hx", &board_sub_vendor, &board_sub_device) == 2;
+	return 0;
+}
+early_param("antinomie_fsub", facade_sub_param);
+
+/* antinomie_fnvme="model,firmware,OUI,VVVV,SSSS" (OUI as six hex digits). */
+static int __init facade_nvme_param(char *value)
+{
+	char *model = value ? strsep(&value, ",") : NULL;
+	char *firmware = value ? strsep(&value, ",") : NULL;
+	unsigned int oui;
+	u16 vid, ssvid;
+
+	if (!model || !firmware || !value ||
+	    sscanf(value, "%6x,%4hx,%4hx", &oui, &vid, &ssvid) != 3 ||
+	    strlen(model) > sizeof(nvme.model) || strlen(firmware) > sizeof(nvme.firmware))
+		return 0;
+	/* Identify strings: ASCII, space padded, not terminated. */
+	memset(nvme.model, ' ', sizeof(nvme.model));
+	memcpy(nvme.model, model, strlen(model));
+	memset(nvme.firmware, ' ', sizeof(nvme.firmware));
+	memcpy(nvme.firmware, firmware, strlen(firmware));
+	nvme.oui[0] = oui >> 16;
+	nvme.oui[1] = oui >> 8;
+	nvme.oui[2] = oui;
+	nvme.vid = vid;
+	nvme.ssvid = ssvid;
+	nvme.set = true;
+	return 0;
+}
+early_param("antinomie_fnvme", facade_nvme_param);
+
+/* antinomie_facpi="CCCC:RRRRRRRR:OEMIDx:TABLEIDx": creator ID (four
+ * characters), its revision in hex, and the machine's OEM and OEM table IDs
+ * (six and eight characters, space padded, as QEMU writes them). */
+static int __init facade_acpi_param(char *value)
+{
+	char revision[9];
+
+	if (!value || strlen(value) != 4 + 1 + 8 + 1 + 6 + 1 +
+	    8 || value[4] != ':' || value[13] != ':' || value[20] != ':')
+		return 0;
+	memcpy(revision, value + 5, 8);
+	revision[8] = '\0';
+	if (kstrtou32(revision, 16, &acpi_facade.revision))
+		return 0;
+	memcpy(acpi_facade.creator, value, 4);
+	memcpy(acpi_facade.oem_id, value + 14, 6);
+	memcpy(acpi_facade.oem_table_id, value + 21, 8);
+	acpi_facade.set = true;
+	return 0;
+}
+early_param("antinomie_facpi", facade_acpi_param);
+
+/* antinomie_fdrm=NAME: the DRM driver QEMU's VGA is named as. */
+static int __init facade_drm_param(char *value)
+{
+	if (value && (!strcmp(value, "i915") || !strcmp(value, "amdgpu")))
+		take_text(drm_name, sizeof(drm_name), value, strlen(value));
+	return 0;
+}
+early_param("antinomie_fdrm", facade_drm_param);
+
+/* antinomie_finput="VVVV:PPPP:BBBB,maker,product": the mouse QEMU's USB HID
+ * devices are shown as. */
+static int __init facade_input_param(char *value)
+{
+	char *ids = value ? strsep(&value, ",") : NULL;
+	char *maker = value ? strsep(&value, ",") : NULL;
+
+	if (!ids || !maker || !value ||
+	    sscanf(ids, "%4hx:%4hx:%4hx", &usb_facade.vendor, &usb_facade.product,
+		   &usb_facade.bcd) != 3 ||
+	    !take_text(usb_facade.manufacturer, sizeof(usb_facade.manufacturer), maker,
+		       strlen(maker)) ||
+	    !take_text(usb_facade.product_name, sizeof(usb_facade.product_name), value,
+		       strlen(value)))
+		return 0;
+	usb_facade.set = true;
+	return 0;
+}
+early_param("antinomie_finput", facade_input_param);
+
+/* antinomie_fefi="vendor": the firmware vendor of the EFI system table. */
+static int __init facade_efi_param(char *value)
+{
+	if (value)
+		take_text(efi_vendor, sizeof(efi_vendor), value, strlen(value));
+	return 0;
+}
+early_param("antinomie_fefi", facade_efi_param);
+
+/* antinomie_fnocd: the machine has no optical drive, so QEMU's default one
+ * (q35 adds it when no IDE disk is given, as with an NVMe root) is not
+ * attached. */
+static int __init facade_nocd_param(char *value)
+{
+	hide_qemu_cdrom = true;
+	return 0;
+}
+early_param("antinomie_fnocd", facade_nocd_param);
+
+/* --- PCI ----------------------------------------------------------------- */
+
+static void shown_ids(u16 vendor, u16 device, u16 sub_vendor, u16 sub_device,
+		      struct ant_pci_ids *ids)
+{
+	unsigned int i;
+
+	ids->vendor = vendor;
+	ids->device = device;
+	ids->subsystem_vendor = sub_vendor;
+	ids->subsystem_device = sub_device;
+	for (i = 0; i < pci_rule_count; i++)
+		if (pci_rules[i].vendor == vendor && pci_rules[i].device == device) {
+			*ids = pci_rules[i].shown;
+			return;
+		}
+	if (board_sub && (sub_vendor == PCI_VENDOR_QEMU_VIRTIO || sub_vendor == PCI_VENDOR_QEMU)) {
+		ids->subsystem_vendor = board_sub_vendor;
+		ids->subsystem_device = board_sub_device;
+	}
+}
+
+void ant_pci_shown_ids(const struct pci_dev *dev, struct ant_pci_ids *ids)
+{
+	shown_ids(dev->vendor, dev->device, dev->subsystem_vendor, dev->subsystem_device, ids);
+}
+
+/* A config-space read by user space (pci_user_read_config_*): the bytes of
+ * the IDs it covers, as shown. The subsystem IDs are at 0x2c only in a type 0
+ * header. */
+void ant_pci_config_shown(const struct pci_dev *dev, int pos, int size, u32 *val)
+{
+	struct ant_pci_ids ids;
+	u8 header[0x30];
+	int i;
+
+	if ((!pci_rule_count && !board_sub) || pos >= 0x30)
+		return;
+	ant_pci_shown_ids(dev, &ids);
+	memset(header, 0, sizeof(header));
+	put_unaligned_le16(ids.vendor, header + PCI_VENDOR_ID);
+	put_unaligned_le16(ids.device, header + PCI_DEVICE_ID);
+	put_unaligned_le16(ids.subsystem_vendor, header + PCI_SUBSYSTEM_VENDOR_ID);
+	put_unaligned_le16(ids.subsystem_device, header + PCI_SUBSYSTEM_ID);
+	for (i = 0; i < size && pos + i < 0x30; i++) {
+		int at = pos + i;
+
+		if (at < PCI_COMMAND ||
+		    (dev->hdr_type == PCI_HEADER_TYPE_NORMAL && at >= PCI_SUBSYSTEM_VENDOR_ID)) {
+			*val &= ~(0xffu << (8 * i));
+			*val |= (u32)header[at] << (8 * i);
+		}
+	}
+}
+
+/* Rewrite NAME=<hex> fields of a uevent text in place (same width). */
+static void uevent_rewrite(char *entry, const char *prefix, const char *format,
+			   const struct ant_pci_ids *ids, const struct pci_dev *dev)
+{
+	char text[96];
+	size_t len = strlen(prefix);
+
+	if (strncmp(entry, prefix, len))
+		return;
+	if (!strcmp(prefix, "MODALIAS="))
+		snprintf(text, sizeof(text), format, ids->vendor, ids->device,
+			 ids->subsystem_vendor, ids->subsystem_device, (u8)(dev->class >> 16),
+			 (u8)(dev->class >> 8), (u8)dev->class);
+	else if (!strcmp(prefix, "PCI_ID="))
+		snprintf(text, sizeof(text), format, ids->vendor, ids->device);
+	else
+		snprintf(text, sizeof(text), format, ids->subsystem_vendor, ids->subsystem_device);
+	if (strlen(text) == strlen(entry + len))
+		memcpy(entry + len, text, strlen(text));
+}
+
+/* The uevent file of a PCI device as read (not the uevents the kernel
+ * sends, which load the emulated devices' modules). */
+void ant_uevent_shown(struct device *dev, struct kobj_uevent_env *env)
+{
+	struct ant_pci_ids ids;
+	struct pci_dev *pdev;
+	int i;
+
+	if ((!pci_rule_count && !board_sub) || !dev_is_pci(dev))
+		return;
+	pdev = to_pci_dev(dev);
+	ant_pci_shown_ids(pdev, &ids);
+	for (i = 0; i < env->envp_idx; i++) {
+		uevent_rewrite(env->envp[i], "PCI_ID=", "%04X:%04X", &ids, pdev);
+		uevent_rewrite(env->envp[i], "PCI_SUBSYS_ID=", "%04X:%04X", &ids, pdev);
+		uevent_rewrite(env->envp[i], "MODALIAS=",
+			       "pci:v%08Xd%08Xsv%08Xsd%08Xbc%02Xsc%02Xi%02X", &ids, pdev);
+	}
+}
+
+/* --- Display ------------------------------------------------------------- */
+
+/* QEMU's display drivers, named after the profile's GPU driver. */
+static bool qemu_display(const char *name)
+{
+	return name && !strcmp(name, "bochs-drm");
+}
+
+const char *ant_driver_name(const char *name)
+{
+	return *drm_name && qemu_display(name) ? drm_name : name;
+}
+
+/* DRM_IOCTL_VERSION: the name, description and version of the shown driver
+ * (the real drivers' DRIVER_DESC and version numbers in this kernel). */
+void ant_drm_version(const char **name, const char **desc, int *major, int *minor,
+		     int *patchlevel)
+{
+	bool intel = !strcmp(drm_name, "i915");
+
+	if (!*drm_name || !qemu_display(*name))
+		return;
+	*name = drm_name;
+	*desc = intel ? "Intel Graphics" : "AMD GPU";
+	*major = intel ? 1 : 3;
+	*minor = intel ? 6 : 61;
+	*patchlevel = 0;
+}
+
+/* --- NVMe ---------------------------------------------------------------- */
+
+static bool qemu_oui(const u8 *eui)
+{
+	return eui[0] == 0x52 && eui[1] == 0x54 && eui[2] == 0x00;
+}
+
+/* Identify data (CNS 0 namespace, 1 controller, 3 namespace descriptors) of
+ * QEMU's controller, in place. */
+void ant_nvme_identify(u8 cns, void *data, size_t len)
+{
+	if (!nvme.set)
+		return;
+	if (cns == NVME_ID_CNS_CTRL && len >= sizeof(struct nvme_id_ctrl)) {
+		struct nvme_id_ctrl *id = data;
+		char nqn[NVMF_NQN_SIZE];
+		int at;
+
+		if (memcmp(id->mn, "QEMU", 4))
+			return;
+		if (!nvme_real_firmware[0])
+			memcpy(nvme_real_firmware, id->fr, sizeof(id->fr));
+		id->vid = cpu_to_le16(nvme.vid);
+		id->ssvid = cpu_to_le16(nvme.ssvid);
+		memcpy(id->mn, nvme.model, sizeof(id->mn));
+		memcpy(id->fr, nvme.firmware, sizeof(id->fr));
+		/* The OUI's least significant byte first. */
+		id->ieee[0] = nvme.oui[2];
+		id->ieee[1] = nvme.oui[1];
+		id->ieee[2] = nvme.oui[0];
+		/* nvme_init_subnqn()'s name for a drive without one. */
+		at = snprintf(nqn, sizeof(nqn), "nqn.2014.08.org.nvmexpress:%04x%04x", nvme.vid,
+			      nvme.ssvid);
+		memcpy(nqn + at, id->sn, sizeof(id->sn));
+		memcpy(nqn + at + sizeof(id->sn), id->mn, sizeof(id->mn));
+		at += sizeof(id->sn) + sizeof(id->mn);
+		memset(id->subnqn, 0, sizeof(id->subnqn));
+		memcpy(id->subnqn, nqn, min_t(size_t, at, sizeof(id->subnqn)));
+	} else if (cns == NVME_ID_CNS_NS && len >= sizeof(struct nvme_id_ns)) {
+		struct nvme_id_ns *id = data;
+
+		if (qemu_oui(id->eui64))
+			memcpy(id->eui64, nvme.oui, 3);
+	} else if (cns == NVME_ID_CNS_NS_DESC_LIST && len >= NVME_IDENTIFY_DATA_SIZE) {
+		size_t pos = 0;
+
+		while (pos + sizeof(struct nvme_ns_id_desc) <= NVME_IDENTIFY_DATA_SIZE) {
+			struct nvme_ns_id_desc *cur = data + pos;
+
+			if (!cur->nidl)
+				break;
+			if (pos + sizeof(*cur) + cur->nidl > NVME_IDENTIFY_DATA_SIZE)
+				break;
+			if (cur->nidt == NVME_NIDT_EUI64 && cur->nidl == NVME_NIDT_EUI64_LEN &&
+			    qemu_oui((u8 *)(cur + 1)))
+				memcpy(cur + 1, nvme.oui, 3);
+			pos += sizeof(*cur) + cur->nidl;
+		}
+	}
+}
+
+/* An admin command passed through by a program (NVME_IOCTL_ADMIN_CMD and
+ * ADMIN64): the Identify data and the firmware slot log it read, as the
+ * driver's own reads show them. */
+void ant_nvme_passthru(u8 opcode, u32 cdw10, u64 address, u32 len)
+{
+	void __user *buffer = u64_to_user_ptr(address);
+	u8 *copy;
+
+	if (!nvme.set || !address || !len)
+		return;
+	if (opcode == nvme_admin_identify) {
+		u8 cns = cdw10 & 0xff;
+
+		if (cns != NVME_ID_CNS_CTRL && cns != NVME_ID_CNS_NS &&
+		    cns != NVME_ID_CNS_NS_DESC_LIST)
+			return;
+		if (len < NVME_IDENTIFY_DATA_SIZE)
+			return;
+		copy = kmalloc(NVME_IDENTIFY_DATA_SIZE, GFP_KERNEL);
+		if (!copy)
+			return;
+		/*
+		 * On a fault the caller keeps the device's own data. No message:
+		 * a dynamic debug entry (/proc/dynamic_debug/control, readable by
+		 * every user) would name this file.
+		 */
+		if (!copy_from_user(copy, buffer, NVME_IDENTIFY_DATA_SIZE)) {
+			ant_nvme_identify(cns, copy, NVME_IDENTIFY_DATA_SIZE);
+			if (copy_to_user(buffer, copy, NVME_IDENTIFY_DATA_SIZE)) {
+				kfree(copy);
+				return;
+			}
+		}
+		kfree(copy);
+	} else if (opcode == nvme_admin_get_log_page && (cdw10 & 0xff) == NVME_LOG_FW_SLOT &&
+		   len >= 64 && nvme_real_firmware[0]) {
+		/* struct nvme_fw_slot_info_log: afi, then frs[7] of 8 bytes at 8. */
+		u8 slots[64];
+		int i;
+
+		if (copy_from_user(slots, buffer, sizeof(slots)))
+			return;
+		for (i = 0; i < 7; i++)
+			if (!memcmp(slots + 8 + 8 * i, nvme_real_firmware, 8))
+				memcpy(slots + 8 + 8 * i, nvme.firmware, 8);
+		if (copy_to_user(buffer, slots, sizeof(slots)))
+			return;
+	}
+}
+
+/* --- ACPI ---------------------------------------------------------------- */
+
+#ifdef CONFIG_ACPI
+static bool qemu_oem(const struct acpi_table_header *header)
+{
+	return !memcmp(header->oem_id, "BOCHS ", 6) || !memcmp(header->oem_id, "INTEL ", 6) ||
+		!memcmp(header->oem_table_id, "BXPC", 4) || !memcmp(header->oem_table_id, "EDK2", 4);
+}
+
+/* A table header as shown: the profile's creator for QEMU's, the machine's
+ * OEM IDs for OVMF's and QEMU's own. The checksum is not touched here. */
+static void header_shown(struct acpi_table_header *header)
+{
+	if (!acpi_facade.set || !memcmp(header->signature, ACPI_SIG_FACS, 4))
+		return;
+	if (!memcmp(header->asl_compiler_id, "BXPC", 4)) {
+		memcpy(header->asl_compiler_id, acpi_facade.creator, 4);
+		header->asl_compiler_revision = acpi_facade.revision;
+	}
+	if (qemu_oem(header)) {
+		memcpy(header->oem_id, acpi_facade.oem_id, ACPI_OEM_ID_SIZE);
+		memcpy(header->oem_table_id, acpi_facade.oem_table_id, ACPI_OEM_TABLE_ID_SIZE);
+	}
+}
+
+/* The boot log's line for a table (acpi_tb_print_table_header()). */
+void ant_acpi_header_shown(struct acpi_table_header *header)
+{
+	header_shown(header);
+}
+
+/* QEMU's fw_cfg device in AML: its name FWCF and the string _HID "QEMU0002"
+ * (StringPrefix, eight characters, NUL). The name becomes one the table does
+ * not use; the string becomes EisaId("PNP0C02") (DWordPrefix and the 32-bit
+ * EISA ID, as compilers write it) followed by Noops to the same length. */
+static bool aml_has(const u8 *aml, size_t len, const char *name)
+{
+	size_t i;
+
+	for (i = 0; i + 4 <= len; i++)
+		if (!memcmp(aml + i, name, 4))
+			return true;
+	return false;
+}
+
+static void aml_shown(u8 *aml, size_t len)
+{
+	static const char *const names[] = { "RMSC", "MBRS", "SIOR", "LDRS" };
+	static const u8 pnp0c02[] = { 0x0c, 0x41, 0xd0, 0x0c, 0x02 };
+	const char *name = NULL;
+	size_t i, n;
+
+	for (n = 0; n < ARRAY_SIZE(names) && !name; n++)
+		if (!aml_has(aml, len, names[n]))
+			name = names[n];
+	for (i = 0; i + 10 <= len; i++) {
+		if (aml[i] == 0x0d && !memcmp(aml + i + 1, "QEMU000", 7) && aml[i + 9] == 0) {
+			memcpy(aml + i, pnp0c02, sizeof(pnp0c02));
+			memset(aml + i + sizeof(pnp0c02), 0xa3, 10 - sizeof(pnp0c02));
+			i += 9;
+		} else if (name && !memcmp(aml + i, "FWCF", 4)) {
+			memcpy(aml + i, name, 4);
+			i += 3;
+		}
+	}
+}
+
+/* A table read through /sys/firmware/acpi/tables: a rewritten copy (to free
+ * with kvfree()), or NULL to show the table itself. */
+void *ant_acpi_table_shown(struct acpi_table_header *table)
+{
+	struct acpi_table_header *copy;
+	u8 sum = 0;
+	u32 i;
+
+	if (!acpi_facade.set || table->length < sizeof(*table) || table->length > SZ_4M)
+		return NULL;
+	copy = kvmalloc(table->length, GFP_KERNEL);
+	if (!copy)
+		return NULL;
+	memcpy(copy, table, table->length);
+	header_shown(copy);
+	if (!memcmp(copy->signature, ACPI_SIG_DSDT, 4) || !memcmp(copy->signature, ACPI_SIG_SSDT, 4))
+		aml_shown((u8 *)copy + sizeof(*copy), copy->length - sizeof(*copy));
+	copy->checksum = 0;
+	for (i = 0; i < copy->length; i++)
+		sum += ((u8 *)copy)[i];
+	copy->checksum = -sum;
+	return copy;
+}
+#endif
+
+/* --- USB ----------------------------------------------------------------- */
+
+static void replace_string(char **field, const char *text)
+{
+	char *copy = text ? kstrdup(text, GFP_KERNEL) : NULL;
+
+	if (text && !copy)
+		return;
+	kfree(*field);
+	*field = copy;
+}
+
+/* A device read by the hub (usb_new_device(), after usb_enumerate_device()):
+ * QEMU's HID devices take the profile's mouse identity before any driver
+ * binds, so its sysfs attributes, descriptors file and the input device's
+ * name and IDs are the mouse's. */
+void ant_usb_device_shown(struct usb_device *udev)
+{
+	if (!usb_facade.set || le16_to_cpu(udev->descriptor.idVendor) != USB_VENDOR_QEMU ||
+	    !udev->manufacturer || strcmp(udev->manufacturer, "QEMU"))
+		return;
+	udev->descriptor.idVendor = cpu_to_le16(usb_facade.vendor);
+	udev->descriptor.idProduct = cpu_to_le16(usb_facade.product);
+	udev->descriptor.bcdDevice = cpu_to_le16(usb_facade.bcd);
+	udev->descriptor.iSerialNumber = 0;
+	replace_string(&udev->manufacturer, usb_facade.manufacturer);
+	replace_string(&udev->product, usb_facade.product_name);
+	replace_string(&udev->serial, NULL);
+}
+
+/* --- ATA ----------------------------------------------------------------- */
+
+/* ata_dev_configure(): QEMU's default CD-ROM, which libata then disables. */
+bool ant_ata_device_hidden(const char *model)
+{
+	return hide_qemu_cdrom && !strcmp(model, "QEMU DVD-ROM");
+}
+
+/* --- EFI ----------------------------------------------------------------- */
+
+const char *ant_efi_vendor(const char *vendor)
+{
+	return *efi_vendor ? efi_vendor : vendor;
+}
