diff --git a/drivers/acpi/sysfs.c b/drivers/acpi/sysfs.c
index 687524b50..34151fa04 100644
--- a/drivers/acpi/sysfs.c
+++ b/drivers/acpi/sysfs.c
@@ -6,6 +6,7 @@
 #define pr_fmt(fmt) "ACPI: " fmt
 
 #include <linux/acpi.h>
+#include <linux/antinomie_stealth.h>
 #include <linux/bitmap.h>
 #include <linux/init.h>
 #include <linux/kernel.h>
@@ -325,6 +326,7 @@ static ssize_t acpi_table_show(struct file *filp, struct kobject *kobj,
 	struct acpi_table_attr *table_attr =
 	    container_of(bin_attr, struct acpi_table_attr, attr);
 	struct acpi_table_header *table_header = NULL;
+	void *shown;
 	acpi_status status;
 	ssize_t rc;
 
@@ -333,8 +335,11 @@ static ssize_t acpi_table_show(struct file *filp, struct kobject *kobj,
 	if (ACPI_FAILURE(status))
 		return -ENODEV;
 
-	rc = memory_read_from_buffer(buf, count, &offset, table_header,
+	/* The table as the guest facade shows it, if it rewrites it. */
+	shown = ant_acpi_table_shown(table_header);
+	rc = memory_read_from_buffer(buf, count, &offset, shown ?: table_header,
 			table_header->length);
+	kvfree(shown);
 	acpi_put_table(table_header);
 	return rc;
 }
