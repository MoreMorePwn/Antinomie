{
  "contract": "native-schema-slices.md revision 1",
  "slice": "2a",
  "setup": {
    "tcp4": "socket(AF_INET, SOCK_STREAM, 0), never connected",
    "tcp6": "socket(AF_INET6, SOCK_STREAM, 0), never connected",
    "unix": "socketpair(AF_UNIX, SOCK_STREAM, 0)",
    "notes": [
      "so_peercred, so_attach_filter use unix[0]; ipv6_v6only uses tcp6; every other case uses tcp4",
      "so_attach_filter program: one instruction BPF_RET|BPF_K accepting 0xffffffff bytes",
      "unknown cases use level SOL_SOCKET and optname 0x7fff",
      "fault.set passes optval address 1; negative_optlen.set passes optlen -1",
      "so_get_filter reads back the one-instruction program attached to unix[0]; optlen counts instructions",
      "ipv6_tclass uses tcp6 and checks that option 67 is not treated as a netfilter command"
    ]
  },
