# ---------------------------------------------------------------------------
# Disposable per-adapter work trees. Rebuilt by scripts/bootstrap.sh; never
# committed. See CONTRIBUTING.md.
# ---------------------------------------------------------------------------
/work/

# Large upstream Debian source input: fetched on demand by scripts/fetch-inputs.sh
*.orig.tar.xz

# Build products
*.deb
*.udeb
*.changes
*.buildinfo
*.build

# Rust build output (Cargo.lock is tracked for the desktop application)
target/

# Local capture and runtime artifacts
*.antcap
*.sock
*.ram

# Quilt state and generated images
.pc/
*.qcow2

# Editor / OS noise
*.swp
*.swo
.DS_Store
__pycache__/
*.pyc
