{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:antinomie:triage-report:2",
  "title": "Antinomie Triage report, schema version 2",
  "description": "The JSON export of Triage > Export report. A part the person did not choose is null. Version 2: summary.key_findings are objects (the version 1 sentences are summary.key_findings_text); entries carry an anchor id and links to other entries (*_ref, *_refs) that always name an id of the same file; tables carry typed row values in data. See docs/triage-report.md.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "generated_ms",
    "app",
    "run",
    "notes"
  ],
  "properties": {
    "schema": {
      "const": "antinomie-triage-report"
    },
    "schema_version": {
      "const": 2
    },
    "generated_ms": {
      "type": "integer",
      "minimum": 0
    },
    "app": {
      "type": "string"
    },
    "run": {
      "$ref": "#/$defs/run"
    },
    "sample": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sample"
        }
      ]
    },
    "summary": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/summary"
        }
      ]
    },
    "indicators": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/indicator"
          }
        }
      ]
    },
    "attack": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/technique"
          }
        }
      ]
    },
    "processes": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/table"
        }
      ]
    },
    "findings": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/table"
        }
      ]
    },
    "files": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "tabs"
          ],
          "properties": {
            "tabs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/named_table"
              }
            }
          }
        }
      ]
    },
    "file_activity": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file_record"
          }
        }
      ]
    },
    "network": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/named_table"
          }
        }
      ]
    },
    "detections": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/detection"
          }
        }
      ]
    },
    "evidence": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      ]
    },
    "custody": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/custody"
        }
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^([0-9a-f]{64})?$"
    },
    "kind": {
      "enum": [
        "endpoint",
        "domain",
        "url",
        "tls",
        "file"
      ]
    },
    "run": {
      "type": "object",
      "required": [
        "vm_id",
        "boot_id",
        "run_id",
        "finished"
      ],
      "properties": {
        "vm_id": {
          "type": "string"
        },
        "boot_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "started_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "finished": {
          "type": "boolean"
        },
        "state": {
          "type": "string"
        },
        "exit": {
          "type": "string"
        },
        "stopped_by_user": {
          "type": "boolean"
        },
        "ended_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "command": {
          "type": "string"
        },
        "route": {
          "type": "string"
        },
        "environment": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "sample": {
      "type": "object",
      "required": [
        "name",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "role": {
          "type": "string"
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "assessment",
        "statement",
        "highest_tier",
        "families",
        "key_behaviours",
        "counts"
      ],
      "properties": {
        "assessment": {
          "enum": [
            "matched_indicators",
            "suspicious_behaviour",
            "observed_only",
            "no_findings"
          ]
        },
        "statement": {
          "type": "string"
        },
        "highest_tier": {
          "enum": [
            "high",
            "medium",
            "low",
            "info",
            "none"
          ]
        },
        "families": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "family_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "key_behaviours": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rule",
              "tier",
              "category",
              "count"
            ],
            "properties": {
              "rule": {
                "type": "string"
              },
              "tier": {
                "enum": [
                  "high",
                  "medium",
                  "low",
                  "info"
                ]
              },
              "category": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "counts": {
          "type": "object",
          "required": [
            "processes",
            "findings",
            "indicators",
            "indicators_matched",
            "techniques",
            "files_changed",
            "files_opened",
            "endpoints",
            "domains"
          ],
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "key_findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key_finding"
          }
        },
        "key_findings_text": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The key findings as the sentences of schema version 1."
        },
        "key_findings_total": {
          "type": "integer",
          "minimum": 0
        },
        "other_families": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tiers": {
          "type": "object",
          "properties": {
            "high": {
              "type": "integer",
              "minimum": 0
            },
            "medium": {
              "type": "integer",
              "minimum": 0
            },
            "low": {
              "type": "integer",
              "minimum": 0
            },
            "info": {
              "type": "integer",
              "minimum": 0
            },
            "info_not_listed": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "indicator": {
      "type": "object",
      "required": [
        "kind",
        "value",
        "verdict",
        "matched"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "value": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "sources": {
          "type": "string"
        },
        "process": {
          "type": "string"
        },
        "first_seen": {
          "type": "string"
        },
        "first_seen_relative_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "first_seen as ms since the run's first call"
        },
        "last_seen": {
          "type": "string"
        },
        "count": {
          "type": "string"
        },
        "verdict": {
          "type": "string"
        },
        "matched": {
          "type": "boolean"
        },
        "dataset": {
          "type": "string"
        },
        "record_id": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "confidence": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "reference": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "sni": {
          "type": "string"
        },
        "ja3": {
          "type": "string"
        },
        "ja4": {
          "type": "string"
        },
        "cert_sha1": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "md5": {
          "type": "string"
        },
        "sha1": {
          "type": "string"
        },
        "base_noise": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/anchor"
        },
        "stand_in": {
          "type": "string"
        },
        "not_shared": {
          "type": "string"
        },
        "pids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "target_ref": {
          "$ref": "#/$defs/ref"
        },
        "process_refs": {
          "$ref": "#/$defs/refs"
        },
        "finding_refs": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "technique": {
      "type": "object",
      "required": [
        "id",
        "name",
        "rules",
        "count"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
        },
        "name": {
          "type": "string"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "rule_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "description": "One per rule; empty when the rule has no entry."
        }
      }
    },
    "table": {
      "type": "object",
      "required": [
        "columns",
        "rows",
        "omitted",
        "indicator_columns"
      ],
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "omitted": {
          "type": "integer",
          "minimum": 0
        },
        "indicator_columns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "column",
              "kind"
            ],
            "properties": {
              "column": {
                "type": "integer",
                "minimum": 0
              },
              "kind": {
                "$ref": "#/$defs/kind"
              }
            }
          }
        },
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row_data"
          }
        }
      }
    },
    "named_table": {
      "type": "object",
      "required": [
        "name",
        "table"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "table": {
          "$ref": "#/$defs/table"
        }
      }
    },
    "file_record": {
      "type": "object",
      "required": [
        "path",
        "created",
        "deleted",
        "changed",
        "reconstruction"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "created": {
          "type": "boolean"
        },
        "deleted": {
          "type": "boolean"
        },
        "changed": {
          "type": "boolean"
        },
        "final_size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "guest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reconstruction": {
          "enum": [
            "complete",
            "incomplete"
          ]
        },
        "bytes_written": {
          "type": "integer",
          "minimum": 0
        },
        "bytes_not_captured": {
          "type": "integer",
          "minimum": 0
        },
        "bytes_unknown": {
          "type": "integer",
          "minimum": 0
        },
        "bundle_entry": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/anchor"
        },
        "process_ref": {
          "$ref": "#/$defs/ref"
        },
        "finding_refs": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "detection": {
      "type": "object",
      "required": [
        "engine",
        "rule_id",
        "title",
        "severity",
        "mitre",
        "count"
      ],
      "properties": {
        "engine": {
          "type": "string"
        },
        "rule_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "mitre": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "author": {
          "type": "string",
          "description": "The rule's author as the rule gives it; empty when it names none."
        },
        "license": {
          "type": "string",
          "description": "The licence of the rule's pack."
        },
        "source": {
          "type": "string",
          "description": "The rule pack the rule came from."
        },
        "reference": {
          "type": "string",
          "description": "The rule's own reference link; empty when it names none."
        },
        "id": {
          "$ref": "#/$defs/anchor"
        },
        "strength": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "attack_refs": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "kind",
        "path",
        "size",
        "sha256"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "files": {
          "type": "integer",
          "minimum": 0,
          "description": "A folder: how many files it holds."
        }
      }
    },
    "custody": {
      "type": "object",
      "required": [
        "sample_sha256",
        "entries",
        "head",
        "verified"
      ],
      "properties": {
        "sample_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "entries": {
          "type": "integer",
          "minimum": 0
        },
        "head": {
          "$ref": "#/$defs/sha256"
        },
        "verified": {
          "type": "boolean"
        },
        "library_head": {
          "$ref": "#/$defs/sha256"
        },
        "problem": {
          "type": "string"
        }
      }
    },
    "anchor": {
      "type": "string",
      "pattern": "^(proc|file|ep|dom|rule|finding|det|attack|ioc)-[A-Za-z0-9._-]+$"
    },
    "ref": {
      "type": "string",
      "pattern": "^((proc|file|ep|dom|rule|finding|det|attack|ioc)-[A-Za-z0-9._-]+)?$"
    },
    "refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/anchor"
      }
    },
    "row_data": {
      "type": "object",
      "description": "One table row: its anchor, its values as numbers and its links.",
      "properties": {
        "id": {
          "$ref": "#/$defs/anchor"
        },
        "anchors": {
          "$ref": "#/$defs/refs"
        },
        "pid": {
          "type": "integer",
          "minimum": 0
        },
        "cookie": {
          "type": "integer",
          "minimum": 0
        },
        "parent_pid": {
          "type": "integer",
          "minimum": 0
        },
        "parent_cookie": {
          "type": "integer",
          "minimum": 0
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        },
        "time_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "ms since the epoch"
        },
        "relative_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "ms since the run's first call"
        },
        "last_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "a network row's last packet, ms since the epoch"
        },
        "last_relative_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "a network row's last packet, ms since the run's first call"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "addresses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rule": {
          "type": "string"
        },
        "tier": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "attack": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "process_ref": {
          "$ref": "#/$defs/ref"
        },
        "parent_ref": {
          "$ref": "#/$defs/ref"
        },
        "target_ref": {
          "$ref": "#/$defs/ref"
        },
        "domain_ref": {
          "$ref": "#/$defs/ref"
        },
        "endpoint_refs": {
          "$ref": "#/$defs/refs"
        },
        "attack_refs": {
          "$ref": "#/$defs/refs"
        },
        "finding_refs": {
          "$ref": "#/$defs/refs"
        },
        "file_refs": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "key_finding": {
      "type": "object",
      "required": [
        "tier",
        "rule",
        "title",
        "count"
      ],
      "properties": {
        "tier": {
          "enum": [
            "high",
            "medium",
            "low",
            "info"
          ]
        },
        "rule": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "process": {
          "type": "string"
        },
        "pid": {
          "type": [
            "integer",
            "null"
          ]
        },
        "cookie": {
          "type": [
            "integer",
            "null"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "first_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "relative_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "attack": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "why": {
          "type": "string"
        },
        "finding": {
          "type": [
            "integer",
            "null"
          ]
        },
        "finding_ref": {
          "$ref": "#/$defs/ref"
        },
        "process_ref": {
          "$ref": "#/$defs/ref"
        },
        "target_ref": {
          "$ref": "#/$defs/ref"
        },
        "attack_refs": {
          "$ref": "#/$defs/refs"
        }
      }
    }
  }
}
