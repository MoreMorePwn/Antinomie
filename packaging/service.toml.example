# SPDX-License-Identifier: GPL-3.0-only
#
# Example <data>/service.toml. Every key shown has its default; the file is
# optional. Check it with: antinomie-cli --data-dir <data> config validate
# Reference: docs/service-config.md. An unknown key is an error.

[daemon]
# socket = "<data>/run/antinomie.sock"
lanes = 1                    # 1 to 4; lane N needs `auto init --lane N` and RAM for every lane
host_workers = 2             # host work items at once (static tools, Triage, detection, report)
host_time_factor = 2         # an item may take this many times its expected time
shutdown = "cancel"          # or "drain": finish the running job first
drain_timeout_s = 600
shutdown_host_grace_s = 120

[queue]
max_queued = 1000
per_client_queued = 100
paused_on_start = false
wait_s = 3600                # how long a run may wait for resources before it fails

# What the owner on the local socket may do; every key is optional and none
# is set by default. A run above priority_max is refused (limit_exceeded),
# max_runs_per_day is counted only when it is set.
# [limits.local]
# priority_max = 9           # 0 to 9
# max_run_s = 1800
# max_queued = 100           # default: per_client_queued above
# max_running = 1            # runs of this caller running at once
# max_runs_per_day = 200     # unset: no daily limit

# The lanes of this node (one lane group in 0.9.0). Presets name the group in
# vm.lane_group; `auto init` makes the VM and its clean snapshot.
[lanes]
group = "x86_64"
vm = "auto-1"                # lane 1's VM, checked by config validate
revert = "snapshot_disk"     # or "snapshot_full", "reset"
revert_to = "auto-clean"
# stealth = "realistic-desktop"   # the profile the VM must have; unset: any
network = "routed"           # or "isolated", "disconnected"; never "nat"

[resources]
min_free_disk_gib = 20
# min_free_ram_mib = 4096    # default: the VM's RAM plus 2048
require_kvm = true

[retention]
jobs_days = 90
recordings_days = 14
max_recordings_gib = 200
keep_failed = true

# A folder to drop samples into (absolute path, owned by the daemon's user, not
# writable by others). Add it to ReadWritePaths in the unit.
# [[inbox.watch]]
# path = "/srv/drop/default"
# preset = "standard"        # runs it unchanged; preset_by_dir = true picks it by subfolder
# permissions = []           # beside runs.submit, e.g. ["evidence.core_dump"]
# priority_max = 5           # the highest priority its runs may ask for
# delete_after = "move"      # or "delete", "keep"

# A copy of job.json and the reports for every finished job.
# [results]
# dir = "/srv/results"

# A command run when a job ends: argv, never a shell; five ANTINOMIE_* variables.
# [notify]
# on_finish = ["/usr/local/bin/antinomie-hook"]

[log]
level = "info"
format = "text"
